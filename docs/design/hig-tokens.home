// HomeOS HIG tokens — machine-readable form of docs/design/hig.md
//
// docs/design/hig.md is normative prose; this file is the data that Craft
// consumes and that the compiler will enforce after the Phase 4 freeze
// (hig.md §8). A token change requires, in one PR: a HIG version bump, the
// change here, and a conformance-suite update.
//
// Two profiles:
//   BASE_*  desktop, from docs/design/hig.md v0.2 (pointer + keyboard, 60 cm)
//   TV_*    10-foot, from docs/design/hig-tv.md v0.1 (remote, 3 m, 1080p plane)
//
// Sizes are logical pixels. The TV profile's plane is 1920x1080; the HVS
// scales it to the physical mode, so these values are resolution-independent.
//
// Nothing here has run on hardware. See IMPLEMENTATION_STATUS.md.

// ============================================================================
// PROFILE: base (desktop) — docs/design/hig.md v0.2
// ============================================================================

// Type scale: base 15px, ratio ~1.2, whole pixels. hig.md §2.
export const BASE_TYPE_DISPLAY_PX: u32 = 36
export const BASE_TYPE_TITLE_PX: u32 = 24
export const BASE_TYPE_HEADING_PX: u32 = 18
export const BASE_TYPE_BODY_PX: u32 = 15
export const BASE_TYPE_CALLOUT_PX: u32 = 13
export const BASE_TYPE_CAPTION_PX: u32 = 12
export const BASE_TYPE_MIN_PX: u32 = 13

// Spacing: 4px grid. hig.md §3.
export const BASE_SPACE_XS_PX: u32 = 4
export const BASE_SPACE_S_PX: u32 = 8
export const BASE_SPACE_M_PX: u32 = 16
export const BASE_SPACE_L_PX: u32 = 24
export const BASE_SPACE_XL_PX: u32 = 40

export const BASE_RADIUS_S_PX: u32 = 4
export const BASE_RADIUS_M_PX: u32 = 8
export const BASE_RADIUS_L_PX: u32 = 12

export const BASE_HIT_TARGET_PX: u32 = 24

// Motion. hig.md §5. Reduced motion collapses every duration to SNAP.
export const BASE_MOTION_FAST_MS: u32 = 120
export const BASE_MOTION_BASE_MS: u32 = 200
export const BASE_MOTION_SLOW_MS: u32 = 320
export const BASE_MOTION_SNAP_MS: u32 = 0

// Contrast floors, x100 to stay integral (450 = 4.5:1). hig.md §6.
export const BASE_CONTRAST_BODY_X100: u32 = 450
export const BASE_CONTRAST_LARGE_X100: u32 = 300

// ============================================================================
// PROFILE: tv (10-foot) — docs/design/hig-tv.md v0.1, home-lang/home-os#50
// ============================================================================

// --- Plane and safe area. hig-tv.md §3.1 -----------------------------------

export const TV_PLANE_WIDTH_PX: u32 = 1920
export const TV_PLANE_HEIGHT_PX: u32 = 1080

// 5% title-safe inset on all four edges.
export const TV_SAFE_INSET_PCT: u32 = 5
export const TV_SAFE_X_PX: u32 = 96
export const TV_SAFE_Y_PX: u32 = 54
export const TV_SAFE_WIDTH_PX: u32 = 1728
export const TV_SAFE_HEIGHT_PX: u32 = 972

// --- Type scale. hig-tv.md §2 ----------------------------------------------
// Base 32px, ratio ~1.5. 24px is an absolute floor: nothing renders below it.

export const TV_TYPE_DISPLAY_PX: u32 = 96
export const TV_TYPE_TITLE_PX: u32 = 64
export const TV_TYPE_HEADING_PX: u32 = 40
export const TV_TYPE_BODY_PX: u32 = 32
export const TV_TYPE_CAPTION_PX: u32 = 24
export const TV_TYPE_MIN_PX: u32 = 24

export const TV_LINE_DISPLAY_PX: u32 = 104
export const TV_LINE_TITLE_PX: u32 = 72
export const TV_LINE_HEADING_PX: u32 = 48
export const TV_LINE_BODY_PX: u32 = 44
export const TV_LINE_CAPTION_PX: u32 = 32

// Maximum measure for body text, in characters.
export const TV_LINE_LENGTH_MAX_CHARS: u32 = 60

// --- Spacing: the desktop 4px grid doubled to 8px. hig-tv.md §3.2 ----------

export const TV_GRID_PX: u32 = 8
export const TV_SPACE_XS_PX: u32 = 8
export const TV_SPACE_S_PX: u32 = 16
export const TV_SPACE_M_PX: u32 = 32
export const TV_SPACE_L_PX: u32 = 48
export const TV_SPACE_XL_PX: u32 = 80

export const TV_RADIUS_S_PX: u32 = 8
export const TV_RADIUS_M_PX: u32 = 16
export const TV_RADIUS_L_PX: u32 = 24

// The TV analogue of the desktop hit target: the focusable element must be
// findable in one saccade at three metres.
export const TV_FOCUS_TARGET_MIN_PX: u32 = 96

// --- Contrast floors, x100. hig-tv.md §4 -----------------------------------

export const TV_CONTRAST_BODY_X100: u32 = 700
export const TV_CONTRAST_LARGE_X100: u32 = 450
export const TV_CONTRAST_FOCUS_X100: u32 = 450

// Opacity of the scrim under text drawn over artwork, in percent. Contrast is
// measured against the scrimmed result, never against the raw artwork.
export const TV_SCRIM_OPACITY_PCT: u32 = 80

// --- Focus language. hig-tv.md §5 ------------------------------------------
// Three simultaneous, non-redundant cues: scale, shadow, parallax. No ring:
// a 2px ring is invisible at three metres.

// Scale of the focused element about its own centre, x100 (108 = 1.08).
export const TV_FOCUS_SCALE_X100: u32 = 108

// Counter-motion of the artwork inside a focused card.
export const TV_FOCUS_PARALLAX_PX: u32 = 8

// Nudge shown when focus hits an edge that does not wrap (hig-tv.md §5.4).
export const TV_FOCUS_NUDGE_PX: u32 = 12

// Horizontal wrap does not exist. Vertical wrap-to-top exists only on long
// lists and only via long-press.
export const TV_FOCUS_WRAP_HORIZONTAL: bool = false
export const TV_FOCUS_WRAP_VERTICAL_LONGPRESS: bool = true

// A row longer than this shows a position indicator, since there is no
// scrollbar.
export const TV_LIST_POSITION_INDICATOR_MIN_ITEMS: u32 = 12

// --- Motion. hig-tv.md §6 --------------------------------------------------
// One curve for everything that is not snap. Reduced motion collapses every
// duration below to zero — not faster, zero.

export const TV_MOTION_FOCUS_MS: u32 = 150
export const TV_MOTION_PAGE_MS: u32 = 250
export const TV_MOTION_HERO_MS: u32 = 400
export const TV_MOTION_SNAP_MS: u32 = 0
export const TV_MOTION_CURVE: string = "ease-out-quart"
export const TV_MOTION_REDUCED_MS: u32 = 0

// --- Remote grammar timing. hig-tv.md §7 -----------------------------------

// Hold at least this long for the long-press variant. A shorter hold fires
// the short press instead; a long press does not also fire its short press.
export const TV_LONGPRESS_MS: u32 = 500

// Key-to-visible-change budget, end to end (gate input-latency, #101).
export const TV_INPUT_LATENCY_BUDGET_MS: u32 = 50

// The player OSD hides after this long with no input.
export const TV_OSD_AUTOHIDE_MS: u32 = 4000

// Player skip on a short Left/Right press.
export const TV_SKIP_SECONDS: u32 = 10
