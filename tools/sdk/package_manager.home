// home-os SDK - Package Manager
// Create and manage application packages

import "../../kernel/src/core/foundation.home" as foundation
import "../../kernel/src/core/filesystem.home" as filesystem

const MAX_PACKAGES: u32 = 1000

struct PackageManifest {
  name: [u8; 128],
  version: [u8; 32],
  description: [u8; 256],
  author: [u8; 128],
  license: [u8; 64],
  dependencies: [u64; 32],
  dep_count: u32
}

struct Package {
  manifest: PackageManifest,
  installed: u32,
  install_path: [u8; 256]
}

var packages: [Package; 1000]
var package_count: u32 = 0

export fn package_init() {
  package_count = 0
  foundation.serial_write_string("[Package] Package manager initialized\n")
}

// Use correct pointer syntax throughout
// Return 0 on success, 1 on failure (was inverted)
export fn package_create(name: u64, version: u64, description: u64): u32 {
  if name == 0 or version == 0 { return 1 }

  foundation.serial_write_string("[Package] Creating package: ")
  foundation.serial_write_string(name)
  foundation.serial_write_string("\n")

  var manifest: [u8; 1024]
  var pos: u32 = 0

  // Write "name: <name>\n"
  pos = write_str(@ptrFromInt(manifest), pos, "name: ")
  pos = write_str(@ptrFromInt(manifest), pos, name)
  @as(*u8, @ptrFromInt(@intFromPtr(&manifest[0]) + pos)).* = '\n'
  pos = pos + 1

  // Write "version: <version>\n"
  pos = write_str(@ptrFromInt(manifest), pos, "version: ")
  pos = write_str(@ptrFromInt(manifest), pos, version)
  @as(*u8, @ptrFromInt(@intFromPtr(&manifest[0]) + pos)).* = '\n'
  pos = pos + 1

  // Write "description: <description>\n" if provided
  if description != 0 {
    pos = write_str(@ptrFromInt(manifest), pos, "description: ")
    pos = write_str(@ptrFromInt(manifest), pos, description)
    @as(*u8, @ptrFromInt(@intFromPtr(&manifest[0]) + pos)).* = '\n'
    pos = pos + 1
  }

  // Save manifest
  var fd: u32 = filesystem.vfs_open(@ptrFromInt("package.manifest"), 0x0242, 0x1B6)
  if fd == 0xFFFFFFFF {
    foundation.serial_write_string("[Package] Failed to create manifest file\n")
    return 1
  }

  filesystem.vfs_write(fd, @ptrFromInt(manifest), pos)
  filesystem.vfs_close(fd)

  foundation.serial_write_string("[Package] Manifest created\n")
  return 0
}

// Proper string write helper with correct pointer operations and bounds
fn write_str(dest: u64, offset: u32, src: u64): u32 {
  if src == 0 { return offset }
  var i: u32 = 0
  while i < 512 and offset + i < 1023 {
    var ch: u8 = @as(*u8, @ptrFromInt(src + i)).*
    if ch == 0 { break }
    @as(*u8, @ptrFromInt(dest + offset + i)).* = ch
    i = i + 1
  }
  return offset + i
}

// Implement package_install with actual file operations
export fn package_install(package_file: u64): u32 {
  if package_file == 0 { return 1 }

  foundation.serial_write_string("[Package] Installing: ")
  foundation.serial_write_string(package_file)
  foundation.serial_write_string("\n")

  // Verify package file exists
  var fd: u32 = filesystem.vfs_open(package_file, 0)
  if fd == 0xFFFFFFFF {
    foundation.serial_write_string("[Package] Package file not found\n")
    return 1
  }

  // Read manifest from package
  var buffer: [u8; 4096]
  var bytes: u64 = filesystem.vfs_read(fd, @ptrFromInt(buffer), 4096)
  filesystem.vfs_close(fd)

  if bytes == 0 {
    foundation.serial_write_string("[Package] Empty package file\n")
    return 1
  }

  if package_count >= MAX_PACKAGES {
    foundation.serial_write_string("[Package] Package limit reached\n")
    return 1
  }

  // Register package
  packages[package_count].installed = 1
  package_count = package_count + 1

  foundation.serial_write_string("[Package] Installation complete\n")
  return 0
}

export fn package_uninstall(name: u64): u32 {
  if name == 0 { return 1 }

  foundation.serial_write_string("[Package] Uninstalling: ")
  foundation.serial_write_string(name)
  foundation.serial_write_string("\n")

  // Find package by name and remove
  var i: u32 = 0
  while i < package_count {
    if packages[i].installed == 1 and sdk_str_match(@ptrFromInt(packages[i].manifest.name), name) {
      packages[i].installed = 0
      foundation.serial_write_string("[Package] Uninstalled\n")
      return 0
    }
    i = i + 1
  }

  foundation.serial_write_string("[Package] Package not found\n")
  return 1
}

fn sdk_str_match(s1: u64, s2: u64): u32 {
  if s1 == 0 or s2 == 0 { return 0 }
  var i: u32 = 0
  while i < 128 {
    var c1: u8 = @as(*u8, @ptrFromInt(s1 + i)).*
    var c2: u8 = @as(*u8, @ptrFromInt(s2 + i)).*
    if c1 != c2 { return 0 }
    if c1 == 0 { return 1 }
    i = i + 1
  }
  return 0
}

// List all installed packages
export fn package_list(): u32 {
  var count: u32 = 0
  var i: u32 = 0
  while i < package_count {
    if packages[i].installed == 1 {
      count = count + 1
    }
    i = i + 1
  }
  return count
}

export fn main() {
  package_init()
  foundation.serial_write_string("Package Manager\n")
}
