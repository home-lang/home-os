// CPU operations for OS development
// Provides low-level CPU instructions via inline assembly

/// Output a byte to an I/O port
///
/// Writes a single byte to the specified port using the x86 OUT instruction.
///
/// Parameters:
///   - port: I/O port address (0-65535)
///   - value: Byte value to write
export inline fn outb(port: u16, value: u8) {
    if @targetIs("x86_64") {
        asm volatile ("outb %[value], %[port]"
            :
            : [port] "N{dx}" (port),
              [value] "{al}" (value),
        )
    } else {
        port_io_unavailable()
    }
}

/// Input a byte from an I/O port
///
/// Reads a single byte from the specified port using the x86 IN instruction.
///
/// Parameters:
///   - port: I/O port address (0-65535)
///
/// Returns: Byte value read from port
export inline fn inb(port: u16): u8 {
    var result: u8 = 0
    if @targetIs("x86_64") {
        asm volatile ("inb %[port], %[result]"
            : [result] "={al}" (result),
            : [port] "N{dx}" (port),
        )
    } else {
        port_io_unavailable()
    }
    return result
}

/// Output a word (16-bit) to an I/O port
///
/// Writes a 16-bit value to the specified port using the x86 OUT instruction.
///
/// Parameters:
///   - port: I/O port address (0-65535)
///   - value: 16-bit value to write
export inline fn outw(port: u16, value: u16) {
    if @targetIs("x86_64") {
        asm volatile ("outw %[value], %[port]"
            :
            : [port] "N{dx}" (port),
              [value] "{ax}" (value),
        )
    } else {
        port_io_unavailable()
    }
}

/// Input a word (16-bit) from an I/O port
///
/// Reads a 16-bit value from the specified port using the x86 IN instruction.
///
/// Parameters:
///   - port: I/O port address (0-65535)
///
/// Returns: 16-bit value read from port
export inline fn inw(port: u16): u16 {
    var result: u16 = 0
    if @targetIs("x86_64") {
        asm volatile ("inw %[port], %[result]"
            : [result] "={ax}" (result),
            : [port] "N{dx}" (port),
        )
    } else {
        port_io_unavailable()
    }
    return result
}

/// Output a double word (32-bit) to an I/O port
///
/// Writes a 32-bit value to the specified port using the x86 OUT instruction.
///
/// Parameters:
///   - port: I/O port address (0-65535)
///   - value: 32-bit value to write
export inline fn outl(port: u16, value: u32) {
    if @targetIs("x86_64") {
        asm volatile ("outl %[value], %[port]"
            :
            : [port] "N{dx}" (port),
              [value] "{eax}" (value),
        )
    } else {
        port_io_unavailable()
    }
}

/// Input a double word (32-bit) from an I/O port
///
/// Reads a 32-bit value from the specified port using the x86 IN instruction.
///
/// Parameters:
///   - port: I/O port address (0-65535)
///
/// Returns: 32-bit value read from port
export inline fn inl(port: u16): u32 {
    var result: u32 = 0
    if @targetIs("x86_64") {
        asm volatile ("inl %[port], %[result]"
            : [result] "={eax}" (result),
            : [port] "N{dx}" (port),
        )
    } else {
        port_io_unavailable()
    }
    return result
}

/// Halt the CPU until the next interrupt
///
/// Puts the CPU into a low-power state until an interrupt occurs.
/// This is commonly used in idle loops to save power.
export inline fn hlt() {
    arch_halt()
}

/// Disable interrupts (Clear Interrupt Flag)
///
/// Prevents the CPU from responding to maskable interrupts.
/// Use with caution - disabling interrupts for too long can cause system issues.
export inline fn cli() {
    arch_disable_interrupts()
}

/// Enable interrupts (Set Interrupt Flag)
///
/// Allows the CPU to respond to maskable interrupts again.
export inline fn sti() {
    arch_enable_interrupts()
}

/// Read the CPU timestamp counter
///
/// Returns the number of CPU cycles since reset using the RDTSC instruction.
///
/// Returns: 64-bit timestamp counter value
export inline fn rdtsc(): u64 {
    // CNTVCT_EL0 is ARM64's free-running counter — the same monotonic
    // cycle source, already assembled into one 64-bit value rather than
    // the edx:eax pair rdtsc returns.
    return arch_read_timestamp()
}

/// Load the Interrupt Descriptor Table Register
///
/// Sets the IDTR to point to the IDT.
///
/// Parameters:
///   - idtr_ptr: Pointer to IDTR structure (6 bytes: 2-byte limit + 4/8-byte base)
export inline fn lidt(idtr_ptr: *anyopaque) {
    if @targetIs("x86_64") {
        asm volatile ("lidt (%[idtr])"
            :
            : [idtr] "r" (idtr_ptr),
        )
    } else {
        descriptor_tables_unavailable()
    }
}

/// Load the Global Descriptor Table Register
///
/// Sets the GDTR to point to the GDT.
///
/// Parameters:
///   - gdtr_ptr: Pointer to GDTR structure (6 bytes: 2-byte limit + 4/8-byte base)
export inline fn lgdt(gdtr_ptr: *anyopaque) {
    if @targetIs("x86_64") {
        asm volatile ("lgdt (%[gdtr])"
            :
            : [gdtr] "r" (gdtr_ptr),
        )
    } else {
        descriptor_tables_unavailable()
    }
}

/// Invalidate TLB entry for a specific page
///
/// Flushes the Translation Lookaside Buffer entry for the given virtual address.
///
/// Parameters:
///   - addr: Virtual address to invalidate
export inline fn invlpg(addr: usize) {
    arch_invalidate_tlb_page(addr)
}

/// Write to Control Register 3 (Page Directory Base)
///
/// Sets the CR3 register which controls page table addressing.
///
/// Parameters:
///   - value: Physical address of page directory
export inline fn write_cr3(value: usize) {
    // TTBR0_EL1 is ARM64's page-table base register, the role CR3 plays.
    if @targetIs("x86_64") {
        arch_write_sysreg("cr3", value)
    } else {
        arch_write_sysreg("ttbr0_el1", value)
    }
}

/// Read from Control Register 3 (Page Directory Base)
///
/// Gets the current CR3 register value.
///
/// Returns: Physical address of current page directory
export inline fn read_cr3(): usize {
    if @targetIs("x86_64") {
        return arch_read_sysreg("cr3")
    } else {
        return arch_read_sysreg("ttbr0_el1")
    }
}

/// Read from Control Register 2 (Page Fault Linear Address)
///
/// Gets the CR2 register which contains the address that caused a page fault.
///
/// Returns: Virtual address that caused the last page fault
export inline fn read_cr2(): usize {
    // FAR_EL1 holds the faulting virtual address on ARM64, as CR2 does on x86.
    if @targetIs("x86_64") {
        return arch_read_sysreg("cr2")
    } else {
        return arch_read_sysreg("far_el1")
    }
}

/// No operation instruction
///
/// Does nothing, but prevents optimization from removing the instruction.
export inline fn nop() {
    arch_nop()
}

/// Pause instruction for spin-wait loops
///
/// Provides a hint to the CPU that we're in a spin-wait loop.
/// Improves performance and reduces power consumption.
export inline fn pause() {
    arch_spin_hint()
}

/// ARM64 has no I/O address space, so no return value from a port read could
/// be distinguished from a working device. Stopping is the honest answer:
/// ARM64 drivers reach their hardware over MMIO and never call these.
/// See STUB(S9).
fn port_io_unavailable() {
    loop {
        arch_halt()
    }
}

/// The GDT and IDT are x86 structures with no ARM64 counterpart — ARM64
/// vectors exceptions through a single VBAR_EL1 base and has no segmentation
/// to describe. Loading one on ARM64 is a caller bug, not a no-op.
fn descriptor_tables_unavailable() {
    loop {
        arch_halt()
    }
}
