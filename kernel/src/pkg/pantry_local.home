}

// Read a little-endian u32 from the package at `at`, or 0 when it would run
// off the end. Every multi-byte field goes through here.
fn pkg_u32(at: u32): u32 {
  if at + 4 > pkg_len { return 0 }
  return @as(u32, pkg_buf[at]) |
         (@as(u32, pkg_buf[at + 1]) << 8) |
         (@as(u32, pkg_buf[at + 2]) << 16) |
         (@as(u32, pkg_buf[at + 3]) << 24)
}

fn pkg_magic_ok(): u32 {
  if pkg_len < PKG_HEADER_BYTES { return 0 }
  if pkg_buf[0] != 72 { return 0 }    // H
  if pkg_buf[1] != 80 { return 0 }    // P
  if pkg_buf[2] != 75 { return 0 }    // K
  if pkg_buf[3] != 71 { return 0 }    // G
  if pkg_buf[4] != 48 { return 0 }    // 0
  if pkg_buf[5] != 48 { return 0 }    // 0
  if pkg_buf[6] != 48 { return 0 }    // 0
  if pkg_buf[7] != 49 { return 0 }    // 1
  return 1
}

// Read the whole package into memory. Returns 1 on success.
fn pkg_read(path: u64): u32 {
  pkg_len = 0
  var fd: u32 = filesystem.vfs_open(path, 0, 0)
  if fd == 0 { return 0 }

  var guard: u32 = 0
  while guard < 64 {
    if pkg_len >= PKG_MAX_BYTES { break }
    let room: u64 = @as(u64, PKG_MAX_BYTES - pkg_len)
    let got: u64 = filesystem.vfs_read(fd, @intFromPtr(&pkg_buf) + @as(u64, pkg_len), room)
    if got == 0 { break }
    pkg_len = pkg_len + @as(u32, got)
    guard = guard + 1
  }
  filesystem.vfs_close(fd)
  if pkg_len == 0 { return 0 }
  return 1
}

// Check the signature over everything before the signature length.
//
// Done before anything is written, and reported as a refusal rather than a
// warning: a package manager that installs what it could not verify is a
// package manager that does not verify.
fn pkg_signature_ok(): u32 {
  if pkg_magic_ok() == 0 {
    foundation.serial_write_string("[pantry] not a package: bad magic\n")
    return 0
  }

  let payload_len: u32 = pkg_u32(12)
  let body_len: u32 = PKG_HEADER_BYTES + payload_len
  if body_len > pkg_len {
    foundation.serial_write_string("[pantry] truncated: the entries run past the file\n")
    return 0
  }
  if body_len + 4 > pkg_len {
    foundation.serial_write_string("[pantry] truncated: no signature\n")
    return 0
  }

  let sig_len: u32 = pkg_u32(body_len)
  if sig_len != PANTRY_KEY_BYTES {
    foundation.serial_write_string("[pantry] signature is the wrong size for this key\n")
    return 0
  }
  if body_len + 4 + sig_len > pkg_len {
    foundation.serial_write_string("[pantry] truncated: the signature runs past the file\n")
    return 0
  }

  pantry_key_init()
  rsa.rsa_init()
  rsa.rsa_import_public_key(&pkg_key, @ptrFromInt(@intFromPtr(&pantry_key_n)),
                            PANTRY_KEY_BYTES, 65537)

  if rsa.rsa_verify(@ptrFromInt(@intFromPtr(&pkg_buf)), body_len,
                    @ptrFromInt(@intFromPtr(&pkg_buf) + @as(u64, body_len + 4)),
                    sig_len, &pkg_key) != 1 {
    foundation.serial_write_string("[pantry] REFUSED: signature does not verify\n")
    return 0
  }
  return 1
}

// Write one member out under `/usr/local/pantry/`. The name comes from the
// package, so it is checked: a name with a separator in it could otherwise
// name a path outside the install directory.
fn pkg_write_member(name_at: u32, name_len: u32, data_at: u32, data_len: u32): u32 {
  var i: u32 = 0
  while i < name_len {
    let c: u8 = pkg_buf[name_at + i]
    if c == 47 {
      foundation.serial_write_string("[pantry] REFUSED: a member name contains a separator\n")
      return 0
    }
    if c == 0 {
      foundation.serial_write_string("[pantry] REFUSED: a member name contains a NUL\n")
      return 0
    }
    i = i + 1
  }
  if name_len == 0 or name_len > 64 {
    foundation.serial_write_string("[pantry] REFUSED: a member name is empty or too long\n")
    return 0
  }

  // "/usr/local/pantry/" then the name.
  let prefix: u64 = @intFromPtr("/usr/local/pantry/")
  var at: u32 = 0
  while at < 18 {
    install_path[at] = @as(*u8, @ptrFromInt(prefix + @as(u64, at))).*
    at = at + 1
  }
  var k: u32 = 0
  while k < name_len {
    install_path[18 + k] = pkg_buf[name_at + k]
    k = k + 1
  }
  install_path[18 + name_len] = 0

  var fd: u32 = filesystem.vfs_open(@intFromPtr(&install_path), 65, 0o644)
  if fd == 0 {
    foundation.serial_write_string("[pantry] could not create ")
    foundation.serial_write_string(@intFromPtr(&install_path))
    foundation.serial_write_string("\n")
    return 0
  }
  filesystem.vfs_ftruncate(fd, 0)
  let put: u64 = filesystem.vfs_write(fd, @intFromPtr(&pkg_buf) + @as(u64, data_at),
                                      @as(u64, data_len))
  filesystem.vfs_close(fd)
  if put != @as(u64, data_len) {
    foundation.serial_write_string("[pantry] short write installing a member\n")
    return 0
  }
  return 1
}

// Install a signed package. Returns the number of files written, or 0.
export fn pantry_install_local(path: u64): u32 {
  if pkg_read(path) == 0 {
    foundation.serial_write_string("[pantry] cannot read the package\n")
    return 0
  }
  if pkg_signature_ok() == 0 { return 0 }

  foundation.serial_write_string("[pantry] signature verified over ")
  foundation.serial_write_u64(@as(u64, PKG_HEADER_BYTES + pkg_u32(12)))
  foundation.serial_write_string(" bytes\n")

  filesystem.vfs_mkdir(@intFromPtr("/usr"), 0o755)
  filesystem.vfs_mkdir(@intFromPtr("/usr/local"), 0o755)
  filesystem.vfs_mkdir(@intFromPtr("/usr/local/pantry"), 0o755)

  let count: u32 = pkg_u32(8)
  if count > PKG_MAX_FILES {
    foundation.serial_write_string("[pantry] REFUSED: too many members\n")
    return 0
  }

  let body_len: u32 = PKG_HEADER_BYTES + pkg_u32(12)
  var at: u32 = PKG_HEADER_BYTES
  var written: u32 = 0
  var n: u32 = 0
  while n < count {
    // Each field is bounded against the end of the entries section, not
    // against the end of the buffer: a length that reaches into the signature
    // is as wrong as one that reaches off the end.
    if at + 4 > body_len { return written }
    let name_len: u32 = pkg_u32(at)
    at = at + 4
    if at + name_len > body_len { return written }
    let name_at: u32 = at
    at = at + ((name_len + 3) & ~3)

    if at + 4 > body_len { return written }
    let data_len: u32 = pkg_u32(at)
    at = at + 4
    if at + data_len > body_len { return written }
    let data_at: u32 = at
    at = at + ((data_len + 3) & ~3)

    if pkg_write_member(name_at, name_len, data_at, data_len) == 0 { return written }
    written = written + 1
    n = n + 1
  }

  foundation.serial_write_string("[pantry] installed ")
  foundation.serial_write_u64(@as(u64, written))
  foundation.serial_write_string(" file(s) into /usr/local/pantry\n")
  return written
}
