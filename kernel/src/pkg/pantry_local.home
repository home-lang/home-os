  pantry_key_n[37] = 11
  pantry_key_n[38] = 103
  pantry_key_n[39] = 90
  pantry_key_n[40] = 210
  pantry_key_n[41] = 75
  pantry_key_n[42] = 152
  pantry_key_n[43] = 99
  pantry_key_n[44] = 84
  pantry_key_n[45] = 169
  pantry_key_n[46] = 255
  pantry_key_n[47] = 62
  pantry_key_n[48] = 233
  pantry_key_n[49] = 55
