// home-os — installing a signed package from a local repository.
//
// Phase 3's `pantry-local-install` gate. What makes it worth having is not
// that a package installs, but that an altered one does not: the signature is
// checked before a single byte is written, so a package that fails leaves the
// filesystem exactly as it was.
//
// The format is built by tools/make-package.py and described there. Every
// length in it comes from the package, which is to say from outside, so each
// one is bounded against what is actually present before it is used. A reader
// that trusts a length field is a reader that can be handed one.

import "../core/foundation.home" as foundation
import "../core/filesystem.home" as filesystem
import "../crypto/rsa.home" as rsa

const PKG_MAX_BYTES: u32 = 8192
const PKG_HEADER_BYTES: u32 = 16
const PKG_MAX_FILES: u32 = 16

var pkg_buf: [8192]u8 = undefined
var pkg_len: u32 = 0
var pkg_key: rsa.RsaPublicKey = undefined
var install_path: [256]u8 = undefined

const PANTRY_KEY_BYTES: u32 = 128
var pantry_key_n: [u8; 128] = undefined
