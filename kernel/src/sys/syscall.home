// ============================================================================
// File Descriptor Operations
// ============================================================================

// A duplicate is a second descriptor onto the same open file, sharing its
// offset — which needs the open-file table to be reference-counted from the
// descriptor side, and it is not: closing either copy would close the file
// under the other. dup2 returning `newfd` was the plausible-looking lie, since
// the number it returns is the number the caller asked for.
fn sys_dup(oldfd: u32): u64 {
  return ENOSYS
}

fn sys_dup2(oldfd: u32, newfd: u32): u64 {
  return ENOSYS
}

fn sys_dup3(oldfd: u32, newfd: u32, flags: u32): u64 {
  if oldfd == newfd { return EINVAL }
  return ENOSYS
}

// Pipe tracking
var pipe_count: u32 = 0

// Two descriptors onto one kernel buffer: the read end through pipefd[0], the
// write end through pipefd[1].
//
// This used to hand back descriptor numbers 200, 201, 202… counted up from a
// global, and nothing in the VFS answered to them: a write to the write end
// went nowhere and a read from the read end returned 0, which reads as end of
// file — so a shell built on it saw every pipeline produce empty output and
// no error (MASTER_PLAN §7, S14).
fn sys_pipe(pipefd: u64): u64 {
  if pipefd == 0 { return EINVAL }

  if ptr_safety.ptr_is_user(pipefd) == 0 {
    foundation.serial_write_string("[Syscall] pipe: invalid user buffer\n")
    return EINVAL
  }
  if ptr_safety.ptr_check_range(pipefd, 8) == 0 { return EINVAL }
  if ptr_safety.ptr_is_aligned_u32(pipefd) == 0 {
    foundation.serial_write_string("[Syscall] pipe: unaligned buffer\n")
    return EINVAL
  }

  var read_fd: u32 = 0
  var write_fd: u32 = 0
  if filesystem.vfs_pipe(&read_fd, &write_fd) != 0 { return EPERM }

  // The descriptors are live from here, so a failure to hand them back has to
  // close them rather than leak two slots and a pipe.
  if ptr_safety.ptr_safe_write_u32(pipefd, read_fd) != 0 {
    filesystem.vfs_close(read_fd)
    filesystem.vfs_close(write_fd)
    return EINVAL
  }
  if ptr_safety.ptr_safe_write_u32(pipefd + 4, write_fd) != 0 {
    filesystem.vfs_close(read_fd)
    filesystem.vfs_close(write_fd)
    return EINVAL
  }
  return 0
}

fn sys_pipe2(pipefd: u64, flags: u32): u64 {
  return sys_pipe(pipefd)
}

