// home-os Kernel - ASLR (Address Space Layout Randomization)
// Randomize memory layout to prevent exploitation

import "../core/foundation.home" as foundation
import "../core/memory.home" as memory
import "random.home" as random

const ASLR_ENABLED: u32 = 1
const KASLR_ENABLED: u32 = 1

// Randomization ranges.
//
// 28 bits is trivially brute-forceable (256M guesses).
// Linux amd64 uses 30 bits for exec, 30–32 for heap/mmap, and up to
// 36 for KASLR. Bump to realistic entropy so ASLR actually costs an
// attacker something — 36 bits = ~68 billion possible bases, well
// beyond what any practical attack can enumerate within a reboot.
const STACK_RANDOM_BITS: u32 = 30  // 1 GB range
const HEAP_RANDOM_BITS: u32 = 32   // 4 GB range
const MMAP_RANDOM_BITS: u32 = 32   // 4 GB range
const EXEC_RANDOM_BITS: u32 = 30   // 1 GB range
const KASLR_RANDOM_BITS: u32 = 36  // Full 64 GB window for kernel base

// Base addresses (will be randomized)
const STACK_BASE: u64 = 0x7FFFFFFFFFFF
const HEAP_BASE: u64 = 0x0000100000000000
const MMAP_BASE: u64 = 0x00007F0000000000
const EXEC_BASE: u64 = 0x0000555555554000

var aslr_initialized: u32 = 0
var kaslr_offset: u64 = 0

export fn aslr_init() {
  if aslr_initialized == 1 { return }
  
  // Initialize random number generator
  random.random_init()
  
  // Generate kernel ASLR offset using the full KASLR entropy range,
  // not the (smaller) exec range.
  if KASLR_ENABLED == 1 {
    kaslr_offset = aslr_generate_random_offset(KASLR_RANDOM_BITS)
    foundation.serial_write_string("[ASLR] Kernel offset: 0x")
    foundation.serial_write_hex(kaslr_offset)
    foundation.serial_write_string("\n")
  }
  
  aslr_initialized = 1
  foundation.serial_write_string("[ASLR] Initialized\n")
}

export fn aslr_get_kaslr_offset(): u64 {
  return kaslr_offset
}

export fn aslr_randomize_stack(base: u64): u64 {
  if ASLR_ENABLED == 0 { return base }

  // The old code clamped `offset = base` on underflow,
  // producing `randomized = 0` — i.e. it placed the stack at the
  // first page of the address space, which is never mappable.
  // We now cap the offset to leave at least a minimum stack headroom
  // below `base` and fall back to a sensible minimum instead of zero.
  const MIN_STACK_HEADROOM: u64 = 0x100000  // 1 MiB

  var offset: u64 = aslr_generate_random_offset(STACK_RANDOM_BITS)
  // If base is too small to safely subtract, don't randomize —
  // returning `base` unchanged is strictly safer than returning 0.
  if base < MIN_STACK_HEADROOM { return base }
  if offset > base - MIN_STACK_HEADROOM {
    offset = base - MIN_STACK_HEADROOM
  }
  var randomized: u64 = base - offset

  randomized = randomized & ~0xFFF

  foundation.serial_write_string("[ASLR] Stack randomized: 0x")
  foundation.serial_write_hex(randomized)
  foundation.serial_write_string("\n")

  return randomized
}

// Canonical x86_64 user addresses must stay below the
// 48-bit canonical split (0x0000_7FFF_FFFF_FFFF). Overflow past this
// produces a non-canonical address that faults on first access.
// Add checked arithmetic helper used by heap/mmap/exec/library.
const USER_ADDR_MAX: u64 = 0x00007FFFFFFFFFFF

fn aslr_saturating_add(base: u64, offset: u64): u64 {
  if base >= USER_ADDR_MAX { return base }
  if offset > USER_ADDR_MAX - base {
    return USER_ADDR_MAX
  }
  return base + offset
}

export fn aslr_randomize_heap(base: u64): u64 {
  if ASLR_ENABLED == 0 { return base }

  var offset: u64 = aslr_generate_random_offset(HEAP_RANDOM_BITS)
  var randomized: u64 = aslr_saturating_add(base, offset)

  // Align to page boundary
  randomized = randomized & ~0xFFF

  foundation.serial_write_string("[ASLR] Heap randomized: 0x")
  foundation.serial_write_hex(randomized)
  foundation.serial_write_string("\n")

  return randomized
}

export fn aslr_randomize_mmap(base: u64): u64 {
  if ASLR_ENABLED == 0 { return base }

  var offset: u64 = aslr_generate_random_offset(MMAP_RANDOM_BITS)
  var randomized: u64 = aslr_saturating_add(base, offset)

  // Align to page boundary
  randomized = randomized & ~0xFFF

  foundation.serial_write_string("[ASLR] Mmap randomized: 0x")
  foundation.serial_write_hex(randomized)
  foundation.serial_write_string("\n")

  return randomized
}

export fn aslr_randomize_exec(base: u64): u64 {
  if ASLR_ENABLED == 0 { return base }

  var offset: u64 = aslr_generate_random_offset(EXEC_RANDOM_BITS)
  var randomized: u64 = aslr_saturating_add(base, offset)

  // Align to page boundary
  randomized = randomized & ~0xFFF

  foundation.serial_write_string("[ASLR] Exec randomized: 0x")
  foundation.serial_write_hex(randomized)
  foundation.serial_write_string("\n")

  return randomized
}

export fn aslr_randomize_library(base: u64): u64 {
  if ASLR_ENABLED == 0 { return base }

  var offset: u64 = aslr_generate_random_offset(MMAP_RANDOM_BITS)
  var randomized: u64 = aslr_saturating_add(base, offset)

  // Align to page boundary
  randomized = randomized & ~0xFFF


  return randomized
}

fn aslr_generate_random_offset(bits: u32): u64 {
  // Need at least 13 bits to have any randomness after page alignment
  if bits <= 12 or bits > 63 { return 0 }
  var random_value: u64 = random.random_get_u64()

  // Mix in a second random source for better entropy
  var random2: u64 = random.random_get_u64()
  random_value = random_value ^ (random2 >> 17)

  var mask: u64 = (@as(u64, 1) << bits) - 1
  var offset: u64 = random_value & mask

  // Align to page boundary (4KB) — effective entropy is (bits - 12) bits
  offset = offset & ~@as(u64, 0xFFF)

  return offset
}

export fn aslr_is_enabled(): u32 {
  return ASLR_ENABLED
}

export fn aslr_is_kaslr_enabled(): u32 {
  return KASLR_ENABLED
}

// Get randomized addresses for process creation
export fn aslr_get_stack_base(): u64 {
  return aslr_randomize_stack(STACK_BASE)
}

export fn aslr_get_heap_base(): u64 {
  return aslr_randomize_heap(HEAP_BASE)
}

export fn aslr_get_mmap_base(): u64 {
  return aslr_randomize_mmap(MMAP_BASE)
}

export fn aslr_get_exec_base(): u64 {
  return aslr_randomize_exec(EXEC_BASE)
}

// Entropy measurement
export fn aslr_get_entropy_bits(): u32 {
  return STACK_RANDOM_BITS + HEAP_RANDOM_BITS + MMAP_RANDOM_BITS + EXEC_RANDOM_BITS
}

export fn aslr_get_address_space_entropy(): u32 {
  // Total entropy in bits for the entire address space layout
  return aslr_get_entropy_bits()
}

// Statistics
var aslr_randomizations: u64 = 0

export fn aslr_increment_randomizations() {
  aslr_randomizations = aslr_randomizations + 1
}

export fn aslr_get_randomization_count(): u64 {
  return aslr_randomizations
}
