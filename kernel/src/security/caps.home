// home-os Capabilities
// Capability-based security
//
// The capability store lives here directly: one bounding/permitted/effective
// triple per process, u64 bitmasks. The richer capabilities.home engine
// exists in-tree but is outside the minimum viable kernel link set; when it
// joins the MVK this module becomes a thin wrapper over it again.

import "../core/foundation.home" as foundation

const CAPS_MAX_PROCESSES: u32 = 256

// Per-process capability sets. A capability is a bit. Every process starts
// with an empty permitted/effective set and a full bounding set (0xFFFF…);
// caps_init() enforces that at boot, and init gets everything via
// caps_grant_full.
let cap_permitted: [CAPS_MAX_PROCESSES]u64 = [0; CAPS_MAX_PROCESSES]
let cap_effective: [CAPS_MAX_PROCESSES]u64 = [0; CAPS_MAX_PROCESSES]
let cap_bounding: [CAPS_MAX_PROCESSES]u64 = [0xFFFFFFFFFFFFFFFF; CAPS_MAX_PROCESSES]

fn full_mask(): u64 {
  return 0xFFFFFFFFFFFFFFFF
}

// Initialize the global capability engine. Every process starts with an
// empty effective set and a full bounding set; init gets everything via
// caps_grant_full.
export fn caps_init() {
  var i: u32 = 0
  while i < CAPS_MAX_PROCESSES {
    cap_permitted[i] = 0
    cap_effective[i] = 0
    cap_bounding[i] = full_mask()
    i = i + 1
  }
  foundation.serial_write_string("[Caps] Capability system initialized\n")
}

// Grant every capability to a process. Used for init (pid 0/1) only.
export fn caps_grant_full(process_id: u32) {
  if process_id >= CAPS_MAX_PROCESSES { return }
  cap_bounding[process_id] = full_mask()
  cap_permitted[process_id] = full_mask()
  cap_effective[process_id] = full_mask()
}

// Check whether a given process has the specified capability bit set.
// Returns 1 on success (allowed), 0 on failure (denied).
export fn caps_check(process_id: u32, cap: u64): u32 {
  if process_id >= CAPS_MAX_PROCESSES { return 0 }
  if (cap_effective[process_id] & cap) != 0 { return 1 }
  return 0
}

// Grant one or more capabilities to a process by updating its permitted and
// effective sets, constrained by the bounding set.
export fn caps_set(process_id: u32, caps: u64) {
  if process_id >= CAPS_MAX_PROCESSES { return }
  let allowed: u64 = caps & cap_bounding[process_id]
  cap_permitted[process_id] = cap_permitted[process_id] | allowed
  cap_effective[process_id] = cap_effective[process_id] | allowed
}

// Drop a capability from a process's effective (and permitted) set.
export fn caps_drop(process_id: u32, cap: u64) {
  if process_id >= CAPS_MAX_PROCESSES { return }
  let clear: u64 = ~cap
  cap_effective[process_id] = cap_effective[process_id] & clear
}
