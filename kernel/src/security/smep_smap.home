// home-os Kernel - SMEP/SMAP Support
// Supervisor Mode Execution Prevention / Supervisor Mode Access Prevention

import "../core/foundation.home" as foundation

// CR4 control register bits
const CR4_SMEP_BIT: u32 = 20  // Bit 20: SMEP enable
const CR4_SMAP_BIT: u32 = 21  // Bit 21: SMAP enable

var smep_enabled: u32 = 0
var smap_enabled: u32 = 0
var smep_violations: u64 = 0
var smap_violations: u64 = 0

// FIX R7 #32: Save crash context for post-mortem analysis. Captured
// before panic so operators can decode the faulting instruction and
// the offending user page after a SMEP/SMAP violation.
export var smep_last_rip: u64 = 0
export var smep_last_user_addr: u64 = 0
export var smep_last_cr2: u64 = 0
export var smep_last_cr3: u64 = 0
export var smap_last_rip: u64 = 0
export var smap_last_user_addr: u64 = 0
export var smap_last_cr2: u64 = 0
export var smap_last_cr3: u64 = 0

export fn smep_smap_init() {
  // Check CPU support
  if smep_check_support() == 1 {
    smep_enable()
  }
  
  if smap_check_support() == 1 {
    smap_enable()
  }
  
  foundation.serial_write_string("[SMEP/SMAP] Initialized - SMEP: ")
  if smep_enabled == 1 {
    foundation.serial_write_string("enabled")
  } else {
    foundation.serial_write_string("disabled")
  }
  foundation.serial_write_string(", SMAP: ")
  if smap_enabled == 1 {
    foundation.serial_write_string("enabled")
  } else {
    foundation.serial_write_string("disabled")
  }
  foundation.serial_write_string("\n")
}

fn smep_check_support(): u32 {
  // CPUID.07H:EBX[7] = SMEP support
  var eax: u32 = 0x07
  var ecx: u32 = 0
  var ebx: u32 = foundation.cpuid_ebx_ecx(eax, ecx)
  
  if (ebx & (1 << 7)) != 0 {
    return 1
  }
  return 0
}

fn smap_check_support(): u32 {
  // CPUID.07H:EBX[20] = SMAP support
  var eax: u32 = 0x07
  var ecx: u32 = 0
  var ebx: u32 = foundation.cpuid_ebx_ecx(eax, ecx)
  
  if (ebx & (1 << 20)) != 0 {
    return 1
  }
  return 0
}

fn smep_enable() {
  var cr4: u64 = foundation.read_cr4()
  cr4 = cr4 | (1 << CR4_SMEP_BIT)
  foundation.write_cr4(cr4)
  smep_enabled = 1
  foundation.serial_write_string("[SMEP] Enabled\n")
}

fn smap_enable() {
  var cr4: u64 = foundation.read_cr4()
  cr4 = cr4 | (1 << CR4_SMAP_BIT)
  foundation.write_cr4(cr4)
  smap_enabled = 1
  foundation.serial_write_string("[SMAP] Enabled\n")
}

export fn smep_handle_violation(rip: u64, user_addr: u64) {
  smep_violations = smep_violations + 1

  // FIX R7 #32: Snapshot crash context BEFORE panic so the values are
  // observable even if panic itself tramples the stack.
  smep_last_rip = rip
  smep_last_user_addr = user_addr
  smep_last_cr2 = foundation.read_cr2()
  smep_last_cr3 = foundation.read_cr3()

  foundation.serial_write_string("[SMEP] VIOLATION DETECTED!\n")
  foundation.serial_write_string("  RIP: 0x")
  foundation.serial_write_hex(rip)
  foundation.serial_write_string("\n  User address: 0x")
  foundation.serial_write_hex(user_addr)
  foundation.serial_write_string("\n  CR2: 0x")
  foundation.serial_write_hex(smep_last_cr2)
  foundation.serial_write_string("\n  CR3: 0x")
  foundation.serial_write_hex(smep_last_cr3)
  foundation.serial_write_string("\n")

  foundation.panic("SMEP violation - kernel attempted to execute user code")
}

export fn smap_handle_violation(rip: u64, user_addr: u64) {
  smap_violations = smap_violations + 1

  // FIX R7 #32: Same crash-context snapshot for SMAP.
  smap_last_rip = rip
  smap_last_user_addr = user_addr
  smap_last_cr2 = foundation.read_cr2()
  smap_last_cr3 = foundation.read_cr3()

  foundation.serial_write_string("[SMAP] VIOLATION DETECTED!\n")
  foundation.serial_write_string("  RIP: 0x")
  foundation.serial_write_hex(rip)
  foundation.serial_write_string("\n  User address: 0x")
  foundation.serial_write_hex(user_addr)
  foundation.serial_write_string("\n  CR2: 0x")
  foundation.serial_write_hex(smap_last_cr2)
  foundation.serial_write_string("\n  CR3: 0x")
  foundation.serial_write_hex(smap_last_cr3)
  foundation.serial_write_string("\n")

  foundation.panic("SMAP violation - kernel attempted to access user memory")
}

// FIX R7 #31: Return a status so callers can tell whether the AC-flag
// toggle actually happened. Silent no-ops caused copy_to_user wrappers
// to believe SMAP was temporarily disabled when it was never enabled
// in the first place, masking bugs on non-SMAP CPUs.
// Returns 0 on success, 1 if SMAP disabled (caller's request was a no-op).
export fn smap_stac(): u32 {
  if smap_enabled == 0 { return 1 }

  foundation.asm_stac()
  return 0
}

export fn smap_clac(): u32 {
  if smap_enabled == 0 { return 1 }

  foundation.asm_clac()
  return 0
}

export fn smep_is_enabled(): u32 {
  return smep_enabled
}

export fn smap_is_enabled(): u32 {
  return smap_enabled
}

export fn smep_get_violations(): u64 {
  return smep_violations
}

export fn smap_get_violations(): u64 {
  return smap_violations
}
