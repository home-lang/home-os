// home-os Kernel - File System Encryption
// Full-disk and per-file encryption support

import "../core/foundation.home" as foundation
import "../core/filesystem.home" as filesystem
import "../crypto/aes.home" as aes
import "random.home" as random

// Encryption algorithms
const ENCRYPT_NONE: u32 = 0
const ENCRYPT_AES256: u32 = 1
const ENCRYPT_CHACHA20: u32 = 2

// Key sizes
const KEY_SIZE_128: u32 = 16
const KEY_SIZE_256: u32 = 32

// Block size
const BLOCK_SIZE: u32 = 16

const MAX_ENCRYPTED_FILES: u32 = 1000

struct EncryptedFile {
  inode: u32,
  algorithm: u32,
  key: [u8; 32],
  iv: [u8; 16],
  enabled: u32
}

var encrypted_files: [EncryptedFile; 1000]
var encrypted_file_count: u32 = 0
var encryption_initialized: u32 = 0
var master_key: [u8; 32]
var master_key_set: u32 = 0

export fn encryption_init() {
  if encryption_initialized == 1 { return }
  
  encrypted_file_count = 0
  master_key_set = 0
  
  encryption_initialized = 1
  foundation.serial_write_string("[Encryption] Initialized\n")
}

// FIX R7 #22: Only accept standard AES key sizes. The previous code
// silently zero-padded 16-byte keys up to 32 bytes, producing an
// AES-256 key with half its bits known-zero.
const ENCRYPTION_KEY_SIZE_128: u32 = 16
const ENCRYPTION_KEY_SIZE_256: u32 = 32

export fn encryption_set_master_key(key: u64, size: u32): u32 {
  if key == 0 { return 0 }
  if size != ENCRYPTION_KEY_SIZE_128 and size != ENCRYPTION_KEY_SIZE_256 {
    return 0
  }

  // Zero the buffer first so a later 32→16 byte change doesn't
  // leave old tail bytes in place.
  var i: u32 = 0
  while i < 32 { master_key[i] = 0; i = i + 1 }

  i = 0
  while i < size {
    master_key[i] = @as(*u8, @ptrFromInt(key + i)).*
    i = i + 1
  }

  master_key_set = 1
  foundation.serial_write_string("[Encryption] Master key set\n")
  return 1
}

export fn encryption_generate_key(key_out: u64, size: u32): u32 {
  if size > 32 { return 0 }
  
  random.random_get_bytes(key_out, size)
  
  return 1
}

// FIX R7 #23: Wrap per-file keys under the master key before storing
// so a kernel memory disclosure alone doesn't expose every file key.
// The wrap is a keystream XOR with the master key repeated — a
// full AES-KW implementation would be ideal but this at least
// removes plaintext-in-memory.
fn encryption_wrap_key_in_place(buf: u64, len: u32) {
  if master_key_set == 0 { return }
  var i: u32 = 0
  while i < len {
    @as(*u8, @ptrFromInt(buf + i)).* = @as(*u8, @ptrFromInt(buf + i)).* ^ master_key[i % 32]
    i = i + 1
  }
}

export fn encryption_add_file(inode: u32, algorithm: u32): u32 {
  if encrypted_file_count >= MAX_ENCRYPTED_FILES { return 0 }

  var key: [u8; 32]
  var iv: [u8; 16]

  random.random_get_bytes(@intFromPtr(&key), 32)
  random.random_get_bytes(@intFromPtr(&iv), 16)

  encrypted_files[encrypted_file_count].inode = inode
  encrypted_files[encrypted_file_count].algorithm = algorithm

  var i: u32 = 0
  while i < 32 {
    encrypted_files[encrypted_file_count].key[i] = key[i]
    i = i + 1
  }
  i = 0
  while i < 16 {
    encrypted_files[encrypted_file_count].iv[i] = iv[i]
    i = i + 1
  }

  // Wrap the stored key and scrub stack copies.
  encryption_wrap_key_in_place(@intFromPtr(&encrypted_files[encrypted_file_count].key), 32)
  i = 0
  while i < 32 { key[i] = 0; i = i + 1 }
  i = 0
  while i < 16 { iv[i] = 0; i = i + 1 }

  encrypted_files[encrypted_file_count].enabled = 1
  encrypted_file_count = encrypted_file_count + 1

  foundation.serial_write_string("[Encryption] Added file inode ")
  foundation.serial_write_hex(inode)
  foundation.serial_write_string("\n")

  return encrypted_file_count - 1
}

// FIX R7 #24: Flip `enabled = 0` BEFORE wiping key material so a
// concurrent reader that's mid-operation bails out rather than
// racing against an all-zeros key.
export fn encryption_remove_file(inode: u32): u32 {
  var i: u32 = 0
  while i < encrypted_file_count {
    if encrypted_files[i].inode == inode {
      encrypted_files[i].enabled = 0
      var k: u32 = 0
      while k < 32 { encrypted_files[i].key[k] = 0; k = k + 1 }
      k = 0
      while k < 16 { encrypted_files[i].iv[k] = 0; k = k + 1 }
      return 1
    }
    i = i + 1
  }
  
  return 0
}

export fn encryption_is_encrypted(inode: u32): u32 {
  var i: u32 = 0
  while i < encrypted_file_count {
    if encrypted_files[i].inode == inode and encrypted_files[i].enabled == 1 {
      return 1
    }
    i = i + 1
  }
  
  return 0
}

export fn encryption_encrypt_block(inode: u32, block_in: u64, block_out: u64, size: u32): u32 {
  if block_in == 0 or block_out == 0 or size == 0 { return 0 }
  var i: u32 = 0
  while i < encrypted_file_count {
    if encrypted_files[i].inode == inode and encrypted_files[i].enabled == 1 {
      if encrypted_files[i].algorithm == ENCRYPT_AES256 {
        return encryption_aes256_encrypt(
          @ptrFromInt(encrypted_files[i].key),
          @ptrFromInt(encrypted_files[i].iv),
          block_in,
          block_out,
          size
        )
      } else if encrypted_files[i].algorithm == ENCRYPT_CHACHA20 {
        return encryption_chacha20_encrypt(
          @ptrFromInt(encrypted_files[i].key),
          @ptrFromInt(encrypted_files[i].iv),
          block_in,
          block_out,
          size
        )
      }
    }
    i = i + 1
  }
  
  return 0
}

export fn encryption_decrypt_block(inode: u32, block_in: u64, block_out: u64, size: u32): u32 {
  if block_in == 0 or block_out == 0 or size == 0 { return 0 }
  var i: u32 = 0
  while i < encrypted_file_count {
    if encrypted_files[i].inode == inode and encrypted_files[i].enabled == 1 {
      if encrypted_files[i].algorithm == ENCRYPT_AES256 {
        return encryption_aes256_decrypt(
          @ptrFromInt(encrypted_files[i].key),
          @ptrFromInt(encrypted_files[i].iv),
          block_in,
          block_out,
          size
        )
      } else if encrypted_files[i].algorithm == ENCRYPT_CHACHA20 {
        return encryption_chacha20_decrypt(
          @ptrFromInt(encrypted_files[i].key),
          @ptrFromInt(encrypted_files[i].iv),
          block_in,
          block_out,
          size
        )
      }
    }
    i = i + 1
  }
  
  return 0
}

// AES-256 encryption — delegates to the real AES implementation in crypto/aes.home.
// The previous XOR-based stub has been removed as it provided no real security.
fn encryption_aes256_encrypt(key: u64, iv: u64, input: u64, output: u64, size: u32): u32 {
  if size == 0 { return 0 }
  if size % 16 != 0 { return 0 }  // AES requires block-aligned input

  var aes_ctx_buf: [256]u8
  var ctx_addr: u64 = @intFromPtr(&aes_ctx_buf[0])

  // Initialize AES context with 256-bit key
  if aes.aes_init(ctx_addr, key, 256) != 0 { return 0 }

  // Encrypt block-by-block in CBC mode
  var prev_block: [16]u8
  var i: u32 = 0
  while i < 16 {
    prev_block[i] = @as(*u8, @ptrFromInt(iv + i)).*
    i = i + 1
  }

  var offset: u32 = 0
  while offset < size {
    // XOR plaintext block with previous ciphertext (or IV for first block)
    i = 0
    while i < 16 {
      var pt_byte: u8 = @as(*u8, @ptrFromInt(input + offset + i)).*
      @as(*u8, @ptrFromInt(output + offset + i)).* = pt_byte ^ prev_block[i]
      i = i + 1
    }

    // Encrypt the XOR'd block in-place
    aes.aes_encrypt_block(ctx_addr, output + offset, output + offset)

    // Save ciphertext as prev_block for next iteration
    i = 0
    while i < 16 {
      prev_block[i] = @as(*u8, @ptrFromInt(output + offset + i)).*
      i = i + 1
    }
    offset = offset + 16
  }

  return 1
}

fn encryption_aes256_decrypt(key: u64, iv: u64, input: u64, output: u64, size: u32): u32 {
  if size == 0 { return 0 }
  if size % 16 != 0 { return 0 }

  var aes_ctx_buf: [256]u8
  var ctx_addr: u64 = @intFromPtr(&aes_ctx_buf[0])

  if aes.aes_init(ctx_addr, key, 256) != 0 { return 0 }

  var prev_block: [16]u8
  var tmp_block: [16]u8
  var i: u32 = 0
  while i < 16 {
    prev_block[i] = @as(*u8, @ptrFromInt(iv + i)).*
    i = i + 1
  }

  var offset: u32 = 0
  while offset < size {
    // Save current ciphertext block before decryption
    i = 0
    while i < 16 {
      tmp_block[i] = @as(*u8, @ptrFromInt(input + offset + i)).*
      i = i + 1
    }

    // Decrypt the block
    aes.aes_decrypt_block(ctx_addr, input + offset, output + offset)

    // XOR with previous ciphertext (or IV) to get plaintext
    i = 0
    while i < 16 {
      @as(*u8, @ptrFromInt(output + offset + i)).* = @as(*u8, @ptrFromInt(output + offset + i)).* ^ prev_block[i]
      prev_block[i] = tmp_block[i]
      i = i + 1
    }
    offset = offset + 16
  }

  return 1
}

// ChaCha20 encryption (simplified implementation)
fn encryption_chacha20_encrypt(key: u64, nonce: u64, input: u64, output: u64, size: u32): u32 {
  // Simplified XOR-based encryption for now
  // Real implementation would use proper ChaCha20
  
  var i: u32 = 0
  while i < size {
    var key_byte: u8 = @as(*u8, @ptrFromInt(key + (i % 32))).*
    var nonce_byte: u8 = @as(*u8, @ptrFromInt(nonce + (i % 16))).*
    var input_byte: u8 = @as(*u8, @ptrFromInt(input + i)).*
    
    @as(*u8, @ptrFromInt(output + i)).* = input_byte ^ key_byte ^ nonce_byte ^ @truncate(i, u8)
    i = i + 1
  }
  
  return 1
}

fn encryption_chacha20_decrypt(key: u64, nonce: u64, input: u64, output: u64, size: u32): u32 {
  return encryption_chacha20_encrypt(key, nonce, input, output, size)
}

export fn encryption_get_encrypted_count(): u32 {
  return encrypted_file_count
}

export fn encryption_is_master_key_set(): u32 {
  return master_key_set
}
