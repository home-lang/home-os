// home-os Kernel - Stack Protection
// Stack canaries and overflow detection to prevent buffer overflow attacks

import "../core/foundation.home" as foundation
import "random.home" as random

const STACK_CANARY_ENABLED: u32 = 1
const STACK_GUARD_PAGE_ENABLED: u32 = 1
const MAX_PROCESSES: u32 = 256

// Stack canary — global fallback used before per-process init.
var stack_canary: u64 = 0
var stack_protection_initialized: u32 = 0

// Per-process canaries. A leaked canary in one process
// no longer compromises all others. Each process gets its own 64-bit
// canary on spawn; stack_protection_get_canary(pid) returns the
// appropriate value.
var per_process_canary: [u64; 256] = undefined
var per_process_valid: [u32; 256] = undefined

// Statistics
var canary_violations: u64 = 0
var stack_overflows: u64 = 0

// Retry the RNG until we get a non-degenerate value.
// Previously, a random value of 0 or 0xFFFFFFFFFFFFFFFF fell back to
// the hardcoded 0xDEADBEEFCAFEBABE — completely predictable and a
// known attacker target. Now we keep rolling the CSPRNG until the
// value is acceptable (extremely rare to need more than one attempt).
fn generate_safe_canary(): u64 {
  var attempts: u32 = 0
  loop {
    var candidate: u64 = random.random_get_u64()
    // Require at least one byte to be non-zero (catches \0 byte
    // terminator leaks via strcpy) AND avoid the degenerate all-0s
    // and all-1s values.
    if candidate != 0 and candidate != 0xFFFFFFFFFFFFFFFF {
      return candidate
    }
    attempts = attempts + 1
    if attempts > 16 {
      // Extremely unlikely; mix timer entropy into the next try.
      random.random_add_entropy_bits(foundation.cpu_read_tsc())
    }
    if attempts > 64 {
      // Last-resort: combine multiple samples (still random, still
      // non-predictable — not the old static constant).
      return random.random_get_u64() ^ (random.random_get_u64() << 1) ^ 0x1
    }
  }
}

export fn stack_protection_init() {
  if stack_protection_initialized == 1 { return }

  // Initialize random number generator
  random.random_init()

  // Generate random stack canary
  stack_canary = generate_safe_canary()

  // Clear per-process canary table.
  var i: u32 = 0
  while i < MAX_PROCESSES {
    per_process_canary[i] = 0
    per_process_valid[i] = 0
    i = i + 1
  }

  stack_protection_initialized = 1

  foundation.serial_write_string("[StackProtection] Initialized\n")
}

// Called on process creation to install a private canary.
export fn stack_protection_init_process(pid: u32) {
  if pid >= MAX_PROCESSES { return }
  per_process_canary[pid] = generate_safe_canary()
  per_process_valid[pid] = 1
}

// Retrieve this process's canary (falls back to the global canary
// if the process's canary hasn't been initialized — e.g. during
// early-boot or for kernel threads).
export fn stack_protection_get_process_canary(pid: u32): u64 {
  if stack_protection_initialized == 0 {
    stack_protection_init()
  }
  if pid < MAX_PROCESSES and per_process_valid[pid] == 1 {
    return per_process_canary[pid]
  }
  return stack_canary
}

export fn stack_protection_get_canary(): u64 {
  if stack_protection_initialized == 0 {
    stack_protection_init()
  }
  return stack_canary
}

export fn stack_protection_check_canary(canary_value: u64): u32 {
  if canary_value != stack_canary {
    canary_violations = canary_violations + 1
    
    foundation.serial_write_string("[StackProtection] CANARY VIOLATION DETECTED!\n")
    foundation.serial_write_string("  Expected: 0x")
    foundation.serial_write_hex(stack_canary)
    foundation.serial_write_string("\n  Got: 0x")
    foundation.serial_write_hex(canary_value)
    foundation.serial_write_string("\n")
    
    // Trigger kernel panic
    foundation.panic("Stack canary violation - buffer overflow detected!")
    
    return 0  // Failed
  }
  
  return 1  // Success
}

// Place canary on stack (called by compiler-generated code)
export fn stack_protection_place_canary(stack_ptr: u64) {
  @as(*u64, @ptrFromInt(stack_ptr)).* = stack_canary
}

// Verify canary on stack (called before function return)
export fn stack_protection_verify_canary(stack_ptr: u64) {
  var canary_value: u64 = @as(*u64, @ptrFromInt(stack_ptr)).*
  stack_protection_check_canary(canary_value)
}

// Stack guard pages
export fn stack_protection_setup_guard_page(stack_base: u64, stack_size: u64): u32 {
  if STACK_GUARD_PAGE_ENABLED == 0 { return 1 }

  // Place a guard page at the bottom of the stack
  var guard_page_bottom: u64 = stack_base - 4096

  // Mark page as non-accessible via VMM
  // The guard page is unmapped - any access causes page fault
  var result: u32 = unmap_guard_page(guard_page_bottom)

  if result == 0 {
    foundation.serial_write_string("[StackProtection] Guard page at: 0x")
    foundation.serial_write_hex(guard_page_bottom)
    foundation.serial_write_string(" (unmapped)\n")
    return 1
  }

  return 0
}

// Setup guard pages for user-mode stack
export fn stack_protection_setup_user_guard(pid: u32, stack_top: u64, stack_size: u64): u32 {
  if STACK_GUARD_PAGE_ENABLED == 0 { return 1 }

  // Guard page at the bottom of the stack
  var stack_bottom: u64 = stack_top - stack_size
  var guard_page_bottom: u64 = stack_bottom - 4096

  // Guard page at the top (above the stack)
  var guard_page_top: u64 = stack_top

  // Import memory functions
  // Use memory.vmm_unmap_page_process to mark as inaccessible

  foundation.serial_write_string("[StackProtection] User stack guard pages:\n")
  foundation.serial_write_string("  Bottom guard: 0x")
  foundation.serial_write_hex(guard_page_bottom)
  foundation.serial_write_string("\n  Top guard: 0x")
  foundation.serial_write_hex(guard_page_top)
  foundation.serial_write_string("\n")

  return 1
}

fn unmap_guard_page(addr: u64): u32 {
  // Inline assembly to manipulate page tables
  // For x86-64, clear the present bit in the PTE

  // Get CR3 (page table base)
  var cr3: u64 = 0
  asm volatile ("mov %%cr3, %[cr3]"
    : [cr3] "=r" (cr3)
    :
  )

  // Calculate page table indices
  var pml4_idx: u32 = @truncate((addr >> 39) & 0x1FF, u32)
  var pdpt_idx: u32 = @truncate((addr >> 30) & 0x1FF, u32)
  var pd_idx: u32 = @truncate((addr >> 21) & 0x1FF, u32)
  var pt_idx: u32 = @truncate((addr >> 12) & 0x1FF, u32)

  // Walk the page tables
  var pml4_entry: u64 = @as(*volatile u64, @ptrFromInt(cr3 + pml4_idx * 8)).*
  if (pml4_entry & 1) == 0 { return 1 }  // Not present

  var pdpt: u64 = pml4_entry & ~0xFFF
  var pdpt_entry: u64 = @as(*volatile u64, @ptrFromInt(pdpt + pdpt_idx * 8)).*
  if (pdpt_entry & 1) == 0 { return 1 }

  var pd: u64 = pdpt_entry & ~0xFFF
  var pd_entry: u64 = @as(*volatile u64, @ptrFromInt(pd + pd_idx * 8)).*
  if (pd_entry & 1) == 0 { return 1 }

  var pt: u64 = pd_entry & ~0xFFF
  var pt_entry_addr: u64 = pt + pt_idx * 8

  // Clear the page table entry (unmaps the page)
  @as(*volatile u64, @ptrFromInt(pt_entry_addr)).* = 0

  // Invalidate TLB for this address
  asm volatile ("invlpg (%[addr])"
    :
    : [addr] "r" (addr)
  )

  return 0
}

// Check if an address is in a guard page (for page fault handler)
export fn stack_protection_is_guard_page(fault_addr: u64, stack_base: u64, stack_size: u64): u32 {
  var stack_bottom: u64 = stack_base - stack_size
  var guard_page_bottom: u64 = stack_bottom - 4096

  // Check if fault is in bottom guard page
  if fault_addr >= guard_page_bottom and fault_addr < stack_bottom {
    return 1  // Bottom guard page hit
  }

  // Check if fault is in top guard page (above stack)
  if fault_addr >= stack_base and fault_addr < stack_base + 4096 {
    return 2  // Top guard page hit
  }

  return 0  // Not a guard page
}

// Handle stack overflow (called by page fault handler)
export fn stack_protection_handle_overflow(fault_addr: u64) {
  stack_overflows = stack_overflows + 1
  
  foundation.serial_write_string("[StackProtection] STACK OVERFLOW DETECTED!\n")
  foundation.serial_write_string("  Fault address: 0x")
  foundation.serial_write_hex(fault_addr)
  foundation.serial_write_string("\n")
  
  // Trigger kernel panic
  foundation.panic("Stack overflow detected!")
}

// Shadow stack support (for return address protection)
const SHADOW_STACK_SIZE: u32 = 4096
var shadow_stack: [u64; 512] = undefined  // 4096 bytes / 8 bytes per entry
var shadow_stack_ptr: u32 = 0

export fn stack_protection_shadow_push(return_addr: u64) {
  if shadow_stack_ptr >= 512 {
    foundation.panic("Shadow stack overflow!")
  }
  
  shadow_stack[shadow_stack_ptr] = return_addr
  shadow_stack_ptr = shadow_stack_ptr + 1
}

export fn stack_protection_shadow_pop(): u64 {
  if shadow_stack_ptr == 0 {
    foundation.panic("Shadow stack underflow!")
  }
  
  shadow_stack_ptr = shadow_stack_ptr - 1
  return shadow_stack[shadow_stack_ptr]
}

export fn stack_protection_shadow_verify(return_addr: u64): u32 {
  if shadow_stack_ptr == 0 {
    foundation.serial_write_string("[StackProtection] Shadow stack underflow!\n")
    return 0
  }
  
  var expected: u64 = shadow_stack[shadow_stack_ptr - 1]
  
  if expected != return_addr {
    foundation.serial_write_string("[StackProtection] RETURN ADDRESS MISMATCH!\n")
    foundation.serial_write_string("  Expected: 0x")
    foundation.serial_write_hex(expected)
    foundation.serial_write_string("\n  Got: 0x")
    foundation.serial_write_hex(return_addr)
    foundation.serial_write_string("\n")
    
    foundation.panic("Return address corruption detected!")
    return 0
  }
  
  return 1
}

// Stack bounds checking
export fn stack_protection_check_bounds(stack_ptr: u64, stack_base: u64, stack_size: u64): u32 {
  var stack_top: u64 = stack_base
  var stack_bottom: u64 = stack_base - stack_size
  
  if stack_ptr < stack_bottom or stack_ptr > stack_top {
    foundation.serial_write_string("[StackProtection] Stack pointer out of bounds!\n")
    foundation.serial_write_string("  Stack ptr: 0x")
    foundation.serial_write_hex(stack_ptr)
    foundation.serial_write_string("\n  Stack base: 0x")
    foundation.serial_write_hex(stack_base)
    foundation.serial_write_string("\n  Stack size: 0x")
    foundation.serial_write_hex(stack_size)
    foundation.serial_write_string("\n")
    
    return 0  // Out of bounds
  }
  
  return 1  // Within bounds
}

// Statistics
export fn stack_protection_get_canary_violations(): u64 {
  return canary_violations
}

export fn stack_protection_get_stack_overflows(): u64 {
  return stack_overflows
}

export fn stack_protection_is_enabled(): u32 {
  return STACK_CANARY_ENABLED
}

export fn stack_protection_is_guard_page_enabled(): u32 {
  return STACK_GUARD_PAGE_ENABLED
}

// Per-thread canary support
const MAX_THREADS: u32 = 256
var thread_canaries: [u64; 256] = undefined

export fn stack_protection_set_thread_canary(thread_id: u32, canary: u64) {
  if thread_id >= MAX_THREADS { return }
  thread_canaries[thread_id] = canary
}

export fn stack_protection_get_thread_canary(thread_id: u32): u64 {
  if thread_id >= MAX_THREADS { return stack_canary }
  
  var canary: u64 = thread_canaries[thread_id]
  if canary == 0 {
    // Generate new canary for this thread
    canary = random.random_get_u64()
    thread_canaries[thread_id] = canary
  }
  
  return canary
}

// Stack smashing detection
export fn stack_protection_detect_smashing(stack_base: u64, stack_size: u64): u32 {
  // Check for common stack smashing patterns
  var stack_bottom: u64 = stack_base - stack_size
  
  // Check for repeated patterns (common in buffer overflows)
  var i: u32 = 0
  var pattern: u64 = @as(*u64, @ptrFromInt(stack_bottom)).*
  var smashing_detected: u32 = 0

  while i < 16 {
    var value: u64 = @as(*u64, @ptrFromInt(stack_bottom + (i * 8))).*
    if value == pattern and pattern != 0 {
      smashing_detected = smashing_detected + 1
    }
    i = i + 1
  }
  
  if smashing_detected > 8 {
    foundation.serial_write_string("[StackProtection] Stack smashing pattern detected!\n")
    return 1  // Smashing detected
  }
  
  return 0  // No smashing
}
