// home-os AML — the ACPI Machine Language namespace parser
//
// AML is the bytecode the firmware's DSDT and SSDT tables are written in. It
// carries two different kinds of thing in one stream: declarations, which
// build a namespace, and executable statements, which only appear inside
// method bodies. This file parses the first and steps over the second.
//
// That split is what makes a useful parser much smaller than a full
// interpreter. The sleep types a kernel needs in order to power the machine
// down or suspend it are declarations — `Name (_S5, Package () { 0x00, ... })`
// — evaluated by nobody. Reading them does not require running any AML.
//
// The declaration walk does not execute methods; the interpreter further down
// does, within a subset whose edge is stated there. A method body is skipped
// by the walk and reached only through aml_call.
//
// The parse is checked by arithmetic rather than by inspection: every
// construct is length-prefixed, so a parser that misreads one opcode
// desynchronises and cannot land exactly on the end of the table. Consuming
// the table's own declared length, to the byte, is the assertion.

import "../core/foundation.home" as foundation

// Namespace-building opcodes.
const OP_ZERO: u8 = 0x00
const OP_ONE: u8 = 0x01
const OP_ALIAS: u8 = 0x06
const OP_NAME: u8 = 0x08
const OP_BYTE_PREFIX: u8 = 0x0A
const OP_WORD_PREFIX: u8 = 0x0B
const OP_DWORD_PREFIX: u8 = 0x0C
const OP_STRING_PREFIX: u8 = 0x0D
const OP_QWORD_PREFIX: u8 = 0x0E
const OP_SCOPE: u8 = 0x10
const OP_BUFFER: u8 = 0x11
const OP_PACKAGE: u8 = 0x12
const OP_VAR_PACKAGE: u8 = 0x13
const OP_METHOD: u8 = 0x14
const OP_EXTERNAL: u8 = 0x15
const OP_EXT_PREFIX: u8 = 0x5B
const OP_ONES: u8 = 0xFF

// Extended opcodes, all preceded by 0x5B.
const EXT_MUTEX: u8 = 0x01
const EXT_EVENT: u8 = 0x02
const EXT_OP_REGION: u8 = 0x80
const EXT_FIELD: u8 = 0x81
const EXT_DEVICE: u8 = 0x82
const EXT_PROCESSOR: u8 = 0x83
const EXT_POWER_RES: u8 = 0x84
const EXT_THERMAL_ZONE: u8 = 0x85
const EXT_INDEX_FIELD: u8 = 0x86
const EXT_BANK_FIELD: u8 = 0x87

// Name path prefixes.
const NAME_ROOT: u8 = 0x5C          // '\'
const NAME_PARENT: u8 = 0x5E        // '^'
const NAME_DUAL: u8 = 0x2E
const NAME_MULTI: u8 = 0x2F
const NAME_NULL: u8 = 0x00

// A table longer than this is not parsed at all. The bound exists so a length
// field that came off the firmware cannot send the walk through memory that
// is not the table.
const AML_MAX_LENGTH: u32 = 0x100000

var aml_base: u64 = 0
var aml_length: u32 = 0
var aml_pos: u32 = 0
var aml_failed: u32 = 0

// How many named objects the walk built. Not a checksum, but a number that
// changes if the walk starts skipping things.
var aml_names: u32 = 0
var aml_methods: u32 = 0
var aml_devices: u32 = 0

// Sleep types, indexed by state: S0 through S5.
var sleep_a: [u32; 6] = undefined
var sleep_b: [u32; 6] = undefined
var sleep_known: [u32; 6] = undefined

// The name currently being declared, as its last four characters packed
// little-endian — which is exactly how a NameSeg sits in the byte stream.
var current_name: u32 = 0

fn at(offset: u32): u8 {
  if offset >= aml_length { return 0 }
  return @as(*u8, @ptrFromInt(aml_base + @as(u64, offset))).*
}

fn take(): u8 {
  let b: u8 = at(aml_pos)
  aml_pos = aml_pos + 1
  return b
}

fn fail() {
  aml_failed = 1
  // Jump to the end so every enclosing loop unwinds rather than each one
  // needing to test the flag.
  aml_pos = aml_length
}

// PkgLength: the top two bits of the first byte say how many more bytes
// follow. With none, the low six bits are the whole length; otherwise the low
// four bits are the least significant nibble and the following bytes supply
// the rest. The length counts itself, which is what makes "skip to start +
// length" work.
fn pkg_length(): u32 {
  let lead: u8 = take()
  let extra: u32 = @as(u32, lead >> 6)
  if extra == 0 { return @as(u32, lead & 0x3F) }

  var value: u32 = @as(u32, lead & 0x0F)
  var i: u32 = 0
  while i < extra {
    value = value | (@as(u32, take()) << (4 + i * 8))
    i = i + 1
  }
  return value
}

// Step over a name path and return its final NameSeg. Returning only the last
// segment is enough for what this file looks for — `_S5` is `_S5_` wherever
// it is scoped — and it avoids carrying a path buffer through the walk.
fn name_string(): u32 {
  // Prefixes first: a root marker, then any number of parent markers.
  if at(aml_pos) == NAME_ROOT { aml_pos = aml_pos + 1 }
  while at(aml_pos) == NAME_PARENT { aml_pos = aml_pos + 1 }

  let lead: u8 = at(aml_pos)
  if lead == NAME_NULL {
    aml_pos = aml_pos + 1
    return 0
  }

  var segments: u32 = 1
  if lead == NAME_DUAL {
    aml_pos = aml_pos + 1
    segments = 2
  } else {
    if lead == NAME_MULTI {
      aml_pos = aml_pos + 1
      segments = @as(u32, take())
      // A multi-name with no segments is malformed, and treating it as zero
      // would leave the stream pointing at the next opcode's first byte with
      // nothing consumed.
      if segments == 0 { fail() }
    }
  }

  var last: u32 = 0
  var i: u32 = 0
  while i < segments {
    last = @as(u32, take())
      | (@as(u32, take()) << 8)
      | (@as(u32, take()) << 16)
      | (@as(u32, take()) << 24)
    i = i + 1
  }
  return last
}

// The integer a data object denotes, having consumed it. Non-integer objects
// consume themselves and report 0 — this reads sleep packages, whose elements
// are small integers, and everything else only has to be stepped over.
fn data_object(): u32 {
  let op: u8 = take()
  if op == OP_ZERO { return 0 }
  if op == OP_ONE { return 1 }
  if op == OP_ONES { return 0xFFFFFFFF }
  if op == OP_BYTE_PREFIX { return @as(u32, take()) }
  if op == OP_WORD_PREFIX {
    return @as(u32, take()) | (@as(u32, take()) << 8)
  }
  if op == OP_DWORD_PREFIX {
    return @as(u32, take()) | (@as(u32, take()) << 8)
      | (@as(u32, take()) << 16) | (@as(u32, take()) << 24)
  }
  if op == OP_QWORD_PREFIX {
    // Only the low half is returned: nothing this reads is wider, and a
    // sleep type that needed 64 bits would be a malformed table.
    let low: u32 = @as(u32, take()) | (@as(u32, take()) << 8)
      | (@as(u32, take()) << 16) | (@as(u32, take()) << 24)
    var i: u32 = 0
    while i < 4 {
      aml_pos = aml_pos + 1
      i = i + 1
    }
    return low
  }
  if op == OP_STRING_PREFIX {
    while aml_pos < aml_length {
      if take() == 0 { return 0 }
    }
    return 0
  }
  if op == OP_BUFFER or op == OP_PACKAGE or op == OP_VAR_PACKAGE {
    let start: u32 = aml_pos
    let length: u32 = pkg_length()
    if length == 0 { fail() }
    aml_pos = start + length
    return 0
  }
  // Anything else in a data position is a name or an expression this parser
  // does not evaluate. It has already consumed its opcode byte; there is
  // nothing more to skip, and reporting 0 is honest — it is not an integer.
  return 0
}

// A sleep package: `Name (_Sx, Package () { SLP_TYPa, SLP_TYPb, ... })`.
// Called with the stream positioned at the package opcode.
fn sleep_package(state: u32) {
  let op: u8 = at(aml_pos)
  if op != OP_PACKAGE and op != OP_VAR_PACKAGE {
    // Not a package. Consume it as an ordinary data object so the walk stays
    // aligned, and leave the state unknown rather than recording a value
    // that was never there.
    let ignored: u32 = data_object()
    return
  }

  aml_pos = aml_pos + 1
  let start: u32 = aml_pos
  let length: u32 = pkg_length()
  if length == 0 {
    fail()
    return
  }
  let end: u32 = start + length
  let count: u32 = @as(u32, take())

  if count >= 1 {
    sleep_a[state] = data_object()
    if count >= 2 {
      sleep_b[state] = data_object()
    }
    sleep_known[state] = 1
  }

  // However many elements were read, the package ends where its length says.
  aml_pos = end
}

// '_' 'S' <digit> '_' packed the way a NameSeg sits in the stream.
fn sleep_state_of(name: u32): u32 {
  if (name & 0xFF) != 95 { return 0xFFFFFFFF }          // '_'
  if ((name >> 8) & 0xFF) != 83 { return 0xFFFFFFFF }   // 'S'
  if ((name >> 24) & 0xFF) != 95 { return 0xFFFFFFFF }  // '_'
  let digit: u32 = (name >> 16) & 0xFF
  if digit < 48 or digit > 53 { return 0xFFFFFFFF }     // '0'..'5'
  return digit - 48
}

// One declaration. Returns after consuming exactly it.
fn term(): u32 {
  if aml_pos >= aml_length { return 0 }
  let op: u8 = take()

  if op == OP_NAME {
    aml_names = aml_names + 1
    let name: u32 = name_string()
    let state: u32 = sleep_state_of(name)
    if state != 0xFFFFFFFF {
      sleep_package(state)
    } else {
      let ignored: u32 = data_object()
    }
    return 1
  }

  if op == OP_SCOPE {
    // A scope's body is more declarations, so it is walked rather than
    // skipped — the sleep packages live inside the root scope.
    let start: u32 = aml_pos
    let length: u32 = pkg_length()
    if length == 0 {
      fail()
      return 0
    }
    let end: u32 = start + length
    let discarded: u32 = name_string()
    term_list(end)
    aml_pos = end
    return 1
  }

  if op == OP_METHOD {
    aml_methods = aml_methods + 1
    let start: u32 = aml_pos
    let length: u32 = pkg_length()
    if length == 0 {
      fail()
      return 0
    }
    let end: u32 = start + length
    let name: u32 = name_string()
    // MethodFlags: the low three bits are the argument count.
    let flags: u8 = take()
    register_method(name, aml_pos, end, @as(u32, flags & 0x07))
    // The body is executable AML. It is not walked here — it declares
    // nothing — but it is now reachable through aml_call.
    aml_pos = end
    return 1
  }

  if op == OP_ALIAS {
    let a: u32 = name_string()
    let b: u32 = name_string()
    aml_names = aml_names + 1
    return 1
  }

  if op == OP_EXTERNAL {
    let name: u32 = name_string()
    aml_pos = aml_pos + 2    // object type, argument count
    return 1
  }

  if op == OP_EXT_PREFIX {
    return ext_term()
  }

  // Anything else at this level is not a declaration. The stream is no
  // longer where this parser thinks it is, and guessing would produce a
  // namespace built out of misread bytes.
  fail()
  return 0
}

fn ext_term(): u32 {
  let op: u8 = take()

  // Length-prefixed, with a body of further declarations.
  if op == EXT_DEVICE or op == EXT_THERMAL_ZONE {
    aml_devices = aml_devices + 1
    let start: u32 = aml_pos
    let length: u32 = pkg_length()
    if length == 0 {
      fail()
      return 0
    }
    let end: u32 = start + length
    let name: u32 = name_string()
    term_list(end)
    aml_pos = end
    return 1
  }

  if op == EXT_PROCESSOR or op == EXT_POWER_RES {
    let start: u32 = aml_pos
    let length: u32 = pkg_length()
    if length == 0 {
      fail()
      return 0
    }
    let end: u32 = start + length
    let name: u32 = name_string()
    // Both carry fixed fields before their body: a processor has an ID, a
    // block address and a block length; a power resource a system level and
    // a resource order. Their bodies are declarations, but nothing this
    // reads lives in one, so the whole thing is stepped over.
    aml_pos = end
    return 1
  }

  // Length-prefixed, with a body this parser has no use for.
  if op == EXT_FIELD or op == EXT_INDEX_FIELD or op == EXT_BANK_FIELD {
    let start: u32 = aml_pos
    let length: u32 = pkg_length()
    if length == 0 {
      fail()
      return 0
    }
    aml_pos = start + length
    return 1
  }

  // Not length-prefixed: each is a name followed by a fixed shape.
  if op == EXT_OP_REGION {
    let name: u32 = name_string()
    aml_pos = aml_pos + 1              // region space
    let offset: u32 = data_object()    // region offset
    let size: u32 = data_object()      // region length
    aml_names = aml_names + 1
    return 1
  }

  if op == EXT_MUTEX {
    let name: u32 = name_string()
    aml_pos = aml_pos + 1              // sync flags
    aml_names = aml_names + 1
    return 1
  }

  if op == EXT_EVENT {
    let name: u32 = name_string()
    aml_names = aml_names + 1
    return 1
  }

  fail()
  return 0
}

fn term_list(end: u32) {
  while aml_pos < end {
    if aml_failed == 1 { return }
    if term() == 0 { return }
  }
}

// Parse a table's AML body. `base` is the table, `length` its whole length
// including the 36-byte header. Returns 1 when the walk consumed exactly the
// table and nothing was malformed.
export fn aml_parse(base: u64, length: u32): u32 {
  if base == 0 { return 0 }
  if length <= 36 or length > AML_MAX_LENGTH { return 0 }

  aml_base = base
  aml_length = length
  aml_pos = 36
  aml_failed = 0

  term_list(length)

  if aml_failed == 1 { return 0 }
  // Exactly the table, to the byte. Every construct here is length-prefixed,
  // so a parser that misread one opcode desynchronises and lands somewhere
  // else — which is why this is the check rather than "it did not crash".
  if aml_pos != length { return 0 }
  return 1
}

export fn aml_reset() {
  aml_names = 0
  method_count = 0
  methods_dropped = 0
  aml_methods = 0
  aml_devices = 0
  var i: u32 = 0
  while i < 6 {
    sleep_a[i] = 0
    sleep_b[i] = 0
    sleep_known[i] = 0
    i = i + 1
  }
}

export fn aml_name_count(): u32 { return aml_names }
export fn aml_method_count(): u32 { return aml_methods }
export fn aml_device_count(): u32 { return aml_devices }

// The SLP_TYP values for a sleep state, or 0 with aml_sleep_known() == 0.
export fn aml_sleep_known(state: u32): u32 {
  if state >= 6 { return 0 }
  return sleep_known[state]
}

export fn aml_sleep_typ_a(state: u32): u32 {
  if state >= 6 { return 0 }
  return sleep_a[state]
}

export fn aml_sleep_typ_b(state: u32): u32 {
  if state >= 6 { return 0 }
  return sleep_b[state]
}

// ============================================================================
// Method execution
//
// The declarations above build a namespace; this runs the executable AML
// inside a method body. The subset is deliberate and its edge is sharp:
// integers, the eight locals and seven arguments, arithmetic and logic,
// If/Else/While, Return and Store.
//
// Everything outside that subset — a field read, a buffer, a package element,
// a reference, a call to a method this parser did not see — makes evaluation
// *refuse*, and a refused evaluation propagates: the caller is told the method
// could not be run rather than handed a number. That is the whole design
// decision here. An interpreter that guessed at an unimplemented opcode would
// return plausible integers from methods it does not understand, and the
// caller has no way to tell those from real ones.
//
// This is enough to call the simple methods firmware actually writes for
// power transitions. It is not enough for a method that touches hardware
// through an operation region, and the refusal is how you find that out.
// ============================================================================

// QEMU's DSDT alone declares a hundred methods, and a table that overflowed
// silently would drop whichever ones came last — which is how _PTS, declared
// late in that table, went missing while the walk reported finding it.
const AML_MAX_METHODS: u32 = 256
const AML_MAX_DEPTH: u32 = 16

var method_name: [u32; 256] = undefined
var method_start: [u32; 256] = undefined
var method_end: [u32; 256] = undefined
var method_argc: [u32; 256] = undefined
var method_count: u32 = 0
// Methods the table had no room for. Counted rather than ignored: a lookup
// that misses is otherwise indistinguishable from a method the firmware does
// not declare.
var methods_dropped: u32 = 0

// Execution state. One frame: this interpreter does not recurse into another
// method while one is running, and says so rather than sharing the frame.
var aml_local: [u32; 8] = undefined
var aml_arg: [u32; 7] = undefined
var aml_result: u32 = 0
var aml_returned: u32 = 0
var aml_refused: u32 = 0
var aml_running: u32 = 0
var aml_depth: u32 = 0

// Opcodes this interpreter executes.
const OP_LOCAL0: u8 = 0x60
const OP_LOCAL7: u8 = 0x67
const OP_ARG0: u8 = 0x68
const OP_ARG6: u8 = 0x6E
const OP_STORE: u8 = 0x70
const OP_ADD: u8 = 0x72
const OP_SUBTRACT: u8 = 0x74
const OP_INCREMENT: u8 = 0x75
const OP_DECREMENT: u8 = 0x76
const OP_MULTIPLY: u8 = 0x77
const OP_DIVIDE: u8 = 0x78
const OP_SHIFT_LEFT: u8 = 0x79
const OP_SHIFT_RIGHT: u8 = 0x7A
const OP_AND: u8 = 0x7B
const OP_NAND: u8 = 0x7C
const OP_OR: u8 = 0x7D
const OP_NOR: u8 = 0x7E
const OP_XOR: u8 = 0x7F
const OP_NOT: u8 = 0x80
const OP_LAND: u8 = 0x90
const OP_LOR: u8 = 0x91
const OP_LNOT: u8 = 0x92
const OP_LEQUAL: u8 = 0x93
const OP_LGREATER: u8 = 0x94
const OP_LLESS: u8 = 0x95
const OP_IF: u8 = 0xA0
const OP_ELSE: u8 = 0xA1
const OP_WHILE: u8 = 0xA2
const OP_NOOP: u8 = 0xA3
const OP_RETURN: u8 = 0xA4
const OP_BREAK: u8 = 0xA5
const OP_BREAKPOINT: u8 = 0xCC

// A while loop that never terminates would hang the kernel in firmware code.
// Firmware loops are short; this bound is generous and finite.
const AML_MAX_ITERATIONS: u32 = 100000

fn refuse() {
  aml_refused = 1
}

// A target for Store and for the third operand of the arithmetic operators.
// Returns 1 if it consumed and applied a target, 0 if the target was the null
// one (Zero), and refuses for anything it cannot write.
fn store_target(value: u32): u32 {
  let op: u8 = at(aml_pos)
  if op == OP_ZERO {
    // The null target: the operator's value is its result and nothing is
    // written. Every arithmetic opcode carries one.
    aml_pos = aml_pos + 1
    return 0
  }
  if op >= OP_LOCAL0 and op <= OP_LOCAL7 {
    aml_pos = aml_pos + 1
    aml_local[@as(u32, op - OP_LOCAL0)] = value
    return 1
  }
  if op >= OP_ARG0 and op <= OP_ARG6 {
    aml_pos = aml_pos + 1
    aml_arg[@as(u32, op - OP_ARG0)] = value
    return 1
  }
  if op == OP_EXT_PREFIX and at(aml_pos + 1) == 0x31 {
    // The debug object. Writes to it are diagnostics and are discarded, which
    // is what it is for — not a refusal.
    aml_pos = aml_pos + 2
    return 1
  }
  // A named object, a field, an index, a reference. Writing any of those
  // needs a mutable namespace or hardware access, neither of which exists
  // here, and pretending the write happened would let a method appear to
  // succeed while changing nothing.
  refuse()
  return 0
}

// Evaluate one TermArg to an integer.
fn eval(): u32 {
  if aml_refused == 1 { return 0 }
  if aml_pos >= aml_length {
    refuse()
    return 0
  }

  let op: u8 = at(aml_pos)

  if op >= OP_LOCAL0 and op <= OP_LOCAL7 {
    aml_pos = aml_pos + 1
    return aml_local[@as(u32, op - OP_LOCAL0)]
  }
  if op >= OP_ARG0 and op <= OP_ARG6 {
    aml_pos = aml_pos + 1
    return aml_arg[@as(u32, op - OP_ARG0)]
  }

  if op == OP_ZERO or op == OP_ONE or op == OP_ONES or op == OP_BYTE_PREFIX or
     op == OP_WORD_PREFIX or op == OP_DWORD_PREFIX or op == OP_QWORD_PREFIX {
    return data_object()
  }

  // Binary arithmetic: two operands and a target.
  if op == OP_ADD or op == OP_SUBTRACT or op == OP_MULTIPLY or
     op == OP_SHIFT_LEFT or op == OP_SHIFT_RIGHT or op == OP_AND or
     op == OP_NAND or op == OP_OR or op == OP_NOR or op == OP_XOR {
    aml_pos = aml_pos + 1
    let a: u32 = eval()
    let b: u32 = eval()
    if aml_refused == 1 { return 0 }
    var value: u32 = 0
    if op == OP_ADD { value = a + b }
    if op == OP_SUBTRACT { value = a - b }
    if op == OP_MULTIPLY { value = a * b }
    if op == OP_SHIFT_LEFT {
      if b < 32 { value = a << b }
    }
    if op == OP_SHIFT_RIGHT {
      if b < 32 { value = a >> b }
    }
    if op == OP_AND { value = a & b }
    if op == OP_NAND { value = ~(a & b) }
    if op == OP_OR { value = a | b }
    if op == OP_NOR { value = ~(a | b) }
    if op == OP_XOR { value = a ^ b }
    let stored: u32 = store_target(value)
    return value
  }

  if op == OP_DIVIDE {
    aml_pos = aml_pos + 1
    let dividend: u32 = eval()
    let divisor: u32 = eval()
    if aml_refused == 1 { return 0 }
    if divisor == 0 {
      // AML says this is a fatal error. Refusing is this interpreter's
      // version of that: the caller learns the method did not run rather
      // than receiving a quotient that was never computed.
      refuse()
      return 0
    }
    let remainder: u32 = dividend % divisor
    let quotient: u32 = dividend / divisor
    let r_target: u32 = store_target(remainder)
    let q_target: u32 = store_target(quotient)
    return quotient
  }

  if op == OP_NOT {
    aml_pos = aml_pos + 1
    let a: u32 = eval()
    if aml_refused == 1 { return 0 }
    let value: u32 = ~a
    let stored: u32 = store_target(value)
    return value
  }

  if op == OP_INCREMENT or op == OP_DECREMENT {
    aml_pos = aml_pos + 1
    // The operand is both source and target, so it is read without consuming
    // it and then written.
    let before: u32 = aml_pos
    let a: u32 = eval()
    if aml_refused == 1 { return 0 }
    var value: u32 = a + 1
    if op == OP_DECREMENT { value = a - 1 }
    aml_pos = before
    let stored: u32 = store_target(value)
    return value
  }

  // Logical operators yield Ones for true and Zero for false, which is what
  // AML's predicates test.
  if op == OP_LEQUAL or op == OP_LGREATER or op == OP_LLESS or
     op == OP_LAND or op == OP_LOR {
    aml_pos = aml_pos + 1
    let a: u32 = eval()
    let b: u32 = eval()
    if aml_refused == 1 { return 0 }
    var truth: u32 = 0
    if op == OP_LEQUAL and a == b { truth = 1 }
    if op == OP_LGREATER and a > b { truth = 1 }
    if op == OP_LLESS and a < b { truth = 1 }
    if op == OP_LAND and a != 0 and b != 0 { truth = 1 }
    if op == OP_LOR {
      if a != 0 or b != 0 { truth = 1 }
    }
    if truth == 1 { return 0xFFFFFFFF }
    return 0
  }

  if op == OP_LNOT {
    aml_pos = aml_pos + 1
    let a: u32 = eval()
    if aml_refused == 1 { return 0 }
    if a == 0 { return 0xFFFFFFFF }
    return 0
  }

  if op == OP_STORE {
    aml_pos = aml_pos + 1
    let value: u32 = eval()
    if aml_refused == 1 { return 0 }
    let stored: u32 = store_target(value)
    return value
  }

  // A name in an expression position is either a call to a method or a read
  // of a named object. Neither is evaluable here — a named object's value
  // lives in a namespace this parser does not keep, and a method call would
  // need a second frame.
  refuse()
  return 0
}

// Execute the statements in [start, end).
fn exec_term_list(start: u32, end: u32) {
  aml_pos = start
  var guard: u32 = 0
  while aml_pos < end {
    if aml_refused == 1 { return }
    if aml_returned == 1 { return }
    guard = guard + 1
    if guard > AML_MAX_ITERATIONS {
      refuse()
      return
    }
    exec_statement(end)
  }
}

fn exec_statement(end: u32) {
  let op: u8 = at(aml_pos)

  if op == OP_NOOP or op == OP_BREAKPOINT {
    aml_pos = aml_pos + 1
    return
  }

  if op == OP_RETURN {
    aml_pos = aml_pos + 1
    aml_result = eval()
    aml_returned = 1
    return
  }

  if op == OP_IF {
    aml_pos = aml_pos + 1
    let pkg_start: u32 = aml_pos
    let length: u32 = pkg_length()
    if length == 0 {
      refuse()
      return
    }
    let body_end: u32 = pkg_start + length
    let taken: u32 = eval()
    if aml_refused == 1 { return }
    let body_start: u32 = aml_pos

    if taken != 0 {
      exec_term_list(body_start, body_end)
      if aml_refused == 1 or aml_returned == 1 { return }
    }
    aml_pos = body_end

    // An Else, if there is one, belongs to this If.
    if aml_pos < end {
      if at(aml_pos) == OP_ELSE {
        aml_pos = aml_pos + 1
        let else_start: u32 = aml_pos
        let else_length: u32 = pkg_length()
        if else_length == 0 {
          refuse()
          return
        }
        let else_end: u32 = else_start + else_length
        if taken == 0 {
          exec_term_list(aml_pos, else_end)
          if aml_refused == 1 or aml_returned == 1 { return }
        }
        aml_pos = else_end
      }
    }
    return
  }

  if op == OP_WHILE {
    aml_pos = aml_pos + 1
    let pkg_start: u32 = aml_pos
    let length: u32 = pkg_length()
    if length == 0 {
      refuse()
      return
    }
    let loop_end: u32 = pkg_start + length
    let predicate_at: u32 = aml_pos

    var iterations: u32 = 0
    loop {
      aml_pos = predicate_at
      let condition: u32 = eval()
      if aml_refused == 1 { return }
      if condition == 0 { break }
      let body_start: u32 = aml_pos
      exec_term_list(body_start, loop_end)
      if aml_refused == 1 or aml_returned == 1 { return }
      iterations = iterations + 1
      if iterations >= AML_MAX_ITERATIONS {
        // Firmware loops are short. One that is not is either malformed or
        // waiting on hardware this interpreter cannot touch, and hanging the
        // kernel inside it is not an option.
        refuse()
        return
      }
    }
    aml_pos = loop_end
    return
  }

  if op == OP_ELSE {
    // An Else with no If before it. The stream is not where this thinks it
    // is, and stepping over it would run its body unconditionally.
    refuse()
    return
  }

  // Anything else is an expression evaluated for its effect — a Store, an
  // arithmetic operator with a target, a call. eval() refuses what it cannot
  // do, so an unimplemented opcode stops the method rather than being
  // skipped.
  let discarded: u32 = eval()
}

// Register a method the namespace walk found, so it can be called later.
fn register_method(name: u32, body_start: u32, body_end: u32, argc: u32) {
  if method_count >= AML_MAX_METHODS {
    methods_dropped = methods_dropped + 1
    return
  }
  method_name[method_count] = name
  method_start[method_count] = body_start
  method_end[method_count] = body_end
  method_argc[method_count] = argc
  method_count = method_count + 1
}

export fn aml_method_registered(name: u32): u32 {
  var i: u32 = 0
  while i < method_count {
    if method_name[i] == name { return 1 }
    i = i + 1
  }
  return 0
}

// Call a method by its final NameSeg with one argument.
//
// Returns 1 when the method ran to completion; the value is then in
// aml_call_result(). Returns 0 when it could not be run — because it is not
// registered, or because it used something outside the subset above. Those
// are different from a method that ran and returned 0, which is why the
// result is not the return value.
export fn aml_call(name: u32, arg0: u32): u32 {
  if aml_running == 1 { return 0 }

  var index: u32 = AML_MAX_METHODS
  var i: u32 = 0
  while i < method_count {
    if method_name[i] == name { index = i }
    i = i + 1
  }
  if index >= method_count { return 0 }

  aml_running = 1
  aml_refused = 0
  aml_returned = 0
  aml_result = 0
  var j: u32 = 0
  while j < 8 {
    aml_local[j] = 0
    j = j + 1
  }
  j = 0
  while j < 7 {
    aml_arg[j] = 0
    j = j + 1
  }
  aml_arg[0] = arg0

  let saved: u32 = aml_pos
  exec_term_list(method_start[index], method_end[index])
  aml_pos = saved
  aml_running = 0

  if aml_refused == 1 { return 0 }
  return 1
}

export fn aml_call_result(): u32 { return aml_result }
export fn aml_registered_methods(): u32 { return method_count }
export fn aml_methods_dropped(): u32 { return methods_dropped }


// ============================================================================
// Interpreter self-test
//
// A hand-assembled AML method rather than one out of the firmware, because a
// firmware method's result depends on which firmware, and this has to assert
// an exact number. The program is:
//
//   Method (TEST, 1) {
//     Local0 = 0
//     Local1 = Arg0
//     While (Local1 > 0) { Local0 += Local1;  Local1 -= 1 }
//     If (Local0 > 100)  { Return (Local0 - 100) }
//     Return (Local0)
//   }
//
// It exercises a loop, a conditional, arithmetic with a target, locals and an
// argument — and the two calls take different branches, so a conditional that
// always went one way would fail one of them.
// ============================================================================

export const AML_INTERP_CHECKS: u32 = 5

const AML_TEST_LENGTH: u32 = 80
var aml_test_table: [u8; 80] = undefined

fn build_test_table() {
  var i: u32 = 0
  while i < AML_TEST_LENGTH {
    aml_test_table[i] = 0
    i = i + 1
  }
  // A DSDT header: only the signature and the length are read by the parser,
  // and the length is what its correctness check compares against.
  aml_test_table[0] = 68    // 'D'
  aml_test_table[1] = 83    // 'S'
  aml_test_table[2] = 68    // 'D'
  aml_test_table[3] = 84    // 'T'
  aml_test_table[4] = @as(u8, AML_TEST_LENGTH & 0xFF)
  aml_test_table[5] = 0
  aml_test_table[6] = 0
  aml_test_table[7] = 0

  aml_test_table[36] = 0x14
  aml_test_table[37] = 0x2B
  aml_test_table[38] = 0x54
  aml_test_table[39] = 0x45
  aml_test_table[40] = 0x53
  aml_test_table[41] = 0x54
  aml_test_table[42] = 0x01
  aml_test_table[43] = 0x70
  aml_test_table[44] = 0x00
  aml_test_table[45] = 0x60
  aml_test_table[46] = 0x70
  aml_test_table[47] = 0x68
  aml_test_table[48] = 0x61
  aml_test_table[49] = 0xA2
  aml_test_table[50] = 0x10
  aml_test_table[51] = 0x94
  aml_test_table[52] = 0x61
  aml_test_table[53] = 0x00
  aml_test_table[54] = 0x70
  aml_test_table[55] = 0x72
  aml_test_table[56] = 0x60
  aml_test_table[57] = 0x61
  aml_test_table[58] = 0x00
  aml_test_table[59] = 0x60
  aml_test_table[60] = 0x70
  aml_test_table[61] = 0x74
  aml_test_table[62] = 0x61
  aml_test_table[63] = 0x01
  aml_test_table[64] = 0x00
  aml_test_table[65] = 0x61
  aml_test_table[66] = 0xA0
  aml_test_table[67] = 0x0B
  aml_test_table[68] = 0x94
  aml_test_table[69] = 0x60
  aml_test_table[70] = 0x0A
  aml_test_table[71] = 0x64
  aml_test_table[72] = 0xA4
  aml_test_table[73] = 0x74
  aml_test_table[74] = 0x60
  aml_test_table[75] = 0x0A
  aml_test_table[76] = 0x64
  aml_test_table[77] = 0x00
  aml_test_table[78] = 0xA4
  aml_test_table[79] = 0x60
}

export fn aml_interpreter_selftest(): u32 {
  var passed: u32 = 0
  build_test_table()

  aml_reset()
  // 1: the synthetic table parses, exactly.
  if aml_parse(@intFromPtr(&aml_test_table), AML_TEST_LENGTH) == 1 {
    passed = passed + 1
  }

  // 2: and the method in it was registered.
  //    'T','E','S','T' packed the way a NameSeg sits in the stream.
  let test_name: u32 = 84 | (69 << 8) | (83 << 16) | (84 << 24)
  if aml_method_registered(test_name) == 1 { passed = passed + 1 }

  // 3: sum 1..10 is 55, which does not exceed 100, so the If is not taken.
  if aml_call(test_name, 10) == 1 and aml_call_result() == 55 {
    passed = passed + 1
  }

  // 4: sum 1..20 is 210, which does, so it returns 110. Different branch,
  //    same method — a conditional that always went one way fails one of
  //    these two.
  if aml_call(test_name, 20) == 1 and aml_call_result() == 110 {
    passed = passed + 1
  }

  // 5: a method that does not exist is refused rather than answered. The
  //    call returning 0 is what tells a caller apart from a method that ran
  //    and returned 0.
  if aml_call(0x5A5A5A5A, 1) == 0 { passed = passed + 1 }

  return passed
}

// How many of the firmware's own methods this interpreter can execute.
//
// Every method is called with argument 0 and the results counted, not used.
// That is safe precisely because of the refusal rule: a method that reaches a
// field, a buffer, a package or another method stops rather than doing
// anything, so the only side effects possible are writes to locals and to the
// debug object. What comes back is a measurement of the subset against real
// firmware rather than against a program written to fit it.
export fn aml_survey_methods(): u32 {
  var ran: u32 = 0
  var i: u32 = 0
  while i < method_count {
    if aml_call(method_name[i], 0) == 1 { ran = ran + 1 }
    i = i + 1
  }
  return ran
}
