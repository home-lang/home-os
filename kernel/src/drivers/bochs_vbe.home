// home-os Kernel — Bochs VBE display driver
//
// QEMU's -kernel loader implements Multiboot1 without the video-mode
// extension: it ignores the header's framebuffer request and leaves the info
// structure's framebuffer fields absent. A kernel booted that way has no
// framebuffer unless it programs the display itself.
//
// This programs it. The device QEMU presents as `-vga std` is the Bochs
// display adapter, whose registers are reached through an index/data port
// pair; setting a mode is a handful of writes and the linear framebuffer is
// the device's first PCI memory BAR.

import "../core/foundation.home" as foundation
import "pci.home" as pci

// Index and data ports of the VBE dispatch interface.
const VBE_DISPI_IOPORT_INDEX: u16 = 0x01CE
const VBE_DISPI_IOPORT_DATA: u16 = 0x01CF

const VBE_DISPI_INDEX_ID: u16 = 0
const VBE_DISPI_INDEX_XRES: u16 = 1
const VBE_DISPI_INDEX_YRES: u16 = 2
const VBE_DISPI_INDEX_BPP: u16 = 3
const VBE_DISPI_INDEX_ENABLE: u16 = 4
const VBE_DISPI_INDEX_VIRT_WIDTH: u16 = 6
const VBE_DISPI_INDEX_VIRT_HEIGHT: u16 = 7
const VBE_DISPI_INDEX_X_OFFSET: u16 = 8
const VBE_DISPI_INDEX_Y_OFFSET: u16 = 9

const VBE_DISPI_DISABLED: u16 = 0x00
const VBE_DISPI_ENABLED: u16 = 0x01
const VBE_DISPI_LFB_ENABLED: u16 = 0x40

// Any ID in 0xB0C0..0xB0C5 identifies the adapter; the low digit is the
// interface revision and only matters for features this does not use.
const VBE_DISPI_ID_BASE: u16 = 0xB0C0

// QEMU's std VGA. The Bochs adapter proper uses the same registers.
const PCI_VENDOR_QEMU: u16 = 0x1234
const PCI_DEVICE_VGA: u16 = 0x1111
const PCI_VENDOR_BOCHS: u16 = 0x1AF4
const PCI_DEVICE_BOCHS_VGA: u16 = 0x1050

var fb_base: u64 = 0
var fb_width: u32 = 0
var fb_height: u32 = 0
var fb_bpp: u32 = 0
var initialized: u32 = 0

fn vbe_write(index: u16, value: u16) {
  foundation.outw(VBE_DISPI_IOPORT_INDEX, index)
  foundation.outw(VBE_DISPI_IOPORT_DATA, value)
}

fn vbe_read(index: u16): u16 {
  foundation.outw(VBE_DISPI_IOPORT_INDEX, index)
  return foundation.inw(VBE_DISPI_IOPORT_DATA)
}

// Is a Bochs-compatible adapter present?
//
// The ID register reads back a version rather than a fixed value, so the
// check is a range. Reading a floating bus gives 0xFFFF, which is outside it.
fn vbe_present(): u32 {
  var id: u16 = vbe_read(VBE_DISPI_INDEX_ID)
  if id < VBE_DISPI_ID_BASE { return 0 }
  if id > VBE_DISPI_ID_BASE + 5 { return 0 }
  return 1
}

// The linear framebuffer's physical address, from PCI BAR 0.
//
// It is not guessed: the address differs between machine types, and a wrong
// guess writes over whatever else lives there rather than failing.
fn find_lfb(): u64 {
  var dev: u64 = pci.pci_find_device(PCI_VENDOR_QEMU, PCI_DEVICE_VGA)
  if dev == 0 {
    dev = pci.pci_find_device(PCI_VENDOR_BOCHS, PCI_DEVICE_BOCHS_VGA)
  }
  if dev == 0 { return 0 }

  var bar: u32 = pci.pci_read_bar(dev, 0)
  if bar == 0 { return 0 }
  return @as(u64, bar)
}

// Set a linear mode. Returns 0 on success.
//
// The mode must be disabled while the geometry registers are written: the
// adapter latches them on the enable, and changing them under a live mode is
// what produces a torn or blank display.
export fn bochs_vbe_set_mode(width: u32, height: u32, bpp: u32): u32 {
  if vbe_present() == 0 {
    foundation.serial_write_string("[VBE] no Bochs display adapter\n")
    return 1
  }

  var lfb: u64 = find_lfb()
  if lfb == 0 {
    foundation.serial_write_string("[VBE] no framebuffer BAR\n")
    return 1
  }

  vbe_write(VBE_DISPI_INDEX_ENABLE, VBE_DISPI_DISABLED)
  vbe_write(VBE_DISPI_INDEX_XRES, @as(u16, width))
  vbe_write(VBE_DISPI_INDEX_YRES, @as(u16, height))
  vbe_write(VBE_DISPI_INDEX_BPP, @as(u16, bpp))
  vbe_write(VBE_DISPI_INDEX_VIRT_WIDTH, @as(u16, width))
  vbe_write(VBE_DISPI_INDEX_VIRT_HEIGHT, @as(u16, height))
  vbe_write(VBE_DISPI_INDEX_X_OFFSET, 0)
  vbe_write(VBE_DISPI_INDEX_Y_OFFSET, 0)
  vbe_write(VBE_DISPI_INDEX_ENABLE, VBE_DISPI_ENABLED | VBE_DISPI_LFB_ENABLED)

  // Read the geometry back rather than trusting the write. The adapter
  // clamps to what its video memory allows, so a mode that was too large
  // comes back smaller and the console must lay out for what it got.
  var got_w: u16 = vbe_read(VBE_DISPI_INDEX_XRES)
  var got_h: u16 = vbe_read(VBE_DISPI_INDEX_YRES)
  var got_bpp: u16 = vbe_read(VBE_DISPI_INDEX_BPP)

  fb_base = lfb
  fb_width = @as(u32, got_w)
  fb_height = @as(u32, got_h)
  fb_bpp = @as(u32, got_bpp)
  initialized = 1

  foundation.serial_write_string("[VBE] mode ")
  foundation.serial_write_u64(@as(u64, fb_width))
  foundation.serial_write_string("x")
  foundation.serial_write_u64(@as(u64, fb_height))
  foundation.serial_write_string("x")
  foundation.serial_write_u64(@as(u64, fb_bpp))
  foundation.serial_write_string(" lfb ")
  foundation.serial_write_hex(fb_base)
  foundation.serial_write_string("\n")

  return 0
}

export fn bochs_vbe_get_base(): u64 {
  return fb_base
}

export fn bochs_vbe_get_width(): u32 {
  return fb_width
}

export fn bochs_vbe_get_height(): u32 {
  return fb_height
}

export fn bochs_vbe_get_bpp(): u32 {
  return fb_bpp
}

export fn bochs_vbe_ready(): u32 {
  return initialized
}
