// home-os Mouse Driver
// PS/2 mouse support

import "../core/foundation.home" as foundation

const MOUSE_DATA_PORT: u16 = 0x60
const MOUSE_STATUS_PORT: u16 = 0x64
const MOUSE_COMMAND_PORT: u16 = 0x64

var mouse_x: i32 = 0
var mouse_y: i32 = 0
var mouse_buttons: u8 = 0
var mouse_initialized: u32 = 0

fn mouse_wait_input() {
  var timeout: u32 = 100000
  while timeout > 0 {
    if (foundation.inb(MOUSE_STATUS_PORT) & 0x02) == 0 {
      return
    }
    timeout = timeout - 1
  }
}

fn mouse_wait_output() {
  var timeout: u32 = 100000
  while timeout > 0 {
    if (foundation.inb(MOUSE_STATUS_PORT) & 0x01) != 0 {
      return
    }
    timeout = timeout - 1
  }
}

fn mouse_write(data: u8) {
  mouse_wait_input()
  foundation.outb(MOUSE_COMMAND_PORT, 0xD4)
  mouse_wait_input()
  foundation.outb(MOUSE_DATA_PORT, data)
}

fn mouse_read(): u8 {
  mouse_wait_output()
  return foundation.inb(MOUSE_DATA_PORT)
}

export fn mouse_init() {
  if mouse_initialized == 1 { return }
  
  // Enable auxiliary device
  mouse_wait_input()
  foundation.outb(MOUSE_COMMAND_PORT, 0xA8)
  
  // Enable interrupts
  mouse_wait_input()
  foundation.outb(MOUSE_COMMAND_PORT, 0x20)
  var status: u8 = mouse_read()
  status = status | 0x02
  mouse_wait_input()
  foundation.outb(MOUSE_COMMAND_PORT, 0x60)
  mouse_wait_input()
  foundation.outb(MOUSE_DATA_PORT, status)
  
  // Set defaults
  mouse_write(0xF6)
  mouse_read()  // ACK
  
  // Enable data reporting
  mouse_write(0xF4)
  mouse_read()  // ACK
  
  mouse_initialized = 1
  foundation.serial_write_string("[Mouse] Initialized\n")
}

// PS/2 mouse packets arrive ONE BYTE PER INTERRUPT, so we must
// accumulate across three separate IRQ calls. The old code read
// three bytes back-to-back which returned two bytes of garbage.
var mouse_cycle: u32 = 0
var mouse_pkt0: u8 = 0
var mouse_pkt1: u8 = 0
var mouse_pkt2: u8 = 0
var mouse_screen_w: i32 = 1024
var mouse_screen_h: i32 = 768

export fn mouse_set_screen(w: i32, h: i32) {
  if w > 0 { mouse_screen_w = w }
  if h > 0 { mouse_screen_h = h }
}

// Guard against IRQ re-entry trashing the packet-reassembly
// state. A nested IRQ (interrupt during handler execution) would read
// the next byte into mouse_pkt0/1/2 out of order, misaligning the
// three-byte PS/2 packet stream. Save+disable IRQs for the entire
// handler so the accumulator state is updated atomically.
var mouse_irq_active: u32 = 0

export fn mouse_interrupt_handler() {
  var flags: u64 = foundation.irq_save()
  // Defensive re-entry guard in case irq_save is a no-op.
  if mouse_irq_active == 1 {
    foundation.irq_restore(flags)
    return
  }
  mouse_irq_active = 1

  var byte_val: u8 = foundation.inb(MOUSE_DATA_PORT)

  if mouse_cycle == 0 {
    // First byte must have bit 3 set (always-one bit per PS/2 spec).
    // If it's not, we're out of sync — drop the byte and wait.
    if (byte_val & 0x08) == 0 {
      mouse_irq_active = 0
      foundation.irq_restore(flags)
      return
    }
    mouse_pkt0 = byte_val
    mouse_cycle = 1
    mouse_irq_active = 0
    foundation.irq_restore(flags)
    return
  }

  if mouse_cycle == 1 {
    mouse_pkt1 = byte_val
    mouse_cycle = 2
    mouse_irq_active = 0
    foundation.irq_restore(flags)
    return
  }

  // Third byte — commit the full packet.
  mouse_pkt2 = byte_val
  mouse_cycle = 0

  // Drop packets with the X/Y overflow flags set; the deltas are
  // meaningless when hardware reports overflow.
  if (mouse_pkt0 & 0xC0) != 0 {
    mouse_irq_active = 0
    foundation.irq_restore(flags)
    return
  }

  mouse_buttons = mouse_pkt0 & 0x07

  // Mask to lower 8 bits before sign-extending from 9-bit two's complement.
  var dx: i32 = @as(i32, mouse_pkt1) & 0xFF
  var dy: i32 = @as(i32, mouse_pkt2) & 0xFF

  if (mouse_pkt0 & 0x10) != 0 { dx = dx | @bitCast(@as(u32, 0xFFFFFF00), i32) }
  if (mouse_pkt0 & 0x20) != 0 { dy = dy | @bitCast(@as(u32, 0xFFFFFF00), i32) }

  mouse_x = mouse_x + dx
  mouse_y = mouse_y - dy

  if mouse_x < 0 { mouse_x = 0 }
  if mouse_y < 0 { mouse_y = 0 }
  if mouse_x > mouse_screen_w { mouse_x = mouse_screen_w }
  if mouse_y > mouse_screen_h { mouse_y = mouse_screen_h }

  mouse_irq_active = 0
  foundation.irq_restore(flags)
}

export fn mouse_get_x(): i32 {
  return mouse_x
}

export fn mouse_get_y(): i32 {
  return mouse_y
}

export fn mouse_get_buttons(): u8 {
  return mouse_buttons
}
