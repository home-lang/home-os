// home-os PCI Driver
// PCI device enumeration

import "../core/foundation.home" as foundation

const PCI_CONFIG_ADDRESS: u16 = 0xCF8
const PCI_CONFIG_DATA: u16 = 0xCFC

struct PCIDevice {
  bus: u8,
  device: u8,
  function: u8,
  vendor_id: u16,
  device_id: u16,
  class_code: u8,
  subclass: u8,
  prog_if: u8,
  bar0: u32,
  bar1: u32,
  irq: u8
}

var pci_devices: [PCIDevice; 64] = undefined
var pci_device_count: u32 = 0

fn pci_config_read(bus: u8, device: u8, func: u8, offset: u8): u32 {
  // Validate before shifting — device is 5 bits (0-31) and func is
  // 3 bits (0-7); values outside that would corrupt the address word.
  if device >= 32 { return 0xFFFFFFFF }
  if func >= 8 { return 0xFFFFFFFF }

  var address: u32 = (1 << 31) | (@as(u32, bus) << 16) |
                     (@as(u32, device) << 11) |
                     (@as(u32, func) << 8) |
                     (@as(u32, offset) & 0xFC)

  // PCI config access is a single 32-bit write to CONFIG_ADDRESS
  // followed by a single 32-bit read from CONFIG_DATA — the old code
  // was writing four separate byte ports, which corrupts the address
  // on real hardware (ports 0xCF8+1..+3 aren't what PCI expects).
  foundation.outl(PCI_CONFIG_ADDRESS, address)
  return foundation.inl(PCI_CONFIG_DATA)
}

fn pci_check_device(bus: u8, device: u8, func: u8) {
  var vendor: u32 = pci_config_read(bus, device, func, 0)
  var vendor_id: u16 = vendor & 0xFFFF
  var device_id: u16 = (vendor >> 16) & 0xFFFF
  
  if vendor_id == 0xFFFF { return }  // No device
  
  if pci_device_count < 64 {
    var dev: PCIDevice
    dev.bus = bus
    dev.device = device
    dev.function = func
    dev.vendor_id = vendor_id
    dev.device_id = device_id
    
    var class_info: u32 = pci_config_read(bus, device, func, 0x08)
    dev.class_code = (class_info >> 24) & 0xFF
    dev.subclass = (class_info >> 16) & 0xFF
    dev.prog_if = (class_info >> 8) & 0xFF
    
    dev.bar0 = pci_config_read(bus, device, func, 0x10)
    dev.bar1 = pci_config_read(bus, device, func, 0x14)
    
    var irq_info: u32 = pci_config_read(bus, device, func, 0x3C)
    dev.irq = irq_info & 0xFF
    
    pci_devices[pci_device_count] = dev
    pci_device_count = pci_device_count + 1
  }
}

// Recursive bus scan. The naive 256-bus × 32-device scan
// wastes time probing buses that don't exist. We instead walk the
// PCI hierarchy: scan bus 0, and for each PCI-to-PCI bridge we find
// (class 0x06, subclass 0x04) follow its secondary bus number.
// This cuts typical boot probe time from ~8000 I/O port writes to
// ~200, and correctly discovers PCIe devices behind bridges that
// the flat 256-bus scan would miss on architectures that don't map
// all buses flat at bus 0.

const PCI_CLASS_BRIDGE: u8 = 0x06
const PCI_SUBCLASS_PCI_BRIDGE: u8 = 0x04

// Per-boot bitmap of already-visited buses so a bridge loop (either a
// misconfigured device or a crafted virtio mapping) can't drive the
// scanner into unbounded recursion. 256 buses × 1 bit = 32 bytes.
var pci_bus_visited: [u8; 32] = undefined

fn pci_bus_mark_visited(bus: u8): u32 {
  var idx: u32 = @as(u32, bus) >> 3
  var mask: u8 = 1 << (bus & 7)
  if (pci_bus_visited[idx] & mask) != 0 { return 1 }
  pci_bus_visited[idx] = pci_bus_visited[idx] | mask
  return 0
}

fn pci_check_and_recurse(bus: u8, device: u8, func: u8) {
  var vendor: u32 = pci_config_read(bus, device, func, 0)
  var vendor_id: u16 = vendor & 0xFFFF
  if vendor_id == 0xFFFF { return }

  pci_check_device(bus, device, func)

  // Follow PCI-to-PCI bridge to its secondary bus.
  var class_info: u32 = pci_config_read(bus, device, func, 0x08)
  var class_code: u8 = @truncate((class_info >> 24) & 0xFF, u8)
  var subclass: u8 = @truncate((class_info >> 16) & 0xFF, u8)
  if class_code == PCI_CLASS_BRIDGE and subclass == PCI_SUBCLASS_PCI_BRIDGE {
    var bus_info: u32 = pci_config_read(bus, device, func, 0x18)
    var secondary_bus: u8 = @truncate((bus_info >> 8) & 0xFF, u8)
    if secondary_bus != 0 and secondary_bus != bus {
      if pci_bus_mark_visited(secondary_bus) == 0 {
        pci_scan_bus(secondary_bus)
      }
    }
  }
}

fn pci_scan_bus(bus: u8) {
  var device: u32 = 0
  while device < 32 {
    pci_check_and_recurse(bus, @truncate(device, u8), 0)

    // Multi-function devices: bit 7 of header_type at offset 0x0E.
    var hdr: u32 = pci_config_read(bus, @truncate(device, u8), 0, 0x0C)
    var header_type: u8 = @truncate((hdr >> 16) & 0xFF, u8)
    if (header_type & 0x80) != 0 {
      var func: u32 = 1
      while func < 8 {
        pci_check_and_recurse(bus, @truncate(device, u8), @truncate(func, u8))
        func = func + 1
      }
    }

    device = device + 1
  }
}

export fn pci_init() {
  pci_device_count = 0

  // Reset the visited-bus bitmap for this boot.
  var k: u32 = 0
  while k < 32 { pci_bus_visited[k] = 0; k = k + 1 }
  pci_bus_mark_visited(0)

  // Start from bus 0; recursion follows any bridges we discover.
  pci_scan_bus(0)

  foundation.serial_write_string("[PCI] Found ")
  foundation.serial_write_u64(pci_device_count)
  foundation.serial_write_string(" devices\n")
}

export fn pci_get_device_count(): u32 {
  return pci_device_count
}

export fn pci_get_device(index: u32): u64 {
  if index >= pci_device_count { return 0 }
  return @ptrFromInt(pci_devices[index])
}

// Narrow config reads. PCI config space is addressed in 32-bit words, so a
// byte or halfword read is a word read plus a shift — doing that here rather
// than at each call site is what keeps the shift from being wrong somewhere.
export fn pci_read_config8(dev: u64, offset: u8): u8 {
  if dev == 0 { return 0xFF }
  var d: *PCIDevice = @ptrFromInt(dev)
  var word: u32 = pci_config_read(d.bus, d.device, d.function, offset & 0xFC)
  var shift: u32 = (@as(u32, offset) & 3) * 8
  return @truncate((word >> shift) & 0xFF, u8)
}

export fn pci_read_config16(dev: u64, offset: u8): u16 {
  if dev == 0 { return 0xFFFF }
  var d: *PCIDevice = @ptrFromInt(dev)
  var word: u32 = pci_config_read(d.bus, d.device, d.function, offset & 0xFC)
  var shift: u32 = (@as(u32, offset) & 2) * 8
  return @truncate((word >> shift) & 0xFFFF, u16)
}

// Read-modify-write, because the hardware has no narrower write. The word is
// read first and the untouched half preserved; writing the halfword alone
// would clear the other one.
export fn pci_write_config16(dev: u64, offset: u8, value: u16) {
  if dev == 0 { return }
  var d: *PCIDevice = @ptrFromInt(dev)
  var aligned: u8 = offset & 0xFC
  var word: u32 = pci_config_read(d.bus, d.device, d.function, aligned)
  var shift: u32 = (@as(u32, offset) & 2) * 8
  var mask: u32 = ~(@as(u32, 0xFFFF) << shift)
  var merged: u32 = (word & mask) | (@as(u32, value) << shift)

  var address: u32 = (1 << 31) | (@as(u32, d.bus) << 16) |
                     (@as(u32, d.device) << 11) |
                     (@as(u32, d.function) << 8) |
                     (@as(u32, aligned) & 0xFC)
  foundation.outl(PCI_CONFIG_ADDRESS, address)
  foundation.outl(PCI_CONFIG_DATA, merged)
}

// Base address register `index` (0-5), with the type bits masked off so the
// caller gets an address rather than an address with flags in its low bits.
// Bit 0 distinguishes I/O space (1) from memory space (0); I/O BARs keep two
// low bits of flags, memory BARs four.
export fn pci_read_bar(dev: u64, index: u32): u32 {
  if dev == 0 { return 0 }
  if index > 5 { return 0 }
  var d: *PCIDevice = @ptrFromInt(dev)
  var offset: u8 = @truncate(0x10 + (index * 4), u8)
  var raw: u32 = pci_config_read(d.bus, d.device, d.function, offset)
  if (raw & 1) != 0 {
    return raw & 0xFFFFFFFC  // I/O space
  }
  return raw & 0xFFFFFFF0    // Memory space
}

export fn pci_find_device(vendor: u16, device: u16): u64 {
  var i: u32 = 0
  while i < pci_device_count {
    if pci_devices[i].vendor_id == vendor and pci_devices[i].device_id == device {
      return @ptrFromInt(pci_devices[i])
    }
    i = i + 1
  }
  return 0
}
