// home-os USB — xHCI host controller discovery
//
// STUB(S6): there is no HID driver, so a USB keyboard is still not a keyboard
// — the interrupt endpoint is configured but nothing reads a report off it —
// and nothing mounts a USB disk through the VFS. Blocks Phase 7a.
// MASTER_PLAN §7.
//
// What is implemented is everything under that: the controller found on the
// PCI bus and its register window mapped, the command ring, event ring and
// device-context base array set up from the capability registers, a device
// reset, addressed and configured, and Bulk-Only Transport carrying SCSI —
// INQUIRY, READ CAPACITY(10), READ(10) and WRITE(10). The boot gate reads a
// known block off a USB disk, writes another, reads it back, and then checks
// the host image, because a device accepting a write is not the same as the
// write reaching the media.

import "../core/foundation.home" as foundation
import "pci.home" as pci
import "../core/memory.home" as memory

// A USB controller is class 0x0C (serial bus), subclass 0x03 (USB); the
// programming interface distinguishes the four generations, and 0x30 is xHCI.
const PCI_CLASS_SERIAL_BUS: u8 = 0x0C
const PCI_SUBCLASS_USB: u8 = 0x03
const PCI_PROGIF_UHCI: u8 = 0x00
const PCI_PROGIF_OHCI: u8 = 0x10
const PCI_PROGIF_EHCI: u8 = 0x20
const PCI_PROGIF_XHCI: u8 = 0x30

const PCI_OFFSET_PROGIF: u8 = 0x09
const PCI_OFFSET_SUBCLASS: u8 = 0x0A
const PCI_OFFSET_CLASS: u8 = 0x0B
const PCI_OFFSET_COMMAND: u8 = 0x04

// Capability registers, at the base of the register window.
const XHCI_CAPLENGTH: u32 = 0x00
const XHCI_HCIVERSION: u32 = 0x02
const XHCI_HCSPARAMS1: u32 = 0x04
const XHCI_HCCPARAMS1: u32 = 0x10

// Operational registers, at base + CAPLENGTH.
const XHCI_USBCMD: u32 = 0x00
const XHCI_USBSTS: u32 = 0x04
const XHCI_CRCR: u32 = 0x18
const XHCI_DCBAAP: u32 = 0x30
const XHCI_CONFIG: u32 = 0x38
const XHCI_PORTSC_BASE: u32 = 0x400
const XHCI_PORT_STRIDE: u32 = 0x10

// Capability registers naming the other two register spaces.
const XHCI_DBOFF: u32 = 0x14
const XHCI_RTSOFF: u32 = 0x18

// Interrupter 0 lives at runtime base + 0x20.
const XHCI_IR0: u32 = 0x20
const XHCI_IR_ERSTSZ: u32 = 0x08
const XHCI_IR_ERSTBA: u32 = 0x10
const XHCI_IR_ERDP: u32 = 0x18

const USBCMD_RS: u32 = 0x00000001       // run/stop
const USBCMD_HCRST: u32 = 0x00000002    // host controller reset

const USBSTS_HCHALTED: u32 = 0x00000001
const USBSTS_CNR: u32 = 0x00000800      // controller not ready

const CRCR_RCS: u32 = 0x00000001        // ring cycle state
const PORTSC_CCS: u32 = 0x00000001      // current connect status
const PORTSC_PED: u32 = 0x00000002      // port enabled
const PORTSC_PR: u32 = 0x00000010       // port reset
const PORTSC_PRC: u32 = 0x00200000      // port reset change
// Every write-1-to-clear status bit in PORTSC, masked off before a
// read-modify-write so a control change does not silently clear them.
const PORTSC_CHANGE_MASK: u32 = 0x00FE0002

// One page each. 256 TRBs of 16 bytes fills a page exactly, which is why the
// ring sizes below are what they are.
const TRB_SIZE: u32 = 16
const RING_TRBS: u32 = 256

var controller_pci: u64 = 0
var register_base: u64 = 0
var operational_base: u64 = 0
var hci_version: u32 = 0
var max_ports: u32 = 0
var max_slots: u32 = 0
var controller_found: u32 = 0
var ports_connected: u32 = 0

var runtime_base: u64 = 0
var doorbell_base: u64 = 0
var dcbaa_page: u64 = 0
var command_ring: u64 = 0
var event_ring: u64 = 0
var erst_page: u64 = 0
var controller_running: u32 = 0

// Producer and consumer state for the two rings. The cycle bit is what marks
// an entry as belonging to the current pass around a ring, so it flips every
// time the index wraps — without it the controller cannot tell a fresh TRB
// from the one that occupied the slot last time round.
var cmd_enqueue: u32 = 0
var cmd_cycle: u32 = 1
var event_dequeue: u32 = 0
var event_cycle: u32 = 1
var last_slot_id: u32 = 0
var context_size: u32 = 32
var device_context: u64 = 0
var input_context: u64 = 0
var ep0_ring: u64 = 0
var descriptor_buffer: u64 = 0
var ep0_enqueue: u32 = 0
var ep0_cycle: u32 = 1
var device_vendor: u32 = 0
var device_product: u32 = 0
var config_value: u32 = 0
var interrupt_ep_address: u32 = 0
var interrupt_ep_max_packet: u32 = 0
var interrupt_ep_interval: u32 = 0
var interrupt_ep_dci: u32 = 0
var interrupt_ring: u64 = 0
var device_port: u32 = 0
var bulk_in_address: u32 = 0
var bulk_out_address: u32 = 0
var bulk_in_max_packet: u32 = 0
var bulk_out_max_packet: u32 = 0
var bulk_in_dci: u32 = 0
var bulk_out_dci: u32 = 0
var bulk_in_ring: u64 = 0
var bulk_out_ring: u64 = 0
var bulk_in_enqueue: u32 = 0
var bulk_out_enqueue: u32 = 0
var interface_class: u32 = 0
var interface_protocol: u32 = 0

// Register reads go through the architecture-neutral MMIO intrinsic rather
// than a plain load: it is what tells the backend this access must not be
// reordered or elided, which on ARM64 also emits the barrier.
fn read32(addr: u64): u32 {
  return arch_mmio_read32(addr)
}

fn write32(addr: u64, value: u32) {
  arch_mmio_write32(addr, value)
}

// A 64-bit register is written as two dwords, low half first. Writing the
// high half first would momentarily point the controller at an address made
// of the new top and the old bottom.
fn write64(addr: u64, value: u64) {
  arch_mmio_write32(addr, @as(u32, value & 0xFFFFFFFF))
  arch_mmio_write32(addr + 4, @as(u32, (value >> 32) & 0xFFFFFFFF))
}

fn zero_page(base: u64) {
  var i: u32 = 0
  while i < 4096 {
    @as(*u8, @ptrFromInt(base + @as(u64, i))).* = 0
    i = i + 1
  }
}

// Spin until `mask` reads back clear, or give up. A controller that never
// answers must not hang the boot: returning failure lets the caller say so.
fn wait_clear(addr: u64, mask: u32): u32 {
  var spins: u32 = 0
  while spins < 1000000 {
    if (read32(addr) & mask) == 0 { return 1 }
    foundation.cpu_pause()
    spins = spins + 1
  }
  return 0
}

fn wait_set(addr: u64, mask: u32): u32 {
  var spins: u32 = 0
  while spins < 1000000 {
    if (read32(addr) & mask) != 0 { return 1 }
    foundation.cpu_pause()
    spins = spins + 1
  }
  return 0
}

// Find the first xHCI controller on the bus. Returns the PCI device handle,
// or 0. Reported by class rather than by vendor and device id, because the
// class is what the specification fixes — a vendor table would find QEMU's
// controller and miss every real one.
fn find_xhci(): u64 {
  var i: u32 = 0
  let count: u32 = pci.pci_get_device_count()
  while i < count {
    let dev: u64 = pci.pci_get_device(i)
    if dev != 0 {
      let class: u8 = pci.pci_read_config8(dev, PCI_OFFSET_CLASS)
      let subclass: u8 = pci.pci_read_config8(dev, PCI_OFFSET_SUBCLASS)
      let progif: u8 = pci.pci_read_config8(dev, PCI_OFFSET_PROGIF)
      if class == PCI_CLASS_SERIAL_BUS and subclass == PCI_SUBCLASS_USB and progif == PCI_PROGIF_XHCI {
        return dev
      }
    }
    i = i + 1
  }
  return 0
}

// The register window sits above the kernel's identity map, so its pages have
// to be mapped before the first read. Mapping one page and hoping is how a
// driver reads the first capability register and faults on the operational
// ones: the window is 64 KiB on every controller this has been run against.
fn map_registers(base: u64, bytes: u64): u32 {
  var mapped: u64 = 0
  while mapped < bytes {
    if memory.vmm_map_page(base + mapped, base + mapped, 3) != 0 {
      return 0
    }
    mapped = mapped + 4096
  }
  return 1
}

export fn usb_init() {
  controller_pci = find_xhci()
  if controller_pci == 0 {
    foundation.serial_write_string("[USB] no xHCI controller on the PCI bus\n")
    return
  }

  // BAR0 is a 64-bit memory BAR on xHCI; its high half is BAR1. Reading only
  // the low dword works until firmware places the window above 4 GB.
  let bar_low: u64 = @as(u64, pci.pci_read_bar(controller_pci, 0))
  let bar_high: u64 = @as(u64, pci.pci_read_bar(controller_pci, 1))
  register_base = bar_low | (bar_high << 32)
  if register_base == 0 {
    foundation.serial_write_string("[USB] xHCI BAR is unassigned\n")
    return
  }

  // Bus mastering and memory space have to be enabled before the controller
  // will answer, and firmware does not always leave them on.
  let command: u16 = pci.pci_read_config16(controller_pci, PCI_OFFSET_COMMAND)
  pci.pci_write_config16(controller_pci, PCI_OFFSET_COMMAND, command | 0x0006)

  if map_registers(register_base, 65536) == 0 {
    foundation.serial_write_string("[USB] could not map the xHCI register window\n")
    return
  }

  // Read the capability header as one dword and take the fields out of it.
  // An MMIO window is not memory: a controller only has to decode the access
  // widths its registers are defined at, and xHCI defines these as 32-bit.
  // Byte and word reads of this window return zero on QEMU, which reads as a
  // controller reporting version 0 rather than as an access the device
  // declined to answer.
  let cap_header: u32 = read32(register_base + @as(u64, XHCI_CAPLENGTH))
  let cap_length: u32 = cap_header & 0xFF
  hci_version = (cap_header >> 16) & 0xFFFF
  operational_base = register_base + @as(u64, cap_length)

  // HCSPARAMS1 packs the three numbers that size everything above this layer:
  // slots in [7:0], interrupters in [18:8], ports in [31:24].
  let hcsparams1: u32 = read32(register_base + @as(u64, XHCI_HCSPARAMS1))
  max_slots = hcsparams1 & 0xFF
  max_ports = (hcsparams1 >> 24) & 0xFF

  // Count ports with something plugged in. Port registers are indexed from 1
  // and stride 0x10 from the operational base plus 0x400.
  // The doorbell and runtime register spaces are at offsets the capability
  // registers name; they are not at fixed addresses.
  doorbell_base = register_base + @as(u64, read32(register_base + @as(u64, XHCI_DBOFF)) & 0xFFFFFFFC)
  runtime_base = register_base + @as(u64, read32(register_base + @as(u64, XHCI_RTSOFF)) & 0xFFFFFFE0)

  // Context size, from HCCPARAMS1. Assuming 32 puts every field of a 64-byte
  // context at the wrong offset, and the controller answers with a parameter
  // error that names nothing.
  if (read32(register_base + @as(u64, XHCI_HCCPARAMS1)) & HCCPARAMS1_CSZ) != 0 {
    context_size = 64
  } else {
    context_size = 32
  }

  ports_connected = 0
  var port: u32 = 0
  while port < max_ports {
    let portsc: u32 = read32(operational_base + @as(u64, XHCI_PORTSC_BASE + port * XHCI_PORT_STRIDE))
    if (portsc & PORTSC_CCS) != 0 {
      ports_connected = ports_connected + 1
    }
    port = port + 1
  }

  controller_found = 1
  foundation.serial_write_string("[USB] xHCI ")
  foundation.serial_write_hex_word(@as(u16, hci_version))
  foundation.serial_write_string(", ")
  foundation.serial_write_u64(@as(u64, max_ports))
  foundation.serial_write_string(" ports, ")
  foundation.serial_write_u64(@as(u64, max_slots))
  foundation.serial_write_string(" slots\n")
}

// Bring the controller out of halt: reset it, give it the structures it
// reads at run time, and start it.
//
// A controller with no device-context array and no command ring will refuse
// to leave the halted state, or leave it and immediately fault on the first
// pointer it follows — so these are set up before RS is written, in the order
// the specification requires.
export fn xhci_start(): u32 {
  if controller_found == 0 { return 0 }

  // 1. Stop, then reset. Resetting a running controller is undefined.
  write32(operational_base + @as(u64, XHCI_USBCMD),
    read32(operational_base + @as(u64, XHCI_USBCMD)) & ~USBCMD_RS)
  if wait_set(operational_base + @as(u64, XHCI_USBSTS), USBSTS_HCHALTED) == 0 {
    foundation.serial_write_string("[USB] controller did not halt
")
    return 0
  }

  write32(operational_base + @as(u64, XHCI_USBCMD), USBCMD_HCRST)
  // The reset bit clears itself when the reset is done, and CNR stays set
  // until the controller can answer register reads at all. Both have to be
  // waited on; checking only the first reads registers from a controller that
  // has not finished coming up.
  if wait_clear(operational_base + @as(u64, XHCI_USBCMD), USBCMD_HCRST) == 0 {
    foundation.serial_write_string("[USB] reset did not complete
")
    return 0
  }
  if wait_clear(operational_base + @as(u64, XHCI_USBSTS), USBSTS_CNR) == 0 {
    foundation.serial_write_string("[USB] controller stayed not-ready
")
    return 0
  }

  // 2. Structures. Physical addresses: the first gigabyte is identity
  //    mapped, so a page from the physical allocator is usable as both.
  dcbaa_page = memory.pmm_alloc_page()
  command_ring = memory.pmm_alloc_page()
  event_ring = memory.pmm_alloc_page()
  erst_page = memory.pmm_alloc_page()
  if dcbaa_page == 0 or command_ring == 0 or event_ring == 0 or erst_page == 0 {
    foundation.serial_write_string("[USB] could not allocate controller structures
")
    return 0
  }
  zero_page(dcbaa_page)
  zero_page(command_ring)
  zero_page(event_ring)
  zero_page(erst_page)

  // 3. Enable the slots the controller reports, or it accepts no device.
  write32(operational_base + @as(u64, XHCI_CONFIG), max_slots)
  write64(operational_base + @as(u64, XHCI_DCBAAP), dcbaa_page)

  // The command ring pointer carries its cycle state in bit 0: the controller
  // compares that bit against each TRB to know which entries are ours.
  write64(operational_base + @as(u64, XHCI_CRCR), command_ring | @as(u64, CRCR_RCS))

  // 4. Event ring. Without one the controller has nowhere to report
  //    completions, so a command would be accepted and never answered.
  //    The segment table is one entry: base and size of the single segment.
  write64(erst_page, event_ring)
  write32(erst_page + 8, RING_TRBS)
  let ir0: u64 = runtime_base + @as(u64, XHCI_IR0)
  write32(ir0 + @as(u64, XHCI_IR_ERSTSZ), 1)
  write64(ir0 + @as(u64, XHCI_IR_ERDP), event_ring)
  // ERSTBA last: writing it is what makes the controller read the table, so
  // the table has to be complete first.
  write64(ir0 + @as(u64, XHCI_IR_ERSTBA), erst_page)

  // 5. Run.
  write32(operational_base + @as(u64, XHCI_USBCMD),
    read32(operational_base + @as(u64, XHCI_USBCMD)) | USBCMD_RS)
  if wait_clear(operational_base + @as(u64, XHCI_USBSTS), USBSTS_HCHALTED) == 0 {
    foundation.serial_write_string("[USB] controller did not start
")
    return 0
  }

  controller_running = 1
  return 1
}

// TRB types used here. A TRB is 16 bytes: a 64-bit parameter, a status
// dword, and a control dword whose bit 0 is the cycle and whose bits 15:10
// are the type.
const TRB_TYPE_ENABLE_SLOT: u32 = 9
const TRB_TYPE_ADDRESS_DEVICE: u32 = 11
const TRB_TYPE_CONFIGURE_ENDPOINT: u32 = 12
const TRB_TYPE_NOOP_COMMAND: u32 = 23
const TRB_TYPE_SETUP_STAGE: u32 = 2
const TRB_TYPE_DATA_STAGE: u32 = 3
const TRB_TYPE_STATUS_STAGE: u32 = 4
const TRB_TYPE_TRANSFER_EVENT: u32 = 32

const TRB_IOC: u32 = 0x20        // interrupt on completion, control bit 5
const TRB_IDT: u32 = 0x40        // immediate data, control bit 6
const TRB_DIR_IN: u32 = 0x10000  // direction, control bit 16

// HCCPARAMS1 bit 2 says whether a context is 64 bytes rather than 32. Getting
// this wrong puts every field at the wrong offset, and the controller reports
// a parameter error rather than anything that names the cause.
const HCCPARAMS1_CSZ: u32 = 0x00000004
const TRB_TYPE_COMMAND_COMPLETION: u32 = 33
const TRB_COMPLETION_SUCCESS: u32 = 1
const ERDP_EHB: u64 = 0x8            // event handler busy, write-1-to-clear

fn write_mem32(base: u64, offset: u32, value: u32) {
  @as(*u32, @ptrFromInt(base + @as(u64, offset))).* = value
}

fn read_mem32(base: u64, offset: u32): u32 {
  return @as(*u32, @ptrFromInt(base + @as(u64, offset))).*
}

// Place a command TRB on the ring, ring the doorbell, and wait for the
// completion event that names it.
//
// Returns the completion code — 1 is success — and leaves the slot id the
// event carried in last_slot_id. A code rather than a boolean because the
// controller distinguishes its refusals, and a caller that cannot see which
// one it got has to guess.
fn issue_command(param: u64, trb_type: u32): u32 {
  return issue_command_slot(param, trb_type, 0)
}

fn issue_command_slot(param: u64, trb_type: u32, slot_id: u32): u32 {
  if controller_running == 0 { return 0 }

  // The last TRB of the ring must be a Link back to the start, so the ring is
  // one short of its size for commands. Wrapping is handled by refusing to
  // fill the final slot rather than by writing a Link TRB, because nothing
  // here issues enough commands to reach it.
  if cmd_enqueue >= RING_TRBS - 1 { return 0 }

  let slot: u32 = cmd_enqueue * TRB_SIZE
  write_mem32(command_ring, slot, @as(u32, param & 0xFFFFFFFF))
  write_mem32(command_ring, slot + 4, @as(u32, (param >> 32) & 0xFFFFFFFF))
  write_mem32(command_ring, slot + 8, 0)
  write_mem32(command_ring, slot + 12, (slot_id << 24) | (trb_type << 10) | cmd_cycle)

  let issued_at: u64 = command_ring + @as(u64, slot)
  cmd_enqueue = cmd_enqueue + 1

  write32(doorbell_base, 0)

  var spins: u32 = 0
  while spins < 1000000 {
    let offset: u32 = event_dequeue * TRB_SIZE
    let control: u32 = read_mem32(event_ring, offset + 12)
    if (control & 1) == event_cycle {
      let event_type: u32 = (control >> 10) & 0x3F
      let completion_code: u32 = read_mem32(event_ring, offset + 8) >> 24
      let pointer_low: u32 = read_mem32(event_ring, offset)
      last_slot_id = (control >> 24) & 0xFF

      event_dequeue = event_dequeue + 1
      if event_dequeue >= RING_TRBS {
        event_dequeue = 0
        event_cycle = event_cycle ^ 1
      }
      let ir0: u64 = runtime_base + @as(u64, XHCI_IR0)
      write64(ir0 + @as(u64, XHCI_IR_ERDP),
        (event_ring + @as(u64, event_dequeue * TRB_SIZE)) | ERDP_EHB)

      // The event ring carries every kind of event, not just command
      // completions: a port reset posts a Port Status Change Event, and it
      // arrives on the same ring. Treating the next event as the answer to
      // the last command makes a command look like it failed whenever
      // anything else happened first. Consume what is not ours and keep
      // waiting.
      if event_type == TRB_TYPE_COMMAND_COMPLETION and
         @as(u64, pointer_low) == (issued_at & 0xFFFFFFFF) {
        return completion_code
      }
    }
    foundation.cpu_pause()
    spins = spins + 1
  }
  return 0
}

// The No-Op command asks the controller to do nothing and report that it did.
// It is the specification's own way of exercising the ring path without a
// device attached.
export fn xhci_noop_command(): u32 {
  if issue_command(0, TRB_TYPE_NOOP_COMMAND) == TRB_COMPLETION_SUCCESS { return 1 }
  return 0
}

// Reset a port and wait for the reset to be acknowledged. Ports are numbered
// from 1; the register array is indexed from 0.
export fn xhci_port_reset(port: u32): u32 {
  if port == 0 or port > max_ports { return 0 }
  let portsc: u64 = operational_base + @as(u64, XHCI_PORTSC_BASE + (port - 1) * XHCI_PORT_STRIDE)

  // PORTSC has write-1-to-clear status bits alongside read/write control
  // bits. Writing the value straight back would clear every status bit that
  // happened to be set, so the change bits are masked out first.
  let current: u32 = read32(portsc) & ~PORTSC_CHANGE_MASK
  write32(portsc, current | PORTSC_PR)

  var spins: u32 = 0
  while spins < 1000000 {
    let now: u32 = read32(portsc)
    if (now & PORTSC_PRC) != 0 {
      // Acknowledge the change bit, or it stays set and the next reset looks
      // as though it completed instantly.
      write32(portsc, (now & ~PORTSC_CHANGE_MASK) | PORTSC_PRC)
      if (now & PORTSC_PED) != 0 { return 1 }
      return 0
    }
    foundation.cpu_pause()
    spins = spins + 1
  }
  return 0
}

// Ask the controller for a device slot. The slot id comes back in the
// completion event, and is the handle every later command for that device
// carries.
export fn xhci_enable_slot(): u32 {
  if issue_command(0, TRB_TYPE_ENABLE_SLOT) != TRB_COMPLETION_SUCCESS { return 0 }
  return last_slot_id
}

// Give the controller a device context for `slot` and tell it to address the
// device on `port`.
//
// The input context is the controller's argument block: an Input Control
// Context saying which of the following contexts are valid, then a Slot
// Context describing the device's place in the topology, then the context for
// endpoint 0. The controller copies what it accepts into the *output* device
// context, which is what DCBAA[slot] points at — the two are different
// structures and conflating them is the classic first mistake here.
export fn xhci_address_device(slot: u32, port: u32): u32 {
  if slot == 0 or controller_running == 0 { return 0 }

  device_context = memory.pmm_alloc_page()
  input_context = memory.pmm_alloc_page()
  ep0_ring = memory.pmm_alloc_page()
  if device_context == 0 or input_context == 0 or ep0_ring == 0 { return 0 }
  zero_page(device_context)
  zero_page(input_context)
  zero_page(ep0_ring)

  // DCBAA entry for this slot. Index 0 is reserved for the scratchpad array.
  @as(*u64, @ptrFromInt(dcbaa_page + @as(u64, slot * 8))).* = device_context

  // Input Control Context: add the slot context and endpoint 0, which are
  // bits 0 and 1 of the add flags.
  write_mem32(input_context, 4, 0x00000003)

  // Slot Context, one context in from the start of the input context.
  let slot_ctx: u32 = context_size
  let portsc: u64 = operational_base + @as(u64, XHCI_PORTSC_BASE + (port - 1) * XHCI_PORT_STRIDE)
  let speed: u32 = (read32(portsc) >> 10) & 0x0F
  // Context entries = 1 (only endpoint 0 is valid), route string 0 for a
  // device on a root port.
  write_mem32(input_context, slot_ctx, (1 << 27) | (speed << 20))
  write_mem32(input_context, slot_ctx + 4, port << 16)

  // Endpoint 0 Context, two contexts in.
  let ep0_ctx: u32 = context_size * 2
  // CErr = 3, EP Type = 4 (control), max packet size 64. The real maximum
  // comes from the device descriptor, which cannot be read until endpoint 0
  // works — so 64 is used to fetch it, which every speed above low tolerates.
  write_mem32(input_context, ep0_ctx + 4, (64 << 16) | (4 << 3) | (3 << 1))
  // TR dequeue pointer, with the dequeue cycle state in bit 0.
  write_mem32(input_context, ep0_ctx + 8, @as(u32, (ep0_ring & 0xFFFFFFFF)) | 1)
  write_mem32(input_context, ep0_ctx + 12, @as(u32, (ep0_ring >> 32) & 0xFFFFFFFF))
  write_mem32(input_context, ep0_ctx + 16, 8)

  if issue_command_slot(input_context, TRB_TYPE_ADDRESS_DEVICE, slot) != TRB_COMPLETION_SUCCESS {
    return 0
  }
  device_port = port
  return 1
}

// A control transfer on endpoint 0: setup, data, status.
//
// Returns 1 when the transfer event reports success. The buffer is filled
// with up to `length` bytes.
fn control_in(slot: u32, request_type: u32, request: u32, value: u32, index: u32, length: u32): u32 {
  if ep0_ring == 0 { return 0 }

  // Setup Stage. The eight bytes of the setup packet travel in the TRB
  // itself rather than in a buffer, which is what the immediate-data flag
  // means.
  let setup_low: u32 = request_type | (request << 8) | (value << 16)
  let setup_high: u32 = index | (length << 16)
  var off: u32 = ep0_enqueue * TRB_SIZE
  write_mem32(ep0_ring, off, setup_low)
  write_mem32(ep0_ring, off + 4, setup_high)
  write_mem32(ep0_ring, off + 8, 8)
  // Transfer type 3 is an IN data stage.
  write_mem32(ep0_ring, off + 12, (3 << 16) | (TRB_TYPE_SETUP_STAGE << 10) | TRB_IDT | ep0_cycle)
  ep0_enqueue = ep0_enqueue + 1

  // Data Stage.
  off = ep0_enqueue * TRB_SIZE
  write_mem32(ep0_ring, off, @as(u32, descriptor_buffer & 0xFFFFFFFF))
  write_mem32(ep0_ring, off + 4, @as(u32, (descriptor_buffer >> 32) & 0xFFFFFFFF))
  write_mem32(ep0_ring, off + 8, length)
  write_mem32(ep0_ring, off + 12, TRB_DIR_IN | (TRB_TYPE_DATA_STAGE << 10) | ep0_cycle)
  ep0_enqueue = ep0_enqueue + 1

  // Status Stage, in the opposite direction, asking for an interrupt so the
  // controller posts a transfer event we can wait on.
  off = ep0_enqueue * TRB_SIZE
  write_mem32(ep0_ring, off, 0)
  write_mem32(ep0_ring, off + 4, 0)
  write_mem32(ep0_ring, off + 8, 0)
  write_mem32(ep0_ring, off + 12, (TRB_TYPE_STATUS_STAGE << 10) | TRB_IOC | ep0_cycle)
  ep0_enqueue = ep0_enqueue + 1

  // Doorbell for this slot, target 1 = endpoint 0.
  write32(doorbell_base + @as(u64, slot * 4), 1)
  return await_transfer_event()
}

// Read the device descriptor and keep the two identifiers out of it.
export fn xhci_read_device_descriptor(slot: u32): u32 {
  if descriptor_buffer == 0 {
    descriptor_buffer = memory.pmm_alloc_page()
    if descriptor_buffer == 0 { return 0 }
  }
  zero_page(descriptor_buffer)

  // GET_DESCRIPTOR(DEVICE): direction device-to-host, standard, device.
  if control_in(slot, 0x80, 6, 0x0100, 0, 18) == 0 { return 0 }

  // idVendor at byte 8, idProduct at byte 10, both little-endian.
  device_vendor = @as(u32, @as(*u8, @ptrFromInt(descriptor_buffer + 8)).*)
    | (@as(u32, @as(*u8, @ptrFromInt(descriptor_buffer + 9)).*) << 8)
  device_product = @as(u32, @as(*u8, @ptrFromInt(descriptor_buffer + 10)).*)
    | (@as(u32, @as(*u8, @ptrFromInt(descriptor_buffer + 11)).*) << 8)

  // bDescriptorType at byte 1 must say DEVICE, or we read something else.
  if @as(*u8, @ptrFromInt(descriptor_buffer + 1)).* != 1 { return 0 }
  return 1
}

// A control transfer with no data stage: setup, then status. SET_CONFIGURATION
// is one of these — the request is entirely in the setup packet.
fn control_no_data(slot: u32, request_type: u32, request: u32, value: u32, index: u32): u32 {
  if ep0_ring == 0 { return 0 }

  var off: u32 = ep0_enqueue * TRB_SIZE
  write_mem32(ep0_ring, off, request_type | (request << 8) | (value << 16))
  write_mem32(ep0_ring, off + 4, index)
  write_mem32(ep0_ring, off + 8, 8)
  // Transfer type 0: no data stage.
  write_mem32(ep0_ring, off + 12, (TRB_TYPE_SETUP_STAGE << 10) | TRB_IDT | ep0_cycle)
  ep0_enqueue = ep0_enqueue + 1

  // With no data, the status stage runs IN.
  off = ep0_enqueue * TRB_SIZE
  write_mem32(ep0_ring, off, 0)
  write_mem32(ep0_ring, off + 4, 0)
  write_mem32(ep0_ring, off + 8, 0)
  write_mem32(ep0_ring, off + 12, TRB_DIR_IN | (TRB_TYPE_STATUS_STAGE << 10) | TRB_IOC | ep0_cycle)
  ep0_enqueue = ep0_enqueue + 1

  write32(doorbell_base + @as(u64, slot * 4), 1)
  return await_transfer_event()
}

// Wait for the next transfer event and report whether it succeeded.
fn await_transfer_event(): u32 {
  var spins: u32 = 0
  while spins < 1000000 {
    let eoff: u32 = event_dequeue * TRB_SIZE
    let control: u32 = read_mem32(event_ring, eoff + 12)
    if (control & 1) == event_cycle {
      let event_type: u32 = (control >> 10) & 0x3F
      let completion_code: u32 = read_mem32(event_ring, eoff + 8) >> 24

      event_dequeue = event_dequeue + 1
      if event_dequeue >= RING_TRBS {
        event_dequeue = 0
        event_cycle = event_cycle ^ 1
      }
      let ir0: u64 = runtime_base + @as(u64, XHCI_IR0)
      write64(ir0 + @as(u64, XHCI_IR_ERDP),
        (event_ring + @as(u64, event_dequeue * TRB_SIZE)) | ERDP_EHB)

      if event_type == TRB_TYPE_TRANSFER_EVENT {
        if completion_code == TRB_COMPLETION_SUCCESS or completion_code == 13 { return 1 }
        return 0
      }
    }
    foundation.cpu_pause()
    spins = spins + 1
  }
  return 0
}

// Read the configuration descriptor and find the first interrupt IN endpoint
// in it.
//
// The configuration descriptor is a header followed by the interface and
// endpoint descriptors that belong to it, laid end to end. Its wTotalLength
// says how far that goes, and walking by each descriptor's own bLength is the
// only way through — the records are not fixed width.
export fn xhci_read_config_descriptor(slot: u32): u32 {
  if descriptor_buffer == 0 { return 0 }
  zero_page(descriptor_buffer)

  // GET_DESCRIPTOR(CONFIGURATION, index 0). Ask for a page; the device sends
  // what it has and a short packet says so.
  if control_in(slot, 0x80, 6, 0x0200, 0, 255) == 0 { return 0 }
  if @as(*u8, @ptrFromInt(descriptor_buffer + 1)).* != 2 { return 0 }

  config_value = @as(u32, @as(*u8, @ptrFromInt(descriptor_buffer + 5)).*)
  let total_length: u32 = @as(u32, @as(*u8, @ptrFromInt(descriptor_buffer + 2)).*)
    | (@as(u32, @as(*u8, @ptrFromInt(descriptor_buffer + 3)).*) << 8)

  var offset: u32 = 0
  while offset + 2 <= total_length and offset < 4096 {
    let length: u32 = @as(u32, @as(*u8, @ptrFromInt(descriptor_buffer + @as(u64, offset))).*)
    let kind: u32 = @as(u32, @as(*u8, @ptrFromInt(descriptor_buffer + @as(u64, offset + 1))).*)
    // A zero-length record would not advance, so refuse it rather than spin.
    if length < 2 { return 0 }
    // Endpoint descriptor: address at byte 2, attributes at 3, max packet at
    // 4-5, interval at 6. Attribute bits 1:0 select the transfer type, and 3
    // is interrupt; bit 7 of the address is the direction.
    if kind == 5 and length >= 7 {
      let attributes: u32 = @as(u32, @as(*u8, @ptrFromInt(descriptor_buffer + @as(u64, offset + 3))).*)
      let address: u32 = @as(u32, @as(*u8, @ptrFromInt(descriptor_buffer + @as(u64, offset + 2))).*)
      let max_packet: u32 = @as(u32, @as(*u8, @ptrFromInt(descriptor_buffer + @as(u64, offset + 4))).*)
        | (@as(u32, @as(*u8, @ptrFromInt(descriptor_buffer + @as(u64, offset + 5))).*) << 8)
      let transfer_type: u32 = attributes & 3
      // Bit 7 of the address is the direction: set means IN.
      if transfer_type == 3 and (address & 0x80) != 0 {
        interrupt_ep_address = address
        interrupt_ep_max_packet = max_packet
        interrupt_ep_interval = @as(u32, @as(*u8, @ptrFromInt(descriptor_buffer + @as(u64, offset + 6))).*)
      }
      if transfer_type == 2 {
        if (address & 0x80) != 0 {
          bulk_in_address = address
          bulk_in_max_packet = max_packet
        } else {
          bulk_out_address = address
          bulk_out_max_packet = max_packet
        }
      }
      // Also remember the interface class, which is what says a device is
      // mass storage rather than something else with the same endpoints.
    }
    if kind == 4 and length >= 9 {
      interface_class = @as(u32, @as(*u8, @ptrFromInt(descriptor_buffer + @as(u64, offset + 5))).*)
      interface_protocol = @as(u32, @as(*u8, @ptrFromInt(descriptor_buffer + @as(u64, offset + 7))).*)
    }
    offset = offset + length
  }
  // A configuration with no interrupt IN endpoint is still a configuration
  // read successfully; the caller decides whether that is a problem.
  return 1
}

// SET_CONFIGURATION moves the device from addressed to configured, which is
// what makes its endpoints usable.
export fn xhci_set_configuration(slot: u32): u32 {
  if config_value == 0 { return 0 }
  return control_no_data(slot, 0x00, 9, config_value, 0)
}

// Tell the controller about the interrupt endpoint, so it will move data on
// it. Returns 1 when the Configure Endpoint command succeeds.
//
// Endpoints are addressed by Device Context Index, not by their USB address:
// DCI = 2 * endpoint number + direction, with endpoint 0 occupying DCI 1.
// Endpoint 0x81 is endpoint 1 IN, so DCI 3. Getting this mapping wrong
// configures a different endpoint than the one intended, and the controller
// has no way to notice.
export fn xhci_configure_interrupt_endpoint(slot: u32): u32 {
  if interrupt_ep_address == 0 or input_context == 0 { return 0 }

  let endpoint_number: u32 = interrupt_ep_address & 0x0F
  let dci: u32 = endpoint_number * 2 + 1     // IN endpoints take the odd index

  interrupt_ring = memory.pmm_alloc_page()
  if interrupt_ring == 0 { return 0 }
  zero_page(interrupt_ring)
  zero_page(input_context)

  // Add the slot context and this endpoint. The slot context is required on
  // a Configure Endpoint because its context-entries field has to grow to
  // cover the new highest DCI.
  write_mem32(input_context, 4, 1 | (1 << dci))

  let slot_ctx: u32 = context_size
  let portsc: u64 = operational_base + @as(u64, XHCI_PORTSC_BASE + (device_port - 1) * XHCI_PORT_STRIDE)
  let speed: u32 = (read32(portsc) >> 10) & 0x0F
  write_mem32(input_context, slot_ctx, (dci << 27) | (speed << 20))
  write_mem32(input_context, slot_ctx + 4, device_port << 16)

  let ep_ctx: u32 = context_size * (1 + dci)
  // Interval is a power-of-two exponent in the context but a frame count in
  // the descriptor; passing the descriptor's value through unchanged would
  // poll at wildly the wrong rate.
  write_mem32(input_context, ep_ctx, (interrupt_ep_interval & 0xFF) << 16)
  // EP type 7 is interrupt IN. CErr = 3.
  write_mem32(input_context, ep_ctx + 4, (interrupt_ep_max_packet << 16) | (7 << 3) | (3 << 1))
  write_mem32(input_context, ep_ctx + 8, @as(u32, (interrupt_ring & 0xFFFFFFFF)) | 1)
  write_mem32(input_context, ep_ctx + 12, @as(u32, (interrupt_ring >> 32) & 0xFFFFFFFF))
  write_mem32(input_context, ep_ctx + 16, interrupt_ep_max_packet)

  if issue_command_slot(input_context, TRB_TYPE_CONFIGURE_ENDPOINT, slot) != TRB_COMPLETION_SUCCESS {
    return 0
  }
  interrupt_ep_dci = dci
  return 1
}

// Configure both bulk endpoints in one Configure Endpoint command. The
// controller takes an input context describing every endpoint being added, so
// doing them together is both fewer round trips and the only way to set the
// slot's context-entries count once and correctly.
export fn xhci_configure_bulk_endpoints(slot: u32): u32 {
  if bulk_in_address == 0 or bulk_out_address == 0 or input_context == 0 { return 0 }

  bulk_in_dci = (bulk_in_address & 0x0F) * 2 + 1
  bulk_out_dci = (bulk_out_address & 0x0F) * 2
  bulk_in_ring = memory.pmm_alloc_page()
  bulk_out_ring = memory.pmm_alloc_page()
  if bulk_in_ring == 0 or bulk_out_ring == 0 { return 0 }
  zero_page(bulk_in_ring)
  zero_page(bulk_out_ring)
  zero_page(input_context)

  var highest: u32 = bulk_in_dci
  if bulk_out_dci > highest { highest = bulk_out_dci }

  write_mem32(input_context, 4, 1 | (1 << bulk_in_dci) | (1 << bulk_out_dci))

  let slot_ctx: u32 = context_size
  let portsc: u64 = operational_base + @as(u64, XHCI_PORTSC_BASE + (device_port - 1) * XHCI_PORT_STRIDE)
  let speed: u32 = (read32(portsc) >> 10) & 0x0F
  write_mem32(input_context, slot_ctx, (highest << 27) | (speed << 20))
  write_mem32(input_context, slot_ctx + 4, device_port << 16)

  // EP type 6 is bulk IN, 2 is bulk OUT.
  let in_ctx: u32 = context_size * (1 + bulk_in_dci)
  write_mem32(input_context, in_ctx + 4, (bulk_in_max_packet << 16) | (6 << 3) | (3 << 1))
  write_mem32(input_context, in_ctx + 8, @as(u32, (bulk_in_ring & 0xFFFFFFFF)) | 1)
  write_mem32(input_context, in_ctx + 12, @as(u32, (bulk_in_ring >> 32) & 0xFFFFFFFF))
  write_mem32(input_context, in_ctx + 16, bulk_in_max_packet)

  let out_ctx: u32 = context_size * (1 + bulk_out_dci)
  write_mem32(input_context, out_ctx + 4, (bulk_out_max_packet << 16) | (2 << 3) | (3 << 1))
  write_mem32(input_context, out_ctx + 8, @as(u32, (bulk_out_ring & 0xFFFFFFFF)) | 1)
  write_mem32(input_context, out_ctx + 12, @as(u32, (bulk_out_ring >> 32) & 0xFFFFFFFF))
  write_mem32(input_context, out_ctx + 16, bulk_out_max_packet)

  if issue_command_slot(input_context, TRB_TYPE_CONFIGURE_ENDPOINT, slot) != TRB_COMPLETION_SUCCESS {
    return 0
  }
  return 1
}

// ============================================================================
// USB Mass Storage, Bulk-Only Transport
//
// Every command is three transfers: a 31-byte Command Block Wrapper out, the
// data, then a 13-byte Command Status Wrapper in. The CSW is what says whether
// the command worked — a data phase that returns bytes proves the transfer
// happened, not that the device liked the request.
// ============================================================================

const CBW_SIGNATURE: u32 = 0x43425355   // 'USBC'
const CSW_SIGNATURE: u32 = 0x53425355   // 'USBS'

var cbw_buffer: u64 = 0
var csw_buffer: u64 = 0
var data_buffer: u64 = 0
var scsi_tag: u32 = 1
var storage_last_lba: u32 = 0
var storage_block_size: u32 = 0

// Queue one Normal TRB on a bulk ring and ring its doorbell.
fn bulk_transfer(slot: u32, dci: u32, ring: u64, enqueue: u32, buffer: u64, length: u32, direction_in: u32): u32 {
  let off: u32 = enqueue * TRB_SIZE
  write_mem32(ring, off, @as(u32, buffer & 0xFFFFFFFF))
  write_mem32(ring, off + 4, @as(u32, (buffer >> 32) & 0xFFFFFFFF))
  write_mem32(ring, off + 8, length)
  // Normal TRB is type 1. Interrupt on completion so one transfer yields one
  // event; the ISP bit lets a short packet finish rather than stall.
  write_mem32(ring, off + 12, (1 << 10) | TRB_IOC | 0x4 | 1)

  write32(doorbell_base + @as(u64, slot * 4), dci)
  return await_transfer_event()
}

// Send a SCSI command and carry its data phase. `cdb_len` bytes of command
// block have already been written into cbw_buffer at offset 15.
//
// `direction_in` says which way the data goes, and it decides three things
// that have to agree: the CBW flags byte the device reads, which bulk
// endpoint the data phase uses, and which ring it is queued on. A command
// whose flags say IN while its data goes out on the OUT endpoint does not
// fail cleanly — the device waits for bytes it was told to send.
fn scsi_command_dir(slot: u32, transfer_length: u32, direction_in: u32): u32 {
  // Command Block Wrapper.
  write_mem32(cbw_buffer, 0, CBW_SIGNATURE)
  write_mem32(cbw_buffer, 4, scsi_tag)
  write_mem32(cbw_buffer, 8, transfer_length)
  // Flags: bit 7 set means the data flows device-to-host.
  if direction_in == 1 {
    @as(*u8, @ptrFromInt(cbw_buffer + 12)).* = 0x80
  } else {
    @as(*u8, @ptrFromInt(cbw_buffer + 12)).* = 0x00
  }
  @as(*u8, @ptrFromInt(cbw_buffer + 13)).* = 0      // LUN 0

  if bulk_transfer(slot, bulk_out_dci, bulk_out_ring, bulk_out_enqueue, cbw_buffer, 31, 0) == 0 {
    return 0
  }
  bulk_out_enqueue = bulk_out_enqueue + 1

  if transfer_length > 0 {
    if direction_in == 1 {
      if bulk_transfer(slot, bulk_in_dci, bulk_in_ring, bulk_in_enqueue, data_buffer, transfer_length, 1) == 0 {
        return 0
      }
      bulk_in_enqueue = bulk_in_enqueue + 1
    } else {
      if bulk_transfer(slot, bulk_out_dci, bulk_out_ring, bulk_out_enqueue, data_buffer, transfer_length, 0) == 0 {
        return 0
      }
      bulk_out_enqueue = bulk_out_enqueue + 1
    }
  }

  // Command Status Wrapper. Its signature and matching tag are what make the
  // reply trustworthy: a device that is out of step will still return bytes.
  if bulk_transfer(slot, bulk_in_dci, bulk_in_ring, bulk_in_enqueue, csw_buffer, 13, 1) == 0 {
    return 0
  }
  bulk_in_enqueue = bulk_in_enqueue + 1

  if read_mem32(csw_buffer, 0) != CSW_SIGNATURE { return 0 }
  if read_mem32(csw_buffer, 4) != scsi_tag { return 0 }
  scsi_tag = scsi_tag + 1
  // Byte 12 is the status: 0 is success.
  if @as(*u8, @ptrFromInt(csw_buffer + 12)).* != 0 { return 0 }
  return 1
}

// Device-to-host, which is what every command here but WRITE(10) wants.
fn scsi_command(slot: u32, transfer_length: u32): u32 {
  return scsi_command_dir(slot, transfer_length, 1)
}

// SCSI READ CAPACITY(10): the last addressable block and the block size, each
// a big-endian 32-bit field. Big-endian because SCSI is, unlike everything
// else on this path.
export fn usb_storage_read_capacity(slot: u32): u32 {
  if ensure_storage_buffers() == 0 { return 0 }
  zero_page(cbw_buffer)
  zero_page(csw_buffer)
  zero_page(data_buffer)

  @as(*u8, @ptrFromInt(cbw_buffer + 14)).* = 10
  @as(*u8, @ptrFromInt(cbw_buffer + 15)).* = 0x25   // READ CAPACITY(10)

  if scsi_command(slot, 8) == 0 { return 0 }

  storage_last_lba = be32_at(data_buffer, 0)
  storage_block_size = be32_at(data_buffer, 4)
  if storage_block_size == 0 { return 0 }
  return 1
}

// SCSI READ(10): one block at `lba` into the data buffer.
export fn usb_storage_read_block(slot: u32, lba: u32): u32 {
  if ensure_storage_buffers() == 0 { return 0 }
  if storage_block_size == 0 { return 0 }
  zero_page(cbw_buffer)
  zero_page(csw_buffer)
  zero_page(data_buffer)

  @as(*u8, @ptrFromInt(cbw_buffer + 14)).* = 10
  @as(*u8, @ptrFromInt(cbw_buffer + 15)).* = 0x28   // READ(10)
  // LBA, big-endian, at CDB bytes 2..5.
  @as(*u8, @ptrFromInt(cbw_buffer + 17)).* = @as(u8, (lba >> 24) & 0xFF)
  @as(*u8, @ptrFromInt(cbw_buffer + 18)).* = @as(u8, (lba >> 16) & 0xFF)
  @as(*u8, @ptrFromInt(cbw_buffer + 19)).* = @as(u8, (lba >> 8) & 0xFF)
  @as(*u8, @ptrFromInt(cbw_buffer + 20)).* = @as(u8, lba & 0xFF)
  // Transfer length in *blocks*, not bytes, at CDB bytes 7..8.
  @as(*u8, @ptrFromInt(cbw_buffer + 22)).* = 0
  @as(*u8, @ptrFromInt(cbw_buffer + 23)).* = 1

  return scsi_command(slot, storage_block_size)
}

// SCSI WRITE(10): one block from the data buffer to `lba`.
//
// Fill the buffer with usb_storage_set_data_byte first. The command is the
// mirror of READ(10) — same CDB shape, opcode 0x2A, and a data phase that
// goes the other way.
export fn usb_storage_write_block(slot: u32, lba: u32): u32 {
  if ensure_storage_buffers() == 0 { return 0 }
  if storage_block_size == 0 { return 0 }
  // The data buffer is not zeroed here, unlike the read path: it holds what
  // the caller means to write.
  zero_page(cbw_buffer)
  zero_page(csw_buffer)

  @as(*u8, @ptrFromInt(cbw_buffer + 14)).* = 10
  @as(*u8, @ptrFromInt(cbw_buffer + 15)).* = 0x2A   // WRITE(10)
  @as(*u8, @ptrFromInt(cbw_buffer + 17)).* = @as(u8, (lba >> 24) & 0xFF)
  @as(*u8, @ptrFromInt(cbw_buffer + 18)).* = @as(u8, (lba >> 16) & 0xFF)
  @as(*u8, @ptrFromInt(cbw_buffer + 19)).* = @as(u8, (lba >> 8) & 0xFF)
  @as(*u8, @ptrFromInt(cbw_buffer + 20)).* = @as(u8, lba & 0xFF)
  @as(*u8, @ptrFromInt(cbw_buffer + 22)).* = 0
  @as(*u8, @ptrFromInt(cbw_buffer + 23)).* = 1

  return scsi_command_dir(slot, storage_block_size, 0)
}

// Put a byte into the buffer the next write will send. Bounded by the block
// size the device reported rather than by the page, so a caller cannot stage
// more than one block and have the tail silently ignored.
export fn usb_storage_set_data_byte(index: u32, value: u8): u32 {
  if data_buffer == 0 { return 0 }
  if storage_block_size == 0 or index >= storage_block_size { return 0 }
  @as(*u8, @ptrFromInt(data_buffer + @as(u64, index))).* = value
  return 1
}

// Clear the staging buffer, so a short write does not ship whatever the last
// read left behind in the rest of the block.
export fn usb_storage_clear_data(): u32 {
  if data_buffer == 0 { return 0 }
  zero_page(data_buffer)
  return 1
}

fn be32_at(base: u64, offset: u32): u32 {
  return (@as(u32, @as(*u8, @ptrFromInt(base + @as(u64, offset))).*) << 24)
    | (@as(u32, @as(*u8, @ptrFromInt(base + @as(u64, offset + 1))).*) << 16)
    | (@as(u32, @as(*u8, @ptrFromInt(base + @as(u64, offset + 2))).*) << 8)
    | @as(u32, @as(*u8, @ptrFromInt(base + @as(u64, offset + 3))).*)
}

fn ensure_storage_buffers(): u32 {
  if bulk_in_dci == 0 or bulk_out_dci == 0 { return 0 }
  if cbw_buffer != 0 { return 1 }
  cbw_buffer = memory.pmm_alloc_page()
  csw_buffer = memory.pmm_alloc_page()
  data_buffer = memory.pmm_alloc_page()
  if cbw_buffer == 0 or csw_buffer == 0 or data_buffer == 0 { return 0 }
  return 1
}

export fn usb_storage_last_lba(): u32 { return storage_last_lba }
export fn usb_storage_block_size(): u32 { return storage_block_size }

// A byte of whatever the last SCSI data phase returned.
export fn usb_storage_data_byte(index: u32): u8 {
  if data_buffer == 0 or index >= 4096 { return 0 }
  return @as(*u8, @ptrFromInt(data_buffer + @as(u64, index))).*
}

// SCSI INQUIRY. Returns 1 when the device answered, leaving its vendor and
// product strings in the data buffer.
export fn usb_storage_inquiry(slot: u32): u32 {
  if ensure_storage_buffers() == 0 { return 0 }
  zero_page(cbw_buffer)
  zero_page(csw_buffer)
  zero_page(data_buffer)

  // A 6-byte INQUIRY asking for 36 bytes: the standard reply.
  @as(*u8, @ptrFromInt(cbw_buffer + 14)).* = 6         // CDB length
  @as(*u8, @ptrFromInt(cbw_buffer + 15)).* = 0x12      // INQUIRY
  @as(*u8, @ptrFromInt(cbw_buffer + 19)).* = 36        // allocation length

  return scsi_command(slot, 36)
}

// The INQUIRY reply puts the vendor at bytes 8..15 and the product at 16..31,
// space-padded ASCII.
export fn usb_storage_vendor_byte(index: u32): u8 {
  if data_buffer == 0 or index >= 8 { return 0 }
  return @as(*u8, @ptrFromInt(data_buffer + @as(u64, 8 + index))).*
}

export fn usb_storage_product_byte(index: u32): u8 {
  if data_buffer == 0 or index >= 16 { return 0 }
  return @as(*u8, @ptrFromInt(data_buffer + @as(u64, 16 + index))).*
}

export fn usb_bulk_in_address(): u32 { return bulk_in_address }
export fn usb_bulk_out_address(): u32 { return bulk_out_address }
export fn usb_interface_class(): u32 { return interface_class }
export fn usb_interrupt_ep_dci(): u32 { return interrupt_ep_dci }
export fn usb_config_value(): u32 { return config_value }
export fn usb_interrupt_ep_address(): u32 { return interrupt_ep_address }
export fn usb_interrupt_ep_max_packet(): u32 { return interrupt_ep_max_packet }
export fn usb_interrupt_ep_interval(): u32 { return interrupt_ep_interval }

export fn usb_device_vendor(): u32 { return device_vendor }
export fn usb_device_product(): u32 { return device_product }

export fn usb_port_connected(port: u32): u32 {
  if port == 0 or port > max_ports { return 0 }
  let portsc: u64 = operational_base + @as(u64, XHCI_PORTSC_BASE + (port - 1) * XHCI_PORT_STRIDE)
  if (read32(portsc) & PORTSC_CCS) != 0 { return 1 }
  return 0
}

export fn usb_controller_running(): u32 { return controller_running }
export fn usb_controller_found(): u32 { return controller_found }
export fn usb_hci_version(): u32 { return hci_version }
export fn usb_max_ports(): u32 { return max_ports }
export fn usb_max_slots(): u32 { return max_slots }
export fn usb_ports_connected(): u32 { return ports_connected }

// Whether the controller is halted. After reset and before the ring setup
// STUB(S6) still lacks, a controller is halted — reporting it is how a caller
// can tell "not started yet" from "started and wedged".
export fn usb_is_halted(): u32 {
  if controller_found == 0 { return 1 }
  if (read32(operational_base + @as(u64, XHCI_USBSTS)) & USBSTS_HCHALTED) != 0 {
    return 1
  }
  return 0
}
