// home-os Kernel - Intel E1000 Network Driver
// Real implementation for network I/O

import "../core/foundation.home" as foundation
import "../core/memory.home" as memory
import "pci.home" as pci

// ============================================================================
// CONSTANTS
// ============================================================================

// E1000 registers
const E1000_REG_CTRL: u32 = 0x00000
const E1000_REG_STATUS: u32 = 0x00008
const E1000_REG_EECD: u32 = 0x00010
const E1000_REG_EERD: u32 = 0x00014
const E1000_REG_CTRL_EXT: u32 = 0x00018
const E1000_REG_MDIC: u32 = 0x00020
const E1000_REG_ICR: u32 = 0x000C0
const E1000_REG_IMS: u32 = 0x000D0
const E1000_REG_RCTL: u32 = 0x00100
const E1000_REG_TCTL: u32 = 0x00400
const E1000_REG_RDBAL: u32 = 0x02800
const E1000_REG_RDBAH: u32 = 0x02804
const E1000_REG_RDLEN: u32 = 0x02808
const E1000_REG_RDH: u32 = 0x02810
const E1000_REG_RDT: u32 = 0x02818
const E1000_REG_TDBAL: u32 = 0x03800
const E1000_REG_TDBAH: u32 = 0x03804
const E1000_REG_TDLEN: u32 = 0x03808
const E1000_REG_TDH: u32 = 0x03810
const E1000_REG_TDT: u32 = 0x03818
const E1000_REG_RAL: u32 = 0x05400
const E1000_REG_RAH: u32 = 0x05404

// Control bits
const E1000_CTRL_RST: u32 = 0x04000000
const E1000_CTRL_SLU: u32 = 0x00000040

// Receive control bits
const E1000_RCTL_EN: u32 = 0x00000002
const E1000_RCTL_BAM: u32 = 0x00008000
const E1000_RCTL_BSIZE_2048: u32 = 0x00000000
// Strip the frame check sequence. Without it the four CRC bytes are counted
// in the descriptor length and every frame reads four bytes longer than it is
// — which parses, and puts rubbish on the end of every payload.
const E1000_RCTL_SECRC: u32 = 0x04000000
// Receive Address High, bit 31: this entry is valid. An address written
// without it is not a filter, it is sixteen bytes of ignored register.
const E1000_RAH_AV: u32 = 0x80000000

// Transmit control bits
const E1000_TCTL_EN: u32 = 0x00000002
const E1000_TCTL_PSP: u32 = 0x00000008

const RX_DESC_COUNT: u32 = 32
const TX_DESC_COUNT: u32 = 32
const PACKET_SIZE: u32 = 2048

// ============================================================================
// DESCRIPTOR STRUCTURES
// ============================================================================

struct RxDescriptor {
  addr: u64,
  length: u16,
  checksum: u16,
  status: u8,
  errors: u8,
  special: u16
}

struct TxDescriptor {
  addr: u64,
  length: u16,
  cso: u8,
  cmd: u8,
  status: u8,
  css: u8,
  special: u16
}

// ============================================================================
// DEVICE STATE
// ============================================================================

var e1000_base: u64 = 0
var e1000_initialized: u32 = 0
var mac_address: [u8; 6] = undefined

var rx_descriptors: [RxDescriptor; 32] = undefined
var tx_descriptors: [TxDescriptor; 32] = undefined
var rx_buffers: u64 = 0
var tx_buffers: u64 = 0

var rx_current: u32 = 0
var tx_current: u32 = 0

// ============================================================================
// MMIO ACCESS
// ============================================================================

fn e1000_read_reg(reg: u32): u32 {
  var addr: u64 = e1000_base + reg
  return @as(*volatile u32, @ptrFromInt(addr)).*
}

fn e1000_write_reg(reg: u32, value: u32) {
  var addr: u64 = e1000_base + reg
  @as(*volatile u32, @ptrFromInt(addr)).* = value
}

// ============================================================================
// EEPROM ACCESS
// ============================================================================

fn e1000_read_eeprom(addr: u8): u16 {
  var tmp: u32 = 0
  
  // Start read
  e1000_write_reg(E1000_REG_EERD, 1 | (addr << 8))
  
  // Wait for completion
  var timeout: u32 = 1000
  while timeout > 0 {
    tmp = e1000_read_reg(E1000_REG_EERD)
    if (tmp & 0x10) != 0 {
      break
    }
    timeout = timeout - 1
  }
  
  return (tmp >> 16) & 0xFFFF
}

// ============================================================================
// INITIALIZATION
// ============================================================================

// PCI identity. 0x100E is the 82540EM QEMU presents as `-device e1000`;
// 0x10D3 is the 82574L it presents as `e1000e`. They differ above this layer,
// not in the register block used here.
const E1000_VENDOR_INTEL: u16 = 0x8086
const E1000_DEVICE_82540EM: u16 = 0x100E
const E1000_DEVICE_82574L: u16 = 0x10D3

const PCI_COMMAND: u8 = 0x04
const PCI_COMMAND_IO: u16 = 0x0001
const PCI_COMMAND_MEMORY: u16 = 0x0002
const PCI_COMMAND_BUS_MASTER: u16 = 0x0004

var e1000_pci: u64 = 0

fn map_registers(base: u64, bytes: u64): u32 {
  var mapped: u64 = 0
  while mapped < bytes {
    if memory.vmm_map_page(base + mapped, base + mapped, 3) != 0 {
      return 0
    }
    mapped = mapped + 4096
  }
  return 1
}

// Find the controller on the PCI bus and bring its register window up.
// Returns 1 if there is one.
//
// Bus mastering is the part that is easy to leave out and impossible to
// notice: without it the device's register writes all take, the driver
// reports itself initialised, and every descriptor ring sits untouched
// because the card is not allowed to reach memory. Nothing fails — packets
// simply never move.
export fn e1000_probe(): u32 {
  if e1000_initialized == 1 { return 1 }

  var dev: u64 = pci.pci_find_device(E1000_VENDOR_INTEL, E1000_DEVICE_82540EM)
  if dev == 0 {
    dev = pci.pci_find_device(E1000_VENDOR_INTEL, E1000_DEVICE_82574L)
  }
  if dev == 0 { return 0 }
  e1000_pci = dev

  let command: u16 = pci.pci_read_config16(dev, PCI_COMMAND)
  pci.pci_write_config16(dev, PCI_COMMAND,
                         command | PCI_COMMAND_MEMORY | PCI_COMMAND_BUS_MASTER)

  let bar0: u64 = @as(u64, pci.pci_read_bar(dev, 0))
  if bar0 == 0 { return 0 }

  // The register window has to be mapped before it can be touched. QEMU puts
  // this BAR around 0xFEBC0000, well above the 2 GB the boot path
  // identity-maps, so the first register write faults rather than reaching
  // the card — and a fault in early init looks like a kernel that stopped
  // for no reason.
  if map_registers(bar0, 131072) == 0 {
    foundation.serial_write_string("[E1000] could not map the register window\n")
    return 0
  }

  e1000_init(bar0)
  if e1000_initialized == 0 { return 0 }
  return 1
}

export fn e1000_pci_device(): u64 { return e1000_pci }

export fn e1000_init(base_addr: u64) {
  if e1000_initialized == 1 { return }
  
  e1000_base = base_addr
  
  // Reset device
  e1000_write_reg(E1000_REG_CTRL, E1000_CTRL_RST)
  
  // Wait for reset
  var i: u32 = 0
  while i < 1000 {
    i = i + 1
  }
  
  // Read MAC address from EEPROM
  var mac_low: u16 = e1000_read_eeprom(0)
  var mac_mid: u16 = e1000_read_eeprom(1)
  var mac_high: u16 = e1000_read_eeprom(2)
  
  mac_address[0] = mac_low & 0xFF
  mac_address[1] = (mac_low >> 8) & 0xFF
  mac_address[2] = mac_mid & 0xFF
  mac_address[3] = (mac_mid >> 8) & 0xFF
  mac_address[4] = mac_high & 0xFF
  mac_address[5] = (mac_high >> 8) & 0xFF
  
  // Packet buffers, from the page allocator rather than the heap.
  //
  // The card reads and writes these by DMA, so the addresses in the
  // descriptors have to be physical ones. kmalloc returns kernel-virtual
  // addresses — the heap sits far above the identity map, and the buffers
  // came back around 0x1000_0000_0000 — so the card was transmitting
  // whatever happened to be at that *physical* address and receiving into
  // it. Nothing failed: descriptors completed, the head pointer moved, and
  // every frame on the wire was sixty bytes of unrelated memory.
  //
  // pmm_alloc_pages hands out identity-mapped physical pages, which is what
  // every other DMA user in this tree already takes.
  let rx_pages: u32 = (RX_DESC_COUNT * PACKET_SIZE + 4095) / 4096
  let tx_pages: u32 = (TX_DESC_COUNT * PACKET_SIZE + 4095) / 4096
  rx_buffers = memory.pmm_alloc_pages(rx_pages)
  tx_buffers = memory.pmm_alloc_pages(tx_pages)

  if rx_buffers == 0 or tx_buffers == 0 {
    rx_buffers = 0
    tx_buffers = 0
    foundation.serial_write_string("[E1000] Failed to allocate buffers\n")
    return
  }

  // Initialize RX descriptors
  i = 0
  while i < RX_DESC_COUNT {
    rx_descriptors[i].addr = rx_buffers + (i * PACKET_SIZE)
    rx_descriptors[i].status = 0
    i = i + 1
  }
  
  // Initialize TX descriptors
  i = 0
  while i < TX_DESC_COUNT {
    tx_descriptors[i].addr = tx_buffers + (i * PACKET_SIZE)
    tx_descriptors[i].cmd = 0
    tx_descriptors[i].status = 1  // Done
    i = i + 1
  }
  
  // Set up receive ring
  e1000_write_reg(E1000_REG_RDBAL, @ptrFromInt(rx_descriptors) & 0xFFFFFFFF)
  e1000_write_reg(E1000_REG_RDBAH, (@ptrFromInt(rx_descriptors) >> 32) & 0xFFFFFFFF)
  e1000_write_reg(E1000_REG_RDLEN, RX_DESC_COUNT * @sizeOf(RxDescriptor))
  e1000_write_reg(E1000_REG_RDH, 0)
  e1000_write_reg(E1000_REG_RDT, RX_DESC_COUNT - 1)
  
  // Set up transmit ring
  e1000_write_reg(E1000_REG_TDBAL, @ptrFromInt(tx_descriptors) & 0xFFFFFFFF)
  e1000_write_reg(E1000_REG_TDBAH, (@ptrFromInt(tx_descriptors) >> 32) & 0xFFFFFFFF)
  e1000_write_reg(E1000_REG_TDLEN, TX_DESC_COUNT * @sizeOf(TxDescriptor))
  e1000_write_reg(E1000_REG_TDH, 0)
  e1000_write_reg(E1000_REG_TDT, 0)
  
  // Program the receive address filter with our own MAC.
  //
  // Without this the card accepts broadcasts — because BAM is set — and
  // nothing else. Every unicast reply to something this kernel sent is
  // dropped by the card before the driver sees it, which looks exactly like
  // a peer that never answered: the transmit descriptor completes, the head
  // pointer moves, and no frame ever arrives. A device reset clears these,
  // so reading them from the EEPROM is not enough.
  let ral: u32 = @as(u32, mac_address[0])
    | (@as(u32, mac_address[1]) << 8)
    | (@as(u32, mac_address[2]) << 16)
    | (@as(u32, mac_address[3]) << 24)
  let rah: u32 = @as(u32, mac_address[4])
    | (@as(u32, mac_address[5]) << 8)
    | E1000_RAH_AV
  e1000_write_reg(E1000_REG_RAL, ral)
  e1000_write_reg(E1000_REG_RAH, rah)

  // Enable receive
  e1000_write_reg(E1000_REG_RCTL,
                  E1000_RCTL_EN | E1000_RCTL_BAM | E1000_RCTL_BSIZE_2048 |
                  E1000_RCTL_SECRC)
  
  // Enable transmit
  e1000_write_reg(E1000_REG_TCTL, E1000_TCTL_EN | E1000_TCTL_PSP)
  
  // Link up
  e1000_write_reg(E1000_REG_CTRL, e1000_read_reg(E1000_REG_CTRL) | E1000_CTRL_SLU)
  
  e1000_initialized = 1
  foundation.serial_write_string("[E1000] Initialized - MAC: ")
  var m: u32 = 0
  while m < 6 {
    foundation.serial_write_hex_byte(mac_address[m])
    if m < 5 { foundation.serial_write_string(":") }
    m = m + 1
  }
  foundation.serial_write_string("\n")
}

// ============================================================================
// PACKET TRANSMISSION
// ============================================================================

export fn e1000_send_packet(data: u64, length: u32): u32 {
  if e1000_initialized == 0 { return 1 }
  if length == 0 or length > PACKET_SIZE { return 1 }
  if data == 0 { return 1 }
  if tx_buffers == 0 { return 1 }
  
  // Wait for current descriptor to be free. The status field is updated
  // by the NIC via DMA, so we MUST read it through a volatile pointer —
  // otherwise the compiler caches the first read and we spin forever
  // even after the hardware completes the prior transmission.
  var timeout: i32 = 10000
  while timeout > 0 {
    var status: u8 = @as(*volatile u8, @ptrFromInt(@intFromPtr(&tx_descriptors[tx_current].status))).*
    if (status & 1) != 0 {
      break
    }
    timeout = timeout - 1
  }

  if timeout <= 0 { return 1 }
  
  // Copy data into the TX descriptor's backing buffer. Using the
  // word-sized mem_copy instead of a byte loop cuts per-packet TX
  // overhead ~8× for typical 1500-byte frames.
  var dest: u64 = tx_descriptors[tx_current].addr
  memory.mem_copy(dest, data, @as(u64, length))

  // Set up descriptor
  tx_descriptors[tx_current].length = length
  tx_descriptors[tx_current].cmd = 0x0B  // EOP | IFCS | RS
  tx_descriptors[tx_current].status = 0
  
  // Update tail
  tx_current = (tx_current + 1) % TX_DESC_COUNT
  e1000_write_reg(E1000_REG_TDT, tx_current)
  
  return 0
}

// ============================================================================
// PACKET RECEPTION
// ============================================================================

export fn e1000_receive_packet(buffer: u64, max_length: u32): u32 {
  if e1000_initialized == 0 { return 0 }
  if buffer == 0 or max_length == 0 { return 0 }
  if rx_buffers == 0 { return 0 }
  
  // Check if packet available. Read via volatile pointer: the NIC
  // updates status via DMA and without `volatile` the compiler would
  // cache the first observation and we'd miss fresh packets.
  var rx_status: u8 = @as(*volatile u8, @ptrFromInt(@intFromPtr(&rx_descriptors[rx_current].status))).*
  if (rx_status & 1) == 0 {
    return 0  // No packet
  }

  // Drop packets with hardware-reported errors (CRC, alignment, etc.)
  if rx_descriptors[rx_current].errors != 0 {
    rx_descriptors[rx_current].status = 0
    var old_cur: u32 = rx_current
    rx_current = (rx_current + 1) % RX_DESC_COUNT
    e1000_write_reg(E1000_REG_RDT, old_cur)
    return 0
  }

  var length: u32 = rx_descriptors[rx_current].length
  if length > max_length {
    length = max_length
  }
  
  // Word-sized copy from the RX descriptor's buffer into the caller.
  var src: u64 = rx_descriptors[rx_current].addr
  memory.mem_copy(buffer, src, @as(u64, length))

  // Reset descriptor
  rx_descriptors[rx_current].status = 0
  
  // Update tail
  var old_current: u32 = rx_current
  rx_current = (rx_current + 1) % RX_DESC_COUNT
  e1000_write_reg(E1000_REG_RDT, old_current)
  
  return length
}

// ============================================================================
// DEVICE INFO
// ============================================================================

export fn e1000_get_mac_address(dest: u64) {
  if dest == 0 { return }
  memory.mem_copy(dest, @intFromPtr(&mac_address[0]), 6)
}

// One byte of the MAC the card reported. Exposed a byte at a time because the
// caller printing it has no array to copy into and no need for one.
export fn e1000_mac_byte(index: u32): u8 {
  if index >= 6 { return 0 }
  return @as(u8, mac_address[index])
}

// Ring positions and the descriptor status bits, straight off the card.
// A transmit that the driver believes it queued and the card never processed
// is indistinguishable from a wire with nothing on the other end, unless you
// can see the head pointer move.
export fn e1000_debug_tdh(): u32 { return e1000_read_reg(E1000_REG_TDH) }
export fn e1000_debug_tdt(): u32 { return e1000_read_reg(E1000_REG_TDT) }
export fn e1000_debug_rdh(): u32 { return e1000_read_reg(E1000_REG_RDH) }
export fn e1000_debug_rdt(): u32 { return e1000_read_reg(E1000_REG_RDT) }
export fn e1000_debug_status(): u32 { return e1000_read_reg(E1000_REG_STATUS) }
export fn e1000_debug_tx_status(index: u32): u32 {
  if index >= TX_DESC_COUNT { return 0xFF }
  return @as(u32, @as(*volatile u8, @ptrFromInt(@intFromPtr(&tx_descriptors[index].status))).*)
}
export fn e1000_debug_rx_status(index: u32): u32 {
  if index >= RX_DESC_COUNT { return 0xFF }
  return @as(u32, @as(*volatile u8, @ptrFromInt(@intFromPtr(&rx_descriptors[index].status))).*)
}
export fn e1000_debug_rdbal(): u32 { return e1000_read_reg(E1000_REG_RDBAL) }
export fn e1000_debug_ring_addr(): u64 { return @intFromPtr(&rx_descriptors) }
export fn e1000_debug_rx_buffers(): u64 { return rx_buffers }
export fn e1000_debug_tx_buffers(): u64 { return tx_buffers }
export fn e1000_debug_rctl(): u32 { return e1000_read_reg(E1000_REG_RCTL) }
export fn e1000_debug_rdlen(): u32 { return e1000_read_reg(E1000_REG_RDLEN) }
export fn e1000_debug_tdlen(): u32 { return e1000_read_reg(E1000_REG_TDLEN) }
export fn e1000_debug_rdbah(): u32 { return e1000_read_reg(E1000_REG_RDBAH) }
export fn e1000_debug_desc_size(): u32 { return @sizeOf(RxDescriptor) }
export fn e1000_debug_ral(): u32 { return e1000_read_reg(E1000_REG_RAL) }
export fn e1000_debug_rah(): u32 { return e1000_read_reg(E1000_REG_RAH) }
// A byte of what the card was actually told to transmit, read back from the
// DMA buffer rather than from the staging frame the driver built.
export fn e1000_debug_txbuf_byte(index: u32): u8 {
  if tx_buffers == 0 or index >= PACKET_SIZE { return 0 }
  return @as(*u8, @ptrFromInt(tx_buffers + @as(u64, index))).*
}
export fn e1000_debug_tx_length(index: u32): u32 {
  if index >= TX_DESC_COUNT { return 0 }
  return @as(u32, tx_descriptors[index].length)
}
export fn e1000_debug_tctl(): u32 { return e1000_read_reg(E1000_REG_TCTL) }
export fn e1000_debug_tx_addr(index: u32): u64 {
  if index >= TX_DESC_COUNT { return 0 }
  return tx_descriptors[index].addr
}

export fn e1000_is_initialized(): u32 {
  return e1000_initialized
}

export fn e1000_get_link_status(): u32 {
  if e1000_initialized == 0 { return 0 }
  
  var status: u32 = e1000_read_reg(E1000_REG_STATUS)
  return (status & 0x02) != 0  // Link up bit
}
