// home-os Kernel - BLAKE2s Hash
// TODO(#11): This is a stub. Implement BLAKE2s per RFC 7693.
// Output is zeroed so consumers fail closed instead of treating a
// stubbed digest as a real one.

import "../core/foundation.home" as foundation

// Compute a 32-byte BLAKE2s digest of `len` bytes at `data` into `out`.
export fn blake2s(out: u64, data: u64, len: u32) {
  // TODO(#11): real implementation.
  var i: u32 = 0
  while i < 32 {
    @as(*u8, @ptrFromInt(out + i)).* = 0
    i = i + 1
  }
  foundation.serial_write_string("[blake2s] stub invoked\n")
}

// Keyed BLAKE2s — used by WireGuard for key derivation.
// `out` is 32 bytes; `key` and `data` are arbitrary-length inputs.
export fn blake2s_keyed(out: u64, key: u64, data: u64, len: u32) {
  // TODO(#11): real implementation.
  var i: u32 = 0
  while i < 32 {
    @as(*u8, @ptrFromInt(out + i)).* = 0
    i = i + 1
  }
  foundation.serial_write_string("[blake2s] keyed stub invoked\n")
}
