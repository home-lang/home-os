// home-os Kernel - Poly1305 MAC
//
// STUB(S5): Poly1305 MAC, RFC 8439 is not implemented. This primitive fails closed —
// it returns zeros or an error rather than a wrong-but-plausible result.
// Package signing needs it, so it blocks the Phase 3 pantry-local-install
// gate, and WireGuard later. See MASTER_PLAN §7.
// TODO(#11): This is a stub. Implement Poly1305 per RFC 8439. The
// authentication tag is currently zeroed so any verification will
// fail closed.

import "../core/foundation.home" as foundation

// Compute a 16-byte authentication tag over `data` using `key` (32 bytes).
export fn poly1305_mac(tag: u64, key: u64, data: u64, len: u32) {
  // TODO(#11): real implementation. Zero the tag so callers cannot
  // mistake a stubbed MAC for a valid one.
  var i: u32 = 0
  while i < 16 {
    @as(*u8, @ptrFromInt(tag + i)).* = 0
    i = i + 1
  }
  foundation.serial_write_string("[poly1305] mac stub invoked\n")
}
