fn test_rsa() {
  rsa_kat_init()

  // rsa_init returns nothing; it only sets the module's initialised flag.
  rsa.rsa_init()

  rsa.rsa_import_public_key(&rsa_kat_pub, @ptrFromInt(@intFromPtr(&rsa_kat_n)), 64, 65537)

  // The signature was computed elsewhere, so verifying it exercises the whole
  // path — modular exponentiation, the PKCS#1 unpadding, the DigestInfo and
  // the hash — against an answer this implementation had no part in choosing.
  if rsa.rsa_verify(@ptrFromInt(@intFromPtr(&rsa_kat_message)), RSA_KAT_MESSAGE_LEN,
                    @ptrFromInt(@intFromPtr(&rsa_kat_sig)), 64, &rsa_kat_pub) != 1 {
    foundation.serial_write_string("[crypto] rsa verify REJECTED a valid signature\n")
    return
  }
  foundation.serial_write_string("[crypto] rsa verify accepts a known-good PKCS#1 v1.5 signature\n")

  // A signature that verifies everything is worth nothing. One flipped bit
  // must be refused.
  rsa_kat_sig[63] = rsa_kat_sig[63] ^ 1
  if rsa.rsa_verify(@ptrFromInt(@intFromPtr(&rsa_kat_message)), RSA_KAT_MESSAGE_LEN,
                    @ptrFromInt(@intFromPtr(&rsa_kat_sig)), 64, &rsa_kat_pub) == 1 {
    foundation.serial_write_string("[crypto] rsa verify ACCEPTED a tampered signature\n")
    return
  }
  rsa_kat_sig[63] = rsa_kat_sig[63] ^ 1
  foundation.serial_write_string("[crypto] rsa verify refuses a tampered signature\n")

  // And signing the same message with the matching private key must reproduce
  // the signature byte for byte.
  rsa.rsa_import_private_key(&rsa_kat_priv, @ptrFromInt(@intFromPtr(&rsa_kat_n)), 64,
                             @ptrFromInt(@intFromPtr(&rsa_kat_d)), 64)

  // rsa_sign returns the signature's length, not a boolean; 0 means failure.
  let siglen: u32 = rsa.rsa_sign(@ptrFromInt(@intFromPtr(&rsa_kat_message)),
                                 RSA_KAT_MESSAGE_LEN,
                                 @ptrFromInt(@intFromPtr(&rsa_kat_out)), &rsa_kat_priv)
  if siglen == 0 {
    foundation.serial_write_string("[crypto] rsa sign failed\n")
    return
  }
  if bytes_equal(@intFromPtr(&rsa_kat_out), @intFromPtr(&rsa_kat_sig), 64) == 1 {
    foundation.serial_write_string("[crypto] rsa sign reproduces the known signature\n")
  } else {
    foundation.serial_write_string("[crypto] rsa sign DIFFERS from the known signature\n")
  }
}

export fn crypto_selftest() {
  test_chacha20()
  test_poly1305()
  test_aead()
  test_blake2s()
  test_sha256()
  test_x25519()
}

// RSA is separate because it is slow: signing walks 512 exponent bits, each
// with a multiply and a modular reduction over a 1024-bit product. That is a
// second or two of emulated CPU, and running it with the rest of the
// self-tests pushed every later boot step out behind it — far enough that
// scripts/crash-gate.sh, which kills the machine 2.4 seconds in, stopped
// reaching the filesystem writes it exists to interrupt.
//
// Called after the filesystem work in main.home for that reason.
export fn crypto_rsa_selftest() {
  test_rsa()
}
