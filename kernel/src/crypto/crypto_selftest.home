// home-os Kernel - Cryptographic primitive self-test
//
// Every vector here is copied from the RFC that defines the primitive, not
// generated by this tree. A test built from our own output would pass just as
// happily against a wrong implementation, which is the failure MASTER_PLAN §7
// rule 1 is written to prevent.
//
//   ChaCha20   RFC 8439 §2.3.2
//   Poly1305   RFC 8439 §2.5.2
//   BLAKE2s    RFC 7693 Appendix B
//   X25519     RFC 7748 §5.2
//
// Each check prints only on success, so a regression drops a boot milestone
// rather than quietly returning a plausible wrong answer.

import "../core/foundation.home" as foundation
import "chacha20.home" as chacha20
import "poly1305.home" as poly1305
import "blake2s.home" as blake2s
import "curve25519.home" as curve25519
import "sha256.home" as sha256

fn bytes_equal(a: u64, b: u64, len: u32): u32 {
  var i: u32 = 0
  while i < len {
    let x: u8 = @as(*u8, @ptrFromInt(a + @as(u64, i))).*
    let y: u8 = @as(*u8, @ptrFromInt(b + @as(u64, i))).*
    if x != y {
      return 0
    }
    i = i + 1
  }
  return 1
}

// ============================================================================
// ChaCha20 — RFC 8439 §2.3.2
// ============================================================================
fn test_chacha20() {
  var key: [u8; 32] = undefined
  var i: u32 = 0
  while i < 32 {
    key[i] = @as(u8, i)
    i = i + 1
  }

  var nonce: [u8; 12] = undefined
  i = 0
  while i < 12 {
    nonce[i] = 0
    i = i + 1
  }
  nonce[3] = 0x09
  nonce[7] = 0x4A

  var out: [u8; 64] = undefined
  chacha20.chacha20_block(@intFromPtr(&key), 1, @intFromPtr(&nonce), @intFromPtr(&out))

  // First 16 bytes of the expected keystream block.
  var want: [u8; 16] = undefined
  want[0] = 0x10
  want[1] = 0xF1
  want[2] = 0xE7
  want[3] = 0xE4
  want[4] = 0xD1
  want[5] = 0x3B
  want[6] = 0x59
  want[7] = 0x15
  want[8] = 0x50
  want[9] = 0x0F
  want[10] = 0xDD
  want[11] = 0x1F
  want[12] = 0xA3
  want[13] = 0x20
  want[14] = 0x71
  want[15] = 0xC4

  if bytes_equal(@intFromPtr(&out), @intFromPtr(&want), 16) == 1 {
    foundation.serial_write_string("[crypto] chacha20 block matches RFC 8439\n")
  }
}

// ============================================================================
// Poly1305 — RFC 8439 §2.5.2
// ============================================================================
fn test_poly1305() {
  var key: [u8; 32] = undefined
  key[0] = 0x85
  key[1] = 0xD6
  key[2] = 0xBE
  key[3] = 0x78
  key[4] = 0x57
  key[5] = 0x55
  key[6] = 0x6D
  key[7] = 0x33
  key[8] = 0x7F
  key[9] = 0x44
  key[10] = 0x52
  key[11] = 0xFE
  key[12] = 0x42
  key[13] = 0xD5
  key[14] = 0x06
  key[15] = 0xA8
  key[16] = 0x01
  key[17] = 0x03
  key[18] = 0x80
  key[19] = 0x8A
  key[20] = 0xFB
  key[21] = 0x0D
  key[22] = 0xB2
  key[23] = 0xFD
  key[24] = 0x4A
  key[25] = 0xBF
  key[26] = 0xF6
  key[27] = 0xAF
  key[28] = 0x41
  key[29] = 0x49
  key[30] = 0xF5
  key[31] = 0x1B

  // "Cryptographic Forum Research Group"
  var msg: [u8; 34] = undefined
  msg[0] = 67
  msg[1] = 114
  msg[2] = 121
  msg[3] = 112
  msg[4] = 116
  msg[5] = 111
  msg[6] = 103
  msg[7] = 114
  msg[8] = 97
  msg[9] = 112
  msg[10] = 104
  msg[11] = 105
  msg[12] = 99
  msg[13] = 32
  msg[14] = 70
  msg[15] = 111
  msg[16] = 114
  msg[17] = 117
  msg[18] = 109
  msg[19] = 32
  msg[20] = 82
  msg[21] = 101
  msg[22] = 115
  msg[23] = 101
  msg[24] = 97
  msg[25] = 114
  msg[26] = 99
  msg[27] = 104
  msg[28] = 32
  msg[29] = 71
  msg[30] = 114
  msg[31] = 111
  msg[32] = 117
  msg[33] = 112

  var tag: [u8; 16] = undefined
  poly1305.poly1305_mac(@intFromPtr(&tag), @intFromPtr(&key), @intFromPtr(&msg), 34)

  var want: [u8; 16] = undefined
  want[0] = 0xA8
  want[1] = 0x06
  want[2] = 0x1D
  want[3] = 0xC1
  want[4] = 0x30
  want[5] = 0x51
  want[6] = 0x36
  want[7] = 0xC6
  want[8] = 0xC2
  want[9] = 0x2B
  want[10] = 0x8B
  want[11] = 0xAF
  want[12] = 0x0C
  want[13] = 0x01
  want[14] = 0x27
  want[15] = 0xA9

  if bytes_equal(@intFromPtr(&tag), @intFromPtr(&want), 16) == 1 {
    foundation.serial_write_string("[crypto] poly1305 tag matches RFC 8439\n")
  }
}

// ============================================================================
// AEAD round trip, plus a forgery that must be refused
// ============================================================================
fn test_aead() {
  var key: [u8; 32] = undefined
  var i: u32 = 0
  while i < 32 {
    key[i] = @as(u8, 128 + i)
    i = i + 1
  }
  var nonce: [u8; 12] = undefined
  i = 0
  while i < 12 {
    nonce[i] = @as(u8, 64 + i)
    i = i + 1
  }
  var aad: [u8; 8] = undefined
  i = 0
  while i < 8 {
    aad[i] = @as(u8, i)
    i = i + 1
  }
  var plain: [u8; 40] = undefined
  i = 0
  while i < 40 {
    plain[i] = @as(u8, i * 3)
    i = i + 1
  }

  var ct: [u8; 40] = undefined
  var tag: [u8; 16] = undefined
  let enc: u32 = chacha20.chacha20_poly1305_encrypt(
    @intFromPtr(&key), @intFromPtr(&nonce),
    @intFromPtr(&aad), 8,
    @intFromPtr(&plain), 40,
    @intFromPtr(&ct), @intFromPtr(&tag))

  var back: [u8; 40] = undefined
  let dec: u32 = chacha20.chacha20_poly1305_decrypt(
    @intFromPtr(&key), @intFromPtr(&nonce),
    @intFromPtr(&aad), 8,
    @intFromPtr(&ct), 40,
    @intFromPtr(&tag), @intFromPtr(&back))

  if enc == 0 and dec == 0 and bytes_equal(@intFromPtr(&plain), @intFromPtr(&back), 40) == 1 {
    foundation.serial_write_string("[crypto] chacha20-poly1305 round trip\n")
  }

  // Flip one ciphertext bit. The tag must no longer verify — an AEAD that
  // decrypts this anyway is worse than no AEAD, because callers trust it.
  ct[7] = ct[7] ^ 0x01
  let forged: u32 = chacha20.chacha20_poly1305_decrypt(
    @intFromPtr(&key), @intFromPtr(&nonce),
    @intFromPtr(&aad), 8,
    @intFromPtr(&ct), 40,
    @intFromPtr(&tag), @intFromPtr(&back))
  if forged != 0 {
    foundation.serial_write_string("[crypto] tampered ciphertext refused\n")
  }
}

// ============================================================================
// BLAKE2s — RFC 7693 Appendix B
// ============================================================================
fn test_blake2s() {
  // "abc"
  var msg: [u8; 3] = undefined
  msg[0] = 97
  msg[1] = 98
  msg[2] = 99

  var out: [u8; 32] = undefined
  blake2s.blake2s(@intFromPtr(&out), @intFromPtr(&msg), 3)

  var want: [u8; 32] = undefined
  want[0] = 0x50
  want[1] = 0x8C
  want[2] = 0x5E
  want[3] = 0x8C
  want[4] = 0x32
  want[5] = 0x7C
  want[6] = 0x14
  want[7] = 0xE2
  want[8] = 0xE1
  want[9] = 0xA7
  want[10] = 0x2B
  want[11] = 0xA3
  want[12] = 0x4E
  want[13] = 0xEB
  want[14] = 0x45
  want[15] = 0x2F
  want[16] = 0x37
  want[17] = 0x45
  want[18] = 0x8B
  want[19] = 0x20
  want[20] = 0x9E
  want[21] = 0xD6
  want[22] = 0x3A
  want[23] = 0x29
  want[24] = 0x4D
  want[25] = 0x99
  want[26] = 0x9B
  want[27] = 0x4C
  want[28] = 0x86
  want[29] = 0x67
  want[30] = 0x59
  want[31] = 0x82

  if bytes_equal(@intFromPtr(&out), @intFromPtr(&want), 32) == 1 {
    foundation.serial_write_string("[crypto] blake2s digest matches RFC 7693\n")
  }
}

// ============================================================================
// SHA-256 — FIPS 180-4 / RFC 6234, the one-block "abc" vector
//
// Not part of STUB(S5): sha256.home was already written. It is tested here
// because it reads its round constants from a module-level const table, and
// until the compiler emitted those tables as data they read as zeros — so
// this file had been computing confidently wrong digests, and the suite that
// "passed" it only checked the file existed.
// ============================================================================
fn test_sha256() {
  var msg: [u8; 3] = undefined
  msg[0] = 97
  msg[1] = 98
  msg[2] = 99

  // sha256_hash() refuses to run before sha256_init(), so the boot path has
  // to initialise it the same way any other caller would.
  sha256.sha256_init()

  var out: [u8; 32] = undefined
  sha256.sha256_hash(@intFromPtr(&msg), 3, @intFromPtr(&out))

  var want: [u8; 32] = undefined
  want[0] = 0xBA
  want[1] = 0x78
  want[2] = 0x16
  want[3] = 0xBF
  want[4] = 0x8F
  want[5] = 0x01
  want[6] = 0xCF
  want[7] = 0xEA
  want[8] = 0x41
  want[9] = 0x41
  want[10] = 0x40
  want[11] = 0xDE
  want[12] = 0x5D
  want[13] = 0xAE
  want[14] = 0x22
  want[15] = 0x23
  want[16] = 0xB0
  want[17] = 0x03
  want[18] = 0x61
  want[19] = 0xA3
  want[20] = 0x96
  want[21] = 0x17
  want[22] = 0x7A
  want[23] = 0x9C
  want[24] = 0xB4
  want[25] = 0x10
  want[26] = 0xFF
  want[27] = 0x61
  want[28] = 0xF2
  want[29] = 0x00
  want[30] = 0x15
  want[31] = 0xAD

  if bytes_equal(@intFromPtr(&out), @intFromPtr(&want), 32) == 1 {
    foundation.serial_write_string("[crypto] sha256 digest matches FIPS 180-4\n")
  } else {
    foundation.serial_write_string("[DBG sha] got ")
    var j: u32 = 0
    while j < 32 {
      foundation.serial_write_hex_byte(out[j])
      j = j + 1
    }
    foundation.serial_write_string("\n")
  }
}

export fn crypto_selftest() {
  test_chacha20()
  test_poly1305()
  test_aead()
  test_blake2s()
  test_sha256()
}
