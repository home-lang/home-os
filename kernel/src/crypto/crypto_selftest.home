  want_m2[25] = 0xC1
  want_m2[26] = 0x81
  want_m2[27] = 0x14
  want_m2[28] = 0x35
  want_m2[29] = 0x1A
  want_m2[30] = 0x61
  want_m2[31] = 0x67
  want_m2[32] = 0xDC
  want_m2[33] = 0x4B
  want_m2[34] = 0xDD
  want_m2[35] = 0xDF
  want_m2[36] = 0xCB
  want_m2[37] = 0x6D
  want_m2[38] = 0x19
  want_m2[39] = 0xEF
  want_m2[40] = 0x61
  want_m2[41] = 0xA0
  want_m2[42] = 0x6D
  want_m2[43] = 0xB9
  want_m2[44] = 0xF4
  want_m2[45] = 0xB4
  want_m2[46] = 0x12
  want_m2[47] = 0xBD
  want_m2[48] = 0x4D
  want_m2[49] = 0x35
  want_m2[50] = 0x98
  want_m2[51] = 0x6C
  want_m2[52] = 0x56
  want_m2[53] = 0x4E
  want_m2[54] = 0xF7
  want_m2[55] = 0xAC
  want_m2[56] = 0xF9
  want_m2[57] = 0xEB
  want_m2[58] = 0x02
  want_m2[59] = 0x4B
  want_m2[60] = 0x16
  want_m2[61] = 0x03
  want_m2[62] = 0x0B
  want_m2[63] = 0x3D
  if bytes_equal(@intFromPtr(&m2), @intFromPtr(&want_m2), 64) == 0 {
    foundation.serial_write_string("[crypto] srp server proof MISMATCH\n")
    return
  }

  foundation.serial_write_string("[crypto] srp-6a exchange matches the fixed vector\n")
}

// ============================================================================
// X25519 — RFC 7748 §5.2, the first test vector
// ============================================================================
fn test_x25519() {
  // scalar a546e36bf0527c9d3b16154b82465edd62144c0ac1fc5a18506a2244ba449ac4
  var scalar: [u8; 32] = undefined
  scalar[0] = 0xA5
