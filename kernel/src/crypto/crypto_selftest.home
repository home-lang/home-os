  msg[31] = 111
  msg[32] = 117
  msg[33] = 112

  var tag: [u8; 16] = undefined
  poly1305.poly1305_mac(@intFromPtr(&tag), @intFromPtr(&key), @intFromPtr(&msg), 34)

  var want: [u8; 16] = undefined
  want[0] = 0xA8
