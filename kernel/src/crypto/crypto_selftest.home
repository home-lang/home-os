// ============================================================================
// Ed25519 — RFC 8032 §7.1, TEST 1 (the empty message).
//
// Checked end to end rather than in pieces: the public key must come out of
// the seed, the signature must match byte for byte, the signature must
// verify, and a tampered signature must not. A wrong base point or a scalar
// reduced incorrectly still produces a self-consistent sign/verify pair, so
// only the fixed vector catches it.
// ============================================================================
fn test_ed25519() {
  var seed: [u8; 32] = undefined
  seed[0] = 0x9D
  seed[1] = 0x61
  seed[2] = 0xB1
  seed[3] = 0x9D
  seed[4] = 0xEF
  seed[5] = 0xFD
  seed[6] = 0x5A
  seed[7] = 0x60
  seed[8] = 0xBA
  seed[9] = 0x84
  seed[10] = 0x4A
  seed[11] = 0xF4
  seed[12] = 0x92
  seed[13] = 0xEC
  seed[14] = 0x2C
  seed[15] = 0xC4
  seed[16] = 0x44
  seed[17] = 0x49
  seed[18] = 0xC5
  seed[19] = 0x69
  seed[20] = 0x7B
  seed[21] = 0x32
  seed[22] = 0x69
  seed[23] = 0x19
  seed[24] = 0x70
  seed[25] = 0x3B
  seed[26] = 0xAC
  seed[27] = 0x03
  seed[28] = 0x1C
  seed[29] = 0xAE
  seed[30] = 0x7F
  seed[31] = 0x60

  var want_pk: [u8; 32] = undefined
  want_pk[0] = 0xD7
  want_pk[1] = 0x5A
  want_pk[2] = 0x98
  want_pk[3] = 0x01
  want_pk[4] = 0x82
  want_pk[5] = 0xB1
  want_pk[6] = 0x0A
  want_pk[7] = 0xB7
  want_pk[8] = 0xD5
  want_pk[9] = 0x4B
  want_pk[10] = 0xFE
  want_pk[11] = 0xD3
  want_pk[12] = 0xC9
  want_pk[13] = 0x64
  want_pk[14] = 0x07
  want_pk[15] = 0x3A
  want_pk[16] = 0x0E
  want_pk[17] = 0xE1
  want_pk[18] = 0x72
  want_pk[19] = 0xF3
  want_pk[20] = 0xDA
  want_pk[21] = 0xA6
  want_pk[22] = 0x23
  want_pk[23] = 0x25
  want_pk[24] = 0xAF
  want_pk[25] = 0x02
  want_pk[26] = 0x1A
  want_pk[27] = 0x68
  want_pk[28] = 0xF7
  want_pk[29] = 0x07
  want_pk[30] = 0x51
  want_pk[31] = 0x1A

  var want_sig: [u8; 64] = undefined
  want_sig[0] = 0xE5
  want_sig[1] = 0x56
  want_sig[2] = 0x43
  want_sig[3] = 0x00
  want_sig[4] = 0xC3
  want_sig[5] = 0x60
  want_sig[6] = 0xAC
  want_sig[7] = 0x72
  want_sig[8] = 0x90
  want_sig[9] = 0x86
  want_sig[10] = 0xE2
  want_sig[11] = 0xCC
  want_sig[12] = 0x80
  want_sig[13] = 0x6E
  want_sig[14] = 0x82
  want_sig[15] = 0x8A
  want_sig[16] = 0x84
  want_sig[17] = 0x87
  want_sig[18] = 0x7F
  want_sig[19] = 0x1E
  want_sig[20] = 0xB8
  want_sig[21] = 0xE5
  want_sig[22] = 0xD9
  want_sig[23] = 0x74
  want_sig[24] = 0xD8
  want_sig[25] = 0x73
  want_sig[26] = 0xE0
  want_sig[27] = 0x65
  want_sig[28] = 0x22
  want_sig[29] = 0x49
  want_sig[30] = 0x01
  want_sig[31] = 0x55
  want_sig[32] = 0x5F
  want_sig[33] = 0xB8
  want_sig[34] = 0x82
  want_sig[35] = 0x15
  want_sig[36] = 0x90
  want_sig[37] = 0xA3
  want_sig[38] = 0x3B
  want_sig[39] = 0xAC
  want_sig[40] = 0xC6
  want_sig[41] = 0x1E
  want_sig[42] = 0x39
  want_sig[43] = 0x70
  want_sig[44] = 0x1C
  want_sig[45] = 0xF9
  want_sig[46] = 0xB4
  want_sig[47] = 0x6B
  want_sig[48] = 0xD2
  want_sig[49] = 0x5B
  want_sig[50] = 0xF5
  want_sig[51] = 0xF0
  want_sig[52] = 0x59
  want_sig[53] = 0x5B
  want_sig[54] = 0xBE
  want_sig[55] = 0x24
  want_sig[56] = 0x65
  want_sig[57] = 0x51
  want_sig[58] = 0x41
  want_sig[59] = 0x43
  want_sig[60] = 0x8E
  want_sig[61] = 0x7A
  want_sig[62] = 0x10
  want_sig[63] = 0x0B

  var pk: [u8; 32] = undefined
  ed25519.ed25519_public_from_seed(@intFromPtr(&seed), @intFromPtr(&pk))
  if bytes_equal(@intFromPtr(&pk), @intFromPtr(&want_pk), 32) == 0 {
    foundation.serial_write_string("[crypto] ed25519 public key MISMATCH\n")
    return
  }

  var msg: [u8; 1] = undefined
  msg[0] = 0

  var sig: [u8; 64] = undefined
  ed25519.ed25519_sign(@intFromPtr(&seed), @intFromPtr(&pk), @intFromPtr(&msg), 0,
                       @intFromPtr(&sig))
  if bytes_equal(@intFromPtr(&sig), @intFromPtr(&want_sig), 64) == 0 {
    foundation.serial_write_string("[crypto] ed25519 signature MISMATCH\n")
    return
  }

  if ed25519.ed25519_verify(@intFromPtr(&pk), @intFromPtr(&msg), 0, @intFromPtr(&sig)) != 1 {
    foundation.serial_write_string("[crypto] ed25519 verify REJECTED a good signature\n")
    return
  }

  // A signature that verifies no matter what it says is not a signature.
  sig[0] = sig[0] ^ 0x01
  if ed25519.ed25519_verify(@intFromPtr(&pk), @intFromPtr(&msg), 0, @intFromPtr(&sig)) != 0 {
    foundation.serial_write_string("[crypto] ed25519 verify ACCEPTED a forged signature\n")
    return
  }

  foundation.serial_write_string("[crypto] ed25519 signs and verifies RFC 8032 test 1\n")
}

// ============================================================================
// Montgomery modular exponentiation, against the SRP group.
//
// 5^65537 mod N compared by its digest rather than by 384 hardcoded bytes.
// A wrong n0inv, a mis-sized R^2, or a dropped carry in CIOS all produce a
// result that is wrong everywhere rather than nearly right, so the digest is
// as discriminating as the value and far easier to read.
// ============================================================================
fn test_bignum_modexp() {
  // The group lives in srp.home and is loaded by srp_init. Reading it before
  // that leaves the modulus zero, which makes every exponentiation return zero
  // and looks exactly like broken arithmetic.
  srp.srp_init()

  var n: bignum.BigNum
  var g: bignum.BigNum
  srp.srp_modulus(&n)
  srp.srp_generator(&g)

  var exponent: [u8; 3] = undefined
  exponent[0] = 0x01
  exponent[1] = 0x00
  exponent[2] = 0x01

  var result: bignum.BigNum
  bignum.bn_mod_exp(&result, &g, @intFromPtr(&exponent), 3, &n)

  var wide: [u8; 384] = undefined
  bignum.bn_to_bytes(&result, @intFromPtr(&wide), 384)

  var got: [u8; 64] = undefined
  sha512.sha512_hash(@intFromPtr(&wide), 384, @intFromPtr(&got))

  var want: [u8; 64] = undefined
  want[0] = 0x51
  want[1] = 0xBF
  want[2] = 0x94
  want[3] = 0x95
  want[4] = 0x8B
  want[5] = 0xFB
  want[6] = 0xA2
  want[7] = 0xE8
  want[8] = 0xFD
  want[9] = 0x8C
  want[10] = 0x4F
  want[11] = 0xA3
  want[12] = 0x27
  want[13] = 0x27
  want[14] = 0xC0
  want[15] = 0x63
  want[16] = 0xFC
  want[17] = 0xAB
  want[18] = 0xE5
  want[19] = 0xBD
  want[20] = 0x78
  want[21] = 0x01
  want[22] = 0xBE
  want[23] = 0xF9
  want[24] = 0xF0
  want[25] = 0x07
  want[26] = 0x3E
  want[27] = 0xEE
  want[28] = 0xED
  want[29] = 0x53
  want[30] = 0x79
  want[31] = 0xA6
  want[32] = 0xDE
  want[33] = 0x18
  want[34] = 0xE6
  want[35] = 0x44
  want[36] = 0x07
  want[37] = 0xEF
  want[38] = 0xDA
  want[39] = 0x9C
  want[40] = 0x78
  want[41] = 0x36
  want[42] = 0x31
  want[43] = 0xEE
  want[44] = 0x22
  want[45] = 0xB3
  want[46] = 0x32
  want[47] = 0x42
  want[48] = 0x4B
  want[49] = 0xBE
  want[50] = 0x1A
  want[51] = 0xDC
  want[52] = 0x50
  want[53] = 0x53
  want[54] = 0xAF
  want[55] = 0x1F
  want[56] = 0xB5
  want[57] = 0xEF
  want[58] = 0x81
  want[59] = 0x39
  want[60] = 0xC9
  want[61] = 0x42
  want[62] = 0x88
  want[63] = 0x12

  if bytes_equal(@intFromPtr(&got), @intFromPtr(&want), 64) == 1 {
    foundation.serial_write_string("[crypto] bignum 5^65537 mod N matches\n")
  } else {
    foundation.serial_write_string("[crypto] bignum modexp MISMATCH\n")
  }
}

// ============================================================================
// SRP-6a, a whole exchange against a fixed vector.
//
// Both private exponents are fixed, so every derived value has one right
// answer: the verifier, our public B, the session key, and both proofs. A test
// that only ran a client and a server against each other would pass just as
// happily if both shared the same misreading of PAD() or of the M1 ordering.
// ============================================================================
fn test_srp() {
  srp.srp_init()

  var user: [u8; 10] = undefined
  user[0] = 'P'
  user[1] = 'a'
  user[2] = 'i'
  user[3] = 'r'
  user[4] = '-'
  user[5] = 'S'
  user[6] = 'e'
  user[7] = 't'
  user[8] = 'u'
  user[9] = 'p'

  var pass: [u8; 8] = undefined
  pass[0] = '1'
  pass[1] = '2'
  pass[2] = '3'
  pass[3] = '4'
  pass[4] = '5'
  pass[5] = '6'
  pass[6] = '7'
  pass[7] = '8'

  var salt: [u8; 16] = undefined
  var i: u32 = 0
  while i < 16 {
    salt[i] = @as(u8, i)
    i = i + 1
  }

  srp.srp_set_credentials(@intFromPtr(&user), 10, @intFromPtr(&pass), 8,
                          @intFromPtr(&salt))

  // v = g^x mod N
  var v: bignum.BigNum
  srp.srp_verifier(&v)
  var wide: [u8; 384] = undefined
  bignum.bn_to_bytes(&v, @intFromPtr(&wide), 384)
  var got: [u8; 64] = undefined
  sha512.sha512_hash(@intFromPtr(&wide), 384, @intFromPtr(&got))
  var want_v: [u8; 64] = undefined
  want_v[0] = 0xD2
  want_v[1] = 0x1D
  want_v[2] = 0xC8
  want_v[3] = 0x92
  want_v[4] = 0x64
  want_v[5] = 0x5B
  want_v[6] = 0x81
  want_v[7] = 0x5C
  want_v[8] = 0x59
  want_v[9] = 0x38
  want_v[10] = 0x39
  want_v[11] = 0x36
  want_v[12] = 0x06
  want_v[13] = 0xAB
  want_v[14] = 0x33
  want_v[15] = 0xBF
  want_v[16] = 0x2F
  want_v[17] = 0x1B
  want_v[18] = 0x13
  want_v[19] = 0xA3
  want_v[20] = 0x07
  want_v[21] = 0xE6
  want_v[22] = 0x91
  want_v[23] = 0xB4
  want_v[24] = 0xE6
  want_v[25] = 0x0B
  want_v[26] = 0x82
  want_v[27] = 0x51
  want_v[28] = 0x3A
  want_v[29] = 0x7F
  want_v[30] = 0x81
  want_v[31] = 0x84
  want_v[32] = 0xBF
  want_v[33] = 0xAE
  want_v[34] = 0x27
  want_v[35] = 0x51
  want_v[36] = 0x79
  want_v[37] = 0xBD
  want_v[38] = 0x9C
  want_v[39] = 0xBE
  want_v[40] = 0x54
  want_v[41] = 0x58
  want_v[42] = 0x04
  want_v[43] = 0xB2
  want_v[44] = 0xEC
  want_v[45] = 0xD2
  want_v[46] = 0x45
  want_v[47] = 0x50
  want_v[48] = 0xDD
  want_v[49] = 0x03
  want_v[50] = 0x8F
  want_v[51] = 0xAD
  want_v[52] = 0xC1
  want_v[53] = 0x91
  want_v[54] = 0x99
  want_v[55] = 0x0C
  want_v[56] = 0x7E
  want_v[57] = 0x16
  want_v[58] = 0xD3
  want_v[59] = 0x70
  want_v[60] = 0x70
  want_v[61] = 0x5E
  want_v[62] = 0x75
  want_v[63] = 0xC6
  if bytes_equal(@intFromPtr(&got), @intFromPtr(&want_v), 64) == 0 {
    foundation.serial_write_string("[crypto] srp verifier MISMATCH\n")
    return
  }

  // B = (k*v + g^b) mod N, with b fixed at 0x40..0x5f.
  var b_private: [u8; 32] = undefined
  i = 0
  while i < 32 {
    b_private[i] = @as(u8, 0x40 + i)
    i = i + 1
  }
  var b_public: [u8; 384] = undefined
  srp.srp_generate_public_with(@intFromPtr(&b_private), @intFromPtr(&b_public))
  sha512.sha512_hash(@intFromPtr(&b_public), 384, @intFromPtr(&got))
  var want_b: [u8; 64] = undefined
  want_b[0] = 0x0D
  want_b[1] = 0x18
  want_b[2] = 0xA0
  want_b[3] = 0x60
  want_b[4] = 0x7F
  want_b[5] = 0x23
  want_b[6] = 0xED
  want_b[7] = 0x8E
  want_b[8] = 0xC9
  want_b[9] = 0xD0
  want_b[10] = 0x70
  want_b[11] = 0x32
  want_b[12] = 0x1E
  want_b[13] = 0xE5
  want_b[14] = 0x34
  want_b[15] = 0xBE
  want_b[16] = 0x97
  want_b[17] = 0x95
  want_b[18] = 0x8B
  want_b[19] = 0x62
  want_b[20] = 0xCC
  want_b[21] = 0x53
  want_b[22] = 0x24
  want_b[23] = 0x9C
  want_b[24] = 0x49
  want_b[25] = 0x83
  want_b[26] = 0x60
  want_b[27] = 0xE0
  want_b[28] = 0x37
  want_b[29] = 0x86
  want_b[30] = 0xAC
  want_b[31] = 0x64
  want_b[32] = 0x37
  want_b[33] = 0x6D
  want_b[34] = 0x5A
  want_b[35] = 0xD5
  want_b[36] = 0x6E
  want_b[37] = 0xF2
  want_b[38] = 0x4C
  want_b[39] = 0xCD
  want_b[40] = 0x0E
  want_b[41] = 0x2D
  want_b[42] = 0x96
  want_b[43] = 0x2B
  want_b[44] = 0x02
  want_b[45] = 0xFE
  want_b[46] = 0x1C
  want_b[47] = 0x54
  want_b[48] = 0xA7
  want_b[49] = 0x85
  want_b[50] = 0x57
  want_b[51] = 0x97
  want_b[52] = 0x2B
  want_b[53] = 0x03
  want_b[54] = 0x84
  want_b[55] = 0x64
  want_b[56] = 0xFE
  want_b[57] = 0x6D
  want_b[58] = 0x55
  want_b[59] = 0xAE
  want_b[60] = 0x73
  want_b[61] = 0x7D
  want_b[62] = 0xC5
  want_b[63] = 0xF3
  if bytes_equal(@intFromPtr(&got), @intFromPtr(&want_b), 64) == 0 {
    foundation.serial_write_string("[crypto] srp public B MISMATCH\n")
    return
  }

  // The client's A = g^a mod N, with a fixed at 0x80..0x9f. Computed here with
  // the same bignum, which test_bignum_modexp has already checked against a
  // fixed answer.
  var a_private: [u8; 32] = undefined
  i = 0
  while i < 32 {
    a_private[i] = @as(u8, 0x80 + i)
    i = i + 1
  }
  var n: bignum.BigNum
  var g: bignum.BigNum
  srp.srp_modulus(&n)
  srp.srp_generator(&g)
  var big_a: bignum.BigNum
  bignum.bn_mod_exp(&big_a, &g, @intFromPtr(&a_private), 32, &n)
  var a_public: [u8; 384] = undefined
  bignum.bn_to_bytes(&big_a, @intFromPtr(&a_public), 384)

  if srp.srp_accept_client_public(@intFromPtr(&a_public)) == 0 {
    foundation.serial_write_string("[crypto] srp refused a valid client public\n")
    return
  }

  var session: [u8; 64] = undefined
  srp.srp_session_key(@intFromPtr(&session))
  var want_k: [u8; 64] = undefined
  want_k[0] = 0x07
  want_k[1] = 0xE2
  want_k[2] = 0x6C
  want_k[3] = 0x3E
  want_k[4] = 0xDB
  want_k[5] = 0x07
  want_k[6] = 0xB4
  want_k[7] = 0x49
  want_k[8] = 0xA9
  want_k[9] = 0xC9
  want_k[10] = 0x2E
  want_k[11] = 0x96
  want_k[12] = 0x02
  want_k[13] = 0x74
  want_k[14] = 0x0A
  want_k[15] = 0x98
  want_k[16] = 0xC0
  want_k[17] = 0xE4
  want_k[18] = 0x1F
  want_k[19] = 0x5C
  want_k[20] = 0xF9
  want_k[21] = 0x42
  want_k[22] = 0xB1
  want_k[23] = 0x00
  want_k[24] = 0xEB
  want_k[25] = 0xC6
  want_k[26] = 0x4B
  want_k[27] = 0xF5
  want_k[28] = 0xD9
  want_k[29] = 0xEB
  want_k[30] = 0xC9
  want_k[31] = 0x82
  want_k[32] = 0xD0
  want_k[33] = 0xB6
  want_k[34] = 0xA3
  want_k[35] = 0xBC
  want_k[36] = 0xC6
  want_k[37] = 0x2A
  want_k[38] = 0x1A
  want_k[39] = 0x08
  want_k[40] = 0xF1
  want_k[41] = 0x6C
