  want_m1[34] = 0xE8
  want_m1[35] = 0xA9
  want_m1[36] = 0x35
  want_m1[37] = 0xA7
  want_m1[38] = 0xA5
  want_m1[39] = 0x49
  want_m1[40] = 0xB6
  want_m1[41] = 0x09
  want_m1[42] = 0x8E
  want_m1[43] = 0x76
  want_m1[44] = 0xFA
  want_m1[45] = 0x3C
  want_m1[46] = 0xE8
  want_m1[47] = 0xE1
  want_m1[48] = 0x0F
  want_m1[49] = 0xBB
  want_m1[50] = 0x55
  want_m1[51] = 0x5C
  want_m1[52] = 0x92
  want_m1[53] = 0xEF
  want_m1[54] = 0x3A
  want_m1[55] = 0x00
  want_m1[56] = 0xDB
  want_m1[57] = 0xD6
  want_m1[58] = 0xD2
  want_m1[59] = 0x4E
  want_m1[60] = 0x27
  want_m1[61] = 0x2F
  want_m1[62] = 0x71
  want_m1[63] = 0x9F
  if srp.srp_verify_client_proof(@intFromPtr(&user), 10, @intFromPtr(&want_m1)) != 1 {
    foundation.serial_write_string("[crypto] srp rejected a valid client proof\n")
    return
  }

  var forged: [u8; 64] = undefined
  i = 0
  while i < 64 {
    forged[i] = want_m1[i]
    i = i + 1
  }
  forged[0] = forged[0] ^ 0x01
  if srp.srp_verify_client_proof(@intFromPtr(&user), 10, @intFromPtr(&forged)) != 0 {
    foundation.serial_write_string("[crypto] srp ACCEPTED a forged client proof\n")
    return
  }

  // And our proof back must match too.
  srp.srp_verify_client_proof(@intFromPtr(&user), 10, @intFromPtr(&want_m1))
  var m2: [u8; 64] = undefined
  srp.srp_compute_server_proof(@intFromPtr(&m2))
  var want_m2: [u8; 64] = undefined
  want_m2[0] = 0xC9
  want_m2[1] = 0xD0
  want_m2[2] = 0xAA
