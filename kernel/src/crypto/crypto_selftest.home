  key[27] = 0xAF
  key[28] = 0x41
  key[29] = 0x49
  key[30] = 0xF5
  key[31] = 0x1B

  // "Cryptographic Forum Research Group"
  var msg: [u8; 34] = undefined
  msg[0] = 67
  msg[1] = 114
  msg[2] = 121
  msg[3] = 112
  msg[4] = 116
  msg[5] = 111
