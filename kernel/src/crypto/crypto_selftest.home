  var out: [u8; 32] = undefined
  curve25519.curve25519(@intFromPtr(&out), @intFromPtr(&scalar), @intFromPtr(&point))

  // c3da55379de9c6908e94ea4df28d084f32eccf03491c71f754b4075577a28552
  var want: [u8; 32] = undefined
  want[0] = 0xC3
  want[1] = 0xDA
