// ============================================================================
// RSA — a known-answer test
//
// rsa_sign and rsa_verify had no test of any kind: no vector, no selftest, no
// milestone. They are the only asymmetric primitive in the tree and the thing
// a signed package would rest on, so "it looks implemented" is not enough.
//
// The key and signature below were generated with a script whose parameters
// are recorded in the commit that added them: a 512-bit key (seeded, so it is
// reproducible) and a PKCS#1 v1.5 SHA-256 signature over the message
// "home-os pantry package", computed independently of this implementation.
// 512 bits is a correctness vector, not a security claim — it is small so the
// modular exponentiation finishes quickly at boot.
// ============================================================================

const RSA_KAT_MESSAGE_LEN: u32 = 22
var rsa_kat_message: [u8; 22] = undefined
var rsa_kat_n: [u8; 64] = undefined
var rsa_kat_d: [u8; 64] = undefined
var rsa_kat_sig: [u8; 64] = undefined
var rsa_kat_out: [u8; 64] = undefined

// The keys live here rather than in test_rsa's frame. An RsaPrivateKey is
// seven BigInts — about 3.6 KB — and the kernel stack is 16 KB in total, which
// rsa_sign and the modular exponentiation beneath it also draw on.
var rsa_kat_pub: rsa.RsaPublicKey = undefined
var rsa_kat_priv: rsa.RsaPrivateKey = undefined

fn rsa_kat_init() {
  rsa_kat_message[0] = 104
