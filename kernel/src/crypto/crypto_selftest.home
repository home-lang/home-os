  want_k[43] = 0x57
  want_k[44] = 0x8E
  want_k[45] = 0x6D
  want_k[46] = 0xA4
  want_k[47] = 0x64
  want_k[48] = 0xA7
  want_k[49] = 0x4C
  want_k[50] = 0x3C
  want_k[51] = 0x90
  want_k[52] = 0x81
  want_k[53] = 0x9A
  want_k[54] = 0xD7
  want_k[55] = 0x05
  want_k[56] = 0x47
  want_k[57] = 0x90
  want_k[58] = 0x94
  want_k[59] = 0x5E
  want_k[60] = 0x7B
  want_k[61] = 0x82
  want_k[62] = 0xEC
  want_k[63] = 0xF4
  if bytes_equal(@intFromPtr(&session), @intFromPtr(&want_k), 64) == 0 {
    foundation.serial_write_string("[crypto] srp session key MISMATCH\n")
    return
  }

  // The client's proof must be accepted, and a wrong one must not be.
  var want_m1: [u8; 64] = undefined
  want_m1[0] = 0xB4
  want_m1[1] = 0x68
  want_m1[2] = 0x41
  want_m1[3] = 0x65
  want_m1[4] = 0xC3
  want_m1[5] = 0x33
  want_m1[6] = 0x45
  want_m1[7] = 0x5B
  want_m1[8] = 0xDD
  want_m1[9] = 0x21
  want_m1[10] = 0x66
  want_m1[11] = 0xB8
  want_m1[12] = 0xE7
  want_m1[13] = 0x0C
  want_m1[14] = 0xF3
  want_m1[15] = 0x50
  want_m1[16] = 0xFF
  want_m1[17] = 0x1B
  want_m1[18] = 0xD1
  want_m1[19] = 0x3D
  want_m1[20] = 0xF1
  want_m1[21] = 0x90
