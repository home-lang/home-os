// home-os Kernel - ChaCha20-Poly1305 AEAD
//
// STUB(S5): ChaCha20 stream cipher, RFC 8439 is not implemented. This primitive fails closed —
// it returns zeros or an error rather than a wrong-but-plausible result.
// Package signing needs it, so it blocks the Phase 3 pantry-local-install
// gate, and WireGuard later. See MASTER_PLAN §7.
// TODO(#11): This is a stub. Implement ChaCha20 stream cipher and
// Poly1305-AEAD per RFC 8439. Currently returns failure for all
// operations so callers degrade gracefully instead of corrupting data.

import "../core/foundation.home" as foundation

// AEAD output: ciphertext bytes followed by 16-byte authentication tag.
// Returns 0 on success, non-zero on failure.
export fn chacha20_poly1305_encrypt(
  key: u64,
  nonce: u64,
  aad: u64,
  aad_len: u32,
  plaintext: u64,
  plaintext_len: u32,
  ciphertext: u64,
  tag: u64
): u32 {
  // TODO(#11): real implementation. Refuse so callers don't think
  // they got authenticated ciphertext.
  foundation.serial_write_string("[chacha20] encrypt stub invoked\n")
  return 1
}

// Returns 0 on success (tag verified, plaintext written), non-zero on failure.
export fn chacha20_poly1305_decrypt(
  key: u64,
  nonce: u64,
  aad: u64,
  aad_len: u32,
  ciphertext: u64,
  ciphertext_len: u32,
  tag: u64,
  plaintext: u64
): u32 {
  // TODO(#11): real implementation. Refuse so callers don't accept
  // unauthenticated data.
  foundation.serial_write_string("[chacha20] decrypt stub invoked\n")
  return 1
}
