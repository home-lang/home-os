// home-os Kernel - Curve25519 ECDH
//
// STUB(S5): X25519 key agreement, RFC 7748 is not implemented. This primitive fails closed —
// it returns zeros or an error rather than a wrong-but-plausible result.
// Package signing needs it, so it blocks the Phase 3 pantry-local-install
// gate, and WireGuard later. See MASTER_PLAN §7.
// TODO(#11): This is a stub. Implement X25519 per RFC 7748. Currently
// produces an all-zero output so handshakes fail closed instead of
// silently negotiating bogus keys.

import "../core/foundation.home" as foundation

// Compute the X25519 public key (or shared secret with `curve25519`).
// `out` and `scalar` are 32-byte buffers; `base` is the basepoint
// implied by `curve25519_base` (= 9).
export fn curve25519_base(out: u64, scalar: u64) {
  // TODO(#11): real implementation. Zero the output to make callers
  // observably fail rather than treat a stubbed key as a real one.
  var i: u32 = 0
  while i < 32 {
    @as(*u8, @ptrFromInt(out + i)).* = 0
    i = i + 1
  }
  foundation.serial_write_string("[curve25519] base stub invoked\n")
}

export fn curve25519(out: u64, scalar: u64, point: u64) {
  // TODO(#11): real implementation.
  var i: u32 = 0
  while i < 32 {
    @as(*u8, @ptrFromInt(out + i)).* = 0
    i = i + 1
  }
  foundation.serial_write_string("[curve25519] scalarmult stub invoked\n")
}
