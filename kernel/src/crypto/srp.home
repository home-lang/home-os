// home-os SRP-6a, accessory side
//
// The half of pair-setup that proves a controller knows the PIN without the
// PIN crossing the wire, and leaves both ends holding the same session key.
// RFC 5054 group 15 (3072-bit, g = 5) with SHA-512, which is what
// HomeKit-derived AirPlay pairing specifies.
//
// We are always the server here: an AirPlay receiver is the thing being paired
// *to*. The client half is not implemented because nothing in this OS needs to
// pair itself to someone else's accessory.
//
//   x  = H(salt || H(user || ":" || pass))
//   v  = g^x mod N                          the verifier, derived from the PIN
//   B  = (k*v + g^b) mod N                  our public value, k = H(N || PAD(g))
//   u  = H(PAD(A) || PAD(B))
//   S  = (A * v^u)^b mod N                  the shared secret
//   K  = H(S)
//   M1 = H(H(N) xor H(g) || H(user) || salt || A || B || K)   the client proves
//   M2 = H(A || M1 || K)                                      we prove back
//
// PAD() means left-padded to the width of N. Getting that wrong produces a
// proof the other end cannot reproduce, and the failure looks like a wrong
// PIN rather than like a bug, so every value hashed below goes through
// bn_to_bytes at the full 384 bytes.

import "../core/foundation.home" as foundation
import "bignum.home" as bn
import "sha512.home" as sha512
import "../security/random.home" as random

export const SRP_MODULUS_BYTES: u32 = 384
export const SRP_HASH_BYTES: u32 = 64
const SRP_PRIVATE_BYTES: u32 = 32

struct SrpState {
  ready: u32,
  n: bn.BigNum,
  g: bn.BigNum,
  k: bn.BigNum,
  v: bn.BigNum,
  b_private: [u8; 32],
  big_b: bn.BigNum,
  big_a: bn.BigNum,
  salt: [u8; 16],
  session_key: [u8; 64],
  m1: [u8; 64]
}

var srp: SrpState = undefined

// RFC 5054 group 15. Written as bytes rather than limbs so it can be read
// against the RFC without mentally regrouping it.
const N_BYTES: [u8; 384] = [
  0xFF,0xFF,0xFF,0xFF,0xFF,0xFF,0xFF,0xFF,0xC9,0x0F,0xDA,0xA2,0x21,0x68,0xC2,0x34,
  0xC4,0xC6,0x62,0x8B,0x80,0xDC,0x1C,0xD1,0x29,0x02,0x4E,0x08,0x8A,0x67,0xCC,0x74,
  0x02,0x0B,0xBE,0xA6,0x3B,0x13,0x9B,0x22,0x51,0x4A,0x08,0x79,0x8E,0x34,0x04,0xDD,
  0xEF,0x95,0x19,0xB3,0xCD,0x3A,0x43,0x1B,0x30,0x2B,0x0A,0x6D,0xF2,0x5F,0x14,0x37,
  0x4F,0xE1,0x35,0x6D,0x6D,0x51,0xC2,0x45,0xE4,0x85,0xB5,0x76,0x62,0x5E,0x7E,0xC6,
  0xF4,0x4C,0x42,0xE9,0xA6,0x37,0xED,0x6B,0x0B,0xFF,0x5C,0xB6,0xF4,0x06,0xB7,0xED,
  0xEE,0x38,0x6B,0xFB,0x5A,0x89,0x9F,0xA5,0xAE,0x9F,0x24,0x11,0x7C,0x4B,0x1F,0xE6,
  0x49,0x28,0x66,0x51,0xEC,0xE4,0x5B,0x3D,0xC2,0x00,0x7C,0xB8,0xA1,0x63,0xBF,0x05,
  0x98,0xDA,0x48,0x36,0x1C,0x55,0xD3,0x9A,0x69,0x16,0x3F,0xA8,0xFD,0x24,0xCF,0x5F,
  0x83,0x65,0x5D,0x23,0xDC,0xA3,0xAD,0x96,0x1C,0x62,0xF3,0x56,0x20,0x85,0x52,0xBB,
  0x9E,0xD5,0x29,0x07,0x70,0x96,0x96,0x6D,0x67,0x0C,0x35,0x4E,0x4A,0xBC,0x98,0x04,
  0xF1,0x74,0x6C,0x08,0xCA,0x18,0x21,0x7C,0x32,0x90,0x5E,0x46,0x2E,0x36,0xCE,0x3B,
  0xE3,0x9E,0x77,0x2C,0x18,0x0E,0x86,0x03,0x9B,0x27,0x83,0xA2,0xEC,0x07,0xA2,0x8F,
  0xB5,0xC5,0x5D,0xF0,0x6F,0x4C,0x52,0xC9,0xDE,0x2B,0xCB,0xF6,0x95,0x58,0x17,0x18,
  0x39,0x95,0x49,0x7C,0xEA,0x95,0x6A,0xE5,0x15,0xD2,0x26,0x18,0x98,0xFA,0x05,0x10,
  0x15,0x72,0x8E,0x5A,0x8A,0xAA,0xC4,0x2D,0xAD,0x33,0x17,0x0D,0x04,0x50,0x7A,0x33,
  0xA8,0x55,0x21,0xAB,0xDF,0x1C,0xBA,0x64,0xEC,0xFB,0x85,0x04,0x58,0xDB,0xEF,0x0A,
  0x8A,0xEA,0x71,0x57,0x5D,0x06,0x0C,0x7D,0xB3,0x97,0x0F,0x85,0xA6,0xE1,0xE4,0xC7,
  0xAB,0xF5,0xAE,0x8C,0xDB,0x09,0x33,0xD7,0x1E,0x8C,0x94,0xE0,0x4A,0x25,0x61,0x9D,
  0xCE,0xE3,0xD2,0x26,0x1A,0xD2,0xEE,0x6B,0xF1,0x2F,0xFA,0x06,0xD9,0x8A,0x08,0x64,
  0xD8,0x76,0x02,0x73,0x3E,0xC8,0x6A,0x64,0x52,0x1F,0x2B,0x18,0x17,0x7B,0x20,0x0C,
  0xBB,0xE1,0x17,0x57,0x7A,0x61,0x5D,0x6C,0x77,0x09,0x88,0xC0,0xBA,0xD9,0x46,0xE2,
  0x08,0xE2,0x4F,0xA0,0x74,0xE5,0xAB,0x31,0x43,0xDB,0x5B,0xFC,0xE0,0xFD,0x10,0x8E,
  0x4B,0x82,0xD1,0x20,0xA9,0x3A,0xD2,0xCA,0xFF,0xFF,0xFF,0xFF,0xFF,0xFF,0xFF,0xFF
]

// ============================================================================
// Hash helpers
// ============================================================================

fn srp_hash_pair(a: u64, a_len: u32, b: u64, b_len: u32, out: u64) {
  var ctx: sha512.Sha512Context
  sha512.sha512_ctx_init(&ctx)
  if a_len > 0 { sha512.sha512_update(&ctx, @ptrFromInt(a), a_len) }
  if b_len > 0 { sha512.sha512_update(&ctx, @ptrFromInt(b), b_len) }
  sha512.sha512_final(&ctx, @ptrFromInt(out))
}

// ============================================================================
// Setup
// ============================================================================

// Load the group and derive k = H(N || PAD(g)). Done once; the group does not
// change between pairings.
export fn srp_init(): u32 {
  foundation.mem_set(&srp as *u8, 0, @sizeOf(SrpState))

  bn.bn_from_bytes(&srp.n, @intFromPtr(&N_BYTES), SRP_MODULUS_BYTES)
  bn.bn_from_u32(&srp.g, 5)

  // k = H(N || PAD(g)); g padded to the modulus width, not written as one byte.
  var g_padded: [u8; 384]
  bn.bn_to_bytes(&srp.g, @intFromPtr(&g_padded), SRP_MODULUS_BYTES)

  var k_digest: [u8; 64]
  srp_hash_pair(@intFromPtr(&N_BYTES), SRP_MODULUS_BYTES,
                @intFromPtr(&g_padded), SRP_MODULUS_BYTES,
                @intFromPtr(&k_digest))
  bn.bn_from_bytes(&srp.k, @intFromPtr(&k_digest), SRP_HASH_BYTES)

  srp.ready = 1
  return 1
}

// x = H(salt || H(user || ":" || pass)), then v = g^x mod N.
//
// The verifier is what the accessory stores instead of the PIN. Recomputing it
// per pairing is the honest thing here: this box has no settings store yet, so
// there is nowhere to keep one.
export fn srp_set_credentials(user: u64, user_len: u32, pass: u64, pass_len: u32,
                              salt: u64) {
  var i: u32 = 0
  while i < 16 {
    srp.salt[i] = @as(*u8, @ptrFromInt(salt + i)).*
    i = i + 1
  }

  // inner = H(user || ":" || pass)
  var ctx: sha512.Sha512Context
  var inner: [u8; 64]
  var colon: [u8; 1]
  colon[0] = 0x3A
  sha512.sha512_ctx_init(&ctx)
  sha512.sha512_update(&ctx, @ptrFromInt(user), user_len)
  sha512.sha512_update(&ctx, @intFromPtr(&colon), 1)
  sha512.sha512_update(&ctx, @ptrFromInt(pass), pass_len)
  sha512.sha512_final(&ctx, @intFromPtr(&inner))

  // x = H(salt || inner)
  var x_digest: [u8; 64]
  srp_hash_pair(salt, 16, @intFromPtr(&inner), SRP_HASH_BYTES, @intFromPtr(&x_digest))

  var x: bn.BigNum
  bn.bn_from_bytes(&x, @intFromPtr(&x_digest), SRP_HASH_BYTES)

  bn.bn_mod_exp(&srp.v, &srp.g, @intFromPtr(&x_digest), SRP_HASH_BYTES, &srp.n)
}

// B = (k*v + g^b) mod N for a caller-supplied private exponent.
//
// Split out from srp_generate_public so the exchange can be driven with a
// fixed b. That is what lets the boot self-test check B, S, M1 and M2 against
// a published vector instead of only checking that both sides agree with each
// other -- two implementations of the same misunderstanding agree perfectly.
export fn srp_generate_public_with(b_bytes: u64, out: u64) {
  var i: u32 = 0
  while i < SRP_PRIVATE_BYTES {
    srp.b_private[i] = @as(*u8, @ptrFromInt(b_bytes + i)).*
    i = i + 1
  }
  srp_public_from_private(out)
}

// B = (k*v + g^b) mod N, with b fresh per session. Writes B big-endian.
export fn srp_generate_public(out: u64) {
  random.random_get_bytes(@intFromPtr(&srp.b_private), SRP_PRIVATE_BYTES)
  srp_public_from_private(out)
}

fn srp_public_from_private(out: u64) {

  var gb: bn.BigNum
  bn.bn_mod_exp(&gb, &srp.g, @intFromPtr(&srp.b_private), SRP_PRIVATE_BYTES, &srp.n)

  var kv: bn.BigNum
  bn.bn_mul_mod(&kv, &srp.k, &srp.v, &srp.n)

  bn.bn_add_mod(&kv, &gb, &srp.n)
  bn.bn_copy(&srp.big_b, &kv)

  bn.bn_to_bytes(&srp.big_b, out, SRP_MODULUS_BYTES)
}

export fn srp_salt(out: u64) {
  var i: u32 = 0
  while i < 16 {
    @as(*u8, @ptrFromInt(out + i)).* = srp.salt[i]
    i = i + 1
  }
}

// Take the client's A, derive u, S and the session key K.
//
// Returns 0 and does nothing if A mod N is zero: that is the one value an
// attacker can send to force S to zero regardless of the verifier, and RFC
// 5054 requires the exchange be abandoned rather than continued.
export fn srp_accept_client_public(a_bytes: u64): u32 {
  if srp.ready == 0 { return 0 }

  bn.bn_from_bytes(&srp.big_a, a_bytes, SRP_MODULUS_BYTES)

  var a_mod: bn.BigNum
  bn.bn_copy(&a_mod, &srp.big_a)
  // A is already below N in any honest exchange; the check that matters is
  // that it is not zero.
  if bn.bn_is_zero(&a_mod) == 1 { return 0 }

  // u = H(PAD(A) || PAD(B))
  var a_padded: [u8; 384]
  var b_padded: [u8; 384]
  bn.bn_to_bytes(&srp.big_a, @intFromPtr(&a_padded), SRP_MODULUS_BYTES)
  bn.bn_to_bytes(&srp.big_b, @intFromPtr(&b_padded), SRP_MODULUS_BYTES)

  var u_digest: [u8; 64]
  srp_hash_pair(@intFromPtr(&a_padded), SRP_MODULUS_BYTES,
                @intFromPtr(&b_padded), SRP_MODULUS_BYTES,
                @intFromPtr(&u_digest))

  // S = (A * v^u)^b mod N
  var vu: bn.BigNum
  bn.bn_mod_exp(&vu, &srp.v, @intFromPtr(&u_digest), SRP_HASH_BYTES, &srp.n)

  var base: bn.BigNum
  bn.bn_mul_mod(&base, &srp.big_a, &vu, &srp.n)

  var s: bn.BigNum
  bn.bn_mod_exp(&s, &base, @intFromPtr(&srp.b_private), SRP_PRIVATE_BYTES, &srp.n)

  // K = H(S)
  var s_padded: [u8; 384]
  bn.bn_to_bytes(&s, @intFromPtr(&s_padded), SRP_MODULUS_BYTES)
  srp_hash_pair(@intFromPtr(&s_padded), SRP_MODULUS_BYTES, 0, 0,
                @intFromPtr(&srp.session_key))

  return 1
}

// M1 = H(H(N) xor H(g) || H(user) || salt || A || B || K)
fn srp_compute_m1(user: u64, user_len: u32, out: u64) {
  var hn: [u8; 64]
  var hg: [u8; 64]
  var g_padded: [u8; 384]
  bn.bn_to_bytes(&srp.g, @intFromPtr(&g_padded), SRP_MODULUS_BYTES)
  srp_hash_pair(@intFromPtr(&N_BYTES), SRP_MODULUS_BYTES, 0, 0, @intFromPtr(&hn))
  srp_hash_pair(@intFromPtr(&g_padded), SRP_MODULUS_BYTES, 0, 0, @intFromPtr(&hg))

  var mixed: [u8; 64]
  var i: u32 = 0
  while i < SRP_HASH_BYTES {
    mixed[i] = hn[i] ^ hg[i]
    i = i + 1
  }

  var huser: [u8; 64]
  srp_hash_pair(user, user_len, 0, 0, @intFromPtr(&huser))

  var a_padded: [u8; 384]
  var b_padded: [u8; 384]
  bn.bn_to_bytes(&srp.big_a, @intFromPtr(&a_padded), SRP_MODULUS_BYTES)
  bn.bn_to_bytes(&srp.big_b, @intFromPtr(&b_padded), SRP_MODULUS_BYTES)

  var ctx: sha512.Sha512Context
  sha512.sha512_ctx_init(&ctx)
  sha512.sha512_update(&ctx, @intFromPtr(&mixed), SRP_HASH_BYTES)
  sha512.sha512_update(&ctx, @intFromPtr(&huser), SRP_HASH_BYTES)
  sha512.sha512_update(&ctx, @intFromPtr(&srp.salt), 16)
  sha512.sha512_update(&ctx, @intFromPtr(&a_padded), SRP_MODULUS_BYTES)
  sha512.sha512_update(&ctx, @intFromPtr(&b_padded), SRP_MODULUS_BYTES)
  sha512.sha512_update(&ctx, @intFromPtr(&srp.session_key), SRP_HASH_BYTES)
  sha512.sha512_final(&ctx, @ptrFromInt(out))
}

// Check the client's proof. Compared over the whole digest with no early exit,
// so the comparison does not leak how much of a wrong proof was right.
export fn srp_verify_client_proof(user: u64, user_len: u32, proof: u64): u32 {
  var expected: [u8; 64]
  srp_compute_m1(user, user_len, @intFromPtr(&expected))

  var diff: u8 = 0
  var i: u32 = 0
  while i < SRP_HASH_BYTES {
    diff = diff | (expected[i] ^ @as(*u8, @ptrFromInt(proof + i)).*)
    srp.m1[i] = expected[i]
    i = i + 1
  }
  if diff == 0 { return 1 }
  return 0
}

// M2 = H(A || M1 || K), our proof back to the client.
export fn srp_compute_server_proof(out: u64) {
  var a_padded: [u8; 384]
  bn.bn_to_bytes(&srp.big_a, @intFromPtr(&a_padded), SRP_MODULUS_BYTES)

  var ctx: sha512.Sha512Context
  sha512.sha512_ctx_init(&ctx)
  sha512.sha512_update(&ctx, @intFromPtr(&a_padded), SRP_MODULUS_BYTES)
  sha512.sha512_update(&ctx, @intFromPtr(&srp.m1), SRP_HASH_BYTES)
  sha512.sha512_update(&ctx, @intFromPtr(&srp.session_key), SRP_HASH_BYTES)
  sha512.sha512_final(&ctx, @ptrFromInt(out))
}

export fn srp_session_key(out: u64) {
  var i: u32 = 0
  while i < SRP_HASH_BYTES {
    @as(*u8, @ptrFromInt(out + i)).* = srp.session_key[i]
    i = i + 1
  }
}

// The verifier, for tests that check x and v independently of any session.
export fn srp_verifier(out: *bn.BigNum) {
  bn.bn_copy(out, &srp.v)
}

export fn srp_modulus(out: *bn.BigNum) {
  bn.bn_copy(out, &srp.n)
}

export fn srp_generator(out: *bn.BigNum) {
  bn.bn_copy(out, &srp.g)
}
