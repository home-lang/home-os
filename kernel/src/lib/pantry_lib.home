// Pantry Library Integration for home-os
// Seamless integration with ~/Code/pantry
// All integration logic lives in this library

// ============================================================================
// PANTRY LIBRARY - COMPLETE IMPLEMENTATION
// ============================================================================

const MAX_PACKAGES: u32 = 1000
const MAX_REGISTRIES: u32 = 10
const MAX_ENVIRONMENTS: u32 = 32
const MAX_SERVICES: u32 = 50

// Package structure
export struct Package {
  name: [u8; 256],
  version: [u8; 64],
  registry_id: u32,
  installed: u32,
  size: u64,
  dep_count: u32,
  dependencies: [u32; 32],
  install_path: [u8; 512]
}

// Registry structure
export struct Registry {
  name: [u8; 128],
  url: [u8; 512],
  reg_type: u32,  // 0=pkgx.sh, 1=npm, 2=github, 3=custom
  enabled: u32,
  priority: u32
}

// Environment structure
export struct Environment {
  name: [u8; 256],
  path: [u8; 512],
  active: u32,
  pkg_count: u32,
  packages: [u32; 64]
}

// Service structure
export struct Service {
  name: [u8; 128],
  command: [u8; 512],
  running: u32,
  pid: u32,
  port: u16,
  auto_start: u32,
  health_check_url: [u8; 256]
}

// Global state (managed by library)
var packages: [Package; 1000] = undefined
var registries: [Registry; 10] = undefined
var environments: [Environment; 32] = undefined
var services: [Service; 50] = undefined
var pkg_count: u32 = 0
var reg_count: u32 = 0
var env_count: u32 = 0
var svc_count: u32 = 0
var initialized: u32 = 0

// ============================================================================
// STRING UTILITIES (Library Internal)
// ============================================================================

fn str_len(s: u64): u32 {
  if s == 0 { return 0 }
  var len: u32 = 0
  var p: u64 = s
  // Bound str_len to prevent infinite loop on unterminated strings
  while len < 4096 and @as(*u8, @ptrFromInt(p)).* != 0 {
    len = len + 1
    p = p + 1
  }
  return len
}

// Always null-terminate destination even if source fills max
fn str_copy(dest: u64, src: u64, max: u32) {
  if dest == 0 or src == 0 or max == 0 { return }
  var i: u32 = 0
  while i < max - 1 {
    var c: u8 = @as(*u8, @ptrFromInt(src + i)).*
    @as(*u8, @ptrFromInt(dest + i)).* = c
    if c == 0 { return }
    i = i + 1
  }
  // Always null-terminate
  @as(*u8, @ptrFromInt(dest + i)).* = 0
}

// Return 0 (not equal) if both strings are 256+ chars without null
fn str_equal(s1: u64, s2: u64): u32 {
  if s1 == 0 or s2 == 0 { return 0 }
  var i: u32 = 0
  while i < 256 {
    var c1: u8 = @as(*u8, @ptrFromInt(s1 + i)).*
    var c2: u8 = @as(*u8, @ptrFromInt(s2 + i)).*
    if c1 != c2 { return 0 }
    if c1 == 0 { return 1 }
    i = i + 1
  }
  return 0
}

// Bound str_concat to prevent buffer overflow
fn str_concat(dest: u64, src: u64, dest_max: u32) {
  if dest == 0 or src == 0 or dest_max == 0 { return }
  var d_len: u32 = 0
  while d_len < dest_max and @as(*u8, @ptrFromInt(dest + d_len)).* != 0 {
    d_len = d_len + 1
  }
  var s: u64 = src
  while d_len < dest_max - 1 and @as(*u8, @ptrFromInt(s)).* != 0 {
    @as(*u8, @ptrFromInt(dest + d_len)).* = @as(*u8, @ptrFromInt(s)).*
    d_len = d_len + 1
    s = s + 1
  }
  @as(*u8, @ptrFromInt(dest + d_len)).* = 0
}

// ============================================================================
// PANTRY INITIALIZATION
// ============================================================================

export fn pantry_init(): u32 {
  if initialized == 1 { return 0 }

  // Initialize default registries
  add_registry("pkgx.sh", "https://pkgx.sh/v1", 0, 1, 10)
  add_registry("npm", "https://registry.npmjs.org", 1, 1, 5)
  add_registry("github", "https://api.github.com/repos", 2, 1, 3)

  // Initialize common services
  add_service("postgresql", "/usr/local/bin/postgres -D /var/lib/postgresql/data", 5432, 0, "http://localhost:5432")
  add_service("redis", "/usr/local/bin/redis-server /etc/redis/redis.conf", 6379, 0, "http://localhost:6379")
  add_service("nginx", "/usr/local/bin/nginx -c /etc/nginx/nginx.conf", 80, 0, "http://localhost:80")
  add_service("mysql", "/usr/local/bin/mysqld", 3306, 0, "http://localhost:3306")
  add_service("mongodb", "/usr/local/bin/mongod --dbpath /var/lib/mongodb", 27017, 0, "http://localhost:27017")

  initialized = 1
  return 0
}

// Return error code from add_registry instead of silent failure
fn add_registry(name: u64, url: u64, reg_type: u32, enabled: u32, priority: u32): u32 {
  if reg_count >= MAX_REGISTRIES { return 1 }

  var reg: Registry = undefined
  str_copy(@ptrFromInt(reg.name), name, 128)
  str_copy(@ptrFromInt(reg.url), url, 512)
  reg.reg_type = reg_type
  reg.enabled = enabled
  reg.priority = priority

  registries[reg_count] = reg
  reg_count = reg_count + 1
  return 0
}

// Return error code from add_service instead of silent failure
fn add_service(name: u64, command: u64, port: u16, auto_start: u32, health_url: u64): u32 {
  if svc_count >= MAX_SERVICES { return 1 }

  var svc: Service = undefined
  str_copy(@ptrFromInt(svc.name), name, 128)
  str_copy(@ptrFromInt(svc.command), command, 512)
  str_copy(@ptrFromInt(svc.health_check_url), health_url, 256)
  svc.running = 0
  svc.pid = 0
  svc.port = port
  svc.auto_start = auto_start

  services[svc_count] = svc
  svc_count = svc_count + 1
  return 0
}

// Find the highest-priority enabled registry
fn find_best_registry(): u32 {
  var best_idx: u32 = 0
  var best_priority: u32 = 0
  var i: u32 = 0
  while i < reg_count {
    if registries[i].enabled == 1 and registries[i].priority > best_priority {
      best_priority = registries[i].priority
      best_idx = i
    }
    i = i + 1
  }
  return best_idx
}

// ============================================================================
// PACKAGE MANAGEMENT
// ============================================================================

// Check capacity before searching for duplicates (short-circuit)
export fn pantry_install(pkg_name: u64, version: u64): u32 {
  if pkg_name == 0 or version == 0 { return 1 }
  if pkg_count >= MAX_PACKAGES { return 1 }

  // Check if already installed
  var i: u32 = 0
  while i < pkg_count {
    if str_equal(@ptrFromInt(packages[i].name), pkg_name) == 1 {
      return 0  // Already installed
    }
    i = i + 1
  }

  // Create package entry
  var pkg: Package = undefined
  str_copy(@ptrFromInt(pkg.name), pkg_name, 256)
  str_copy(@ptrFromInt(pkg.version), version, 64)
  pkg.registry_id = find_best_registry()
  pkg.installed = 1
  pkg.size = 0  // Unknown until actually downloaded
  pkg.dep_count = 0

  // Set install path (use bounded concat)
  str_copy(@ptrFromInt(pkg.install_path), "/usr/local/pantry/", 512)
  str_concat(@ptrFromInt(pkg.install_path), pkg_name, 512)
  str_concat(@ptrFromInt(pkg.install_path), "/", 512)
  str_concat(@ptrFromInt(pkg.install_path), version, 512)

  packages[pkg_count] = pkg
  pkg_count = pkg_count + 1

  return 0
}

// Clear last element after shifting array to prevent stale data
export fn pantry_remove(pkg_name: u64): u32 {
  if pkg_name == 0 { return 1 }

  var i: u32 = 0
  var found: u32 = 0
  var idx: u32 = 0

  while i < pkg_count {
    if str_equal(@ptrFromInt(packages[i].name), pkg_name) == 1 {
      found = 1
      idx = i
      break
    }
    i = i + 1
  }

  if found == 0 { return 1 }

  // Shift array
  i = idx
  while i < pkg_count - 1 {
    packages[i] = packages[i + 1]
    i = i + 1
  }
  // Clear the last slot to prevent stale data
  packages[pkg_count - 1].installed = 0
  packages[pkg_count - 1].name[0] = 0
  pkg_count = pkg_count - 1

  return 0
}

export fn pantry_update(pkg_name: u64): u32 {
  if pkg_name == 0 { return 1 }
  var i: u32 = 0
  while i < pkg_count {
    if str_equal(@ptrFromInt(packages[i].name), pkg_name) == 1 {
      str_copy(@ptrFromInt(packages[i].version), "latest", 64)
      return 0
    }
    i = i + 1
  }
  return 1
}

export fn pantry_list(): u32 {
  return pkg_count
}

// Return address of array element, not cast of struct value
export fn pantry_get_package(index: u32): u64 {
  if index >= pkg_count { return 0 }
  return @intFromPtr(&packages[index])
}

// Search installed packages by name substring match
export fn pantry_search(query: u64): u32 {
  if query == 0 { return 0 }

  var results: u32 = 0
  var i: u32 = 0

  // Search installed packages
  while i < pkg_count {
    if str_contains(@ptrFromInt(packages[i].name), query) == 1 {
      results = results + 1
    }
    i = i + 1
  }

  return results
}

// Substring search helper
fn str_contains(haystack: u64, needle: u64): u32 {
  if haystack == 0 or needle == 0 { return 0 }

  var h_len: u32 = str_len(haystack)
  var n_len: u32 = str_len(needle)

  if n_len == 0 { return 1 }
  if n_len > h_len { return 0 }

  var i: u32 = 0
  while i + n_len <= h_len {
    var match: u32 = 1
    var j: u32 = 0
    while j < n_len {
      if @as(*u8, @ptrFromInt(haystack + i + j)).* != @as(*u8, @ptrFromInt(needle + j)).* {
        match = 0
        break
      }
      j = j + 1
    }
    if match == 1 { return 1 }
    i = i + 1
  }
  return 0
}

// ============================================================================
// ENVIRONMENT MANAGEMENT
// ============================================================================

export fn pantry_env_create(name: u64, path: u64): u32 {
  if name == 0 or path == 0 { return 1 }
  if env_count >= MAX_ENVIRONMENTS { return 1 }

  // Check for duplicate environment names
  var i: u32 = 0
  while i < env_count {
    if str_equal(@ptrFromInt(environments[i].name), name) == 1 {
      return 2  // Already exists
    }
    i = i + 1
  }

  var env: Environment = undefined
  str_copy(@ptrFromInt(env.name), name, 256)
  str_copy(@ptrFromInt(env.path), path, 512)
  env.active = 0
  env.pkg_count = 0

  environments[env_count] = env
  env_count = env_count + 1

  return 0
}

// Don't deactivate all environments before finding the target.
// If target not found, previous state is preserved.
export fn pantry_env_activate(name: u64): u32 {
  if name == 0 { return 1 }

  // First check if the target exists
  var target_idx: u32 = 0xFFFFFFFF
  var i: u32 = 0
  while i < env_count {
    if str_equal(@ptrFromInt(environments[i].name), name) == 1 {
      target_idx = i
      break
    }
    i = i + 1
  }

  if target_idx == 0xFFFFFFFF { return 1 }  // Not found — no state change

  // Deactivate all, then activate target
  i = 0
  while i < env_count {
    environments[i].active = 0
    i = i + 1
  }
  environments[target_idx].active = 1
  return 0
}

export fn pantry_env_deactivate(): u32 {
  var i: u32 = 0
  while i < env_count {
    environments[i].active = 0
    i = i + 1
  }
  return 0
}

export fn pantry_env_list(): u32 {
  return env_count
}

export fn pantry_env_get(index: u32): u64 {
  if index >= env_count { return 0 }
  return @intFromPtr(&environments[index])
}

// Add a package to an environment
export fn pantry_env_add_package(env_name: u64, pkg_idx: u32): u32 {
  if env_name == 0 { return 1 }
  if pkg_idx >= pkg_count { return 1 }

  var i: u32 = 0
  while i < env_count {
    if str_equal(@ptrFromInt(environments[i].name), env_name) == 1 {
      if environments[i].pkg_count >= 64 { return 1 }  // Env package limit

      // Check if already in environment
      var j: u32 = 0
      while j < environments[i].pkg_count {
        if environments[i].packages[j] == pkg_idx { return 0 }  // Already added
        j = j + 1
      }

      environments[i].packages[environments[i].pkg_count] = pkg_idx
      environments[i].pkg_count = environments[i].pkg_count + 1
      return 0
    }
    i = i + 1
  }
  return 1  // Environment not found
}

// Remove a package from an environment
export fn pantry_env_remove_package(env_name: u64, pkg_idx: u32): u32 {
  if env_name == 0 { return 1 }

  var i: u32 = 0
  while i < env_count {
    if str_equal(@ptrFromInt(environments[i].name), env_name) == 1 {
      var j: u32 = 0
      while j < environments[i].pkg_count {
        if environments[i].packages[j] == pkg_idx {
          // Shift remaining packages
          var k: u32 = j
          while k < environments[i].pkg_count - 1 {
            environments[i].packages[k] = environments[i].packages[k + 1]
            k = k + 1
          }
          environments[i].pkg_count = environments[i].pkg_count - 1
          return 0
        }
        j = j + 1
      }
      return 1  // Package not in environment
    }
    i = i + 1
  }
  return 1  // Environment not found
}

// ============================================================================
// SERVICE MANAGEMENT
// ============================================================================

export fn pantry_service_start(name: u64): u32 {
  if name == 0 { return 1 }
  var i: u32 = 0
  while i < svc_count {
    if str_equal(@ptrFromInt(services[i].name), name) == 1 {
      if services[i].running == 0 {
        services[i].running = 1
        services[i].pid = 1000 + i  // Would fork actual process
        return 0
      }
      return 2  // Already running
    }
    i = i + 1
  }
  return 1
}

export fn pantry_service_stop(name: u64): u32 {
  if name == 0 { return 1 }
  var i: u32 = 0
  while i < svc_count {
    if str_equal(@ptrFromInt(services[i].name), name) == 1 {
      if services[i].running == 1 {
        services[i].running = 0
        services[i].pid = 0
        return 0
      }
      return 2  // Not running
    }
    i = i + 1
  }
  return 1
}

// Check return values from stop/start in restart
export fn pantry_service_restart(name: u64): u32 {
  var stop_result: u32 = pantry_service_stop(name)
  // Ignore "not running" (2) on stop — that's fine for restart
  if stop_result == 1 { return 1 }  // Service not found

  var start_result: u32 = pantry_service_start(name)
  return start_result
}

export fn pantry_service_status(name: u64): u32 {
  if name == 0 { return 0 }
  var i: u32 = 0
  while i < svc_count {
    if str_equal(@ptrFromInt(services[i].name), name) == 1 {
      return services[i].running
    }
    i = i + 1
  }
  return 0
}

export fn pantry_service_list(): u32 {
  return svc_count
}

export fn pantry_service_get(index: u32): u64 {
  if index >= svc_count { return 0 }
  return @intFromPtr(&services[index])
}

// ============================================================================
// REGISTRY MANAGEMENT
// ============================================================================

// Check if at capacity before adding
export fn pantry_registry_add(name: u64, url: u64, reg_type: u32): u32 {
  if name == 0 or url == 0 { return 1 }
  if reg_count >= MAX_REGISTRIES { return 1 }

  // Check for duplicate registry names
  var i: u32 = 0
  while i < reg_count {
    if str_equal(@ptrFromInt(registries[i].name), name) == 1 {
      return 2  // Already exists
    }
    i = i + 1
  }

  return add_registry(name, url, reg_type, 1, 1)
}

export fn pantry_registry_remove(name: u64): u32 {
  if name == 0 { return 1 }
  var i: u32 = 0
  var found: u32 = 0
  var idx: u32 = 0

  while i < reg_count {
    if str_equal(@ptrFromInt(registries[i].name), name) == 1 {
      found = 1
      idx = i
      break
    }
    i = i + 1
  }

  if found == 0 { return 1 }

  i = idx
  while i < reg_count - 1 {
    registries[i] = registries[i + 1]
    i = i + 1
  }
  reg_count = reg_count - 1

  return 0
}

export fn pantry_registry_list(): u32 {
  return reg_count
}

export fn pantry_registry_get(index: u32): u64 {
  if index >= reg_count { return 0 }
  return @intFromPtr(&registries[index])
}

// Enable or disable a registry by name
export fn pantry_registry_set_enabled(name: u64, enabled: u32): u32 {
  if name == 0 { return 1 }
  var i: u32 = 0
  while i < reg_count {
    if str_equal(@ptrFromInt(registries[i].name), name) == 1 {
      registries[i].enabled = if enabled != 0 { 1 } else { 0 }
      return 0
    }
    i = i + 1
  }
  return 1  // Registry not found
}

// Set registry priority
export fn pantry_registry_set_priority(name: u64, priority: u32): u32 {
  if name == 0 { return 1 }
  var i: u32 = 0
  while i < reg_count {
    if str_equal(@ptrFromInt(registries[i].name), name) == 1 {
      registries[i].priority = priority
      return 0
    }
    i = i + 1
  }
  return 1
}

// ============================================================================
// CACHE MANAGEMENT
// ============================================================================

export fn pantry_cache_clear(): u32 {
  // Would clear /var/cache/pantry
  return 0
}

export fn pantry_cache_size(): u64 {
  // Would calculate cache size by scanning cache directory
  return 0
}

// ============================================================================
// DEPENDENCY RESOLUTION
// ============================================================================

// Implement basic dependency resolution instead of empty stub
export fn pantry_resolve_deps(pkg_name: u64): u32 {
  if pkg_name == 0 { return 1 }

  // Find the package
  var i: u32 = 0
  while i < pkg_count {
    if str_equal(@ptrFromInt(packages[i].name), pkg_name) == 1 {
      // Check each dependency is installed
      var j: u32 = 0
      var missing: u32 = 0
      while j < packages[i].dep_count and j < 32 {
        var dep_idx: u32 = packages[i].dependencies[j]
        if dep_idx >= pkg_count or packages[dep_idx].installed == 0 {
          missing = missing + 1
        }
        j = j + 1
      }
      return missing  // 0 = all deps satisfied
    }
    i = i + 1
  }
  return 1  // Package not found
}

// Implement basic conflict detection instead of empty stub
export fn pantry_check_conflicts(): u32 {
  var conflicts: u32 = 0
  var i: u32 = 0
  while i < pkg_count {
    // Check for duplicate package names (shouldn't happen, but validate)
    var j: u32 = i + 1
    while j < pkg_count {
      if str_equal(@ptrFromInt(packages[i].name), @ptrFromInt(packages[j].name)) == 1 {
        conflicts = conflicts + 1
      }
      j = j + 1
    }
    i = i + 1
  }
  return conflicts
}
