// HomeOS Minimum Viable Kernel — serial proof-of-life
//
// First end-to-end demonstration of Home-compiled kernel code executing
// on x86-64 (MASTER_PLAN Phase 0, issue #26). Written deliberately within
// the current kernel-codegen subset: integer literals, local function
// calls, and simple-form inline asm (`asm("instr")`, no operand syntax).
//
// The message below is spelled out via putc() calls because string
// iteration is not yet implemented in the kernel backend.

fn putc(c: int) {
  asm("movl %edi, %eax")
  asm("movw $0x3f8, %dx")
  asm("outb %al, %dx")
}

fn newline() {
  asm("movb $10, %al")
  asm("movw $0x3f8, %dx")
  asm("outb %al, %dx")
}

export fn kernel_main(): void {
  // COM1 (0x3F8) init: disable interrupts, DLAB, divisor=2, 8N1
  asm("movb $0x00, %al")
  asm("movw $0x3f9, %dx")
  asm("outb %al, %dx")
  asm("movb $0x80, %al")
  asm("movw $0x3fb, %dx")
  asm("outb %al, %dx")
  asm("movb $0x02, %al")
  asm("movw $0x3f8, %dx")
  asm("outb %al, %dx")
  asm("movb $0x03, %al")
  asm("movw $0x3fb, %dx")
  asm("outb %al, %dx")

  // "HomeOS v0.1: kernel_main reached\n"
  // H o m e O S   v 0 . 1 :   k e r n e l _ m a i n   r e a c h e d
  putc(72)
  putc(111)
  putc(109)
  putc(101)
  putc(79)
  putc(83)
  putc(32)
  putc(118)
  putc(48)
  putc(46)
  putc(49)
  putc(58)
  putc(32)
  putc(107)
  putc(101)
  putc(114)
  putc(110)
  putc(101)
  putc(108)
  putc(95)
  putc(109)
  putc(97)
  putc(105)
  putc(110)
  putc(32)
  putc(114)
  putc(101)
  putc(97)
  putc(99)
  putc(104)
  putc(101)
  putc(100)
  putc(10)

  // Halt forever
  loop {
    asm("hlt")
  }
}
