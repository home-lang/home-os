// HomeOS Minimum Viable Kernel — serial proof-of-life
//
// The first Home code that executes on hardware (MASTER_PLAN Phase 0, #26).
// Everything below compiles through the Home compiler's kernel backend to
// x86-64 assembly, links against kernel/src/boot.s via kernel/linker.ld, and
// runs in QEMU. scripts/boot-test.sh asserts the message on the serial console.
//
// What this file demonstrates, in the order the codegen ladder (#38) added it:
// function parameters, local variables, arithmetic and comparison, loops with
// break, string literals in .rodata, and the port-I/O intrinsics of milestone
// A3 (outb/inb) — no hand-written assembly anywhere in this file.

// COM1. Serial is the first output a kernel gets and the only one the boot
// gate needs: no framebuffer, no font, no console driver.
const COM1: int = 0x3f8
const COM1_IER: int = 0x3f9        // interrupt enable
const COM1_FCR: int = 0x3fa        // FIFO control
const COM1_LCR: int = 0x3fb        // line control
const COM1_MCR: int = 0x3fc        // modem control
const COM1_LSR: int = 0x3fd        // line status

const LCR_DLAB: int = 0x80         // divisor latch access
const LCR_8N1: int = 0x03          // 8 data bits, no parity, 1 stop bit
const LSR_THR_EMPTY: int = 0x20    // transmit holding register empty

// Read one byte of a string. The kernel backend has no byte-width loads yet,
// so this is a 64-bit load masked to its low byte — the codegen pads every
// string literal with seven zero bytes to keep that load in bounds. Replace
// with an indexed byte load when the backend grows sized loads (#38).
fn byte_at(p: int): int {
  return (*p) & 255
}

fn serial_init() {
  outb(COM1_IER, 0x00)             // interrupts off
  outb(COM1_LCR, LCR_DLAB)         // unlock the divisor latch
  outb(COM1, 0x01)                 // divisor low  = 1 (115200 baud)
  outb(COM1_IER, 0x00)             // divisor high = 0
  outb(COM1_LCR, LCR_8N1)          // lock it again, 8N1
  outb(COM1_FCR, 0xc7)             // FIFOs on, cleared, 14-byte threshold
  outb(COM1_MCR, 0x0b)             // DTR + RTS + OUT2
}

fn putc(c: int) {
  // Wait for the transmit holding register before writing, so characters are
  // not dropped when the line is slower than the CPU.
  loop {
    if (inb(COM1_LSR) & LSR_THR_EMPTY) != 0 { break }
  }
  outb(COM1, c)
}

fn puts(s: int) {
  var p = s
  loop {
    let c = byte_at(p)
    if c == 0 { break }
    putc(c)
    p = p + 1
  }
}

export fn kernel_main(): void {
  serial_init()
  puts("HomeOS v0.1: kernel_main reached\n")

  loop {
    hlt()
  }
}
