// home-os Real-Time Scheduler
// RT scheduling class

import "../core/foundation.home" as foundation
import "../sync/spinlock.home" as spinlock

const RT_PRIO_MAX: u32 = 100

struct RtRunQueue {
  active: [u32; 100],
  nr_running: u32,
  highest_prio: u32,
  lock: spinlock.Spinlock  // Protects all run queue state
}

var rt_rq: RtRunQueue
var rt_initialized: u32 = 0

export fn rt_init() {
  spinlock.spinlock_init(&rt_rq.lock)
  rt_rq.nr_running = 0
  rt_rq.highest_prio = RT_PRIO_MAX
  var i: u32 = 0
  while i < RT_PRIO_MAX {
    rt_rq.active[i] = 0
    i = i + 1
  }
  rt_initialized = 1
  foundation.serial_write_string("[RT] Real-time scheduler initialized\n")
}

export fn rt_enqueue(task_id: u32, priority: u32) {
  if priority >= RT_PRIO_MAX { return }

  spinlock.spinlock_acquire(&rt_rq.lock)

  rt_rq.active[priority] = task_id
  rt_rq.nr_running = rt_rq.nr_running + 1

  if priority < rt_rq.highest_prio {
    rt_rq.highest_prio = priority
  }

  spinlock.spinlock_release(&rt_rq.lock)
}

export fn rt_dequeue(task_id: u32, priority: u32) {
  if priority >= RT_PRIO_MAX { return }

  spinlock.spinlock_acquire(&rt_rq.lock)

  rt_rq.active[priority] = 0
  if rt_rq.nr_running > 0 {
    rt_rq.nr_running = rt_rq.nr_running - 1
  }

  // Find new highest priority
  if priority == rt_rq.highest_prio {
    rt_rq.highest_prio = RT_PRIO_MAX  // Reset to no tasks
    var i: u32 = 0
    while i < RT_PRIO_MAX {
      if rt_rq.active[i] != 0 {
        rt_rq.highest_prio = i
        break
      }
      i = i + 1
    }
  }

  spinlock.spinlock_release(&rt_rq.lock)
}

export fn rt_pick_next(): u32 {
  spinlock.spinlock_acquire(&rt_rq.lock)
  var result: u32 = 0xFFFFFFFF
  if rt_rq.nr_running > 0 and rt_rq.highest_prio < RT_PRIO_MAX {
    result = rt_rq.active[rt_rq.highest_prio]
  }
  spinlock.spinlock_release(&rt_rq.lock)
  return result
}

export fn rt_get_load(): u32 {
  return rt_rq.nr_running
}
