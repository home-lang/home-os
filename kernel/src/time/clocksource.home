// home-os Clock Source
// High-resolution time sources

import "../core/foundation.home" as foundation

const CLOCK_MONOTONIC: u32 = 0
const CLOCK_REALTIME: u32 = 1
const CLOCK_BOOTTIME: u32 = 2

struct Timespec {
  tv_sec: u64,
  tv_nsec: u64
}

var boot_time: u64 = 0
var monotonic_time: u64 = 0

// FIX R3 #9: Clock saturation. u64 seconds = 584 billion years, so a
// real overflow is astronomically unlikely — but the conversion
// `ticks / 1_000_000_000` *added* to monotonic_time can still wrap on
// an uncalibrated boot. We detect this and saturate rather than
// wrap, so time never goes backward.
const MAX_U64: u64 = 0xFFFFFFFFFFFFFFFF

fn saturating_add_u64(a: u64, b: u64): u64 {
  if MAX_U64 - a < b { return MAX_U64 }
  return a + b
}

export fn clocksource_init() {
  boot_time = 0
  monotonic_time = 0
  foundation.serial_write_string("[Clocksource] Initialized\n")
}

export fn clocksource_read(): u64 {
  // Read TSC or other high-res timer
  var tsc: u64 = foundation.rdtsc()
  return tsc
}

export fn clocksource_get_time(clock_id: u32, ts: u64) {
  if ts == 0 { return }
  var ticks: u64 = clocksource_read()
  var secs: u64 = ticks / 1000000000
  var nsecs: u64 = ticks % 1000000000

  if clock_id == CLOCK_MONOTONIC {
    @as(*u64, @ptrFromInt(ts)).* = saturating_add_u64(monotonic_time, secs)
    @as(*u64, @ptrFromInt(ts + 8)).* = nsecs
  } else if clock_id == CLOCK_REALTIME {
    @as(*u64, @ptrFromInt(ts)).* = saturating_add_u64(saturating_add_u64(boot_time, monotonic_time), secs)
    @as(*u64, @ptrFromInt(ts + 8)).* = nsecs
  } else if clock_id == CLOCK_BOOTTIME {
    @as(*u64, @ptrFromInt(ts)).* = saturating_add_u64(monotonic_time, secs)
    @as(*u64, @ptrFromInt(ts + 8)).* = nsecs
  }
}

export fn clocksource_tick() {
  // Saturate — if we ever reach MAX_U64, stop incrementing rather
  // than wrapping to 0 (time going backward breaks every timer).
  if monotonic_time != MAX_U64 {
    monotonic_time = monotonic_time + 1
  }
}

// Approximate nanosecond read for hrtimer. Assumes a ~1 GHz TSC
// which is wrong on most hardware but provides a monotonic clock
// until proper calibration is implemented.
var tsc_khz: u64 = 1000000

export fn clocksource_set_tsc_khz(khz: u64) {
  if khz > 0 { tsc_khz = khz }
}

export fn clocksource_read_ns(): u64 {
  var tsc: u64 = foundation.rdtsc()
  return (tsc * 1000) / tsc_khz
}

export fn clocksource_set_next_event(expires_ns: u64) {
  // Would program APIC timer or HPET to fire at expires_ns.
  // Stub until hardware timer programming is implemented.
}
