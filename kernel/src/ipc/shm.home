// home-os Shared Memory
// Shared memory segments

import "../core/foundation.home" as foundation
import "../core/memory.home" as memory
import "../sync/spinlock.home" as spinlock

const MAX_SHM_SEGMENTS: u32 = 32

struct ShmSegment {
  key: u32,
  size: u32,
  addr: u64,
  ref_count: u32,
  in_use: u32
}

var shm_segments: [ShmSegment; 32]
var shm_count: u32 = 0

export fn shm_init() {
  shm_count = 0
  foundation.serial_write_string("[SHM] Initialized\n")
}

export fn shm_create(key: u32, size: u32): u32 {
  if shm_count >= MAX_SHM_SEGMENTS { return 0xFFFFFFFF }
  if size == 0 { return 0xFFFFFFFF }

  // Shared-memory semantics require that creating with a key that
  // already exists returns the existing segment (with its refcount
  // bumped) instead of silently creating a duplicate. Without this
  // check, two clients could `shm_create(K, sz)` and each get their
  // OWN backing buffer — defeating the whole "shared" in "shm".
  var j: u32 = 0
  while j < MAX_SHM_SEGMENTS {
    if shm_segments[j].in_use == 1 and shm_segments[j].key == key {
      shm_segments[j].ref_count = shm_segments[j].ref_count + 1
      return j
    }
    j = j + 1
  }

  var i: u32 = 0
  while i < MAX_SHM_SEGMENTS {
    if shm_segments[i].in_use == 0 {
      var addr: u64 = memory.kmalloc(size)
      if addr == 0 { return 0xFFFFFFFF }

      shm_segments[i].key = key
      shm_segments[i].size = size
      shm_segments[i].addr = addr
      shm_segments[i].ref_count = 1
      shm_segments[i].in_use = 1
      shm_count = shm_count + 1

      return i
    }
    i = i + 1
  }

  return 0xFFFFFFFF
}

export fn shm_attach(shm_id: u32): u64 {
  if shm_id >= MAX_SHM_SEGMENTS or shm_segments[shm_id].in_use == 0 {
    return 0
  }

  // Refuse the attach if ref_count is already at u32 max — otherwise
  // the increment would wrap to 0 and the next detach would free a
  // still-mapped segment.
  if shm_segments[shm_id].ref_count == 0xFFFFFFFF { return 0 }

  shm_segments[shm_id].ref_count = shm_segments[shm_id].ref_count + 1
  return shm_segments[shm_id].addr
}

// FIX R3 #8: shm_detach had a race on shm_count where two concurrent
// detaches of the last reference could both see `shm_count > 0` and
// both decrement, underflowing. The refcount decrement itself was
// also non-atomic, so two concurrent detaches against the same
// segment could go below 0 or miss the free. We wrap the whole
// operation in a spinlock and use CAS semantics on ref_count.
var shm_lock: spinlock.Spinlock
var shm_lock_initialized: u32 = 0

fn ensure_shm_lock() {
  if shm_lock_initialized == 1 { return }
  spinlock.spinlock_init(&shm_lock)
  shm_lock_initialized = 1
}

export fn shm_detach(shm_id: u32) {
  if shm_id >= MAX_SHM_SEGMENTS { return }

  ensure_shm_lock()
  spinlock.spinlock_acquire(&shm_lock)

  if shm_segments[shm_id].in_use == 0 {
    spinlock.spinlock_release(&shm_lock)
    return
  }

  if shm_segments[shm_id].ref_count > 0 {
    shm_segments[shm_id].ref_count = shm_segments[shm_id].ref_count - 1
  }

  if shm_segments[shm_id].ref_count == 0 {
    var doomed_addr: u64 = shm_segments[shm_id].addr
    shm_segments[shm_id].addr = 0
    shm_segments[shm_id].in_use = 0
    if shm_count > 0 {
      shm_count = shm_count - 1
    }
    spinlock.spinlock_release(&shm_lock)
    // Free outside lock — kfree may take internal locks.
    memory.kfree(doomed_addr)
    return
  }

  spinlock.spinlock_release(&shm_lock)
}

export fn shm_get(key: u32): u32 {
  var i: u32 = 0
  while i < MAX_SHM_SEGMENTS {
    if shm_segments[i].in_use == 1 and shm_segments[i].key == key {
      return i
    }
    i = i + 1
  }
  return 0xFFFFFFFF
}
