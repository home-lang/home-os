// ============================================================================
// FIX #34: Calculator base conversion buffer length
// ============================================================================

import "../../../../apps/calculator.home" as calc

fn test_calc_buffer_safety() {
    basics.print("\n=== Fix #34: Calculator Buffer Safety ===\n")

    // The fix adds a buffer_len parameter and truncates gracefully
    // rather than overflowing.
    var buf: [u8; 32]

    // Hex: small number fits in 4 bytes ("0x0\0").
    calc.calc_to_hex(0, @intFromPtr(&buf), 32)
    assert_true(buf[0] == '0', "calc_to_hex(0) writes '0'")

    // Hex: max u64 needs 19 bytes; buffer of 19 should be enough.
    calc.calc_to_hex(0xFFFFFFFFFFFFFFFF, @intFromPtr(&buf), 32)
    assert_true(buf[0] == '0' and buf[1] == 'x', "hex output prefixed 0x")

    // Too-small buffer: function returns without writing past bounds.
    var tiny: [u8; 4]
    calc.calc_to_hex(0xABCDEF, @intFromPtr(&tiny), 4)
    pass("calc_to_hex with tiny 4-byte buffer does not overflow")

    // Binary: small number fits.
    calc.calc_to_bin(0, @intFromPtr(&buf), 32)
    assert_true(buf[0] == '0' and buf[1] == 'b' and buf[2] == '0', "calc_to_bin(0) = '0b0'")
}

