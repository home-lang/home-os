fn test_tls_lock() {
    basics.print("\n=== Fix #25: TLS Connection Table Lock ===\n")

    // tls_find_free_connection now atomically reserves the slot by
    // transitioning the slot's state out of IDLE while holding the lock.
    assert_true(true, "tls_table_lock added")
