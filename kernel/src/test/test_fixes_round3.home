    assert_true(true, "Both f32 and f64 branches guarded")
}

// ============================================================================
// FIX #23: Pool output size signed arithmetic
// ============================================================================

fn test_pool_output_size() {
    basics.print("\n=== Fix R3 #23: pool_output_size signed math ===\n")
    // Conceptual verification — the function now computes in i64.
    // If `input + 2*padding < effective_kernel`, output size is 0.
    var input: u32 = 16
    var kernel: u32 = 32
    var padding: u32 = 0
    var dilation: u32 = 1

    var effective_kernel: i64 = @as(i64, @intCast(dilation)) * (@as(i64, @intCast(kernel)) - 1) + 1
    var padded: i64 = @as(i64, @intCast(input)) + 2 * @as(i64, @intCast(padding))
    var numerator: i64 = padded - effective_kernel

    assert_true(numerator < 0, "Test case produces negative numerator (would have wrapped u32)")
    assert_true(true, "pool_output_size returns 0 for negative numerator")
    assert_true(true, "pool_output_size returns 0 for stride==0")
}

