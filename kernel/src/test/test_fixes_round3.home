// ============================================================================
// MAIN TEST RUNNER
// ============================================================================

export fn run_all_round3_tests() {
    basics.print("\n")
    basics.print("================================================================\n")
    basics.print("  HomeOS Round-3 Fix Test Suite — 35 Fixes\n")
    basics.print("================================================================\n")

    r3_passed = 0
    r3_failed = 0
    r3_total = 0

    // Sync / IPC
    test_rwmutex_write_lock_cleanup()    // #1, #5
    test_rwsem_read_lock_cleanup()       // #2
    test_condvar_cleanup()               // #3, #4
    test_signal_send_lock()              // #6
    test_signal_shift_bounds()           // #7
    test_shm_detach_lock()               // #8

    // Time / Perf / Containers
    test_clock_saturation()              // #9
    test_profiler_overflow_flag()        // #10
    test_spsc_capacity_validation()      // #11
    test_spsc_barriers()                 // #12
    test_mpmc_slot_ordering()            // #13
    test_io_uring_overflow_counter()     // #14
    test_cgroup_memory_cas()             // #15
    test_pid_ns_offset()                 // #16

    // Filesystem / Block
    test_ntfs_read_errors()              // #17
    test_procfs_read_const()             // #18
    test_xfs_extent_state()              // #19
    test_iosched_pool_bounds()           // #20
    test_iso9660_failure_path()          // #21

    // ML / GUI / Input / Media
    test_tensor_div_zero()               // #22
    test_pool_output_size()              // #23
    test_touch_state_precedence()        // #24
    test_flac_decode_validation()        // #25
    test_touch_coord_clamp()             // #26
    test_mp3_frame_size_overflow()       // #27
    test_wm_layout_overflow()            // #28
    test_touch_calibration_i64()         // #29

    // libc / utilities
    test_sprintf_cap()                   // #30
    test_realloc_size_tracking()         // #31
    test_insertion_sort_index()          // #32
    test_fread_error_check()             // #33
    test_pwd_set_termination()           // #34
    test_sha256sum_hex()                 // #35

    // Report
    basics.print("\n")
    basics.print("================================================================\n")
    basics.print("  RESULTS: ")
    basics.print_u32(r3_passed)
    basics.print(" passed, ")
    basics.print_u32(r3_failed)
    basics.print(" failed, ")
    basics.print_u32(r3_total)
    basics.print(" total\n")
    basics.print("================================================================\n")

    if r3_failed == 0 {
        basics.print("  ALL ROUND-3 TESTS PASSED\n")
    } else {
        basics.print("  SOME TESTS FAILED — see [FAIL] above\n")
    }
    basics.print("================================================================\n\n")
}
