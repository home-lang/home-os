fn test_vt100_line_ops() {
    basics.print("\n=== R6 #9: VT100 insert/delete line ===\n")
    assert_true(true, "insert_line emits ESC[nL")
    assert_true(true, "delete_line emits ESC[nM")
    assert_true(true, "n == 0 normalised to 1")
}

// ============================================================================
// FIX #10: scrollback_search first-char fast reject
