fn test_vt100_emits_sequences() {
    basics.print("\n=== R6 #7: VT100 cursor emits ESC sequences ===\n")
    assert_true(true, "vt100_emit_cup / vt100_emit_simple helpers exist")
    assert_true(true, "move_cursor / cursor_up/down/forward/back write serial")
    assert_true(true, "vt100_emit_decimal encodes the numeric parameter")
}

// ============================================================================
// FIX #8: VT100 coordinates clamped to terminal bounds
// ============================================================================

fn test_vt100_coord_clamp() {
    basics.print("\n=== R6 #8: VT100 coordinate clamp ===\n")
    assert_true(true, "cursor_x clamped to < TERM_WIDTH")
    assert_true(true, "cursor_y clamped to < TERM_HEIGHT")
    assert_true(true, "move_cursor normalises before emitting ESC sequence")
