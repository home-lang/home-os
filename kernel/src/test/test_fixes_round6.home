// ============================================================================
// MAIN RUNNER
// ============================================================================

export fn run_all_round6_tests() {
    basics.print("\n")
    basics.print("================================================================\n")
    basics.print("  HomeOS Round-6 Fix Test Suite — 35 Fixes\n")
    basics.print("================================================================\n")

    r6_passed = 0
    r6_failed = 0
    r6_total = 0

    // ANSI / VT100
    test_ansi_csi_bounds()            // #1
    test_ansi_param_cap()             // #2
    test_ansi_osc_terminator()        // #3
    test_ansi_csi_cursor_impl()       // #4
    test_scrollback_empty_query()     // #5
    test_scrollback_lock()            // #6
    test_vt100_emits_sequences()      // #7
    test_vt100_coord_clamp()          // #8
    test_vt100_line_ops()             // #9
    test_scrollback_fast_reject()     // #10

    // Games & editor
    test_tetris_core()                // #11
    test_tetris_score()               // #12
    test_autocomplete_terminate()     // #13
    test_autocomplete_prefix()        // #14
    test_autocomplete_caller_buffer() // #15

    // Clipboard / Browser / MQTT
    test_clipboard_truncation()       // #16
    test_browser_compact()            // #17
    test_browser_private_mode()       // #18
    test_mqtt_slot_reuse()            // #19
    test_mqtt_duplicate_id()          // #20
    test_mqtt_connack_v5()            // #21
    test_mqtt_sub_auth()              // #22

    // Sysmon / test framework
    test_sysmon_insertion_sort()      // #23
    test_sysmon_struct_swap()         // #24
    test_sysmon_network_delta()       // #25
    test_sysmon_pid_zero()            // #26
    test_framework_timestamp()        // #27
    test_framework_assertion_ctx()    // #28
    test_framework_suite_destroy()    // #29
    test_framework_snprintf()         // #30
    test_framework_totals()           // #31

    // Package mgr + remaining
    test_pantry_latest_constant()     // #32
    test_ansi_final_byte_bound()      // #33
    test_autocomplete_stage()         // #34
    test_sysmon_init_clean()          // #35

    // Final Report
    basics.print("\n")
    basics.print("================================================================\n")
    basics.print("  RESULTS: ")
    basics.print_u32(r6_passed)
    basics.print(" passed, ")
    basics.print_u32(r6_failed)
    basics.print(" failed, ")
    basics.print_u32(r6_total)
    basics.print(" total\n")
    basics.print("================================================================\n")

    if r6_failed == 0 {
        basics.print("  ALL ROUND-6 TESTS PASSED\n")
    } else {
        basics.print("  SOME TESTS FAILED — see [FAIL] above\n")
    }
    basics.print("================================================================\n\n")
}
