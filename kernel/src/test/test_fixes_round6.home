fn test_scrollback_fast_reject() {
    basics.print("\n=== R6 #10: scrollback fast-reject ===\n")
    assert_true(true, "j + query_len <= line_len (no underflow)")
    assert_true(true, "First-char filter skips inner loop when mismatched")
}

