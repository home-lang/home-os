// ============================================================================
// FIX #19: RT Scheduler Locking
// ============================================================================

import "../../sched/rt.home" as rt

fn test_rt_scheduler_locking() {
    basics.print("\n=== Fix #19: RT Scheduler Locking ===\n")

    rt.rt_init()

    // Enqueue task with priority 5
    rt.rt_enqueue(100, 5)
    var picked: u32 = rt.rt_pick_next()
    assert_eq_u32(picked, 100, "RT picks enqueued task 100 at priority 5")

    // Enqueue higher priority (lower number) task
    rt.rt_enqueue(200, 2)
    picked = rt.rt_pick_next()
    assert_eq_u32(picked, 200, "RT picks higher-priority task 200 at priority 2")

    // Dequeue priority 2 task
    rt.rt_dequeue(200, 2)
    picked = rt.rt_pick_next()
    assert_eq_u32(picked, 100, "After dequeue, RT falls back to task 100")

    // Dequeue last task
    rt.rt_dequeue(100, 5)
    picked = rt.rt_pick_next()
    assert_eq_u32(picked, 0xFFFFFFFF, "Empty RT queue returns 0xFFFFFFFF")

    assert_eq_u32(rt.rt_get_load(), 0, "RT load is 0 after all dequeues")
}

