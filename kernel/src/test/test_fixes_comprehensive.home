// ============================================================================
// FIX #15: Battery Temperature Sign Extension
// ============================================================================

fn test_battery_sign_extension() {
    basics.print("\n=== Fix #15: Battery Temperature Sign Extension ===\n")

    // Verify the fix: combine as u16 first, then cast to i16 for sign extension
    // Example: 0x80 low, 0x0A high → u16 = 0x0A80 = 2688 deci-Kelvin
    var lo: u8 = 0x80
    var hi: u8 = 0x0A
    var raw_u16: u16 = (@as(u16, lo)) | (@as(u16, hi) << 8)
    var temp_dk: i32 = @as(i16, raw_u16) as i32  // Should be 2688

    assert_eq_u32(@intCast(temp_dk), 2688, "Positive temperature sign-extends correctly")

    // Negative case: 0xF0 low, 0xFF high → u16 = 0xFFF0 → i16 = -16
    lo = 0xF0
    hi = 0xFF
    raw_u16 = (@as(u16, lo)) | (@as(u16, hi) << 8)
    temp_dk = @as(i16, raw_u16) as i32  // Should be -16
    assert_true(temp_dk < 0, "Negative temperature sign-extends correctly")
}

