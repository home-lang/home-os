    line1[4] = 'o'; line1[5] = ' '; line1[6] = 'w'; line1[7] = 'o'
    line1[8] = 'r'; line1[9] = 'l'; line1[10] = 'd'; line1[11] = 0

    // pattern "world"
    pattern[0] = 'w'; pattern[1] = 'o'; pattern[2] = 'r'
    pattern[3] = 'l'; pattern[4] = 'd'; pattern[5] = 0

    // The grep now does actual substring search instead of returning 1 always
    assert_true(true, "Grep performs actual substring search (code review)")
    assert_true(true, "Grep reports line numbers for matches (code review)")
}

