// ============================================================================
// FIX #13: ARM64 MMU @truncate Argument Order
// ============================================================================

fn test_mmu_truncate_order() {
    basics.print("\n=== Fix #13: MMU @truncate Argument Order ===\n")

    // @truncate(u32, value) is correct; @truncate(value, u32) was wrong.
    // Verify with known virtual address
    var virt: u64 = 0x0000_007F_C000_0000  // A known test address

    // PGD index should be bits [47:39] = 0xFF (if address was full)
    var pgd_idx: u32 = @truncate(u32, (virt >> 39) & 0x1FF)
    // For 0x7FC0000000: bits 47:39 = 0xFF = 255
    assert_eq_u32(pgd_idx, 0xFF, "PGD index from @truncate(u32, ...) is correct")

    var pud_idx: u32 = @truncate(u32, (virt >> 30) & 0x1FF)
    assert_eq_u32(pud_idx, 0, "PUD index for test address is 0")
}

