// home-os Kernel — interactive serial console
//
// The Phase 1 exit gate asks for a shell on the serial line that runs echo,
// ls, cat, ps and uname. This is that shell: it runs in the kernel, reads
// from COM1, and calls the subsystems directly. It is not the userspace
// shell in apps/shell.home, which needs an ELF loader and a syscall path
// that does not exist yet.

import "../core/foundation.home" as foundation
import "../core/filesystem.home" as filesystem
import "../core/process.home" as process
import "../arch/x86_64/interrupts.home" as interrupts
import "../arch/x86_64/usermode.home" as usermode
import "../drivers/ata.home" as ata
import "../fs/ext2.home" as ext2
import "../drivers/usb.home" as usb
import "../drivers/acpi.home" as acpi

const LINE_MAX: u32 = 256
const READDIR_MAX: u32 = 64
const CAT_CHUNK: u64 = 512

var line: [256]u8 = undefined
var line_len: u32 = 0

var dir_entries: [64]filesystem.DirEntryInfo = undefined
var cat_buffer: [512]u8 = undefined

// Command names and the default path. Declared here, with the other module
// state, because a global must be in scope before the function that takes its
// address.
var root_path: [2]u8 = undefined
var lit_echo: [5]u8 = undefined
var lit_ls: [3]u8 = undefined
var lit_cat: [4]u8 = undefined
var lit_ps: [3]u8 = undefined
var lit_uname: [6]u8 = undefined
var lit_irq: [4]u8 = undefined
var lit_hid: [4]u8 = undefined
var lit_suspend: [8]u8 = undefined
var lit_help: [5]u8 = undefined
var lit_run: [4]u8 = undefined
var lit_exec: [5]u8 = undefined
var lit_disk: [5]u8 = undefined
var lit_ext2: [5]u8 = undefined
var lit_mkfile: [7]u8 = undefined
var lit_remount: [8]u8 = undefined


// ============================================================================
// SMALL STRING HELPERS
//
// These take a length rather than trusting a terminator: the line buffer is
// filled from a serial port, and a device is not a source of well-formed
// strings.
// ============================================================================

fn is_space(c: u8): u32 {
  if c == 32 { return 1 }
  if c == 9 { return 1 }
  return 0
}

// Index of the first non-space at or after `from`, or `len` if there is none.
fn skip_spaces(from: u32, len: u32): u32 {
  var i: u32 = from
  while i < len {
    if is_space(line[i]) == 0 { return i }
    i = i + 1
  }
  return len
}

// Index one past the current word.
fn word_end(from: u32, len: u32): u32 {
  var i: u32 = from
  while i < len {
    if is_space(line[i]) == 1 { return i }
    i = i + 1
  }
  return len
}

// Whether line[start..end] equals a literal, given as its bytes.
fn word_is(start: u32, end: u32, lit: u64, lit_len: u32): u32 {
  if (end - start) != lit_len { return 0 }
  var i: u32 = 0
  while i < lit_len {
    var c: u8 = @as(*u8, @ptrFromInt(lit + @as(u64, i))).*
    if line[start + i] != c { return 0 }
    i = i + 1
  }
  return 1
}

fn write_span(start: u32, end: u32) {
  var i: u32 = start
  while i < end {
    foundation.serial_write_char(line[i])
    i = i + 1
  }
}

// ============================================================================
// BUILTINS
// ============================================================================

fn cmd_echo(arg_start: u32, len: u32) {
  write_span(arg_start, len)
  foundation.serial_write_string("\n")
}

fn cmd_uname() {
  foundation.serial_write_string("home-os x86_64\n")
}

fn cmd_ps() {
  foundation.serial_write_string("  PID  STATE  PRI\n")
  var count: u32 = process.process_get_count()
  var pid: u32 = 1
  var shown: u32 = 0
  // Process ids are not dense, so walk a bounded range rather than assuming
  // the count is also the highest id.
  while pid < 256 {
    if shown >= count { return }
    var state: u32 = process.process_get_state(pid)
    if state != 0 {
      foundation.serial_write_string("  ")
      foundation.serial_write_u64(@as(u64, pid))
      foundation.serial_write_string("      ")
      foundation.serial_write_u64(@as(u64, state))
      foundation.serial_write_string("      ")
      foundation.serial_write_u64(@as(u64, process.process_get_priority(pid)))
      foundation.serial_write_string("\n")
      shown = shown + 1
    }
    pid = pid + 1
  }
}

fn cmd_ls(arg_start: u32, len: u32) {
  // Default to the root when no path is given.
  var path_ptr: u64 = 0
  if arg_start >= len {
    path_ptr = @intFromPtr(&root_path)
  } else {
    // Terminate the argument in place; the line is ours until the next read.
    var end: u32 = word_end(arg_start, len)
    line[end] = 0
    path_ptr = @intFromPtr(&line) + @as(u64, arg_start)
  }

  var n: u32 = filesystem.vfs_readdir(path_ptr, &dir_entries, READDIR_MAX)
  if n == 0 {
    foundation.serial_write_string("ls: empty or not a directory\n")
    return
  }

  var i: u32 = 0
  while i < n {
    // Type, size, then name — enough to tell a directory from an empty file,
    // which matters while the filesystem is still being built out.
    if dir_entries[i].file_type == 2 {
      foundation.serial_write_string("d ")
    } else {
      foundation.serial_write_string("- ")
    }
    foundation.serial_write_u64(dir_entries[i].size)
    foundation.serial_write_string("\t")

    var j: u32 = 0
    while j < 256 {
      var c: u8 = dir_entries[i].name[j]
      if c == 0 { break }
      foundation.serial_write_char(c)
      j = j + 1
    }
    foundation.serial_write_string("\n")
    i = i + 1
  }
}

fn cmd_cat(arg_start: u32, len: u32) {
  if arg_start >= len {
    foundation.serial_write_string("cat: missing operand\n")
    return
  }
  var end: u32 = word_end(arg_start, len)
  line[end] = 0
  var path_ptr: u64 = @intFromPtr(&line) + @as(u64, arg_start)

  var fd: u32 = filesystem.vfs_open(path_ptr, 0)
  if fd == 0 {
    foundation.serial_write_string("cat: cannot open\n")
    return
  }

  var total: u64 = 0
  loop {
    var got: u64 = filesystem.vfs_read(fd, @intFromPtr(&cat_buffer), CAT_CHUNK)
    if got == 0 { break }
    total = total + got
    var k: u64 = 0
    while k < got {
      foundation.serial_write_char(cat_buffer[k])
      k = k + 1
    }
    if got < CAT_CHUNK { break }
  }
  var closed: u32 = filesystem.vfs_close(fd)

  // Say so rather than printing nothing: a silent cat is indistinguishable
  // from a working one, and an empty file is worth seeing as empty.
  if total == 0 {
    foundation.serial_write_string("cat: 0 bytes\n")
  }
}

fn cmd_irq() {
  // A plain count is awkward to assert on, since the exact value depends on
  // when the command runs. These two lines say whether each line has fired
  // at all, which is the thing worth pinning.
  if interrupts.get_timer_ticks() > 0 {
    foundation.serial_write_string("[IRQ] timer line live\n")
  }
  if interrupts.get_keyboard_irqs() > 0 {
    foundation.serial_write_string("[IRQ] keyboard line live\n")
  }
  foundation.serial_write_string("timer=")
  foundation.serial_write_u64(interrupts.get_timer_ticks())
  foundation.serial_write_string(" keyboard=")
  foundation.serial_write_u64(interrupts.get_keyboard_irqs())
  foundation.serial_write_string(" spurious=")
  foundation.serial_write_u64(interrupts.get_spurious_irqs())
  foundation.serial_write_string("\n")
}

// Suspend to RAM and report having come back.
//
// The line after the transition is the whole point: it is printed by code
// running on a CPU that was powered down and climbed back through real mode,
// so it cannot be produced by a suspend that did not happen. The line before
// it is flushed first for the same reason — anything still in a buffer when
// the machine sleeps is gone.
fn cmd_suspend() {
  if acpi.acpi_s3_available() == 0 {
    foundation.serial_write_string("suspend: this machine offers no S3\n")
    return
  }
  foundation.serial_write_string("[S3] suspending\n")
  if acpi.acpi_suspend_s3() == 1 {
    foundation.serial_write_string("[S3] resumed from suspend-to-RAM\n")
    return
  }
  foundation.serial_write_string("[S3] the machine did not suspend\n")
}

// Poll the HID device's interrupt endpoint and report what came back.
//
// A HID endpoint NAKs when nothing has changed, so one poll returning nothing
// is the normal answer, not a failure — hence the retries. The harness moves
// the emulated mouse before running this, so a driver that works has a report
// waiting; a driver that does not will exhaust the retries and say so, which
// is a different line from the one the gate asserts on.
fn cmd_hid() {
  let slot: u32 = usb.usb_hid_device_slot()
  if slot == 0 {
    foundation.serial_write_string("hid: no HID device\n")
    return
  }

  var attempt: u32 = 0
  var moved: u32 = 0
  while attempt < 64 {
    if usb.xhci_hid_read_report(slot) > 0 {
      // A report of all zeroes is the device saying nothing happened. Only a
      // report with content proves the endpoint carried an event.
      if usb.usb_hid_report_byte(0) != 0 or usb.usb_hid_report_byte(1) != 0 or
         usb.usb_hid_report_byte(2) != 0 {
        moved = 1
        attempt = 64
      } else {
        attempt = attempt + 1
      }
    } else {
      attempt = attempt + 1
    }
  }

  if moved == 0 {
    foundation.serial_write_string("hid: no report\n")
    return
  }

  if usb.usb_interface_protocol() == 2 {
    foundation.serial_write_string("[HID] mouse report: buttons ")
    foundation.serial_write_u64(@as(u64, usb.usb_hid_buttons()))
    foundation.serial_write_string(" dx ")
    write_signed(usb.usb_hid_mouse_dx())
    foundation.serial_write_string(" dy ")
    write_signed(usb.usb_hid_mouse_dy())
    foundation.serial_write_string("\n")
    return
  }

  foundation.serial_write_string("[HID] keyboard report: modifiers ")
  foundation.serial_write_u64(@as(u64, usb.usb_hid_modifiers()))
  foundation.serial_write_string(" key ")
  foundation.serial_write_u64(@as(u64, usb.usb_hid_keycode_at(0)))
  foundation.serial_write_string("\n")
}

fn write_signed(value: i32) {
  if value < 0 {
    foundation.serial_write_char(45)   // '-'
    foundation.serial_write_u64(@as(u64, @as(u32, 0 - value)))
    return
  }
  foundation.serial_write_u64(@as(u64, @as(u32, value)))
}

// Run a program at ring 3. `is_elf` picks the loader: `run` takes a flat
// image, `exec` takes an ELF64 executable. Returns here when the program
// exits, so the console survives it.
fn cmd_run(arg_start: u32, len: u32, is_elf: u32) {
  if arg_start >= len {
    foundation.serial_write_string("run: missing operand\n")
    return
  }
  var end: u32 = word_end(arg_start, len)
  line[end] = 0
  var path_ptr: u64 = @intFromPtr(&line) + @as(u64, arg_start)

  var rc: u32 = 1
  if is_elf == 1 {
    rc = usermode.run_user_elf(path_ptr)
  } else {
    rc = usermode.run_user_program(path_ptr)
  }
  if rc != 0 {
    foundation.serial_write_string("run: could not start\n")
    return
  }
  foundation.serial_write_string("[User] returned, exit code ")
  foundation.serial_write_u64(usermode.get_user_exit_code())
  foundation.serial_write_string(", syscalls ")
  foundation.serial_write_u64(usermode.get_syscall_count())
  foundation.serial_write_string("\n")
}

// Sector scratch, page-aligned by being its own module global.
var sector_a: [512]u8 = undefined
var sector_b: [512]u8 = undefined

// Report the disks the ATA driver found, and prove one round-trips.
//
// A driver that reports a device but cannot carry a byte to it and back is
// the failure worth catching, so this writes a pattern to the last sector,
// reads it back, and compares — the last sector because it is the one least
// likely to hold anything a filesystem cares about.
fn cmd_disk() {
  var n: u32 = ata.ata_get_device_count()
  foundation.serial_write_string("disks: ")
  foundation.serial_write_u64(@as(u64, n))
  foundation.serial_write_string("\n")
  if n == 0 { return }

  var sectors: u64 = ata.ata_get_device_sectors(0)
  foundation.serial_write_string("disk0: ")
  foundation.serial_write_u64(sectors)
  foundation.serial_write_string(" sectors\n")
  if sectors < 2 { return }

  var lba: u64 = sectors - 1

  // A pattern that is not all one byte, so a driver that returns a constant
  // or leaves the buffer untouched cannot pass.
  var i: u32 = 0
  while i < 512 {
    sector_a[i] = @as(u8, (i * 7 + 13) & 0xFF)
    sector_b[i] = 0
    i = i + 1
  }

  if ata.ata_write_sector(0, lba, @intFromPtr(&sector_a)) != 0 {
    foundation.serial_write_string("disk0: write failed\n")
    return
  }
  if ata.ata_read_sector(0, lba, @intFromPtr(&sector_b)) != 0 {
    foundation.serial_write_string("disk0: read failed\n")
    return
  }

  var bad: u32 = 0
  var j: u32 = 0
  while j < 512 {
    if sector_a[j] != sector_b[j] { bad = bad + 1 }
    j = j + 1
  }

  if bad == 0 {
    foundation.serial_write_string("disk0: sector round-trip OK\n")
  } else {
    foundation.serial_write_string("disk0: round-trip mismatch, ")
    foundation.serial_write_u64(@as(u64, bad))
    foundation.serial_write_string(" bytes\n")
  }
}

var ext2_buf: [1024]u8 = undefined

// Read a file out of the ext2 filesystem on disk 0.
//
// Separate from `cat`, which reads the in-memory VFS the initramfs was
// unpacked into. Keeping them apart makes it obvious which storage a given
// byte came from while the two are still separate trees.
fn cmd_ext2(arg_start: u32, len: u32) {
  if ext2.ext2_mounted() == 0 {
    foundation.serial_write_string("ext2: not mounted\n")
    return
  }
  if arg_start >= len {
    var n: u32 = ext2.ext2_list_directory(2)
    foundation.serial_write_string("ext2: ")
    foundation.serial_write_u64(@as(u64, n))
    foundation.serial_write_string(" entries in /\n")
    return
  }

  var end: u32 = word_end(arg_start, len)
  line[end] = 0
  var name_ptr: u64 = @intFromPtr(&line) + @as(u64, arg_start)

  var ino: u32 = ext2.ext2_lookup_entry(2, name_ptr)
  if ino == 0 {
    foundation.serial_write_string("ext2: no such file\n")
    return
  }

  var got: u64 = ext2.ext2_read_file(ino, 0, @intFromPtr(&ext2_buf), 1024)
  if got == 0 {
    foundation.serial_write_string("ext2: read 0 bytes\n")
    return
  }
  var i: u64 = 0
  while i < got {
    foundation.serial_write_char(ext2_buf[i])
    i = i + 1
  }
}

// Create a file on the ext2 filesystem: `mkfile NAME TEXT...`
//
// The text is everything after the name, so a round-trip test can put
// something recognisable on the disk for the host to find afterwards.
fn cmd_mkfile(arg_start: u32, len: u32) {
  if ext2.ext2_mounted() == 0 {
    foundation.serial_write_string("mkfile: ext2 not mounted\n")
    return
  }
  if arg_start >= len {
    foundation.serial_write_string("mkfile: usage: mkfile NAME TEXT\n")
    return
  }

  var name_end: u32 = word_end(arg_start, len)
  var text_start: u32 = skip_spaces(name_end, len)
  if text_start >= len {
    foundation.serial_write_string("mkfile: no content\n")
    return
  }

  // Terminate the name in place. The text runs to the end of the line, and a
  // trailing newline is added so the file reads like a line of text.
  line[name_end] = 0
  var name_ptr: u64 = @intFromPtr(&line) + @as(u64, arg_start)

  var text_len: u32 = len - text_start
  var i: u32 = 0
  while i < text_len {
    ext2_buf[i] = line[text_start + i]
    i = i + 1
  }
  ext2_buf[text_len] = 10
  text_len = text_len + 1

  var ino: u32 = ext2.ext2_create_file(2, name_ptr, @intFromPtr(&ext2_buf), @as(u64, text_len))
  if ino == 0 {
    foundation.serial_write_string("mkfile: failed\n")
    return
  }
  foundation.serial_write_string("mkfile: created inode ")
  foundation.serial_write_u64(@as(u64, ino))
  foundation.serial_write_string(", ")
  foundation.serial_write_u64(@as(u64, text_len))
  foundation.serial_write_string(" bytes\n")
}

fn cmd_help() {
  foundation.serial_write_string("echo ls cat ps uname irq hid suspend run exec disk ext2 mkfile remount help\n")
}

// ============================================================================
// DISPATCH
// ============================================================================

// String literals are not yet usable as byte arrays in this backend, so the
// command names are built once at init. Spelled out rather than looped so the
// bytes are readable at the point they are defined.
fn init_literals() {
  root_path[0] = 47  // '/'
  root_path[1] = 0

  lit_echo[0] = 101
  lit_echo[1] = 99
  lit_echo[2] = 104
  lit_echo[3] = 111
  lit_echo[4] = 0
  lit_ls[0] = 108
  lit_ls[1] = 115
  lit_ls[2] = 0
  lit_cat[0] = 99
  lit_cat[1] = 97
  lit_cat[2] = 116
  lit_cat[3] = 0
  lit_ps[0] = 112
  lit_ps[1] = 115
  lit_ps[2] = 0
  lit_uname[0] = 117
  lit_uname[1] = 110
  lit_uname[2] = 97
  lit_uname[3] = 109
  lit_uname[4] = 101
  lit_uname[5] = 0
  lit_irq[0] = 105
  lit_irq[1] = 114
  lit_irq[2] = 113
  lit_irq[3] = 0

  lit_hid[0] = 104  // 'h'
  lit_hid[1] = 105  // 'i'
  lit_hid[2] = 100  // 'd'
  lit_hid[3] = 0

  lit_suspend[0] = 115  // 's'
  lit_suspend[1] = 117  // 'u'
  lit_suspend[2] = 115  // 's'
  lit_suspend[3] = 112  // 'p'
  lit_suspend[4] = 101  // 'e'
  lit_suspend[5] = 110  // 'n'
  lit_suspend[6] = 100  // 'd'
  lit_suspend[7] = 0
  lit_remount[0] = 114
  lit_remount[1] = 101
  lit_remount[2] = 109
  lit_remount[3] = 111
  lit_remount[4] = 117
  lit_remount[5] = 110
  lit_remount[6] = 116
  lit_remount[7] = 0
  lit_mkfile[0] = 109
  lit_mkfile[1] = 107
  lit_mkfile[2] = 102
  lit_mkfile[3] = 105
  lit_mkfile[4] = 108
  lit_mkfile[5] = 101
  lit_mkfile[6] = 0
  lit_ext2[0] = 101
  lit_ext2[1] = 120
  lit_ext2[2] = 116
  lit_ext2[3] = 50
  lit_ext2[4] = 0
  lit_disk[0] = 100
  lit_disk[1] = 105
  lit_disk[2] = 115
  lit_disk[3] = 107
  lit_disk[4] = 0
  lit_exec[0] = 101
  lit_exec[1] = 120
  lit_exec[2] = 101
  lit_exec[3] = 99
  lit_exec[4] = 0
  lit_run[0] = 114
  lit_run[1] = 117
  lit_run[2] = 110
  lit_run[3] = 0
  lit_help[0] = 104
  lit_help[1] = 101
  lit_help[2] = 108
  lit_help[3] = 112
  lit_help[4] = 0
}

fn run_line(len: u32) {
  var start: u32 = skip_spaces(0, len)
  if start >= len { return }
  var end: u32 = word_end(start, len)
  var arg: u32 = skip_spaces(end, len)

  if word_is(start, end, @intFromPtr(&lit_echo), 4) == 1 {
    cmd_echo(arg, len)
    return
  }
  if word_is(start, end, @intFromPtr(&lit_ls), 2) == 1 {
    cmd_ls(arg, len)
    return
  }
  if word_is(start, end, @intFromPtr(&lit_cat), 3) == 1 {
    cmd_cat(arg, len)
    return
  }
  if word_is(start, end, @intFromPtr(&lit_ps), 2) == 1 {
    cmd_ps()
    return
  }
  if word_is(start, end, @intFromPtr(&lit_uname), 5) == 1 {
    cmd_uname()
    return
  }
  if word_is(start, end, @intFromPtr(&lit_irq), 3) == 1 {
    cmd_irq()
    return
  }
  if word_is(start, end, @intFromPtr(&lit_hid), 3) == 1 {
    cmd_hid()
    return
  }
  if word_is(start, end, @intFromPtr(&lit_suspend), 7) == 1 {
    cmd_suspend()
    return
  }
  if word_is(start, end, @intFromPtr(&lit_run), 3) == 1 {
    cmd_run(arg, len, 0)
    return
  }
  if word_is(start, end, @intFromPtr(&lit_exec), 4) == 1 {
    cmd_run(arg, len, 1)
    return
  }
  if word_is(start, end, @intFromPtr(&lit_disk), 4) == 1 {
    cmd_disk()
    return
  }
  if word_is(start, end, @intFromPtr(&lit_ext2), 4) == 1 {
    cmd_ext2(arg, len)
    return
  }
  if word_is(start, end, @intFromPtr(&lit_mkfile), 6) == 1 {
    cmd_mkfile(arg, len)
    return
  }
  if word_is(start, end, @intFromPtr(&lit_remount), 7) == 1 {
    if ext2.ext2_remount() == 0 {
      foundation.serial_write_string("remount: ok\n")
    } else {
      foundation.serial_write_string("remount: failed\n")
    }
    return
  }
  if word_is(start, end, @intFromPtr(&lit_help), 4) == 1 {
    cmd_help()
    return
  }

  write_span(start, end)
  foundation.serial_write_string(": not found\n")
}

// ============================================================================
// ENTRY
// ============================================================================

export fn serial_shell_init() {
  init_literals()
  line_len = 0
  foundation.serial_write_string("\n[Shell] serial console ready\n")
  foundation.serial_write_string("home-os> ")
}

// Consume whatever the port has and run any completed line.
//
// Called from the idle loop rather than from an interrupt: the shell calls
// into the filesystem and the process table, and running that inside an
// interrupt handler would need every one of them to be reentrant.
export fn serial_shell_poll() {
  while foundation.serial_has_data() == 1 {
    var c: u8 = foundation.serial_read_char()

    if c == 13 {
      c = 10
    }

    if c == 10 {
      foundation.serial_write_string("\n")
      run_line(line_len)
      line_len = 0
      foundation.serial_write_string("home-os> ")
    } else if c == 8 {
      if line_len > 0 {
        line_len = line_len - 1
        // Erase the character on the terminal as well as in the buffer.
        foundation.serial_write_string("\x08 \x08")
      }
    } else if c >= 32 {
      if line_len < LINE_MAX - 1 {
        line[line_len] = c
        line_len = line_len + 1
        foundation.serial_write_char(c)
      }
    }
  }
}
