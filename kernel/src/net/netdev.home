// Hand a received frame up to the stack. Currently a no-op so wifi
// drivers can call it without crashing; real implementation would
// route into the IP stack via socket.home.
export fn receive_packet(buffer: u64, length: u32) {
  // TODO(#11): dispatch to the L2/L3 demux instead of dropping.
  foundation.serial_write_string("[netdev] receive_packet stub\n")
}
