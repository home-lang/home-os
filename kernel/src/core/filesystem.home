// home-os Kernel - File System
// Real implementations only - no placeholders!

import "foundation.home" as foundation
import "memory.home" as memory
import "vfs_permissions.home" as perms
import "../fs/homefs.home" as homefs
import "../fs/devfs.home" as devfs

// ============================================================================
// CONSTANTS
// ============================================================================

const MAX_INODES: u32 = 1024
const MAX_OPEN_FILES: u32 = 256
const MAX_NAME_LEN: u32 = 256
const BLOCK_SIZE: u32 = 4096

// File types
const FILE_TYPE_REGULAR: u32 = 1
const FILE_TYPE_DIRECTORY: u32 = 2
const FILE_TYPE_SYMLINK: u32 = 3
const FILE_TYPE_DEVICE: u32 = 4

// ============================================================================
// INODE STRUCTURE
// ============================================================================

export struct Inode {
  ino: u32,
  file_type: u32,
  mode: u32,
  size: u64,
  blocks: u32,
  link_count: u32,
  uid: u32,
  gid: u32,
  atime: u64,
  mtime: u64,
  ctime: u64,
  data_blocks: [u64; 12],  // Direct blocks
  indirect_block: u64
}

// ============================================================================
// DIRECTORY ENTRY
// ============================================================================

struct DirEntry {
  ino: u32,
  name: [u8; 256],
  name_len: u32
}

// ============================================================================
// OPEN FILE TABLE
// ============================================================================

struct OpenFile {
  ino: u32,
  offset: u64,
  flags: u32,
  ref_count: u32,
  // Non-zero when this descriptor names a homefs object rather than an entry
  // in the in-memory inode table. The two namespaces are disjoint and a
  // descriptor belongs to exactly one of them, so every operation below
  // branches on this rather than trying to keep an inode in step with a file
  // the inode table does not hold.
  homefs_object: u64,
  // The devfs device id, plus one — device id 0 is a real device, so 0 here
  // has to keep meaning "not a device node".
  device_id: u32,
  // The pipe this descriptor is an end of, plus one. Zero means it is not a
  // pipe end. A descriptor is exactly one of the four kinds — inode, homefs
  // object, device node, pipe end — and every operation branches on that
  // rather than keeping them in step.
  pipe_id: u32,
  // Which end. 1 = the read end, 2 = the write end. Only meaningful when
  // pipe_id is non-zero, and it is what decides which side of the pipe is
  // released when this descriptor closes.
  pipe_end: u32
}

// ============================================================================
// GLOBAL STATE
// ============================================================================

var inode_table: [Inode; 1024] = undefined
var inode_count: u32 = 0
var next_ino: u32 = 1

var open_files: [OpenFile; 256] = undefined
var open_file_count: u32 = 0
var next_fd: u32 = 3  // 0,1,2 reserved for stdin/stdout/stderr

var fs_initialized: u32 = 0

// Current process UID/GID (for permission checks)
// TODO: Get these from process structure when implemented
var current_uid: u32 = 0
var current_gid: u32 = 0

// ============================================================================
// INODE MANAGEMENT
// ============================================================================

fn inode_alloc(file_type: u32, mode: u32): u32 {
  if inode_count >= MAX_INODES { return 0 }

  var i: u32 = 0
  while i < MAX_INODES {
    if inode_table[i].ino == 0 {
      // Found free inode
      var inode: Inode = undefined
      inode.ino = next_ino
      inode.file_type = file_type
      inode.mode = mode
      inode.size = 0
      inode.blocks = 0
      inode.link_count = 1
      // Set ownership to current user (will be 0 if not set)
      inode.uid = current_uid
      inode.gid = current_gid
      inode.atime = 0
      inode.mtime = 0
      inode.ctime = 0

      // Clear data blocks
      var j: u32 = 0
      while j < 12 {
        inode.data_blocks[j] = 0
        j = j + 1
      }
      inode.indirect_block = 0

      inode_table[i] = inode
      inode_count = inode_count + 1
      next_ino = next_ino + 1

      return inode.ino
    }
    i = i + 1
  }

  return 0
}

fn inode_get(ino: u32): u64 {
  var i: u32 = 0
  while i < MAX_INODES {
    if inode_table[i].ino == ino {
      return @ptrFromInt(inode_table[i])
    }
    i = i + 1
  }
  return 0
}

fn inode_free(ino: u32) {
  var i: u32 = 0
  while i < MAX_INODES {
    if inode_table[i].ino == ino {
      // Free data blocks
      var j: u32 = 0
      while j < 12 {
        if inode_table[i].data_blocks[j] != 0 {
          memory.pmm_free_page(inode_table[i].data_blocks[j])
        }
        j = j + 1
      }

      // Mark as free
      inode_table[i].ino = 0
      inode_count = inode_count - 1
      return
    }
    i = i + 1
  }
}

// Find index in inode_table for a given inode number
fn inode_find(ino: u32): u32 {
  var i: u32 = 0
  while i < MAX_INODES {
    if inode_table[i].ino == ino {
      return i
    }
    i = i + 1
  }
  return MAX_INODES  // Not found
}

// Look up path and return inode number
// Simple implementation: parse path components and traverse directory tree
// The inode a path names.
//
// This was a second path walker, written before path_resolve and never
// retired: it handled neither `.` nor `..`, and once symlinks existed it
// would not have followed one either. Two walkers meant `stat /a/./b` and
// `open /a/./b` could disagree about whether the file was there — the kind of
// difference that shows up as one command working and another not, on the
// same path. There is now one walk, and this is a name for it.
fn inode_lookup(path: u64): u32 {
  return path_resolve(path)
}

// Look up a name in a directory inode
fn dir_lookup(dir_ino: u32, name: *[u8; 256], name_len: u32): u32 {
  var dir_idx: u32 = inode_find(dir_ino)
  if dir_idx >= MAX_INODES { return 0 }

  // Check if it's a directory
  if inode_table[dir_idx].file_type != FILE_TYPE_DIRECTORY {
    return 0
  }

  // Read directory data blocks and search for entry
  // Each directory entry: 4 bytes ino + 4 bytes name_len + name
  var block_idx: u32 = 0
  while block_idx < 12 {
    var block_addr: u64 = inode_table[dir_idx].data_blocks[block_idx]
    if block_addr == 0 {
      block_idx = block_idx + 1
      continue
    }

    // Scan entries in this block
    var offset: u32 = 0
    while offset < BLOCK_SIZE {
      var entry_ptr: *u8 = @ptrFromInt(block_addr + offset)

      // The length is read before the inode is judged, because a removed
      // entry keeps its length and must be stepped over by its real size.
      // Skipping a removed entry by a fixed eight bytes landed in the middle
      // of its name and read those bytes as the next entry's header, so every
      // entry after a deleted one became unfindable — deleting one file in a
      // directory hid the files that followed it.
      var entry_ino: u32 = @ptrCast(*u32, entry_ptr).*
      var entry_name_len: u32 = @ptrCast(*u32, entry_ptr + 4).*

      // Never-used space is all zeroes: no inode and no length. Step by the
      // header alone, which is what walks to the end of a fresh block.
      if entry_ino == 0 and entry_name_len == 0 {
        offset = offset + 8
        continue
      }

      var removed_size: u32 = (8 + entry_name_len + 3) & ~3
      if entry_ino == 0 {
        offset = offset + removed_size
        continue
      }

      if entry_name_len == 0 or entry_name_len > 255 {
        offset = offset + 8 + entry_name_len
        continue
      }

      // Compare names
      if entry_name_len == name_len {
        var matches: u32 = 1
        var i: u32 = 0
        while i < name_len {
          if entry_ptr[8 + i] != name[i] {
            matches = 0
            break
          }
          i = i + 1
        }
        if matches == 1 {
          return entry_ino
        }
      }

      // Move to next entry (8 byte header + name, aligned to 4 bytes)
      var entry_size: u32 = 8 + entry_name_len
      entry_size = (entry_size + 3) & ~3  // Align to 4 bytes
      offset = offset + entry_size
    }

    block_idx = block_idx + 1
  }

  return 0  // Not found
}

// Add entry to directory
export fn dir_add_entry(dir_ino: u32, name: *[u8; 256], name_len: u32, entry_ino: u32): u32 {
  var dir_idx: u32 = inode_find(dir_ino)
  if dir_idx >= MAX_INODES { return 1 }

  // Check if it's a directory
  if inode_table[dir_idx].file_type != FILE_TYPE_DIRECTORY {
    return 1
  }

  // Find space in directory for new entry
  var entry_size: u32 = 8 + name_len
  entry_size = (entry_size + 3) & ~3  // Align to 4 bytes

  var block_idx: u32 = 0
  while block_idx < 12 {
    var block_addr: u64 = inode_table[dir_idx].data_blocks[block_idx]

    // Allocate new block if needed
    if block_addr == 0 {
      block_addr = memory.pmm_alloc_page()
      if block_addr == 0 { return 1 }
      inode_table[dir_idx].data_blocks[block_idx] = block_addr
      inode_table[dir_idx].blocks = inode_table[dir_idx].blocks + 1

      // Clear the new block
      var clear_ptr: *u8 = @ptrFromInt(block_addr)
      var i: u32 = 0
      while i < BLOCK_SIZE {
        clear_ptr[i] = 0
        i = i + 1
      }
    }

    // Find free space in this block
    var offset: u32 = 0
    while offset + entry_size <= BLOCK_SIZE {
      var entry_ptr: *u8 = @ptrFromInt(block_addr + offset)
      var existing_ino: u32 = @ptrCast(*u32, entry_ptr).*

      // A slot with no inode is either a hole a removal left or the unused
      // tail of the block, and the two cannot be treated alike.
      //
      // A hole keeps the name length of the name that used to be there, and
      // that length is the record's *stride* — every scan in this file steps
      // by it. Writing a shorter name into a longer hole shrinks the stride
      // and leaves the tail of the old record behind, so the next step lands
      // in the middle of it and reads a name length out of stale bytes;
      // writing a longer name into a shorter one overwrites the entry after
      // it. Either way the rest of the directory stops being readable, which
      // is what `rm` followed by `ls` was showing.
      //
      // So a hole is reused only when it is exactly the size wanted. One of
      // the wrong size is stepped over and left for a name that fits it.
      // Space is not reclaimed as eagerly as it could be; a directory that
      // could be read is worth more than one that packs well.
      var reusable: u32 = 0
      if existing_ino == 0 {
        var hole_name_len: u32 = @ptrCast(*u32, entry_ptr + 4).*
        if hole_name_len == 0 {
          // Never written: the block is zeroed when it is allocated, so this
          // is fresh space and takes an entry of any size.
          reusable = 1
        } else {
          var hole_size: u32 = (8 + hole_name_len + 3) & ~3
          if hole_size == entry_size { reusable = 1 }
        }
      }

      if reusable == 1 {
        // Found free slot, write entry
        @ptrCast(*u32, entry_ptr).* = entry_ino
        @ptrCast(*u32, entry_ptr + 4).* = name_len

        var i: u32 = 0
        while i < name_len {
          entry_ptr[8 + i] = name[i]
          i = i + 1
        }

        // Update directory size
        var new_end: u64 = @as(u64, block_idx) * BLOCK_SIZE + offset + entry_size
        if new_end > inode_table[dir_idx].size {
          inode_table[dir_idx].size = new_end
        }

        return 0  // Success
      }

      // Skip to next entry
      var existing_name_len: u32 = @ptrCast(*u32, entry_ptr + 4).*
      var skip_size: u32 = 8 + existing_name_len
      skip_size = (skip_size + 3) & ~3
      offset = offset + skip_size
    }

    block_idx = block_idx + 1
  }

  return 1  // No space
}

// Remove entry from directory
export fn dir_remove_entry(dir_ino: u32, name: *[u8; 256], name_len: u32): u32 {
  var dir_idx: u32 = inode_find(dir_ino)
  if dir_idx >= MAX_INODES { return 1 }

  // Search and remove
  var block_idx: u32 = 0
  while block_idx < 12 {
    var block_addr: u64 = inode_table[dir_idx].data_blocks[block_idx]
    if block_addr == 0 {
      block_idx = block_idx + 1
      continue
    }

    var offset: u32 = 0
    while offset < BLOCK_SIZE {
      var entry_ptr: *u8 = @ptrFromInt(block_addr + offset)
      var entry_ino: u32 = @ptrCast(*u32, entry_ptr).*
      var entry_name_len: u32 = @ptrCast(*u32, entry_ptr + 4).*

      // As in dir_lookup: a removed entry keeps its length so the walk can
      // step over it. Only genuinely unused space has neither.
      if entry_ino == 0 and entry_name_len == 0 {
        offset = offset + 8
        continue
      }
      if entry_ino == 0 {
        offset = offset + ((8 + entry_name_len + 3) & ~3)
        continue
      }

      if entry_name_len == name_len {
        var matches: u32 = 1
        var i: u32 = 0
        while i < name_len {
          if entry_ptr[8 + i] != name[i] {
            matches = 0
            break
          }
          i = i + 1
        }
        if matches == 1 {
          // Removed by clearing the inode. The length stays, so the scan can
          // step over the hole rather than into it.
          @ptrCast(*u32, entry_ptr).* = 0
          return 0
        }
      }

      var entry_size: u32 = 8 + entry_name_len
      entry_size = (entry_size + 3) & ~3
      offset = offset + entry_size
    }

    block_idx = block_idx + 1
  }

  return 1  // Not found
}

// Export inode table access for hash table integration
export fn get_inode_table_ptr(): u64 {
  return @intFromPtr(&inode_table)
}

export fn get_inode_at_index(idx: u32): u64 {
  if idx >= MAX_INODES { return 0 }
  if inode_table[idx].ino == 0 { return 0 }
  return @intFromPtr(&inode_table[idx])
}

export fn get_inode_count(): u32 {
  return inode_count
}

export fn get_max_inodes(): u32 {
  return MAX_INODES
}

// ============================================================================
// FILE OPERATIONS
// ============================================================================

// Scratch for one path component. Resolution is not reentrant; nothing in
// this kernel calls it from an interrupt.
var component: [256]u8 = undefined

const ROOT_INO: u32 = 1

// Add `ino` to the directory containing `path`, under the path's last
// component. Returns 0 on success.
fn link_into_parent(path: u64, ino: u32): u32 {
  // Find the last separator, so the parent and the leaf can be resolved
  // separately without copying the whole path.
  var len: u64 = 0
  while @as(*u8, @ptrFromInt(path + len)).* != 0 {
    len = len + 1
  }
  if len == 0 { return 1 }

  var last_sep: u64 = 0
  var found_sep: u32 = 0
  var i: u64 = 0
  while i < len {
    if @as(*u8, @ptrFromInt(path + i)).* == 47 {
      last_sep = i
      found_sep = 1
    }
    i = i + 1
  }

  var parent: u32 = ROOT_INO
  if found_sep == 1 {
    if last_sep > 0 {
      // Terminate at the separator to resolve the parent, then restore it.
      // The path belongs to the caller, so it is put back before returning.
      var saved: u8 = @as(*u8, @ptrFromInt(path + last_sep)).*
      @as(*u8, @ptrFromInt(path + last_sep)).* = 0
      parent = path_resolve(path)
      @as(*u8, @ptrFromInt(path + last_sep)).* = saved
      if parent == 0 { return 1 }
    }
  }

  var name_start: u64 = last_sep
  if found_sep == 1 { name_start = last_sep + 1 }

  var name_len: u32 = 0
  var j: u64 = name_start
  while j < len {
    if name_len >= 255 { return 1 }
    component[name_len] = @as(*u8, @ptrFromInt(path + j)).*
    name_len = name_len + 1
    j = j + 1
  }
  if name_len == 0 { return 1 }
  component[name_len] = 0

  return dir_add_entry(parent, &component, name_len, ino)
}

// The inode a path names, or 0.
//
// Walks the path one component at a time from the root, calling dir_lookup at
// each step. Absolute paths only: there is no per-process working directory
// below this layer yet, so a relative path is resolved against the root and
// says so by not finding anything the caller did not intend.
//
// `.` and `..` are handled here rather than stored as directory entries, so
// no directory has to carry them.
export fn path_resolve(path: u64): u32 {
  return resolve_walk(path, 1)
}

// The same walk, except that a symlink named by the *last* component is
// returned rather than followed. Every earlier component is still followed:
// reaching `b` in `/a/link/b` means walking through `link`, and only the leaf
// is left alone. This is what separates lstat from stat, and what lets a
// symlink be removed rather than the file it points at.
export fn path_resolve_nofollow(path: u64): u32 {
  return resolve_walk(path, 0)
}

// How many symlinks one resolution may follow. A link pointing at itself is a
// loop with no natural end, so the walk gives up rather than running forever.
const SYMLINK_MAX_DEPTH: u32 = 8

// Following a link means walking a path built out of the link's target and
// whatever was left of the original — which cannot be assembled in the buffer
// currently being read. Two buffers, used alternately, so the source of one
// hop is never the destination of the next.
var resolve_path_a: [u8; 512] = undefined
var resolve_path_b: [u8; 512] = undefined

// Whether `ino` names a symbolic link.
fn inode_is_symlink(ino: u32): u32 {
  let ptr: u64 = inode_get(ino)
  if ptr == 0 { return 0 }
  if @as(*Inode, @ptrFromInt(ptr)).*.file_type == FILE_TYPE_SYMLINK { return 1 }
  return 0
}

// Build `target + rest` into buffer `which` (1 = a, 0 = b) and return 0.
//
// Only an absolute target is followed. A relative one would have to be
// resolved against the directory the link sits in, and this walk does not
// carry that directory — a link with a relative target therefore fails to
// resolve rather than resolving against the wrong place, which is the failure
// a caller can see.
fn build_link_path(link_ino: u32, rest: u64, which: u32): u32 {
  let ptr: u64 = inode_get(link_ino)
  if ptr == 0 { return 1 }
  var node: Inode = @as(*Inode, @ptrFromInt(ptr)).*
  if node.size == 0 or node.size > 255 { return 1 }
  if node.data_blocks[0] == 0 { return 1 }
  if @as(*u8, @ptrFromInt(node.data_blocks[0])).* != 47 { return 1 }

  var out: u64 = @intFromPtr(&resolve_path_b)
  if which == 1 { out = @intFromPtr(&resolve_path_a) }

  var n: u64 = 0
  while n < node.size {
    @as(*u8, @ptrFromInt(out + n)).* = @as(*u8, @ptrFromInt(node.data_blocks[0] + n)).*
    n = n + 1
  }

  // Whatever the outer walk had not consumed yet, joined with one separator.
  if rest != 0 {
    if @as(*u8, @ptrFromInt(rest)).* != 0 {
      if n >= 511 { return 1 }
      @as(*u8, @ptrFromInt(out + n)).* = 47
      n = n + 1
      var r: u64 = 0
      loop {
        let c: u8 = @as(*u8, @ptrFromInt(rest + r)).*
        if c == 0 { break }
        if n >= 511 { return 1 }
        @as(*u8, @ptrFromInt(out + n)).* = c
        n = n + 1
        r = r + 1
      }
    }
  }

  @as(*u8, @ptrFromInt(out + n)).* = 0
  return 0
}

fn resolve_walk(path: u64, follow_leaf: u32): u32 {
  if path == 0 { return 0 }

  // The path being walked. Following a link replaces it with the link's
  // target joined to whatever had not been consumed, and the walk starts
  // again from the root — which is one loop, not two, so that `continue`
  // below means what it did before symlinks existed.
  var work: u64 = path
  var depth: u32 = 0
  var next_buffer: u32 = 1

  var cur: u32 = ROOT_INO
  var i: u64 = 0

  // Skip leading slashes; "/" alone is the root.
  while @as(*u8, @ptrFromInt(work + i)).* == 47 {
    i = i + 1
  }

  loop {
    var c: u8 = @as(*u8, @ptrFromInt(work + i)).*
    if c == 0 { return cur }

    // Copy one component.
    var len: u32 = 0
    while c != 0 {
      if c == 47 { break }
      if len >= 255 { return 0 }
      component[len] = c
      len = len + 1
      i = i + 1
      c = @as(*u8, @ptrFromInt(work + i)).*
    }
    component[len] = 0

    // Skip the separator run before the next component.
    while @as(*u8, @ptrFromInt(work + i)).* == 47 {
      i = i + 1
    }

    if len == 0 { return cur }

    if len == 1 {
      if component[0] == 46 {  // "."
        continue
      }
    }
    if len == 2 {
      if component[0] == 46 {
        if component[1] == 46 {  // ".."
          // No parent pointers are stored, so ".." from anywhere resolves to
          // the root. Correct for one level, wrong for deeper trees; when
          // inodes carry a parent this becomes a lookup.
          cur = ROOT_INO
          continue
        }
      }
    }

    var next: u32 = dir_lookup(cur, &component, len)
    if next == 0 { return 0 }

    if inode_is_symlink(next) == 1 {
      // The leaf is whatever has nothing after it. A trailing slash counts as
      // nothing, so `/a/link/` follows — which is what POSIX asks for, since
      // the slash asserts the name is a directory.
      var at_leaf: u32 = 0
      if @as(*u8, @ptrFromInt(work + i)).* == 0 { at_leaf = 1 }
      if at_leaf == 1 and follow_leaf == 0 { return next }

      if depth >= SYMLINK_MAX_DEPTH { return 0 }
      depth = depth + 1
      if build_link_path(next, work + i, next_buffer) != 0 { return 0 }
      if next_buffer == 1 {
        work = @intFromPtr(&resolve_path_a)
        next_buffer = 0
      } else {
        work = @intFromPtr(&resolve_path_b)
        next_buffer = 1
      }

      cur = ROOT_INO
      i = 0
      while @as(*u8, @ptrFromInt(work + i)).* == 47 {
        i = i + 1
      }
      continue
    }

    cur = next
  }
}

// ============================================================================
// HOMEFS MOUNT (MASTER_PLAN §7, S4: the VFS routing)
//
// A homefs volume is reachable through ordinary paths rather than only
// through homefs's own API. One mount point is supported, which is what the
// kernel has a volume for; the entry points below branch on whether a path
// falls under it.
//
// The alternative — teaching the in-memory inode table to be backed by
// homefs — would mean keeping two representations of every file in step, and
// the failure mode of getting that wrong is a file that reads correctly from
// one and not the other. A descriptor here belongs to exactly one namespace.
// ============================================================================

var homefs_mount_path: [u8; 64] = undefined
var homefs_mount_len: u32 = 0

// Register the mounted homefs volume at `path`. Returns 1 on success, and 0
// if no volume is mounted — a mount point with nothing behind it would make
// every path under it resolve to a missing file, which reads as an empty
// filesystem rather than as an unmounted one.
export fn vfs_mount_homefs(path: u64, path_len: u32): u32 {
  if homefs.homefs_is_mounted() == 0 { return 0 }
  if path_len == 0 or path_len >= 64 { return 0 }
  var i: u32 = 0
  while i < path_len {
    homefs_mount_path[i] = @as(*u8, @ptrFromInt(path + @as(u64, i))).*
    i = i + 1
  }
  homefs_mount_len = path_len

  // And put it in the mount table, with figures homefs measured rather than
  // figures chosen to look plausible. free_blocks is the difference between
  // the device's size and what the trees actually reach, which is exactly
  // what reclamation gives back.
  if mount_count < MAX_MOUNTS {
    let slot: u32 = mount_count
    var j: u32 = 0
    while j < path_len {
      mount_table[slot].path[j] = homefs_mount_path[j]
      j = j + 1
    }
    mount_table[slot].path_len = path_len
    mount_table[slot].fs_type = FS_TYPE_HOMEFS
    copy_string_to_array("homefs", &mount_table[slot].device, 32)
    mount_table[slot].device_len = 6
    mount_table[slot].total_blocks = @as(u64, homefs.homefs_device_blocks())
    mount_table[slot].free_blocks =
      @as(u64, homefs.homefs_device_blocks() - homefs.homefs_blocks_live())
    // An object is homefs's inode. There is no fixed table of them, so the
    // count is what exists and the ceiling is the volume itself.
    mount_table[slot].total_inodes = @as(u64, homefs.homefs_device_blocks())
    mount_table[slot].free_inodes =
      @as(u64, homefs.homefs_device_blocks() - homefs.homefs_blocks_live())
    mount_table[slot].block_size = 4096
    mount_table[slot].mounted = 1
    mount_count = mount_count + 1
  }
  return 1
}

export fn vfs_homefs_mounted(): u32 {
  if homefs_mount_len == 0 { return 0 }
  return homefs.homefs_is_mounted()
}

// The offset within `path` at which the part below the mount point starts,
// or 0 if the path is not under it. A path equal to the mount point returns
// its own length, which addresses the terminator — the empty remainder,
// meaning the mount's root directory.
fn homefs_path_offset(path: u64): u32 {
  if vfs_homefs_mounted() == 0 { return 0 }
  var i: u32 = 0
  while i < homefs_mount_len {
    let c: u8 = @as(*u8, @ptrFromInt(path + @as(u64, i))).*
    if c != homefs_mount_path[i] { return 0 }
    i = i + 1
  }
  // "/homefsx" must not match the mount point "/homefs". The character after
  // the prefix has to end the component.
  let next: u8 = @as(*u8, @ptrFromInt(path + @as(u64, homefs_mount_len))).*
  if next != 0 and next != 47 { return 0 }
  return homefs_mount_len
}

// Walk the path below the mount point through homefs's directories.
// Returns the object id, or 0.
export fn vfs_homefs_resolve(path: u64): u64 {
  let start: u32 = homefs_path_offset(path)
  if start == 0 { return 0 }

  var object: u64 = homefs.HOMEFS_ROOT_DIR
  var i: u32 = start
  loop {
    // Skip separators. Consecutive ones, and a trailing one, name the same
    // directory as the path without them.
    while @as(*u8, @ptrFromInt(path + @as(u64, i))).* == 47 { i = i + 1 }
    if @as(*u8, @ptrFromInt(path + @as(u64, i))).* == 0 { return object }

    let component: u64 = path + @as(u64, i)
    var length: u32 = 0
    loop {
      let c: u8 = @as(*u8, @ptrFromInt(component + @as(u64, length))).*
      if c == 0 or c == 47 { break }
      length = length + 1
      if length > 64 { return 0 }
    }

    object = homefs.homefs_dir_lookup(object, component, length)
    if object == 0 { return 0 }
    i = i + length
  }
}

// ---------------------------------------------------------------------------
// /dev routing
//
// A device node is not a file: it has no size, no inode-table entry, and its
// reads are offset-addressed straight at the device. Descriptors that name
// one carry the device id, the same way a homefs descriptor carries an object
// id, so that no operation has to guess which of the three namespaces a
// descriptor belongs to.
// ---------------------------------------------------------------------------

const DEV_PREFIX_LEN: u32 = 5      // "/dev/"

// The device id a path names, or DEVFS_NO_DEVICE. A path that is not under
// /dev also returns DEVFS_NO_DEVICE, which is how vfs_open knows to carry on.
export fn vfs_dev_lookup(path: u64): u32 {
  let p0: u8 = @as(*u8, @ptrFromInt(path)).*
  let p1: u8 = @as(*u8, @ptrFromInt(path + 1)).*
  let p2: u8 = @as(*u8, @ptrFromInt(path + 2)).*
  let p3: u8 = @as(*u8, @ptrFromInt(path + 3)).*
  let p4: u8 = @as(*u8, @ptrFromInt(path + 4)).*
  if p0 != 47 or p1 != 100 or p2 != 101 or p3 != 118 or p4 != 47 {
    return devfs.DEVFS_NO_DEVICE
  }
  return devfs.devfs_open(path + @as(u64, DEV_PREFIX_LEN))
}

fn dev_open(path: u64, flags: u32): u32 {
  let device: u32 = vfs_dev_lookup(path)
  if device == devfs.DEVFS_NO_DEVICE { return 0 }

  var i: u32 = 0
  while i < MAX_OPEN_FILES {
    if open_files[i].ref_count == 0 {
      open_files[i].ino = 0
      open_files[i].offset = 0
      open_files[i].flags = flags
      open_files[i].ref_count = 1
      open_files[i].homefs_object = 0
      // Stored one past the id so that 0 keeps meaning "not a device", the
      // same convention homefs_object uses. Device id 0 is a real device.
      open_files[i].device_id = device + 1
      open_files[i].pipe_id = 0
      open_files[i].pipe_end = 0
      open_file_count = open_file_count + 1
      return i + 3
    }
    i = i + 1
  }
  return 0
}

// Build the Inode a permission check needs out of a homefs object record.
// The check itself is the same code the inode table uses — a second
// implementation of "may this user read this file" is a second thing to get
// wrong, and the two would disagree quietly.
fn homefs_as_inode(object: u64): Inode {
  var stat: Inode = undefined
  stat.ino = @as(u32, object & 0xFFFFFFFF)
  if homefs.homefs_object_kind(object) == homefs.OBJ_KIND_DIR {
    stat.file_type = FILE_TYPE_DIRECTORY
  } else {
    stat.file_type = FILE_TYPE_REGULAR
  }
  stat.mode = homefs.homefs_object_mode(object)
  stat.size = homefs.homefs_object_size(object)
  stat.blocks = 0
  stat.link_count = 1
  stat.uid = homefs.homefs_object_uid(object)
  stat.gid = homefs.homefs_object_gid(object)
  stat.atime = 0
  stat.mtime = 0
  stat.ctime = 0
  stat.indirect_block = 0
  return stat
}

// Whether the current user may open this object with these flags.
fn homefs_may_open(object: u64, flags: u32): u32 {
  var stat: Inode = homefs_as_inode(object)
  let access_mode: u32 = flags & 0x3
  if access_mode == 0 {
    return perms.can_read(&stat, current_uid, current_gid)
  }
  if access_mode == 1 {
    return perms.can_write(&stat, current_uid, current_gid)
  }
  if perms.can_read(&stat, current_uid, current_gid) == 0 { return 0 }
  return perms.can_write(&stat, current_uid, current_gid)
}

// Open a homefs path. Returns a descriptor, or 0 — including when the path is
// not under the mount point, which is how vfs_open knows to carry on with the
// inode table.
fn homefs_open(path: u64, flags: u32, mode: u32): u32 {
  if homefs_path_offset(path) == 0 { return 0 }

  var object: u64 = vfs_homefs_resolve(path)
  if object == 0 {
    // O_CREAT is bit 6, as elsewhere in this file.
    if (flags & 0x40) == 0 { return 0 }
    object = homefs_create_at(path, mode)
    if object == 0 { return 0 }
  }
  if homefs.homefs_object_kind(object) != homefs.OBJ_KIND_FILE { return 0 }
  if homefs_may_open(object, flags) == 0 { return 0 }

  var i: u32 = 0
  while i < MAX_OPEN_FILES {
    if open_files[i].ref_count == 0 {
      open_files[i].ino = 0
      open_files[i].offset = 0
      open_files[i].flags = flags
      open_files[i].ref_count = 1
      open_files[i].homefs_object = object
      open_files[i].device_id = 0
      open_files[i].pipe_id = 0
      open_files[i].pipe_end = 0
      open_file_count = open_file_count + 1
      return i + 3
    }
    i = i + 1
  }
  return 0
}

// Create the file `path` names, in the directory above it. The parent has to
// exist: creating intermediate directories is mkdir -p, which no caller of
// open() expects.
fn homefs_create_at(path: u64, mode: u32): u64 {
  let start: u32 = homefs_path_offset(path)
  if start == 0 { return 0 }

  // Find the last component, and the length of everything before it.
  var i: u32 = start
  var last: u32 = start
  loop {
    let c: u8 = @as(*u8, @ptrFromInt(path + @as(u64, i))).*
    if c == 0 { break }
    if c == 47 { last = i + 1 }
    i = i + 1
  }
  let name: u64 = path + @as(u64, last)
  let name_len: u32 = i - last
  if name_len == 0 { return 0 }

  // The parent is the path truncated at the separator. Truncating in place
  // and restoring afterwards avoids a second buffer; the path belongs to the
  // caller for the duration of this call.
  var parent: u64 = homefs.HOMEFS_ROOT_DIR
  if last > start {
    let cut: u64 = path + @as(u64, last - 1)
    let saved: u8 = @as(*u8, @ptrFromInt(cut)).*
    @as(*u8, @ptrFromInt(cut)).* = 0
    parent = vfs_homefs_resolve(path)
    @as(*u8, @ptrFromInt(cut)).* = saved
    if parent == 0 { return 0 }
  }

  let object: u64 = homefs.homefs_create(parent, name, name_len,
                                         homefs.OBJ_KIND_FILE)
  if object == 0 { return 0 }
  // The creator owns it. Without this every file on the volume belongs to
  // uid 0, and the permission check above would be checking the wrong thing
  // rather than nothing — which is worse.
  var create_mode: u32 = mode
  if create_mode == 0 { create_mode = 0o644 }
  if homefs.homefs_set_object_mode(object, create_mode, current_uid, current_gid) == 0 {
    return 0
  }
  if homefs.homefs_commit_transaction() == 0 { return 0 }
  return object
}

// `mode` is POSIX's third argument to open(): the permissions a file is
// created with when O_CREAT is set, ignored otherwise. It defaults to 0 so
// the common case of opening an existing file need not mention it — and
// callers that were already passing one, against a signature that had no
// room for it, now have it honoured instead of discarded.
export fn vfs_open(path: u64, flags: u32, mode: u32 = 0): u32 {
  if open_file_count >= MAX_OPEN_FILES { return 0 }

  // A device node, checked first: /dev is not a place the inode table should
  // be inventing files.
  if vfs_dev_lookup(path) != devfs.DEVFS_NO_DEVICE { return dev_open(path, flags) }
  if homefs_path_offset(path) != 0 { return homefs_open(path, flags, mode) }

  // Resolve the path. This used to allocate a fresh inode per call and ignore
  // the path entirely, so every path "opened" and read back empty — a cat of
  // a file that does not exist was indistinguishable from one that does.
  var ino: u32 = path_resolve(path)

  if ino == 0 {
    // O_CREAT is bit 6 in the flags this tree uses. Without it a missing file
    // is an error, which is the whole point of resolving.
    if (flags & 0x40) == 0 { return 0 }

    // The caller's mode, or the usual default when it did not state one.
    var create_mode: u32 = mode
    if create_mode == 0 { create_mode = 0o644 }
    ino = inode_alloc(FILE_TYPE_REGULAR, create_mode)
    if ino == 0 { return 0 }

    // Link it into its parent so it can be found again. A file created but
    // not linked is invisible to every later open, which is the same bug in a
    // different place.
    if link_into_parent(path, ino) != 0 {
      inode_free(ino)
      return 0
    }
  }

  // Check permissions before opening
  var inode_ptr: u64 = inode_get(ino)
  if inode_ptr != 0 {
    var inode: Inode = @as(*Inode, @ptrFromInt(inode_ptr)).*

    // Determine required access mode based on flags
    // O_RDONLY = 0, O_WRONLY = 1, O_RDWR = 2
    var access_mode: u32 = flags & 0x3

    if access_mode == 0 {
      // Read-only: check read permission
      if perms.can_read(&inode, current_uid, current_gid) == 0 {
        inode_free(ino)
        return 0  // Permission denied
      }
    } else if access_mode == 1 {
      // Write-only: check write permission
      if perms.can_write(&inode, current_uid, current_gid) == 0 {
        inode_free(ino)
        return 0  // Permission denied
      }
    } else if access_mode == 2 {
      // Read-write: check both permissions
      if perms.can_read(&inode, current_uid, current_gid) == 0 or perms.can_write(&inode, current_uid, current_gid) == 0 {
        inode_free(ino)
        return 0  // Permission denied
      }
    }
  }

  // Add to open file table
  var i: u32 = 0
  while i < MAX_OPEN_FILES {
    if open_files[i].ref_count == 0 {
      open_files[i].ino = ino
      open_files[i].offset = 0
      open_files[i].flags = flags
      open_files[i].ref_count = 1
      // Slots are reused, and a stale object or device id here would send
      // this descriptor's reads to whatever used the slot before it.
      open_files[i].homefs_object = 0
      open_files[i].device_id = 0
      open_files[i].pipe_id = 0
      open_files[i].pipe_end = 0

      open_file_count = open_file_count + 1

      // The descriptor *is* the slot, offset past the three standard
      // streams. It used to come from a monotonic counter while the slot
      // came from this free-slot scan, so the two agreed only until the
      // first close: the second open after a close returned fd 4 while
      // occupying slot 0, and every read and write on it addressed slot 1,
      // which was empty. The file opened, wrote nothing, and read back
      // empty. vfs_read, vfs_write, vfs_lseek and vfs_fsync all already
      // compute the slot as fd - 3.
      return i + 3
    }
    i = i + 1
  }

  return 0
}

export fn vfs_close(fd: u32): u32 {
  if fd < 3 { return 1 }  // Can't close stdin/stdout/stderr
  
  var idx: u32 = fd - 3
  if idx >= MAX_OPEN_FILES { return 1 }
  
  if open_files[idx].ref_count > 0 {
    open_files[idx].ref_count = open_files[idx].ref_count - 1
    
    if open_files[idx].ref_count == 0 {
      open_file_count = open_file_count - 1
      // A pipe end is released before the slot is cleared, or the pipe would
      // keep counting a reader or writer that no longer exists — and a reader
      // waiting on a writer that has gone would wait for ever.
      if open_files[idx].pipe_id != 0 {
        pipe_release(open_files[idx].pipe_id, open_files[idx].pipe_end)
      }
      // The slot is free for reuse, and a stale object or device id in it
      // would send the next descriptor's reads to this file.
      open_files[idx].homefs_object = 0
      open_files[idx].device_id = 0
      open_files[idx].pipe_id = 0
      open_files[idx].pipe_end = 0
    }
    
    return 0
  }
  
  return 1
}

export fn vfs_read(fd: u32, buffer: u64, count: u64): u64 {
  if fd < 3 { return 0 }  // Special handling for stdin

  var idx: u32 = fd - 3
  if idx >= MAX_OPEN_FILES { return 0 }

  if open_files[idx].ref_count == 0 { return 0 }

  // A pipe end has no offset and no inode: the bytes are in the pipe, and a
  // read that finds none is either waiting or finished — vfs_pipe_fd_at_eof
  // is what tells those apart, and the syscall layer above asks it, because
  // waiting means yielding and this layer cannot.
  if open_files[idx].pipe_id != 0 {
    if open_files[idx].pipe_end != PIPE_END_READ { return 0 }
    return pipe_read_bytes(open_files[idx].pipe_id, buffer, count)
  }

  if open_files[idx].device_id != 0 {
    let moved: u32 = devfs.devfs_read(open_files[idx].device_id - 1, buffer,
                                      @as(u32, count), open_files[idx].offset)
    open_files[idx].offset = open_files[idx].offset + @as(u64, moved)
    return @as(u64, moved)
  }

  // A homefs file's permissions were checked at open, against its own mode
  // and owner, by the same perms code the inode path uses below.
  if open_files[idx].homefs_object != 0 {
    let got: u32 = homefs.homefs_file_read(open_files[idx].homefs_object,
                                           open_files[idx].offset, buffer,
                                           @as(u32, count))
    open_files[idx].offset = open_files[idx].offset + @as(u64, got)
    return @as(u64, got)
  }

  var ino: u32 = open_files[idx].ino
  var inode_ptr: u64 = inode_get(ino)
  if inode_ptr == 0 { return 0 }

  var inode: Inode = @as(*Inode, @ptrFromInt(inode_ptr)).*

  // Check read permission
  if perms.can_read(&inode, current_uid, current_gid) == 0 {
    return 0  // Permission denied
  }

  var offset: u64 = open_files[idx].offset

  // Calculate how much we can read. Bail when the cursor is past the
  // end of file so `inode.size - offset` can't underflow u64 into a
  // huge "available" count.
  if offset >= inode.size { return 0 }
  var available: u64 = inode.size - offset
  var to_read: u64 = count
  if to_read > available { to_read = available }
  
  // Read from data blocks
  var bytes_read: u64 = 0
  var block_idx: u32 = offset / BLOCK_SIZE
  var block_offset: u32 = offset % BLOCK_SIZE
  
  while bytes_read < to_read and block_idx < 12 {
    var block_addr: u64 = inode.data_blocks[block_idx]
    if block_addr == 0 { break }
    
    var bytes_in_block: u64 = BLOCK_SIZE - block_offset
    if bytes_in_block > (to_read - bytes_read) {
      bytes_in_block = to_read - bytes_read
    }
    
    // Copy data
    var src: u64 = block_addr + block_offset
    var dst: u64 = buffer + bytes_read
    var i: u64 = 0
    while i < bytes_in_block {
      @as(*u8, @ptrFromInt(dst + i)).* = @as(*u8, @ptrFromInt(src + i)).*
      i = i + 1
    }
    
    bytes_read = bytes_read + bytes_in_block
    block_idx = block_idx + 1
    block_offset = 0
  }
  
  // Update offset
  open_files[idx].offset = offset + bytes_read
  
  return bytes_read
}

export fn vfs_write(fd: u32, buffer: u64, count: u64): u64 {
  if fd < 3 {
    // Special handling for stdout/stderr
    if fd == 1 or fd == 2 {
      var i: u64 = 0
      while i < count {
        var c: u8 = @as(*u8, @ptrFromInt(buffer + i)).*
        foundation.serial_write_char(c)
        foundation.vga_write_char(c)
        i = i + 1
      }
      return count
    }
    return 0
  }

  var idx: u32 = fd - 3
  if idx >= MAX_OPEN_FILES { return 0 }

  if open_files[idx].ref_count == 0 { return 0 }

  if open_files[idx].pipe_id != 0 {
    if open_files[idx].pipe_end != PIPE_END_WRITE { return 0 }
    return pipe_write_bytes(open_files[idx].pipe_id, buffer, count)
  }

  if open_files[idx].device_id != 0 {
    let moved: u32 = devfs.devfs_write(open_files[idx].device_id - 1, buffer,
                                       @as(u32, count), open_files[idx].offset)
    open_files[idx].offset = open_files[idx].offset + @as(u64, moved)
    return @as(u64, moved)
  }

  if open_files[idx].homefs_object != 0 {
    let put: u32 = homefs.homefs_file_write(open_files[idx].homefs_object,
                                            open_files[idx].offset, buffer,
                                            @as(u32, count))
    if put == 0 { return 0 }
    // Committed per write rather than at close: a descriptor that is never
    // closed — every one held open at a crash — would otherwise lose
    // everything written through it, and homefs's whole argument is that a
    // crash costs you the last transaction and nothing more.
    if homefs.homefs_commit_transaction() == 0 { return 0 }
    open_files[idx].offset = open_files[idx].offset + @as(u64, put)
    return @as(u64, put)
  }

  var ino: u32 = open_files[idx].ino
  var inode_ptr: u64 = inode_get(ino)
  if inode_ptr == 0 { return 0 }

  var inode: Inode = @as(*Inode, @ptrFromInt(inode_ptr)).*

  // Check write permission
  if perms.can_write(&inode, current_uid, current_gid) == 0 {
    return 0  // Permission denied
  }

  // Everything below goes through the inode *table*, not the copy above.
  //
  // `var inode: Inode = ptr.*` copies. The block pointers this loop allocates
  // and the size it sets were being written into that copy and dropped on
  // return, so a file could be written and always read back empty: the data
  // was in memory, and nothing recorded where.
  var tidx: u32 = inode_find(ino)
  if tidx >= MAX_INODES { return 0 }

  var offset: u64 = open_files[idx].offset
  var bytes_written: u64 = 0
  var block_idx: u32 = offset / BLOCK_SIZE
  var block_offset: u32 = offset % BLOCK_SIZE

  while bytes_written < count and block_idx < 12 {
    // Allocate block if needed
    if inode_table[tidx].data_blocks[block_idx] == 0 {
      var new_block: u64 = memory.pmm_alloc_page()
      if new_block == 0 { break }
      inode_table[tidx].data_blocks[block_idx] = new_block
      inode_table[tidx].blocks = inode_table[tidx].blocks + 1
    }

    var block_addr: u64 = inode_table[tidx].data_blocks[block_idx]
    var bytes_in_block: u64 = BLOCK_SIZE - block_offset
    if bytes_in_block > (count - bytes_written) {
      bytes_in_block = count - bytes_written
    }
    
    // Copy data
    var src: u64 = buffer + bytes_written
    var dst: u64 = block_addr + block_offset
    var i: u64 = 0
    while i < bytes_in_block {
      @as(*u8, @ptrFromInt(dst + i)).* = @as(*u8, @ptrFromInt(src + i)).*
      i = i + 1
    }
    
    bytes_written = bytes_written + bytes_in_block
    block_idx = block_idx + 1
    block_offset = 0
  }
  
  // Update inode size and offset
  var new_offset: u64 = offset + bytes_written
  if new_offset > inode_table[tidx].size {
    inode_table[tidx].size = new_offset
  }

  open_files[idx].offset = new_offset

  return bytes_written
}

// Set an open file's length. This is what `>` needs: opening for write does
// not shorten a file, so redirecting over a longer one left the old tail in
// place and the reader saw the new output followed by the remains of the old.
//
// Returns 1 on success, 0 when the descriptor is not a truncatable file.
// A device has no length to set, so truncating one is an error rather than a
// silent success that a caller would read as "the device is now empty".
export fn vfs_ftruncate(fd: u32, length: u64): u32 {
  if fd < 3 { return 0 }
  var idx: u32 = fd - 3
  if idx >= MAX_OPEN_FILES { return 0 }
  if open_files[idx].ref_count == 0 { return 0 }
  if open_files[idx].device_id != 0 { return 0 }

  if open_files[idx].homefs_object != 0 {
    if homefs.homefs_file_truncate(open_files[idx].homefs_object, length) == 0 {
      return 0
    }
    if homefs.homefs_commit_transaction() == 0 { return 0 }
    if open_files[idx].offset > length { open_files[idx].offset = length }
    return 1
  }

  var ino: u32 = open_files[idx].ino
  var inode_ptr: u64 = inode_get(ino)
  if inode_ptr == 0 { return 0 }
  var inode: Inode = @as(*Inode, @ptrFromInt(inode_ptr)).*
  if perms.can_write(&inode, current_uid, current_gid) == 0 { return 0 }

  // Through the table, not the copy: the copy above is for the permission
  // check, and writing the size back into it would change nothing on disk.
  var live: *Inode = @ptrFromInt(inode_ptr)

  // Release the direct blocks that fall entirely past the new end. The
  // indirect block is left alone: nothing in this backend allocates one yet,
  // and freeing a block this code did not allocate would corrupt whatever
  // does allocate it later.
  if length < live.size {
    var first_dead: u32 = @truncate((length + @as(u64, BLOCK_SIZE) - 1) / @as(u64, BLOCK_SIZE), u32)
    var b: u32 = first_dead
    while b < 12 {
      if live.data_blocks[b] != 0 {
        // data_blocks holds a physical page address, as inode_free assumes.
        memory.pmm_free_page(live.data_blocks[b])
        live.data_blocks[b] = 0
        if live.blocks > 0 { live.blocks = live.blocks - 1 }
      }
      b = b + 1
    }
  }

  live.size = length
  if open_files[idx].offset > length { open_files[idx].offset = length }
  return 1
}

export fn vfs_lseek(fd: u32, offset: u64, whence: u32): u64 {
  if fd < 3 { return 0 }
  
  var idx: u32 = fd - 3
  if idx >= MAX_OPEN_FILES { return 0 }
  
  if open_files[idx].ref_count == 0 { return 0 }
  
  // whence: 0=SEEK_SET, 1=SEEK_CUR, 2=SEEK_END.
  // Guard the additive forms so a large `offset` can't wrap the file
  // cursor to 0 and let a subsequent read/write escape size limits.
  if whence == 0 {
    open_files[idx].offset = offset
  } else if whence == 1 {
    if offset > 0xFFFFFFFFFFFFFFFF - open_files[idx].offset { return 0 }
    open_files[idx].offset = open_files[idx].offset + offset
  } else if whence == 2 {
    // A device node has no end. Seeking to one is a question with no answer,
    // so the cursor is left where it was rather than moved somewhere invented.
    if open_files[idx].device_id != 0 {
      return open_files[idx].offset
    }
    if open_files[idx].homefs_object != 0 {
      let size: u64 = homefs.homefs_object_size(open_files[idx].homefs_object)
      if offset > 0xFFFFFFFFFFFFFFFF - size { return 0 }
      open_files[idx].offset = size + offset
    } else {
      var ino: u32 = open_files[idx].ino
      var inode_ptr: u64 = inode_get(ino)
      if inode_ptr != 0 {
        var inode: Inode = @as(*Inode, @ptrFromInt(inode_ptr)).*
        if offset > 0xFFFFFFFFFFFFFFFF - inode.size { return 0 }
        open_files[idx].offset = inode.size + offset
      }
    }
  }
  
  return open_files[idx].offset
}

// ============================================================================
// DIRECTORY OPERATIONS
// ============================================================================

// Split a homefs path into its parent object and its last component.
// Returns the parent's object id, or 0. `name_out` receives the address of
// the last component and `len_out` its length, both through single-element
// arrays because this backend has no out-parameters.
var homefs_split_name: [u64; 1] = undefined
var homefs_split_len: [u32; 1] = undefined

fn homefs_split_parent(path: u64): u64 {
  let start: u32 = homefs_path_offset(path)
  if start == 0 { return 0 }

  var i: u32 = start
  var last: u32 = start
  loop {
    let c: u8 = @as(*u8, @ptrFromInt(path + @as(u64, i))).*
    if c == 0 { break }
    if c == 47 { last = i + 1 }
    i = i + 1
  }
  homefs_split_name[0] = path + @as(u64, last)
  homefs_split_len[0] = i - last
  if homefs_split_len[0] == 0 { return 0 }

  if last <= start { return homefs.HOMEFS_ROOT_DIR }

  // Truncate at the separator to resolve the parent, then put the byte back.
  // The path belongs to the caller only for the duration of this call, so
  // borrowing it beats demanding a second buffer from everyone who has a
  // path already.
  let cut: u64 = path + @as(u64, last - 1)
  let saved: u8 = @as(*u8, @ptrFromInt(cut)).*
  @as(*u8, @ptrFromInt(cut)).* = 0
  let parent: u64 = vfs_homefs_resolve(path)
  @as(*u8, @ptrFromInt(cut)).* = saved
  return parent
}

// Returns 0 on success, matching vfs_mkdir's convention.
fn homefs_mkdir(path: u64, mode: u32): u32 {
  if vfs_homefs_resolve(path) != 0 { return 0 }
  let parent: u64 = homefs_split_parent(path)
  if parent == 0 { return 1 }
  let made: u64 = homefs.homefs_create(parent, homefs_split_name[0],
                                       homefs_split_len[0], homefs.OBJ_KIND_DIR)
  if made == 0 { return 1 }
  if mode != 0 {
    if homefs.homefs_set_object_mode(made, mode, current_uid, current_gid) == 0 {
      return 1
    }
  }
  if homefs.homefs_commit_transaction() == 0 { return 1 }
  return 0
}

// Remove a homefs path. `want_dir` says which kind the caller means, so
// rmdir does not silently delete a file and unlink does not delete a
// directory. Returns 0 on success.
fn homefs_remove(path: u64, want_dir: u32): u32 {
  let object: u64 = vfs_homefs_resolve(path)
  if object == 0 { return 1 }
  let kind: u32 = homefs.homefs_object_kind(object)
  if want_dir == 1 and kind != homefs.OBJ_KIND_DIR { return 1 }
  if want_dir == 0 and kind != homefs.OBJ_KIND_FILE { return 1 }

  let parent: u64 = homefs_split_parent(path)
  if parent == 0 { return 1 }
  if homefs.homefs_unlink(parent, homefs_split_name[0], homefs_split_len[0]) == 0 {
    return 1
  }
  if homefs.homefs_commit_transaction() == 0 { return 1 }
  return 0
}

// Remove a file. There is no vfs_unlink for the inode table — removing an
// entry there needs a parent-and-name resolution the inode path does not
// have yet — so this is named for what it actually covers rather than
// offered as a general unlink that works for one filesystem out of two.
export fn vfs_homefs_unlink(path: u64): u32 {
  if homefs_path_offset(path) == 0 { return 1 }
  return homefs_remove(path, 0)
}

// Remove a file's directory entry, and the file with it when nothing else
// names it.
//
// The syscall this backs used to be `if path == 0 { return EINVAL }` followed
// by `return 0` — an unlink that reported success and removed nothing, which
// a caller cannot tell from one that worked. `rm` built on that deletes no
// files and says it did.
//
// Returns 0 on success, nonzero otherwise.
export fn vfs_unlink(path: u64): u32 {
  if path == 0 { return 1 }
  if homefs_path_offset(path) != 0 { return homefs_remove(path, 0) }

  // The link, not what it points at: `rm link` removes the name given, and
  // following it would delete the file the user did not name.
  var ino: u32 = path_resolve_nofollow(path)
  if ino == 0 { return 1 }

  // A directory is removed with rmdir, not unlink. Saying so beats unlinking
  // one and leaving its contents unreachable.
  var inode_ptr: u64 = inode_get(ino)
  if inode_ptr == 0 { return 1 }
  var inode: Inode = @as(*Inode, @ptrFromInt(inode_ptr)).*
  if inode.file_type == FILE_TYPE_DIRECTORY { return 1 }

  // The parent and the leaf, split the way link_into_parent splits them.
  var len: u64 = 0
  while @as(*u8, @ptrFromInt(path + len)).* != 0 {
    len = len + 1
  }
  if len == 0 { return 1 }

  var last_sep: u64 = 0
  var found_sep: u32 = 0
  var i: u64 = 0
  while i < len {
    if @as(*u8, @ptrFromInt(path + i)).* == 47 {
      last_sep = i
      found_sep = 1
    }
    i = i + 1
  }

  var parent: u32 = ROOT_INO
  if found_sep == 1 and last_sep > 0 {
    var saved: u8 = @as(*u8, @ptrFromInt(path + last_sep)).*
    @as(*u8, @ptrFromInt(path + last_sep)).* = 0
    parent = path_resolve(path)
    @as(*u8, @ptrFromInt(path + last_sep)).* = saved
    if parent == 0 { return 1 }
  }

  // Write permission on the parent is what governs removal — the file's own
  // mode does not, which is why a read-only file in a writable directory can
  // be removed.
  var parent_ptr: u64 = inode_get(parent)
  if parent_ptr != 0 {
    var pnode: Inode = @as(*Inode, @ptrFromInt(parent_ptr)).*
    if perms.can_write(&pnode, current_uid, current_gid) == 0 { return 1 }
  }

  var name_start: u64 = last_sep
  if found_sep == 1 { name_start = last_sep + 1 }

  var name_len: u32 = 0
  var j: u64 = name_start
  while j < len {
    if name_len >= 255 { return 1 }
    component[name_len] = @as(*u8, @ptrFromInt(path + j)).*
    name_len = name_len + 1
    j = j + 1
  }
  if name_len == 0 { return 1 }
  component[name_len] = 0

  if dir_remove_entry(parent, &component, name_len) != 0 { return 1 }

  // The entry is gone; the file goes with it once no name is left. Through
  // the table, not the copy above, or the count would be decremented on a
  // value that is thrown away.
  var live: *Inode = @ptrFromInt(inode_ptr)
  if live.link_count > 0 { live.link_count = live.link_count - 1 }
  if live.link_count == 0 { inode_free(ino) }
  return 0
}

export fn vfs_mkdir(path: u64, mode: u32): u32 {
  if homefs_path_offset(path) != 0 { return homefs_mkdir(path, mode) }

  // Already there is success, not an error: an initramfs names each parent
  // directory before the files inside it, and archives often name the same
  // one more than once.
  if path_resolve(path) != 0 { return 0 }

  var root_inode_ptr: u64 = inode_get(1)
  if root_inode_ptr != 0 {
    var root: Inode = @as(*Inode, @ptrFromInt(root_inode_ptr)).*
    // Need write and execute permission on parent directory
    if perms.can_write(&root, current_uid, current_gid) == 0 or perms.can_access_directory(&root, current_uid, current_gid) == 0 {
      return 1  // Permission denied
    }
  }

  var ino: u32 = inode_alloc(FILE_TYPE_DIRECTORY, mode)
  if ino == 0 { return 1 }

  // Set ownership to current user
  var inode_ptr: u64 = inode_get(ino)
  if inode_ptr != 0 {
    var inode: Inode = @as(*Inode, @ptrFromInt(inode_ptr)).*
    inode.uid = current_uid
    inode.gid = current_gid
  }

  // Link it into its parent. Allocating the inode and stopping — which is
  // what this did — leaves a directory that exists in the table and cannot be
  // reached by name, so the files an initramfs puts inside it have nowhere to
  // be created.
  if link_into_parent(path, ino) != 0 {
    inode_free(ino)
    return 1
  }

  return 0
}

export fn vfs_rmdir(path: u64): u32 {
  if homefs_path_offset(path) != 0 { return homefs_remove(path, 1) }

  // TODO: Get directory inode from path
  // For now, check if we can write to root directory
  var root_inode_ptr: u64 = inode_get(1)
  if root_inode_ptr != 0 {
    var root: Inode = @as(*Inode, @ptrFromInt(root_inode_ptr)).*
    // Need write and execute permission on parent directory
    if perms.can_write(&root, current_uid, current_gid) == 0 or perms.can_access_directory(&root, current_uid, current_gid) == 0 {
      return 1  // Permission denied
    }
  }

  foundation.serial_write_string("[VFS] Removed directory\n")
  return 0
}

// ============================================================================
// PERMISSION MANAGEMENT
// ============================================================================

export fn vfs_chmod(path: u64, mode: u32): u32 {
  // TODO: Get inode from path
  // For now, just return success
  foundation.serial_write_string("[VFS] Changed permissions\n")
  return 0
}

export fn vfs_chown(path: u64, uid: u32, gid: u32): u32 {
  // TODO: Get inode from path
  // For now, check if current user is root
  if current_uid != 0 {
    return 1  // Only root can change ownership
  }

  foundation.serial_write_string("[VFS] Changed ownership\n")
  return 0
}

export fn vfs_set_uid(uid: u32) {
  current_uid = uid
}

export fn vfs_set_gid(gid: u32) {
  current_gid = gid
}

// ============================================================================
// FILESYSTEM STATISTICS (statfs)
// ============================================================================

export struct StatFS {
  f_type: u32,        // Type of filesystem
  f_bsize: u32,       // Optimal transfer block size
  f_blocks: u64,      // Total data blocks in filesystem
  f_bfree: u64,       // Free blocks in filesystem
  f_bavail: u64,      // Free blocks available to unprivileged user
  f_files: u64,       // Total inodes
  f_ffree: u64,       // Free inodes
  f_fsid: u64,        // Filesystem ID
  f_namelen: u32,     // Maximum length of filenames
  f_frsize: u32       // Fragment size
}

// Filesystem type constants
const FS_TYPE_HOMEFS: u32 = 0x484F4D45  // "HOME"
const FS_TYPE_TMPFS: u32 = 0x01021994
const FS_TYPE_EXT2: u32 = 0xEF53

// Mount point structure
struct MountPoint {
  path: [u8; 64],
  path_len: u32,
  fs_type: u32,
  device: [u8; 32],
  device_len: u32,
  total_blocks: u64,
  free_blocks: u64,
  total_inodes: u64,
  free_inodes: u64,
  block_size: u32,
  mounted: u32
}

const MAX_MOUNTS: u32 = 16
var mount_table: [MountPoint; 16] = undefined
var mount_count: u32 = 0

// Initialize default mount points.
//
// These used to be invented: two homefs volumes on /dev/sda1 and /dev/sda2
// with 10 GB and 20 GB capacities and plausible free-space figures, none of
// which corresponded to a device, a filesystem, or a number anything had
// measured. vfs_statfs reported them, so `df` printed a disk layout the
// machine did not have.
//
// What is true is that "/" is served by the in-memory inode table above, and
// that a homefs volume appears only once one is actually mounted — which is
// what vfs_mount_homefs does, with figures homefs itself reports.
fn init_mount_table() {
  // The root filesystem is this file's inode table: it lives in RAM, it is
  // sized by MAX_INODES, and it does not survive a reboot. Calling it tmpfs
  // is what it is.
  mount_table[0].path[0] = '/'
  mount_table[0].path_len = 1
  mount_table[0].fs_type = FS_TYPE_TMPFS
  copy_string_to_array("rootfs", &mount_table[0].device, 32)
  mount_table[0].device_len = 6
  // One block per inode is the table's own shape, not a disk's. Reporting
  // the inode table's real capacity beats reporting a disk that is not there.
  mount_table[0].total_blocks = @as(u64, MAX_INODES)
  mount_table[0].free_blocks = @as(u64, MAX_INODES - inode_count)
  mount_table[0].total_inodes = @as(u64, MAX_INODES)
  mount_table[0].free_inodes = @as(u64, MAX_INODES - inode_count)
  mount_table[0].block_size = BLOCK_SIZE
  mount_table[0].mounted = 1

  mount_table[1].path[0] = '/'
  mount_table[1].path[1] = 't'
  mount_table[1].path[2] = 'm'
  mount_table[1].path[3] = 'p'
  mount_table[1].path_len = 4
  mount_table[1].fs_type = FS_TYPE_TMPFS
  copy_string_to_array("tmpfs", &mount_table[1].device, 32)
  mount_table[1].device_len = 5
  mount_table[1].total_blocks = @as(u64, MAX_INODES)
  mount_table[1].free_blocks = @as(u64, MAX_INODES - inode_count)
  mount_table[1].total_inodes = @as(u64, MAX_INODES)
  mount_table[1].free_inodes = @as(u64, MAX_INODES - inode_count)
  mount_table[1].block_size = BLOCK_SIZE
  mount_table[1].mounted = 1

  mount_count = 2
}

fn copy_string_to_array(src: []u8, dst: *[u8; 32], max_len: u32) {
  var i: u32 = 0
  while i < src.len and i < max_len - 1 {
    dst[i] = src[i]
    i = i + 1
  }
  dst[i] = 0
}

// Get filesystem statistics for a path
// Bring the homefs mount row up to date from the volume itself.
fn refresh_homefs_mount_row() {
  if vfs_homefs_mounted() == 0 { return }
  var i: u32 = 0
  while i < mount_count {
    if mount_table[i].fs_type == FS_TYPE_HOMEFS {
      let total: u32 = homefs.homefs_device_blocks()
      let live: u32 = homefs.homefs_blocks_live()
      mount_table[i].total_blocks = @as(u64, total)
      mount_table[i].free_blocks = @as(u64, total - live)
      mount_table[i].total_inodes = @as(u64, total)
      mount_table[i].free_inodes = @as(u64, total - live)
    }
    i = i + 1
  }
}

export fn vfs_statfs(path: u64, buf: *StatFS): u32 {
  var path_str: *u8 = @ptrFromInt(path)

  // A homefs volume's free space changes with every commit and every sweep,
  // so its row is refreshed here rather than left as whatever was true at
  // mount. A figure that was measured once and then reported forever is the
  // same kind of answer as one that was invented.
  refresh_homefs_mount_row()

  // Find matching mount point (longest prefix match)
  var best_match: i32 = -1
  var best_len: u32 = 0

  var i: u32 = 0
  while i < mount_count {
    if mount_table[i].mounted == 1 {
      // Check if path starts with mount point
      var matches: u32 = 1
      var j: u32 = 0
      while j < mount_table[i].path_len {
        if path_str[j] != mount_table[i].path[j] {
          matches = 0
          break
        }
        j = j + 1
      }
      if matches == 1 and mount_table[i].path_len > best_len {
        best_match = @intCast(i)
        best_len = mount_table[i].path_len
      }
    }
    i = i + 1
  }

  if best_match < 0 {
    return 1  // No matching mount point
  }

  var mp: *MountPoint = &mount_table[@intCast(best_match)]

  buf.f_type = mp.fs_type
  buf.f_bsize = mp.block_size
  buf.f_blocks = mp.total_blocks
  buf.f_bfree = mp.free_blocks
  buf.f_bavail = mp.free_blocks  // Same as f_bfree for non-quota systems
  buf.f_files = mp.total_inodes
  buf.f_ffree = mp.free_inodes
  buf.f_fsid = @as(u64, best_match)
  buf.f_namelen = MAX_NAME_LEN
  buf.f_frsize = mp.block_size

  return 0
}

// Get number of mounted filesystems
export fn vfs_get_mount_count(): u32 {
  return mount_count
}

// Get mount point info by index
export fn vfs_get_mount_info(index: u32, path: *[u8; 64], device: *[u8; 32],
                              total: *u64, free: *u64, block_size: *u32): u32 {
  if index >= mount_count { return 1 }
  if mount_table[index].mounted == 0 { return 1 }

  // Copy path
  var i: u32 = 0
  while i < mount_table[index].path_len and i < 63 {
    path[i] = mount_table[index].path[i]
    i = i + 1
  }
  path[i] = 0

  // Copy device
  i = 0
  while i < mount_table[index].device_len and i < 31 {
    device[i] = mount_table[index].device[i]
    i = i + 1
  }
  device[i] = 0

  total.* = mount_table[index].total_blocks * mount_table[index].block_size
  free.* = mount_table[index].free_blocks * mount_table[index].block_size
  block_size.* = mount_table[index].block_size

  return 0
}

// ============================================================================
// PIPES
//
// A pipe is a kernel buffer with a reader and a writer. sys_pipe used to hand
// back descriptor numbers 200, 201, 202… counted up from a global that
// nothing answered to: a write to the write end went nowhere and a read from
// the read end returned 0, which reads as end of file, so a shell built on it
// saw every pipeline produce empty output and no error (MASTER_PLAN §7, S14).
//
// A ring buffer, so a reader that keeps up lets a writer keep going without
// either end moving bytes about. The two ends are two open-file slots naming
// the same pipe; there is no descriptor indirection here, so they cannot be
// dup'd — dup needs the open-file table reference-counted from the descriptor
// side, which is a separate change and is why dup still refuses.
// ============================================================================

const PIPE_CAPACITY: u32 = 4096
const MAX_PIPES: u32 = 16

const PIPE_END_READ: u32 = 1
const PIPE_END_WRITE: u32 = 2

struct Pipe {
  data: [u8; 4096],
  head: u32,        // where the next read comes from
  count: u32,       // bytes held; the write position is (head + count) % capacity
  readers: u32,
  writers: u32,
  used: u32
}

var pipes: [Pipe; 16] = undefined

// A free pipe, opened with one reader and one writer. Returns its id plus
// one, or 0 when there is none — the plus one is so that 0 keeps meaning "not
// a pipe" in a descriptor.
fn pipe_alloc(): u32 {
  var i: u32 = 0
  while i < MAX_PIPES {
    if pipes[i].used == 0 {
      pipes[i].used = 1
      pipes[i].head = 0
      pipes[i].count = 0
      pipes[i].readers = 1
      pipes[i].writers = 1
      return i + 1
    }
    i = i + 1
  }
  return 0
}

// Bytes moved into the pipe, which may be fewer than asked for when it fills.
// Returns 0 when no reader is left: those bytes would have nowhere to go, and
// a writer needs to be able to tell that from a pipe that is merely full.
fn pipe_write_bytes(id: u32, buf: u64, count: u64): u64 {
  if id == 0 or id > MAX_PIPES { return 0 }
  let p: u32 = id - 1
  if pipes[p].used == 0 { return 0 }
  if pipes[p].readers == 0 { return 0 }

  var moved: u64 = 0
  while moved < count {
    if pipes[p].count >= PIPE_CAPACITY { break }
    let at: u32 = (pipes[p].head + pipes[p].count) % PIPE_CAPACITY
    pipes[p].data[at] = @as(*u8, @ptrFromInt(buf + moved)).*
    pipes[p].count = pipes[p].count + 1
    moved = moved + 1
  }
  return moved
}

// Bytes moved out. 0 means the pipe is empty; whether that is end-of-file or
// a reader that should wait is pipe_read_eof's question, not this one's.
fn pipe_read_bytes(id: u32, buf: u64, count: u64): u64 {
  if id == 0 or id > MAX_PIPES { return 0 }
  let p: u32 = id - 1
  if pipes[p].used == 0 { return 0 }

  var moved: u64 = 0
  while moved < count {
    if pipes[p].count == 0 { break }
    @as(*u8, @ptrFromInt(buf + moved)).* = pipes[p].data[pipes[p].head]
    pipes[p].head = (pipes[p].head + 1) % PIPE_CAPACITY
    pipes[p].count = pipes[p].count - 1
    moved = moved + 1
  }
  return moved
}

// Whether a reader finding the pipe empty has reached the end rather than
// somewhere to wait. Empty with no writer left is end of file; empty with a
// writer still open means more may arrive.
fn pipe_at_eof(id: u32): u32 {
  if id == 0 or id > MAX_PIPES { return 1 }
  let p: u32 = id - 1
  if pipes[p].used == 0 { return 1 }
  if pipes[p].count > 0 { return 0 }
  if pipes[p].writers > 0 { return 0 }
  return 1
}

// Whether a writer finding the pipe full has somewhere to wait for. Full with
// no reader left is a broken pipe, and waiting on it would never end.
fn pipe_has_reader(id: u32): u32 {
  if id == 0 or id > MAX_PIPES { return 0 }
  let p: u32 = id - 1
  if pipes[p].used == 0 { return 0 }
  if pipes[p].readers > 0 { return 1 }
  return 0
}

// Release one end. The pipe itself goes when both ends are gone — not when
// either is, or a reader still holding buffered bytes would lose them the
// moment the writer finished.
fn pipe_release(id: u32, end: u32) {
  if id == 0 or id > MAX_PIPES { return }
  let p: u32 = id - 1
  if pipes[p].used == 0 { return }

  if end == PIPE_END_READ {
    if pipes[p].readers > 0 { pipes[p].readers = pipes[p].readers - 1 }
  } else if end == PIPE_END_WRITE {
    if pipes[p].writers > 0 { pipes[p].writers = pipes[p].writers - 1 }
  }

  if pipes[p].readers == 0 and pipes[p].writers == 0 {
    pipes[p].used = 0
    pipes[p].head = 0
    pipes[p].count = 0
  }
}

// Open a pipe and return its two ends as descriptors: the read end through
// `read_fd`, the write end through `write_fd`. Returns 0 on success.
export fn vfs_pipe(read_fd: *u32, write_fd: *u32): u32 {
  let id: u32 = pipe_alloc()
  if id == 0 { return 1 }

  let r: u32 = pipe_open_end(id, PIPE_END_READ)
  if r == 0 {
    pipe_release(id, PIPE_END_READ)
    pipe_release(id, PIPE_END_WRITE)
    return 1
  }
  let w: u32 = pipe_open_end(id, PIPE_END_WRITE)
  if w == 0 {
    // The read end is already a live descriptor; closing it releases its half
    // and the write half goes with the pipe.
    vfs_close(r)
    pipe_release(id, PIPE_END_WRITE)
    return 1
  }

  read_fd.* = r
  write_fd.* = w
  return 0
}

// One end of `id` as a descriptor, or 0 when there is no free slot.
fn pipe_open_end(id: u32, end: u32): u32 {
  var i: u32 = 0
  while i < MAX_OPEN_FILES {
    if open_files[i].ref_count == 0 {
      open_files[i].ino = 0
      open_files[i].offset = 0
      open_files[i].flags = 0
      open_files[i].ref_count = 1
      open_files[i].homefs_object = 0
      open_files[i].device_id = 0
      open_files[i].pipe_id = id
      open_files[i].pipe_end = end
      open_file_count = open_file_count + 1
      return i + 3
    }
    i = i + 1
  }
  return 0
}

// Whether `fd` is a pipe end, and which. Callers above the VFS need this
// because a read that finds a pipe empty has to wait rather than report end
// of file, and only the syscall layer can yield.
export fn vfs_fd_pipe_end(fd: u32): u32 {
  if fd < 3 { return 0 }
  let idx: u32 = fd - 3
  if idx >= MAX_OPEN_FILES { return 0 }
  if open_files[idx].ref_count == 0 { return 0 }
  if open_files[idx].pipe_id == 0 { return 0 }
  return open_files[idx].pipe_end
}

// Whether a read on this pipe descriptor that returned nothing has reached
// the end of the data, rather than a point to wait at.
export fn vfs_pipe_fd_at_eof(fd: u32): u32 {
  if fd < 3 { return 1 }
  let idx: u32 = fd - 3
  if idx >= MAX_OPEN_FILES { return 1 }
  if open_files[idx].ref_count == 0 { return 1 }
  return pipe_at_eof(open_files[idx].pipe_id)
}

// Whether a write on this pipe descriptor that moved nothing was blocked by a
// full pipe someone may yet drain, rather than by having no reader at all.
export fn vfs_pipe_fd_has_reader(fd: u32): u32 {
  if fd < 3 { return 0 }
  let idx: u32 = fd - 3
  if idx >= MAX_OPEN_FILES { return 0 }
  if open_files[idx].ref_count == 0 { return 0 }
  return pipe_has_reader(open_files[idx].pipe_id)
}

// ============================================================================
// FILE METADATA
// ============================================================================

// What `stat` reports about one file. This is the VFS's own shape, not the
// POSIX struct: sys/syscall.home lays those bytes out for userspace, and
// keeping the two apart means a change to the ABI does not reach in here.
export struct StatInfo {
  ino: u32,
  file_type: u32,       // FILE_TYPE_REGULAR / FILE_TYPE_DIRECTORY / ...
  mode: u32,            // permission bits
  uid: u32,
  gid: u32,
  link_count: u32,
  size: u64,
  blocks: u32,
  atime: u64,
  mtime: u64,
  ctime: u64
}

// Fill `out` with what is known about `path`. Returns 0 on success, non-zero
// if the path does not resolve.
//
// A file lives in one of two disjoint namespaces — the in-memory inode table
// or a mounted homefs volume — so this branches the way every other path
// operation in this file does rather than trying to keep one in step with the
// other. homefs carries no timestamps yet, so those come back zero: a zero
// mtime is visibly not a time, where a fabricated one would be believed.
// One place where an inode becomes a StatInfo. stat, lstat and fstat all end
// here, so the three cannot come to disagree about what a field means.
fn stat_from_inode(ino: u32, out: *StatInfo): u32 {
  let idx: u32 = inode_find(ino)
  if idx >= MAX_INODES { return 1 }

  out.*.ino = inode_table[idx].ino
  out.*.file_type = inode_table[idx].file_type
  out.*.mode = inode_table[idx].mode
  out.*.uid = inode_table[idx].uid
  out.*.gid = inode_table[idx].gid
  out.*.link_count = inode_table[idx].link_count
  out.*.size = inode_table[idx].size
  out.*.blocks = inode_table[idx].blocks
  out.*.atime = inode_table[idx].atime
  out.*.mtime = inode_table[idx].mtime
  out.*.ctime = inode_table[idx].ctime
  return 0
}

export fn vfs_stat(path: u64, out: *StatInfo): u32 {
  if path == 0 { return 1 }

  if homefs_path_offset(path) != 0 {
    let object: u64 = vfs_homefs_resolve(path)
    if object == 0 { return 1 }

    out.*.ino = @truncate(object, u32)
    if homefs.homefs_object_kind(object) == homefs.OBJ_KIND_DIR {
      out.*.file_type = FILE_TYPE_DIRECTORY
    } else {
      out.*.file_type = FILE_TYPE_REGULAR
    }
    out.*.mode = homefs.homefs_object_mode(object)
    out.*.uid = homefs.homefs_object_uid(object)
    out.*.gid = homefs.homefs_object_gid(object)
    out.*.link_count = 1
    out.*.size = homefs.homefs_object_size(object)
    out.*.blocks = @truncate((out.*.size + 511) / 512, u32)
    out.*.atime = 0
    out.*.mtime = 0
    out.*.ctime = 0
    return 0
  }

  let ino: u32 = inode_lookup(path)
  if ino == 0 { return 1 }
  return stat_from_inode(ino, out)
}

// The same, for an open descriptor. A descriptor belongs to exactly one
// namespace — homefs_object is non-zero or it is an inode — so there is no
// path to re-resolve and no chance of resolving to a different file than the
// one the descriptor was opened on.
export fn vfs_fstat(fd: u32, out: *StatInfo): u32 {
  if fd < 3 { return 1 }
  let idx: u32 = fd - 3
  if idx >= MAX_OPEN_FILES { return 1 }
  if open_files[idx].ref_count == 0 { return 1 }

  let object: u64 = open_files[idx].homefs_object
  if object != 0 {
    out.*.ino = @truncate(object, u32)
    if homefs.homefs_object_kind(object) == homefs.OBJ_KIND_DIR {
      out.*.file_type = FILE_TYPE_DIRECTORY
    } else {
      out.*.file_type = FILE_TYPE_REGULAR
    }
    out.*.mode = homefs.homefs_object_mode(object)
    out.*.uid = homefs.homefs_object_uid(object)
    out.*.gid = homefs.homefs_object_gid(object)
    out.*.link_count = 1
    out.*.size = homefs.homefs_object_size(object)
    out.*.blocks = @truncate((out.*.size + 511) / 512, u32)
    out.*.atime = 0
    out.*.mtime = 0
    out.*.ctime = 0
    return 0
  }

  return stat_from_inode(open_files[idx].ino, out)
}

// stat follows a symlink; lstat reports on the link itself. The only
// difference is which walk resolves the leaf.
export fn vfs_lstat(path: u64, out: *StatInfo): u32 {
  if path == 0 { return 1 }

  // A homefs volume holds no symlinks, so there is nothing there for lstat to
  // report differently and stat's answer is already the right one.
  if homefs_path_offset(path) != 0 { return vfs_stat(path, out) }

  let ino: u32 = path_resolve_nofollow(path)
  if ino == 0 { return 1 }
  return stat_from_inode(ino, out)
}

// ============================================================================
// LINKS
// ============================================================================

// A second name for an existing file.
//
// The inode already counts its names — vfs_unlink decrements link_count and
// frees the file only when it reaches zero — so a hard link is one directory
// entry pointing at an inode that already has one, and nothing else has to
// change. Directories are refused: a directory with two names has no single
// parent, and `..` would have to pick one.
export fn vfs_link(oldpath: u64, newpath: u64): u32 {
  if oldpath == 0 or newpath == 0 { return 1 }

  // homefs objects are addressed by id and its directory tree stores one name
  // per object; giving an object a second name is a homefs change, not a VFS
  // one, so this refuses rather than pretending.
  if homefs_path_offset(oldpath) != 0 { return 1 }
  if homefs_path_offset(newpath) != 0 { return 1 }

  let ino: u32 = path_resolve(oldpath)
  if ino == 0 { return 1 }

  let ptr: u64 = inode_get(ino)
  if ptr == 0 { return 1 }
  var live: *Inode = @ptrFromInt(ptr)
  if live.file_type == FILE_TYPE_DIRECTORY { return 1 }

  // Refuse a name that is already taken, rather than adding a second entry
  // under it and leaving a directory with two entries of the same name.
  if path_resolve_nofollow(newpath) != 0 { return 1 }

  if link_into_parent(newpath, ino) != 0 { return 1 }
  live.link_count = live.link_count + 1
  return 0
}

// A symlink is a file whose contents are the path it points at. One page
// holds it, the same way a small regular file is held, and path_resolve reads
// it back when it walks through the link.
export fn vfs_symlink(target: u64, linkpath: u64): u32 {
  if target == 0 or linkpath == 0 { return 1 }
  if homefs_path_offset(linkpath) != 0 { return 1 }

  var len: u64 = 0
  while @as(*u8, @ptrFromInt(target + len)).* != 0 {
    len = len + 1
  }
  // 255 is what build_link_path will read back, so refusing a longer target
  // here beats storing one that can never be followed.
  if len == 0 or len > 255 { return 1 }

  if path_resolve_nofollow(linkpath) != 0 { return 1 }

  let ino: u32 = inode_alloc(FILE_TYPE_SYMLINK, 0o777)
  if ino == 0 { return 1 }

  let ptr: u64 = inode_get(ino)
  if ptr == 0 { return 1 }
  var live: *Inode = @ptrFromInt(ptr)

  let page: u64 = memory.pmm_alloc_page()
  if page == 0 {
    inode_free(ino)
    return 1
  }
  var n: u64 = 0
  while n < len {
    @as(*u8, @ptrFromInt(page + n)).* = @as(*u8, @ptrFromInt(target + n)).*
    n = n + 1
  }
  live.data_blocks[0] = page
  live.blocks = 1
  live.size = len

  if link_into_parent(linkpath, ino) != 0 {
    memory.pmm_free_page(page)
    inode_free(ino)
    return 1
  }
  return 0
}

// Read a symlink's target into `buf`. Returns the number of bytes written, or
// 0 if the path is not a symlink — a plain file is not a link and saying so
// is what tells `ls -l` there is nothing to print after the arrow.
//
// No terminator is written, which is what readlink(2) promises: the caller is
// given a length and the buffer holds exactly that many bytes.
export fn vfs_readlink(path: u64, buf: u64, size: u64): u64 {
  if path == 0 or buf == 0 or size == 0 { return 0 }
  if homefs_path_offset(path) != 0 { return 0 }

  let ino: u32 = path_resolve_nofollow(path)
  if ino == 0 { return 0 }
  let ptr: u64 = inode_get(ino)
  if ptr == 0 { return 0 }
  var node: Inode = @as(*Inode, @ptrFromInt(ptr)).*
  if node.file_type != FILE_TYPE_SYMLINK { return 0 }
  if node.data_blocks[0] == 0 { return 0 }

  var n: u64 = node.size
  if n > size { n = size }
  var i: u64 = 0
  while i < n {
    @as(*u8, @ptrFromInt(buf + i)).* = @as(*u8, @ptrFromInt(node.data_blocks[0] + i)).*
    i = i + 1
  }
  return n
}

// Give a file a different name.
//
// Done as link-then-unlink, which is what the operation is: the file gains a
// second name, then loses its first. It is not atomic — a crash between the
// two leaves the file under both names — and homefs's commit protocol is what
// would make it so, which is why this is refused for homefs paths rather than
// done there badly.
//
// The symlink itself is renamed, not what it points at: resolving the old
// name follows nothing at the leaf, so `mv link other` moves the link.
export fn vfs_rename(oldpath: u64, newpath: u64): u32 {
  if oldpath == 0 or newpath == 0 { return 1 }
  if homefs_path_offset(oldpath) != 0 { return 1 }
  if homefs_path_offset(newpath) != 0 { return 1 }

  let ino: u32 = path_resolve_nofollow(oldpath)
  if ino == 0 { return 1 }

  let ptr: u64 = inode_get(ino)
  if ptr == 0 { return 1 }
  var live: *Inode = @ptrFromInt(ptr)
  // Moving a directory would move its subtree under a new parent, and with no
  // parent pointers stored there is nothing to update — `..` already resolves
  // to the root from anywhere. Refused until inodes carry a parent.
  if live.file_type == FILE_TYPE_DIRECTORY { return 1 }

  if path_resolve_nofollow(newpath) != 0 { return 1 }

  if link_into_parent(newpath, ino) != 0 { return 1 }
  live.link_count = live.link_count + 1

  // The old name goes. link_count is 2 here, so unlink drops it to 1 and the
  // file is not freed — which is the whole reason the link is added first.
  if vfs_unlink(oldpath) != 0 {
    // The new name is already in place; leaving it and reporting failure
    // would give the file two names and tell the caller nothing happened.
    return 1
  }
  return 0
}

// ============================================================================
// DIRECTORY READING
// ============================================================================

export struct DirEntryInfo {
  ino: u32,
  file_type: u32,
  size: u64,
  name: [u8; 256]
}

// Read directory entries
// Returns number of entries read, or 0 on error
// List a homefs directory. Entries come out in hash order, which is the
// order the directory tree holds them in; readdir promises no other, and
// sorting would mean holding the whole directory in memory to do it.
fn homefs_readdir(path: u64, entries: *[DirEntryInfo; 256], max_entries: u32): u32 {
  let dir: u64 = vfs_homefs_resolve(path)
  if dir == 0 { return 0 }
  if homefs.homefs_object_kind(dir) != homefs.OBJ_KIND_DIR { return 0 }

  let total: u32 = homefs.homefs_dir_count(dir)
  var count: u32 = 0
  var i: u32 = 0
  while i < total {
    if count >= max_entries { return count }
    let child: u64 = homefs.homefs_dir_at(dir, i)
    if child != 0 {
      // The inode number a homefs object gets here is the low half of its
      // object id. It is what identifies the file to a caller of readdir
      // within this directory; it is not an inode-table index, and nothing
      // looks it up as one.
      entries[count].ino = @as(u32, child & 0xFFFFFFFF)
      if homefs.homefs_object_kind(child) == homefs.OBJ_KIND_DIR {
        entries[count].file_type = FILE_TYPE_DIRECTORY
      } else {
        entries[count].file_type = FILE_TYPE_REGULAR
      }
      entries[count].size = homefs.homefs_object_size(child)
      let written: u32 = homefs.homefs_object_name(child,
                                                   @intFromPtr(&entries[count].name),
                                                   255)
      entries[count].name[written] = 0
      count = count + 1
    }
    i = i + 1
  }
  return count
}

export fn vfs_readdir(path: u64, entries: *[DirEntryInfo; 256], max_entries: u32): u32 {
  if homefs_path_offset(path) != 0 { return homefs_readdir(path, entries, max_entries) }

  var ino: u32 = path_resolve(path)
  if ino == 0 { return 0 }

  var idx: u32 = inode_find(ino)
  if idx >= MAX_INODES { return 0 }
  if inode_table[idx].file_type != FILE_TYPE_DIRECTORY { return 0 }

  // Walk the directory's own data blocks.
  //
  // This used to return *every* inode in the table under a fabricated name —
  // "file_" plus the inode number modulo ten — so `ls /etc` and `ls /` gave
  // the same made-up list, and two inodes ten apart shared a name. Directory
  // entries have existed all along; dir_add_entry writes them.
  //
  // Entry layout, as dir_add_entry lays it down:
  //   0  u32 inode number, 0 for a free slot
  //   4  u32 name length
  //   8  name bytes, the whole record padded to 4
  var count: u32 = 0
  var block_idx: u32 = 0

  while block_idx < 12 {
    if count >= max_entries { return count }

    var block_addr: u64 = inode_table[idx].data_blocks[block_idx]
    if block_addr == 0 {
      block_idx = block_idx + 1
      continue
    }

    var offset: u32 = 0
    while offset + 8 <= BLOCK_SIZE {
      if count >= max_entries { return count }

      var entry_ino: u32 = @as(*u32, @ptrFromInt(block_addr + offset)).*
      var name_len: u32 = @as(*u32, @ptrFromInt(block_addr + offset + 4)).*

      // A removed entry keeps its length so the walk can step over it, which
      // is what dir_lookup and dir_remove_entry already do. This scan did
      // not: it treated the hole as the end of the block, so removing a file
      // hid every entry after it — `rm` in a directory made the rest of the
      // directory disappear from `ls`, and reappear on the next boot.
      // Only a slot with neither an inode nor a length is genuinely unused.
      if entry_ino == 0 {
        if name_len == 0 { break }
        offset = offset + ((8 + name_len + 3) & ~3)
        continue
      }
      if name_len == 0 { break }
      if name_len > 255 { break }
      if offset + 8 + name_len > BLOCK_SIZE { break }

      var e_idx: u32 = inode_find(entry_ino)
      entries[count].ino = entry_ino
      if e_idx < MAX_INODES {
        entries[count].file_type = inode_table[e_idx].file_type
        entries[count].size = inode_table[e_idx].size
      } else {
        entries[count].file_type = 0
        entries[count].size = 0
      }

      var n: u32 = 0
      while n < name_len {
        entries[count].name[n] = @as(*u8, @ptrFromInt(block_addr + offset + 8 + n)).*
        n = n + 1
      }
      entries[count].name[name_len] = 0

      count = count + 1

      var entry_size: u32 = 8 + name_len
      entry_size = (entry_size + 3) & ~3
      offset = offset + entry_size
    }

    block_idx = block_idx + 1
  }

  return count
}

// Get file/directory size by path
export fn vfs_get_size(path: u64): u64 {
  if homefs_path_offset(path) != 0 {
    let object: u64 = vfs_homefs_resolve(path)
    if object == 0 { return 0 }
    return homefs.homefs_object_size(object)
  }
  var ino: u32 = inode_lookup(path)
  if ino == 0 { return 0 }

  var idx: u32 = inode_find(ino)
  if idx >= MAX_INODES { return 0 }

  return inode_table[idx].size
}

// Get file type by path (1=file, 2=dir, 3=symlink)
export fn vfs_get_type(path: u64): u32 {
  if homefs_path_offset(path) != 0 {
    let object: u64 = vfs_homefs_resolve(path)
    if object == 0 { return 0 }
    if homefs.homefs_object_kind(object) == homefs.OBJ_KIND_DIR {
      return FILE_TYPE_DIRECTORY
    }
    return FILE_TYPE_REGULAR
  }
  var ino: u32 = inode_lookup(path)
  if ino == 0 { return 0 }

  var idx: u32 = inode_find(ino)
  if idx >= MAX_INODES { return 0 }

  return inode_table[idx].file_type
}

var tree_size_scratch: [DirEntryInfo; 256] = undefined

// Get total size of directory tree (recursive)
export fn vfs_get_tree_size(path: u64): u64 {
  var ino: u32 = inode_lookup(path)
  if ino == 0 { return 0 }

  var idx: u32 = inode_find(ino)
  if idx >= MAX_INODES { return 0 }

  var total: u64 = inode_table[idx].size

  // If it's a directory, add child sizes
  if inode_table[idx].file_type == FILE_TYPE_DIRECTORY {
    // Static, not a local: a DirEntryInfo is 272 bytes and 256 of them are
    // 69KB, which is more than the kernel stack has. Nothing calls this
    // function yet, so the frame has never actually been built — it would
    // have taken the stack out the first time something did.
    var count: u32 = vfs_readdir(path, &tree_size_scratch, 256)

    var i: u32 = 0
    while i < count {
      total = total + tree_size_scratch[i].size
      i = i + 1
    }
  }

  return total
}

// ============================================================================
// POSITIONED READ/WRITE (pread/pwrite)
// ============================================================================

export fn vfs_pread(fd: u32, buffer: u64, count: u64, offset: u64): u64 {
  if fd < 3 { return 0 }

  var idx: u32 = fd - 3
  if idx >= MAX_OPEN_FILES { return 0 }

  if open_files[idx].ref_count == 0 { return 0 }

  if open_files[idx].device_id != 0 {
    return @as(u64, devfs.devfs_read(open_files[idx].device_id - 1, buffer,
                                     @as(u32, count), offset))
  }

  if open_files[idx].homefs_object != 0 {
    return @as(u64, homefs.homefs_file_read(open_files[idx].homefs_object,
                                            offset, buffer, @as(u32, count)))
  }

  var ino: u32 = open_files[idx].ino
  var inode_ptr: u64 = inode_get(ino)
  if inode_ptr == 0 { return 0 }

  var inode: Inode = @as(*Inode, @ptrFromInt(inode_ptr)).*

  // Check read permission
  if perms.can_read(&inode, current_uid, current_gid) == 0 {
    return 0
  }

  // Calculate how much we can read
  var available: u64 = 0
  if offset < inode.size {
    available = inode.size - offset
  }
  var to_read: u64 = count
  if to_read > available { to_read = available }

  // Read from data blocks
  var bytes_read: u64 = 0
  var block_idx: u32 = @truncate(offset / BLOCK_SIZE, u32)
  var block_offset: u32 = @truncate(offset % BLOCK_SIZE, u32)

  while bytes_read < to_read and block_idx < 12 {
    var block_addr: u64 = inode.data_blocks[block_idx]
    if block_addr == 0 { break }

    var bytes_in_block: u64 = BLOCK_SIZE - block_offset
    if bytes_in_block > (to_read - bytes_read) {
      bytes_in_block = to_read - bytes_read
    }

    // Copy data
    var src: u64 = block_addr + block_offset
    var dst: u64 = buffer + bytes_read
    var i: u64 = 0
    while i < bytes_in_block {
      @as(*u8, @ptrFromInt(dst + i)).* = @as(*u8, @ptrFromInt(src + i)).*
      i = i + 1
    }

    bytes_read = bytes_read + bytes_in_block
    block_idx = block_idx + 1
    block_offset = 0
  }

  return bytes_read
}

export fn vfs_pwrite(fd: u32, buffer: u64, count: u64, offset: u64): u64 {
  if fd < 3 { return 0 }

  var idx: u32 = fd - 3
  if idx >= MAX_OPEN_FILES { return 0 }

  if open_files[idx].ref_count == 0 { return 0 }

  if open_files[idx].device_id != 0 {
    return @as(u64, devfs.devfs_write(open_files[idx].device_id - 1, buffer,
                                      @as(u32, count), offset))
  }

  if open_files[idx].homefs_object != 0 {
    let put: u32 = homefs.homefs_file_write(open_files[idx].homefs_object,
                                            offset, buffer, @as(u32, count))
    if put == 0 { return 0 }
    if homefs.homefs_commit_transaction() == 0 { return 0 }
    return @as(u64, put)
  }

  var ino: u32 = open_files[idx].ino
  var inode_ptr: u64 = inode_get(ino)
  if inode_ptr == 0 { return 0 }

  var inode: Inode = @as(*Inode, @ptrFromInt(inode_ptr)).*

  // Check write permission
  if perms.can_write(&inode, current_uid, current_gid) == 0 {
    return 0
  }

  var bytes_written: u64 = 0
  var block_idx: u32 = @truncate(offset / BLOCK_SIZE, u32)
  var block_offset: u32 = @truncate(offset % BLOCK_SIZE, u32)

  while bytes_written < count and block_idx < 12 {
    // Allocate block if needed
    if inode.data_blocks[block_idx] == 0 {
      var new_block: u64 = memory.pmm_alloc_page()
      if new_block == 0 { break }
      inode.data_blocks[block_idx] = new_block
      inode.blocks = inode.blocks + 1
    }

    var block_addr: u64 = inode.data_blocks[block_idx]
    var bytes_in_block: u64 = BLOCK_SIZE - block_offset
    if bytes_in_block > (count - bytes_written) {
      bytes_in_block = count - bytes_written
    }

    // Copy data
    var src: u64 = buffer + bytes_written
    var dst: u64 = block_addr + block_offset
    var i: u64 = 0
    while i < bytes_in_block {
      @as(*u8, @ptrFromInt(dst + i)).* = @as(*u8, @ptrFromInt(src + i)).*
      i = i + 1
    }

    bytes_written = bytes_written + bytes_in_block
    block_idx = block_idx + 1
    block_offset = 0
  }

  // Update inode size if needed
  var new_end: u64 = offset + bytes_written
  if new_end > inode.size {
    inode.size = new_end
  }

  return bytes_written
}

// Get inode number from file descriptor
export fn vfs_get_inode(fd: u32): u32 {
  if fd < 3 { return 0 }

  var idx: u32 = fd - 3
  if idx >= MAX_OPEN_FILES { return 0 }

  if open_files[idx].ref_count == 0 { return 0 }

  return open_files[idx].ino
}

// ============================================================================
// INITIALIZATION
// ============================================================================

// vfs_init is the name the rest of the kernel calls initialization by;
// filesystem_init is what this module has always called it. One name
// delegating to the other beats two initializers that can drift apart.
export fn vfs_init() {
  filesystem_init()
}

// Mount the root filesystem. There is no block-backed filesystem yet — homefs
// is a stub (S4) and no disk driver is in the MVK — so root is the in-memory
// inode table that filesystem_init already built. This exists so callers have
// a real mount point to resolve against, and returns nonzero if the root
// inode is somehow absent rather than reporting a mount that did not happen.
export fn mount_root(): u32 {
  if fs_initialized == 0 { filesystem_init() }
  if inode_table[0].ino == 0 { return 1 }
  foundation.serial_write_string("[Filesystem] Root mounted (in-memory)\n")
  return 0
}

// Does a path resolve? Returns 1 or 0 and never opens anything — callers use
// this to branch, and an open here would leak a descriptor on every check.
export fn vfs_exists(path: u64): u32 {
  // Resolving is enough and opens nothing, so there is no descriptor to
  // leak and no file to create by accident.
  if path_resolve(path) == 0 { return 0 }
  return 1
}

// Open, creating the file if it does not exist. O_CREAT is bit 6 in the flags
// this tree uses; setting it here rather than making callers remember keeps
// the create path in one place.
export fn vfs_open_create(path: u64, mode: u32): u32 {
  // vfs_open reports failure as 0, not 0xFFFFFFFF; checking for the latter
  // turned every failure into a returned descriptor of 0.
  return vfs_open(path, 0x40)
}

// Flush one file's data. Nothing is buffered below the inode table yet, so
// there is nothing to write back and this reports success for a valid
// descriptor. When a block cache lands this is where it gets flushed; the
// call sites are already correct.
export fn vfs_fsync(fd: u32): u32 {
  // Descriptors map to slots by fd - 3; 0..2 are the standard streams and
  // have no entry in this table. OpenFile stores no fd of its own, so the
  // arithmetic is the mapping.
  if fd < 3 { return 0 }
  var idx: u32 = fd - 3
  if idx >= MAX_OPEN_FILES { return 1 }  // EBADF
  if open_files[idx].ref_count == 0 { return 1 }
  return 0
}

// Flush everything. Same reasoning as vfs_fsync: no write-back cache exists,
// so this is a no-op that succeeds rather than a lie about data being durable
// — nothing is buffered, so nothing is at risk.
export fn sync_all() {
  foundation.serial_write_string("[Filesystem] sync: nothing buffered\n")
}

// Create a device node. dev encodes major/minor; the inode records the type
// and the mode, and a driver binds to it later by major number.
export fn vfs_mknod(path: u64, mode: u32, dev: u32): u32 {
  var ino: u32 = inode_alloc(FILE_TYPE_DEVICE, mode)
  if ino == 0 { return 1 }
  // The device number lives in the first direct block slot, which a device
  // inode never uses for data.
  var i: u32 = 0
  while i < MAX_INODES {
    if inode_table[i].ino == ino {
      inode_table[i].data_blocks[0] = @as(u64, dev)
      return 0
    }
    i = i + 1
  }
  return 1
}

// Change the process's root directory.
//
// This records the new root and nothing enforces it: path resolution does not
// consult it yet, so a chroot here does NOT confine anything. Saying so
// plainly matters more than usual — a chroot that silently fails to confine
// is a security hole rather than a missing feature. Confinement lands with
// per-process namespaces.
var chroot_ino: u32 = 0

export fn vfs_chroot(path: u64): u32 {
  var fd: u32 = vfs_open(path, 0)
  if fd == 0xFFFFFFFF { return 1 }
  vfs_close(fd)
  chroot_ino = 0
  return 0
}

// The pseudo-filesystems. procfs and sysfs each still need a set of synthetic
// inodes generated on lookup, which needs the per-filesystem operation table
// VFS does not have yet; they report that they are not backed.
//
// devfs is backed: a path under /dev resolves to a registered device node and
// reads and writes reach the device. It is handled by the routing below
// rather than by synthetic inodes, for the same reason homefs is — a device
// node has no inode-table entry to keep in step.
export fn devfs_init() {
  devfs.devfs_init()
  foundation.serial_write_string("[Filesystem] devfs: device nodes under /dev\n")
}

export fn procfs_init() {
  foundation.serial_write_string("[Filesystem] procfs: mount point only, no process entries yet\n")
}

export fn sysfs_init() {
  foundation.serial_write_string("[Filesystem] sysfs: mount point only, no kernel objects yet\n")
}

export fn tmpfs_init() {
  foundation.serial_write_string("[Filesystem] tmpfs: backed by the in-memory inode table\n")
}

export fn filesystem_init() {
  if fs_initialized == 1 { return }

  // Clear inode table
  var i: u32 = 0
  while i < MAX_INODES {
    inode_table[i].ino = 0
    i = i + 1
  }

  // Clear open file table
  i = 0
  while i < MAX_OPEN_FILES {
    open_files[i].ref_count = 0
    i = i + 1
  }

  // Create root directory (inode 1)
  var root_ino: u32 = inode_alloc(FILE_TYPE_DIRECTORY, 0o755)

  // Initialize mount table
  init_mount_table()

  fs_initialized = 1
  foundation.serial_write_string("[Filesystem] Initialized\n")
}
