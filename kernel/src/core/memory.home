// home-os Kernel - Memory Management
// Real implementations only - no placeholders!

import "foundation.home" as foundation

// ============================================================================
// CONSTANTS
// ============================================================================

const PAGE_SIZE: u64 = 4096
const MAX_MEMORY: u64 = 1024 * 1024 * 1024  // 1GB

// How much physical memory vmm_init identity-maps. Must match what the boot
// page tables cover, so that switching CR3 changes nothing about which
// addresses are reachable.
const VMM_IDENTITY_SIZE: u64 = 1024 * 1024 * 1024  // 1GB
const BITMAP_SIZE: u32 = (MAX_MEMORY / PAGE_SIZE / 8)

// Physical memory below this address is never handed out: the BIOS structures
// and ROM hole in the low megabyte, and the kernel image loaded at 1 MB.
//
// The image is far larger than its loaded bytes suggest — .bss carries the
// static tables, and the boot stack sits at the top of it. The linker puts
// __kernel_end (== __bss_end == stack_top) at 0x3573000, just under 56 MB, so
// this bound has to clear that or the allocator hands out the kernel's own
// state. 64 MB leaves room to grow.
const PMM_RESERVED_BELOW: u64 = 64 * 1024 * 1024

// ============================================================================
// PHYSICAL MEMORY MANAGER (Real implementation)
// ============================================================================

var pmm_bitmap: [32768]u8 = undefined  // 1GB / 4096 / 8 = 32768 bytes
var pmm_total_pages: u32 = 0
var pmm_used_pages: u32 = 0
var pmm_initialized: u32 = 0
var pmm_hint: u32 = 0

export fn pmm_init(memory_size: u64) {
  if pmm_initialized == 1 { return }
  
  pmm_total_pages = (memory_size / PAGE_SIZE)
  pmm_used_pages = 0

  // Clear bitmap
  var i: u32 = 0
  while i < BITMAP_SIZE {
    pmm_bitmap[i] = 0
    i = i + 1
  }

  // Reserve everything below the kernel before handing out a single page.
  //
  // Without this the allocator starts at physical page 0 and gives away, in
  // order: the null page, the real-mode interrupt vector table, the BIOS data
  // area, the VGA and option-ROM hole at 0xA0000-0xFFFFF, and then the kernel
  // image itself at 1 MB. Page tables built on those pages are the reason the
  // first walk of a high address dereferenced 0xF000FF53F000E000 — a
  // non-canonical address assembled from BIOS ROM bytes, because writes into
  // the ROM hole are dropped and the reads come back as firmware.
  //
  // PMM_RESERVED_BELOW must stay above the end of the loaded image. The image
  // is linked at 1 MB and is presently well under a megabyte, so 8 MB leaves
  // room to grow; raise it rather than letting the two meet. The linker
  // exports __kernel_end for exactly this, but Home cannot yet name an extern
  // symbol, so the bound is a constant here.
  var reserved_pages: u32 = @as(u32, PMM_RESERVED_BELOW / PAGE_SIZE)
  var p: u32 = 0
  while p < reserved_pages {
    if p < pmm_total_pages {
      pmm_set_bit(p)
      pmm_used_pages = pmm_used_pages + 1
    }
    p = p + 1
  }
  pmm_hint = reserved_pages

  pmm_initialized = 1
  foundation.serial_write_string("[PMM] Initialized with ")
  foundation.serial_write_u64(pmm_total_pages)
  foundation.serial_write_string(" pages\n")
}

fn pmm_set_bit(page: u32) {
  var byte_index: u32 = page / 8
  var bit_index: u32 = page % 8
  pmm_bitmap[byte_index] = pmm_bitmap[byte_index] | (1 << bit_index)
}

fn pmm_clear_bit(page: u32) {
  var byte_index: u32 = page / 8
  var bit_index: u32 = page % 8
  pmm_bitmap[byte_index] = pmm_bitmap[byte_index] & ~(1 << bit_index)
}

fn pmm_test_bit(page: u32): u32 {
  var byte_index: u32 = page / 8
  var bit_index: u32 = page % 8
  return (pmm_bitmap[byte_index] & (1 << bit_index)) != 0
}

export fn pmm_alloc_page(): u64 {
  // Start scanning from the hint so we skip already-full regions.
  var page: u32 = pmm_hint

  while page < pmm_total_pages {
    if pmm_test_bit(page) == 0 {
      pmm_set_bit(page)
      pmm_used_pages = pmm_used_pages + 1
      pmm_hint = page + 1
      return @as(u64, page) * PAGE_SIZE
    }
    page = page + 1
  }

  // Wrap around and scan from 0 to hint.
  page = 0
  while page < pmm_hint {
    if pmm_test_bit(page) == 0 {
      pmm_set_bit(page)
      pmm_used_pages = pmm_used_pages + 1
      pmm_hint = page + 1
      return @as(u64, page) * PAGE_SIZE
    }
    page = page + 1
  }

  return 0
}

export fn pmm_free_page(addr: u64) {
  if (addr & (PAGE_SIZE - 1)) != 0 { return }
  var page: u32 = @truncate(addr / PAGE_SIZE, u32)
  if page >= pmm_total_pages { return }

  if pmm_test_bit(page) == 1 {
    pmm_clear_bit(page)
    if pmm_used_pages > 0 { pmm_used_pages = pmm_used_pages - 1 }
    if page < pmm_hint { pmm_hint = page }
  }
}

// Allocate `count` physically contiguous pages, returning the base address or
// 0. Contiguity is the whole point — a DMA buffer or a framebuffer must be one
// run, so this cannot be a loop over pmm_alloc_page.
export fn pmm_alloc_pages(count: u64): u64 {
  if count == 0 { return 0 }
  if count == 1 { return pmm_alloc_page() }

  var page: u32 = 0
  while page + @as(u32, count) <= pmm_total_pages {
    // Scan for a run of `count` free pages starting here.
    var run: u32 = 0
    while run < @as(u32, count) {
      var idx: u32 = page + run
      var byte: u8 = pmm_bitmap[idx / 8]
      if (byte & (@as(u8, 1) << @as(u3, idx % 8))) != 0 { break }
      run = run + 1
    }

    if run == @as(u32, count) {
      var i: u32 = 0
      while i < @as(u32, count) {
        var idx: u32 = page + i
        pmm_bitmap[idx / 8] = pmm_bitmap[idx / 8] | (@as(u8, 1) << @as(u3, idx % 8))
        i = i + 1
      }
      pmm_used_pages = pmm_used_pages + @as(u32, count)
      return @as(u64, page) * PAGE_SIZE
    }

    // Resume past the page that ended the run, not at page+1: every start
    // inside a failed run fails for the same reason.
    page = page + run + 1
  }
  return 0
}

export fn pmm_free_pages(addr: u64, count: u64) {
  if addr == 0 or count == 0 { return }
  var page: u32 = @as(u32, addr / PAGE_SIZE)
  var i: u32 = 0
  while i < @as(u32, count) {
    var idx: u32 = page + i
    if idx < pmm_total_pages {
      var mask: u8 = @as(u8, 1) << @as(u3, idx % 8)
      if (pmm_bitmap[idx / 8] & mask) != 0 {
        pmm_bitmap[idx / 8] = pmm_bitmap[idx / 8] & (~mask)
        if pmm_used_pages > 0 { pmm_used_pages = pmm_used_pages - 1 }
      }
    }
    i = i + 1
  }
  // A freed run may start below the search hint; reset it so the next
  // allocation can see the space that just became available.
  if page < pmm_hint { pmm_hint = page }
}

// Physical memory totals, in bytes rather than pages — this is what the
// reporting paths want, and converting at each call site invites one of them
// to get the shift wrong.
// The physical allocator's headline numbers. `largest_free` is the biggest
// run of contiguous free pages, which is what a caller asking about
// fragmentation actually wants — total free memory says nothing about
// whether a large allocation can be satisfied.
export struct MemoryStats {
  total_bytes: u64,
  total_free: u64,
  free_blocks: u64,
  largest_free: u64
}

export fn get_stats(): MemoryStats {
  var stats: MemoryStats = undefined
  stats.total_bytes = get_total_memory()
  stats.total_free = get_free_memory()
  stats.free_blocks = 0
  stats.largest_free = 0

  // One pass over the page bitmap, counting runs. A run ends at the first
  // used page, and the longest one seen is the largest allocation this
  // allocator could still satisfy.
  var run: u64 = 0
  var page: u32 = 0
  while page < pmm_total_pages {
    // A set bit means the page is in use, so a clear one is free.
    if pmm_test_bit(page) == 0 {
      if run == 0 { stats.free_blocks = stats.free_blocks + 1 }
      run = run + 1
      if run > stats.largest_free { stats.largest_free = run }
    } else {
      run = 0
    }
    page = page + 1
  }
  stats.largest_free = stats.largest_free * PAGE_SIZE
  return stats
}

export fn get_total_memory(): u64 {
  return @as(u64, pmm_total_pages) * PAGE_SIZE
}

export fn get_free_memory(): u64 {
  return @as(u64, pmm_total_pages - pmm_used_pages) * PAGE_SIZE
}

// Read one byte of physical memory. Deliberately narrow: callers parsing
// tables and headers want a byte at a time, and giving them a typed pointer
// each time invites a cast that is wrong by a factor of the element size.
export fn read_u8(addr: u64): u8 {
  return @as(*u8, @ptrFromInt(addr)).*
}

export fn pmm_get_used_pages(): u32 {
  return pmm_used_pages
}

export fn pmm_get_free_pages(): u32 {
  if pmm_used_pages > pmm_total_pages { return 0 }
  return pmm_total_pages - pmm_used_pages
}

// ============================================================================
// VIRTUAL MEMORY MANAGER (Real implementation)
// ============================================================================

const PML4_ENTRIES: u32 = 512
// Bit 7 of a PDPT or PD entry: the entry maps a huge page directly rather
// than pointing at the level below.
const PAGE_HUGE: u64 = 0x80
const PDPT_ENTRIES: u32 = 512
const PD_ENTRIES: u32 = 512
const PT_ENTRIES: u32 = 512

const PAGE_PRESENT: u64 = 1 << 0
const PAGE_WRITE: u64 = 1 << 1
const PAGE_USER: u64 = 1 << 2

var vmm_pml4: u64 = 0
var vmm_initialized: u32 = 0

export fn vmm_init() {
  if vmm_initialized == 1 { return }
  
  // Allocate PML4
  vmm_pml4 = pmm_alloc_page()
  if vmm_pml4 == 0 { return }
  
  // Clear PML4
  var i: u32 = 0
  while i < PML4_ENTRIES {
    var entry_addr: u64 = vmm_pml4 + (i * 8)
    @as(*u64, @ptrFromInt(entry_addr)).* = 0
    i = i + 1
  }
  
  // Identity-map the same first gigabyte the boot page tables cover, before
  // this table replaces them in CR3.
  //
  // This mapped 4 MB, which does not reach the kernel's own .bss — the boot
  // stack is at 0x3573000, just under 56 MB. Loading CR3 with it unmapped the
  // stack under the running kernel, and the next push faulted.
  vmm_map_range(0, 0, VMM_IDENTITY_SIZE, PAGE_PRESENT | PAGE_WRITE)
  
  // Load CR3
  foundation.write_cr3(vmm_pml4)
  
  vmm_initialized = 1
  foundation.serial_write_string("[VMM] Initialized\n")
}

// The physical page backing `virt` in the kernel address space, or 0 if it is
// not mapped. Walks the same four levels vmm_map_page builds.
//
// A loader needs this to tell "not mapped yet" from "already mapped by an
// earlier segment": two ELF PT_LOAD segments routinely share a page, and
// mapping the second one over the first replaces it with a fresh zero page
// and loses whatever the first put there.
// Plain 32-bit loads and stores through an address.
//
// Distinct from write_volatile_u32: those exist so a compiler cannot fold or
// reorder an MMIO access. These are for ordinary memory the caller happens to
// address numerically — the framebuffer console's glyph cache, for instance.
export fn read_u32(addr: u64): u32 {
  return @as(*u32, @ptrFromInt(addr)).*
}

export fn write_u32(addr: u64, value: u32) {
  @as(*u32, @ptrFromInt(addr)).* = value
}

// ============================================================================
// PER-PROCESS ADDRESS SPACES
//
// The split this rests on is already in the layout, and it is cleaner than it
// looks. The kernel is identity-mapped over the first gigabyte, which is
// PDPT entry 0, and it maps device registers just under four gigabytes, which
// is entry 3. User programs live at 0x40000000, which is entry 1. Kernel and
// user therefore never share a page directory, only a PDPT — so a process can
// be given an address space of its own by handing it a fresh entry 1 and the
// kernel's own entries everywhere else.
//
// No higher-half move is needed for that, which is worth saying because it is
// the usual answer: a kernel that shares PML4[0] with its user programs
// normally has to be moved out of the lower half before processes can differ.
// Here the boundary already falls between two PDPT entries.
//
// The kernel's entries are shared rather than copied, so a mapping the kernel
// makes later — a device the driver brings up after a process exists — is
// visible in every address space without anything being told to update.
// ============================================================================

const USER_PDPT_INDEX: u32 = 1

// Build an address space: the kernel's mappings, plus an empty user region.
// Returns the PML4's physical address, or 0.
export fn vmm_create_user_space(): u64 {
  if vmm_pml4 == 0 { return 0 }

  var pml4: u64 = pmm_alloc_page()
  if pml4 == 0 { return 0 }
  var pdpt: u64 = pmm_alloc_page()
  if pdpt == 0 {
    pmm_free_page(pml4)
    return 0
  }
  var pd: u64 = pmm_alloc_page()
  if pd == 0 {
    pmm_free_page(pdpt)
    pmm_free_page(pml4)
    return 0
  }

  memset(pml4, 0, PAGE_SIZE)
  memset(pdpt, 0, PAGE_SIZE)
  memset(pd, 0, PAGE_SIZE)

  // Everything above PML4[0] as the kernel has it. Nothing in this tree uses
  // the upper half yet, but copying it costs one loop and means an address
  // space does not quietly lose a mapping added there later.
  var i: u32 = 1
  while i < PML4_ENTRIES {
    @as(*u64, @ptrFromInt(pml4 + (i * 8))).* =
      @as(*u64, @ptrFromInt(vmm_pml4 + (i * 8))).*
    i = i + 1
  }

  // PML4[0] gets this process's own PDPT, carrying the kernel's entries.
  var kernel_pml4e: u64 = @as(*u64, @ptrFromInt(vmm_pml4)).*
  if (kernel_pml4e & PAGE_PRESENT) == 0 {
    pmm_free_page(pd)
    pmm_free_page(pdpt)
    pmm_free_page(pml4)
    return 0
  }
  var kernel_pdpt: u64 = kernel_pml4e & ~0xFFF

  var j: u32 = 0
  while j < PML4_ENTRIES {
    if j != USER_PDPT_INDEX {
      @as(*u64, @ptrFromInt(pdpt + (j * 8))).* =
        @as(*u64, @ptrFromInt(kernel_pdpt + (j * 8))).*
    }
    j = j + 1
  }

  // The user's own gigabyte, empty and reachable from ring 3.
  @as(*u64, @ptrFromInt(pdpt + (USER_PDPT_INDEX * 8))).* =
    pd | PAGE_PRESENT | PAGE_WRITE | PAGE_USER
  @as(*u64, @ptrFromInt(pml4)).* =
    pdpt | PAGE_PRESENT | PAGE_WRITE | PAGE_USER

  return pml4
}

// Make `pml4` the address space in force. The kernel is mapped in every space
// this builds, so the code doing the switch stays mapped across it.
export fn vmm_switch_user_space(pml4: u64) {
  if pml4 == 0 { return }
  foundation.write_cr3(pml4)
}

export fn vmm_kernel_space(): u64 {
  return vmm_pml4
}

// Map one page inside a given address space, building the levels it needs.
// The kernel's own vmm_map_page walks vmm_pml4; this walks whichever space it
// is given, so a process's memory can be prepared without switching to it.
export fn vmm_map_page_in(pml4: u64, virt: u64, phys: u64, flags: u64): u32 {
  if pml4 == 0 { return 1 }

  var pml4_index: u32 = (virt >> 39) & 0x1FF
  var pdpt_index: u32 = (virt >> 30) & 0x1FF
  var pd_index: u32 = (virt >> 21) & 0x1FF
  var pt_index: u32 = (virt >> 12) & 0x1FF

  var pml4e_addr: u64 = pml4 + (pml4_index * 8)
  var pml4e: u64 = @as(*u64, @ptrFromInt(pml4e_addr)).*
  if (pml4e & PAGE_PRESENT) == 0 { return 1 }
  var pdpt: u64 = pml4e & ~0xFFF

  var pdpte_addr: u64 = pdpt + (pdpt_index * 8)
  var pdpte: u64 = @as(*u64, @ptrFromInt(pdpte_addr)).*
  if (pdpte & PAGE_PRESENT) == 0 { return 1 }
  // A gigabyte mapped as one huge page has no page directory to descend into,
  // and silently overwriting it would unmap whatever else it covers.
  if (pdpte & PAGE_HUGE) != 0 { return 1 }
  var pd: u64 = pdpte & ~0xFFF

  var pde_addr: u64 = pd + (pd_index * 8)
  var pde: u64 = @as(*u64, @ptrFromInt(pde_addr)).*
  var pt: u64 = 0
  if (pde & PAGE_PRESENT) == 0 {
    pt = pmm_alloc_page()
    if pt == 0 { return 1 }
    memset(pt, 0, PAGE_SIZE)
    @as(*u64, @ptrFromInt(pde_addr)).* = pt | PAGE_PRESENT | PAGE_WRITE | PAGE_USER
  } else {
    if (pde & PAGE_HUGE) != 0 { return 1 }
    pt = pde & ~0xFFF
  }

  @as(*u64, @ptrFromInt(pt + (pt_index * 8))).* = (phys & ~0xFFF) | flags
  return 0
}

// Prove that two address spaces are actually separate.
//
// Not "the call returned nonzero" — that is true of a function that allocates
// a page and forgets it. Two spaces are given the same virtual address backed
// by different physical pages, each written through that one address, and each
// read back after switching. If the spaces were sharing anything the second
// write would be visible from the first, and the check would fail.
//
// The kernel is mapped in both, which is what lets this code keep running
// across the switches; that is the property being relied on, so it is also
// the property being tested.
//
// Returns the number of checks that passed, out of 4.
export fn vmm_address_space_selftest(): u32 {
  let probe: u64 = 0x0000_0000_4800_0000   // inside the user gigabyte, clear of
                                           // anything a program is loaded at
  var passed: u32 = 0

  let kernel_space: u64 = vmm_pml4
  if kernel_space == 0 { return 0 }

  var space_a: u64 = vmm_create_user_space()
  var space_b: u64 = vmm_create_user_space()
  if space_a == 0 or space_b == 0 { return 0 }
  if space_a != space_b { passed = passed + 1 }

  var page_a: u64 = pmm_alloc_page()
  var page_b: u64 = pmm_alloc_page()
  if page_a == 0 or page_b == 0 { return passed }
  if page_a != page_b { passed = passed + 1 }

  let rw: u64 = PAGE_PRESENT | PAGE_WRITE | PAGE_USER
  if vmm_map_page_in(space_a, probe, page_a, rw) != 0 { return passed }
  if vmm_map_page_in(space_b, probe, page_b, rw) != 0 { return passed }

  vmm_switch_user_space(space_a)
  @as(*u64, @ptrFromInt(probe)).* = 0xA11CE

  vmm_switch_user_space(space_b)
  @as(*u64, @ptrFromInt(probe)).* = 0xB0B

  // Back to A: it must still hold what A wrote. If the two spaces shared the
  // page directory, B's write would be here instead.
  vmm_switch_user_space(space_a)
  if @as(*u64, @ptrFromInt(probe)).* == 0xA11CE { passed = passed + 1 }

  vmm_switch_user_space(space_b)
  if @as(*u64, @ptrFromInt(probe)).* == 0xB0B { passed = passed + 1 }

  vmm_switch_user_space(kernel_space)

  pmm_free_page(page_a)
  pmm_free_page(page_b)
  return passed
}

export fn vmm_get_kernel_physical(virt: u64): u64 {
  if vmm_pml4 == 0 { return 0 }

  var pml4_index: u32 = (virt >> 39) & 0x1FF
  var pdpt_index: u32 = (virt >> 30) & 0x1FF
  var pd_index: u32 = (virt >> 21) & 0x1FF
  var pt_index: u32 = (virt >> 12) & 0x1FF

  var pml4e: u64 = @as(*u64, @ptrFromInt(vmm_pml4 + (pml4_index * 8))).*
  if (pml4e & PAGE_PRESENT) == 0 { return 0 }
  var pdpt: u64 = pml4e & ~0xFFF

  var pdpte: u64 = @as(*u64, @ptrFromInt(pdpt + (pdpt_index * 8))).*
  if (pdpte & PAGE_PRESENT) == 0 { return 0 }
  var pd: u64 = pdpte & ~0xFFF

  var pde: u64 = @as(*u64, @ptrFromInt(pd + (pd_index * 8))).*
  if (pde & PAGE_PRESENT) == 0 { return 0 }
  var pt: u64 = pde & ~0xFFF

  var pte: u64 = @as(*u64, @ptrFromInt(pt + (pt_index * 8))).*
  if (pte & PAGE_PRESENT) == 0 { return 0 }

  return pte & ~0xFFF
}

export fn vmm_map_page(virt: u64, phys: u64, flags: u64): u32 {
  var pml4_index: u32 = (virt >> 39) & 0x1FF
  var pdpt_index: u32 = (virt >> 30) & 0x1FF
  var pd_index: u32 = (virt >> 21) & 0x1FF
  var pt_index: u32 = (virt >> 12) & 0x1FF
  
  // Get or create PDPT
  var pml4_entry_addr: u64 = vmm_pml4 + (pml4_index * 8)
  var pdpt: u64 = @as(*u64, @ptrFromInt(pml4_entry_addr)).* & ~0xFFF
  
  if pdpt == 0 {
    pdpt = pmm_alloc_page()
    if pdpt == 0 { return 1 }
    memset(pdpt, 0, PAGE_SIZE)
    @as(*u64, @ptrFromInt(pml4_entry_addr)).* = pdpt | PAGE_PRESENT | PAGE_WRITE | PAGE_USER
  }

  // Get or create PD
  var pdpt_entry_addr: u64 = pdpt + (pdpt_index * 8)
  var pd: u64 = @as(*u64, @ptrFromInt(pdpt_entry_addr)).* & ~0xFFF

  if pd == 0 {
    pd = pmm_alloc_page()
    if pd == 0 { return 1 }
    memset(pd, 0, PAGE_SIZE)
    @as(*u64, @ptrFromInt(pdpt_entry_addr)).* = pd | PAGE_PRESENT | PAGE_WRITE | PAGE_USER
  }

  // Get or create PT
  var pd_entry_addr: u64 = pd + (pd_index * 8)
  var pt: u64 = @as(*u64, @ptrFromInt(pd_entry_addr)).* & ~0xFFF

  if pt == 0 {
    pt = pmm_alloc_page()
    if pt == 0 { return 1 }
    memset(pt, 0, PAGE_SIZE)
    @as(*u64, @ptrFromInt(pd_entry_addr)).* = pt | PAGE_PRESENT | PAGE_WRITE | PAGE_USER
  }
  
  // Map page
  var pt_entry_addr: u64 = pt + (pt_index * 8)
  @as(*u64, @ptrFromInt(pt_entry_addr)).* = phys | flags
  
  // Invalidate TLB
  arch_invalidate_tlb_page(virt)
  
  return 0
}

export fn vmm_unmap_page(virt: u64) {
  var pml4_index: u32 = (virt >> 39) & 0x1FF
  var pdpt_index: u32 = (virt >> 30) & 0x1FF
  var pd_index: u32 = (virt >> 21) & 0x1FF
  var pt_index: u32 = (virt >> 12) & 0x1FF
  
  var pml4_entry_addr: u64 = vmm_pml4 + (pml4_index * 8)
  var pdpt: u64 = @as(*u64, @ptrFromInt(pml4_entry_addr)).* & ~0xFFF
  if pdpt == 0 { return }
  
  var pdpt_entry_addr: u64 = pdpt + (pdpt_index * 8)
  var pd: u64 = @as(*u64, @ptrFromInt(pdpt_entry_addr)).* & ~0xFFF
  if pd == 0 { return }
  
  var pd_entry_addr: u64 = pd + (pd_index * 8)
  var pt: u64 = @as(*u64, @ptrFromInt(pd_entry_addr)).* & ~0xFFF
  if pt == 0 { return }
  
  var pt_entry_addr: u64 = pt + (pt_index * 8)
  @as(*u64, @ptrFromInt(pt_entry_addr)).* = 0
  
  // Invalidate TLB
  arch_invalidate_tlb_page(virt)
}

fn vmm_map_range(virt_start: u64, phys_start: u64, size: u64, flags: u64) {
  var virt: u64 = virt_start
  var phys: u64 = phys_start
  var end: u64 = virt_start + size
  
  while virt < end {
    vmm_map_page(virt, phys, flags)
    virt = virt + PAGE_SIZE
    phys = phys + PAGE_SIZE
  }
}

// ============================================================================
// HEAP ALLOCATOR (Real implementation)
// ============================================================================

const HEAP_START: u64 = 0x0000_1000_0000_0000
const HEAP_SIZE: u64 = 16 * 1024 * 1024  // 16MB

struct HeapBlock {
  size: u64,
  used: u32,
  next: u64
}

var heap_head: u64 = 0
var heap_initialized: u32 = 0

export fn heap_init() {
  if heap_initialized == 1 { return }
  
  // Allocate physical pages for heap
  var pages_needed: u32 = HEAP_SIZE / PAGE_SIZE
  var i: u32 = 0
  
  while i < pages_needed {
    var phys: u64 = pmm_alloc_page()
    if phys == 0 { return }
    vmm_map_page(HEAP_START + (i * PAGE_SIZE), phys, PAGE_PRESENT | PAGE_WRITE)
    i = i + 1
  }
  
  // Initialize first block
  heap_head = HEAP_START
  var block: u64 = heap_head
  @as(*u64, @ptrFromInt(block)).* = HEAP_SIZE - @sizeOf(HeapBlock)  // size
  @as(*volatile u32, @ptrFromInt(block + 8)).* = 0  // used
  @as(*u64, @ptrFromInt(block + 12)).* = 0  // next
  
  heap_initialized = 1
  foundation.serial_write_string("[Heap] Initialized\n")
}

export fn kmalloc(size: u64): u64 {
  if size == 0 { return 0 }
  if heap_initialized == 0 { return 0 }

  // Reject sizes that would overflow the alignment round-up. The
  // heap is much smaller than u64, so an allocation bigger than the
  // whole heap is always bogus.
  if size > HEAP_SIZE { return 0 }
  var aligned_size: u64 = (size + 7) & ~7

  var current: u64 = heap_head
  
  while current != 0 {
    var block_size: u64 = @as(*u64, @ptrFromInt(current)).*
    var block_used: u32 = @as(*volatile u32, @ptrFromInt(current + 8)).*
    var block_next: u64 = @as(*u64, @ptrFromInt(current + 12)).*
    
    if block_used == 0 and block_size >= aligned_size {
      // Found suitable block
      @as(*volatile u32, @ptrFromInt(current + 8)).* = 1  // Mark as used
      
      // Split block if there's enough space
      if block_size >= aligned_size + @sizeOf(HeapBlock) + 64 {
        var new_block: u64 = current + @sizeOf(HeapBlock) + aligned_size
        @as(*u64, @ptrFromInt(new_block)).* = block_size - aligned_size - @sizeOf(HeapBlock)
        @as(*volatile u32, @ptrFromInt(new_block + 8)).* = 0
        @as(*u64, @ptrFromInt(new_block + 12)).* = block_next
        
        @as(*u64, @ptrFromInt(current)).* = aligned_size
        @as(*u64, @ptrFromInt(current + 12)).* = new_block
      }
      
      return current + @sizeOf(HeapBlock)
    }
    
    current = block_next
  }
  
  return 0  // Out of memory
}

export fn kfree(ptr: u64) {
  if ptr == 0 { return }
  if ptr < HEAP_START + @sizeOf(HeapBlock) or ptr >= HEAP_START + HEAP_SIZE { return }

  var block: u64 = ptr - @sizeOf(HeapBlock)
  @as(*volatile u32, @ptrFromInt(block + 8)).* = 0

  // Coalesce adjacent free blocks
  coalesce_free_blocks()
}

// Coalesce adjacent free blocks to reduce fragmentation
fn coalesce_free_blocks() {
  var current: u64 = heap_head

  while current != 0 {
    var current_size: u64 = @as(*u64, @ptrFromInt(current)).*
    var current_used: u32 = @as(*volatile u32, @ptrFromInt(current + 8)).*
    var current_next: u64 = @as(*u64, @ptrFromInt(current + 12)).*

    // If current block is free, try to merge with next block
    if current_used == 0 and current_next != 0 {
      var next_used: u32 = @as(*volatile u32, @ptrFromInt(current_next + 8)).*

      // If next block is also free, merge them
      if next_used == 0 {
        var next_size: u64 = @as(*u64, @ptrFromInt(current_next)).*
        var next_next: u64 = @as(*u64, @ptrFromInt(current_next + 12)).*

        // Merge: current absorbs next
        var new_size: u64 = current_size + @sizeOf(HeapBlock) + next_size
        @as(*u64, @ptrFromInt(current)).* = new_size
        @as(*u64, @ptrFromInt(current + 12)).* = next_next

        // Don't advance - check if we can merge more
        continue
      }
    }

    current = current_next
  }
}

// Get heap statistics
export fn heap_get_stats(total: *u64, used: *u64, free: *u64, largest_free: *u64) {
  var total_size: u64 = 0
  var used_size: u64 = 0
  var free_size: u64 = 0
  var max_free: u64 = 0

  var current: u64 = heap_head

  while current != 0 {
    var block_size: u64 = @as(*u64, @ptrFromInt(current)).*
    var block_used: u32 = @as(*volatile u32, @ptrFromInt(current + 8)).*
    var block_next: u64 = @as(*u64, @ptrFromInt(current + 12)).*

    total_size = total_size + block_size + @sizeOf(HeapBlock)

    if block_used == 1 {
      used_size = used_size + block_size
    } else {
      free_size = free_size + block_size
      if block_size > max_free {
        max_free = block_size
      }
    }

    current = block_next
  }

  @as(*u64, @ptrFromInt(total)).* = total_size
  @as(*u64, @ptrFromInt(used)).* = used_size
  @as(*u64, @ptrFromInt(free)).* = free_size
  @as(*u64, @ptrFromInt(largest_free)).* = max_free
}

// Compact heap by moving used blocks together
export fn heap_compact() {
  // First, coalesce all free blocks
  coalesce_free_blocks()

  // Note: Full compaction would require updating all pointers
  // which is complex without garbage collection. This basic
  // implementation just merges free blocks.

  foundation.serial_write_string("[Heap] Compacted\n")
}

// Check heap integrity
export fn heap_check(): u32 {
  var current: u64 = heap_head
  var prev: u64 = 0
  var block_count: u32 = 0

  while current != 0 {
    var block_size: u64 = @as(*u64, @ptrFromInt(current)).*
    var block_used: u32 = @as(*volatile u32, @ptrFromInt(current + 8)).*
    var block_next: u64 = @as(*u64, @ptrFromInt(current + 12)).*

    // Validate block
    if block_size == 0 {
      foundation.serial_write_string("[Heap] ERROR: Zero-size block at ")
      foundation.serial_write_hex(current)
      foundation.serial_write_string("\n")
      return 1
    }

    if block_used != 0 and block_used != 1 {
      foundation.serial_write_string("[Heap] ERROR: Invalid used flag at ")
      foundation.serial_write_hex(current)
      foundation.serial_write_string("\n")
      return 2
    }

    // Check for cycles
    if block_next != 0 and block_next <= current {
      foundation.serial_write_string("[Heap] ERROR: Backward/cycle link at ")
      foundation.serial_write_hex(current)
      foundation.serial_write_string("\n")
      return 3
    }

    // Check block boundaries
    var expected_next: u64 = current + @sizeOf(HeapBlock) + block_size
    if block_next != 0 and block_next != expected_next {
      // Blocks don't have to be contiguous, but check for overlap
      if block_next < expected_next {
        foundation.serial_write_string("[Heap] ERROR: Overlapping blocks at ")
        foundation.serial_write_hex(current)
        foundation.serial_write_string("\n")
        return 4
      }
    }

    prev = current
    current = block_next
    block_count = block_count + 1

    // Prevent infinite loop
    if block_count > 1000000 {
      foundation.serial_write_string("[Heap] ERROR: Too many blocks (possible cycle)\n")
      return 5
    }
  }

  return 0  // Heap OK
}

// Reallocate memory (resize allocation)
export fn krealloc(ptr: u64, new_size: u64): u64 {
  if ptr == 0 {
    return kmalloc(new_size)
  }

  if new_size == 0 {
    kfree(ptr)
    return 0
  }

  var block: u64 = ptr - @sizeOf(HeapBlock)
  var old_size: u64 = @as(*u64, @ptrFromInt(block)).*

  // If new size fits in current block, just return
  var aligned_new: u64 = (new_size + 7) & ~7
  if aligned_new <= old_size {
    return ptr
  }

  // Check if we can expand into next block
  var next: u64 = @as(*u64, @ptrFromInt(block + 12)).*
  if next != 0 {
    var next_used: u32 = @as(*volatile u32, @ptrFromInt(next + 8)).*
    if next_used == 0 {
      var next_size: u64 = @as(*u64, @ptrFromInt(next)).*
      var combined: u64 = old_size + @sizeOf(HeapBlock) + next_size

      if combined >= aligned_new {
        // Merge with next block
        var next_next: u64 = @as(*u64, @ptrFromInt(next + 12)).*
        @as(*u64, @ptrFromInt(block)).* = combined
        @as(*u64, @ptrFromInt(block + 12)).* = next_next

        // Split if there's enough space left
        if combined >= aligned_new + @sizeOf(HeapBlock) + 64 {
          var new_block: u64 = block + @sizeOf(HeapBlock) + aligned_new
          @as(*u64, @ptrFromInt(new_block)).* = combined - aligned_new - @sizeOf(HeapBlock)
          @as(*volatile u32, @ptrFromInt(new_block + 8)).* = 0
          @as(*u64, @ptrFromInt(new_block + 12)).* = next_next

          @as(*u64, @ptrFromInt(block)).* = aligned_new
          @as(*u64, @ptrFromInt(block + 12)).* = new_block
        }

        return ptr
      }
    }
  }

  // Need to allocate new block and copy
  var new_ptr: u64 = kmalloc(new_size)
  if new_ptr == 0 {
    return 0
  }

  // Copy old data
  var copy_size: u64 = old_size
  if new_size < copy_size {
    copy_size = new_size
  }

  var i: u64 = 0
  while i < copy_size {
    @as(*u8, @ptrFromInt(new_ptr + i)).* = @as(*u8, @ptrFromInt(ptr + i)).*
    i = i + 1
  }

  // Free old block
  kfree(ptr)

  return new_ptr
}

// Allocate zeroed memory
export fn kcalloc(count: u64, size: u64): u64 {
  if count != 0 and size > 0xFFFFFFFFFFFFFFFF / count { return 0 }
  var total: u64 = count * size
  var ptr: u64 = kmalloc(total)

  if ptr != 0 {
    var i: u64 = 0
    while i < total {
      @as(*u8, @ptrFromInt(ptr + i)).* = 0
      i = i + 1
    }
  }

  return ptr
}

// ============================================================================
// MEMORY UTILITIES
// ============================================================================

export fn memset(addr: u64, value: u8, size: u64) {
  var ptr: *u8 = @ptrFromInt(addr)
  var i: u64 = 0
  while i < size {
    ptr[i] = value
    i = i + 1
  }
}

// Word-sized memcpy. Copies 8 bytes at a time when both source and
// destination are 8-byte aligned and the region is large enough; falls
// back to a byte loop for the leading/trailing unaligned fragments and
// for small copies. Correctly handles overlapping regions where dst is
// below src (shift-down), which is the common ring-buffer drain case.
export fn mem_copy(dst: u64, src: u64, size: u64) {
  if size == 0 { return }
  if dst == src { return }

  // Overlap that would corrupt source when dst > src: copy backwards.
  if dst > src and dst < src + size {
    var i: u64 = size
    var d: *u8 = @ptrFromInt(dst)
    var s: *u8 = @ptrFromInt(src)
    while i > 0 {
      i = i - 1
      d[i] = s[i]
    }
    return
  }

  // Fast path: both pointers 8-byte aligned, bulk copy as u64 words.
  if (dst & 7) == 0 and (src & 7) == 0 and size >= 8 {
    var dw: *u64 = @ptrFromInt(dst)
    var sw: *u64 = @ptrFromInt(src)
    var words: u64 = size >> 3
    var i: u64 = 0
    while i < words {
      dw[i] = sw[i]
      i = i + 1
    }
    // Trailing bytes.
    var copied: u64 = words << 3
    var db: *u8 = @ptrFromInt(dst + copied)
    var sb: *u8 = @ptrFromInt(src + copied)
    var j: u64 = 0
    var tail: u64 = size - copied
    while j < tail {
      db[j] = sb[j]
      j = j + 1
    }
    return
  }

  // Unaligned or tiny: byte copy.
  var d: *u8 = @ptrFromInt(dst)
  var s: *u8 = @ptrFromInt(src)
  var i: u64 = 0
  while i < size {
    d[i] = s[i]
    i = i + 1
  }
}

// Legacy alias kept for callers that still say memcpy(). New code
// should prefer mem_copy().
export fn memcpy(dst: u64, src: u64, size: u64) {
  mem_copy(dst, src, size)
}

// ============================================================================
// PER-PROCESS ADDRESS SPACE MANAGEMENT
// ============================================================================

const MAX_PROCESSES: u32 = 256
const PAGE_COW: u64 = 1 << 9  // Copy-on-write flag

// Per-process PML4 table pointers
var process_pml4: [u64; 256] = undefined
var process_pml4_initialized: u32 = 0

fn init_process_pml4() {
  if process_pml4_initialized == 1 { return }

  var i: u32 = 0
  while i < MAX_PROCESSES {
    process_pml4[i] = 0
    i = i + 1
  }

  // Process 0 uses kernel PML4
  process_pml4[0] = vmm_pml4

  process_pml4_initialized = 1
}

// Create address space for a new process
export fn vmm_create_address_space(pid: u32): u64 {
  init_process_pml4()

  if pid >= MAX_PROCESSES { return 0 }

  // Allocate PML4 for this process
  var pml4: u64 = pmm_alloc_page()
  if pml4 == 0 { return 0 }

  // Clear PML4
  memset(pml4, 0, PAGE_SIZE)

  // Copy kernel mappings (upper half)
  var kernel_pml4: u64 = vmm_pml4
  var i: u32 = 256
  while i < 512 {
    var src_entry: u64 = @as(*u64, @ptrFromInt(kernel_pml4 + i * 8)).*
    if src_entry != 0 {
      @as(*u64, @ptrFromInt(pml4 + i * 8)).* = src_entry
    }
    i = i + 1
  }

  process_pml4[pid] = pml4
  return pml4
}

// Get PML4 for a process
fn get_process_pml4(pid: u32): u64 {
  init_process_pml4()

  if pid >= MAX_PROCESSES { return vmm_pml4 }
  if process_pml4[pid] == 0 { return vmm_pml4 }
  return process_pml4[pid]
}

// Map page in a process's address space
export fn vmm_map_page_process(pid: u32, virt: u64, phys: u64, prot: u32): u32 {
  var pml4: u64 = get_process_pml4(pid)

  // Convert protection flags
  var flags: u64 = PAGE_PRESENT
  if (prot & 2) != 0 {  // PROT_WRITE
    flags = flags | PAGE_WRITE
  }
  if (prot & 4) == 0 {  // Not PROT_EXEC (NX bit)
    // NX bit would be set here if supported
  }
  flags = flags | PAGE_USER

  var pml4_index: u32 = @truncate((virt >> 39) & 0x1FF, u32)
  var pdpt_index: u32 = @truncate((virt >> 30) & 0x1FF, u32)
  var pd_index: u32 = @truncate((virt >> 21) & 0x1FF, u32)
  var pt_index: u32 = @truncate((virt >> 12) & 0x1FF, u32)

  // Get or create PDPT
  var pml4_entry_addr: u64 = pml4 + (pml4_index * 8)
  var pdpt: u64 = @as(*u64, @ptrFromInt(pml4_entry_addr)).* & ~0xFFF

  if pdpt == 0 {
    pdpt = pmm_alloc_page()
    if pdpt == 0 { return 1 }
    memset(pdpt, 0, PAGE_SIZE)
    @as(*u64, @ptrFromInt(pml4_entry_addr)).* = pdpt | PAGE_PRESENT | PAGE_WRITE | PAGE_USER
  }

  // Get or create PD
  var pdpt_entry_addr: u64 = pdpt + (pdpt_index * 8)
  var pd: u64 = @as(*u64, @ptrFromInt(pdpt_entry_addr)).* & ~0xFFF

  if pd == 0 {
    pd = pmm_alloc_page()
    if pd == 0 { return 1 }
    memset(pd, 0, PAGE_SIZE)
    @as(*u64, @ptrFromInt(pdpt_entry_addr)).* = pd | PAGE_PRESENT | PAGE_WRITE | PAGE_USER
  }

  // Get or create PT
  var pd_entry_addr: u64 = pd + (pd_index * 8)
  var pt: u64 = @as(*u64, @ptrFromInt(pd_entry_addr)).* & ~0xFFF

  if pt == 0 {
    pt = pmm_alloc_page()
    if pt == 0 { return 1 }
    memset(pt, 0, PAGE_SIZE)
    @as(*u64, @ptrFromInt(pd_entry_addr)).* = pt | PAGE_PRESENT | PAGE_WRITE | PAGE_USER
  }

  // Map page
  var pt_entry_addr: u64 = pt + (pt_index * 8)
  @as(*u64, @ptrFromInt(pt_entry_addr)).* = phys | flags

  // Flush TLB if this is the current address space
  if pid == 0 or pml4 == vmm_pml4 {
    arch_invalidate_tlb_page(virt)
  }

  return 0
}

// Unmap page in a process's address space
export fn vmm_unmap_page_process(pid: u32, virt: u64) {
  var pml4: u64 = get_process_pml4(pid)

  var pml4_index: u32 = @truncate((virt >> 39) & 0x1FF, u32)
  var pdpt_index: u32 = @truncate((virt >> 30) & 0x1FF, u32)
  var pd_index: u32 = @truncate((virt >> 21) & 0x1FF, u32)
  var pt_index: u32 = @truncate((virt >> 12) & 0x1FF, u32)

  var pml4_entry_addr: u64 = pml4 + (pml4_index * 8)
  var pdpt: u64 = @as(*u64, @ptrFromInt(pml4_entry_addr)).* & ~0xFFF
  if pdpt == 0 { return }

  var pdpt_entry_addr: u64 = pdpt + (pdpt_index * 8)
  var pd: u64 = @as(*u64, @ptrFromInt(pdpt_entry_addr)).* & ~0xFFF
  if pd == 0 { return }

  var pd_entry_addr: u64 = pd + (pd_index * 8)
  var pt: u64 = @as(*u64, @ptrFromInt(pd_entry_addr)).* & ~0xFFF
  if pt == 0 { return }

  var pt_entry_addr: u64 = pt + (pt_index * 8)
  @as(*u64, @ptrFromInt(pt_entry_addr)).* = 0

  // Flush TLB if this is the current address space
  if pid == 0 or pml4 == vmm_pml4 {
    arch_invalidate_tlb_page(virt)
  }
}

// Get physical address for a virtual address in a process
export fn vmm_get_physical(pid: u32, virt: u64): u64 {
  var pml4: u64 = get_process_pml4(pid)

  var pml4_index: u32 = @truncate((virt >> 39) & 0x1FF, u32)
  var pdpt_index: u32 = @truncate((virt >> 30) & 0x1FF, u32)
  var pd_index: u32 = @truncate((virt >> 21) & 0x1FF, u32)
  var pt_index: u32 = @truncate((virt >> 12) & 0x1FF, u32)

  var pml4_entry_addr: u64 = pml4 + (pml4_index * 8)
  var pml4_entry: u64 = @as(*u64, @ptrFromInt(pml4_entry_addr)).*
  if (pml4_entry & PAGE_PRESENT) == 0 { return 0 }

  var pdpt: u64 = pml4_entry & ~0xFFF
  var pdpt_entry: u64 = @as(*u64, @ptrFromInt(pdpt + pdpt_index * 8)).*
  if (pdpt_entry & PAGE_PRESENT) == 0 { return 0 }

  var pd: u64 = pdpt_entry & ~0xFFF
  var pd_entry: u64 = @as(*u64, @ptrFromInt(pd + pd_index * 8)).*
  if (pd_entry & PAGE_PRESENT) == 0 { return 0 }

  var pt: u64 = pd_entry & ~0xFFF
  var pt_entry: u64 = @as(*u64, @ptrFromInt(pt + pt_index * 8)).*
  if (pt_entry & PAGE_PRESENT) == 0 { return 0 }

  return (pt_entry & ~0xFFF) + (virt & 0xFFF)
}

// Set page protection
export fn vmm_set_protection(pid: u32, virt: u64, prot: u32) {
  var pml4: u64 = get_process_pml4(pid)

  var pml4_index: u32 = @truncate((virt >> 39) & 0x1FF, u32)
  var pdpt_index: u32 = @truncate((virt >> 30) & 0x1FF, u32)
  var pd_index: u32 = @truncate((virt >> 21) & 0x1FF, u32)
  var pt_index: u32 = @truncate((virt >> 12) & 0x1FF, u32)

  var pml4_entry: u64 = @as(*u64, @ptrFromInt(pml4 + pml4_index * 8)).*
  if (pml4_entry & PAGE_PRESENT) == 0 { return }

  var pdpt: u64 = pml4_entry & ~0xFFF
  var pdpt_entry: u64 = @as(*u64, @ptrFromInt(pdpt + pdpt_index * 8)).*
  if (pdpt_entry & PAGE_PRESENT) == 0 { return }

  var pd: u64 = pdpt_entry & ~0xFFF
  var pd_entry: u64 = @as(*u64, @ptrFromInt(pd + pd_index * 8)).*
  if (pd_entry & PAGE_PRESENT) == 0 { return }

  var pt: u64 = pd_entry & ~0xFFF
  var pt_entry_addr: u64 = pt + pt_index * 8
  var pt_entry: u64 = @as(*u64, @ptrFromInt(pt_entry_addr)).*
  if (pt_entry & PAGE_PRESENT) == 0 { return }

  // Get physical address
  var phys: u64 = pt_entry & ~0xFFF

  // Build new flags
  var flags: u64 = PAGE_PRESENT | PAGE_USER
  if (prot & 2) != 0 {  // PROT_WRITE
    flags = flags | PAGE_WRITE
  }

  // Update entry
  @as(*u64, @ptrFromInt(pt_entry_addr)).* = phys | flags

  // Flush TLB
  if pid == 0 or pml4 == vmm_pml4 {
    arch_invalidate_tlb_page(virt)
  }
}

// Set copy-on-write for a page
export fn vmm_set_cow(pid: u32, virt: u64) {
  var pml4: u64 = get_process_pml4(pid)

  var pml4_index: u32 = @truncate((virt >> 39) & 0x1FF, u32)
  var pdpt_index: u32 = @truncate((virt >> 30) & 0x1FF, u32)
  var pd_index: u32 = @truncate((virt >> 21) & 0x1FF, u32)
  var pt_index: u32 = @truncate((virt >> 12) & 0x1FF, u32)

  var pml4_entry: u64 = @as(*u64, @ptrFromInt(pml4 + pml4_index * 8)).*
  if (pml4_entry & PAGE_PRESENT) == 0 { return }

  var pdpt: u64 = pml4_entry & ~0xFFF
  var pdpt_entry: u64 = @as(*u64, @ptrFromInt(pdpt + pdpt_index * 8)).*
  if (pdpt_entry & PAGE_PRESENT) == 0 { return }

  var pd: u64 = pdpt_entry & ~0xFFF
  var pd_entry: u64 = @as(*u64, @ptrFromInt(pd + pd_index * 8)).*
  if (pd_entry & PAGE_PRESENT) == 0 { return }

  var pt: u64 = pd_entry & ~0xFFF
  var pt_entry_addr: u64 = pt + pt_index * 8
  var pt_entry: u64 = @as(*u64, @ptrFromInt(pt_entry_addr)).*
  if (pt_entry & PAGE_PRESENT) == 0 { return }

  // Set COW flag and remove write permission
  pt_entry = pt_entry | PAGE_COW
  pt_entry = pt_entry & ~PAGE_WRITE

  @as(*u64, @ptrFromInt(pt_entry_addr)).* = pt_entry

  // Flush TLB
  if pid == 0 or pml4 == vmm_pml4 {
    arch_invalidate_tlb_page(virt)
  }
}

// Handle COW page fault
export fn vmm_handle_cow(pid: u32, virt: u64): u32 {
  var pml4: u64 = get_process_pml4(pid)

  var pml4_index: u32 = @truncate((virt >> 39) & 0x1FF, u32)
  var pdpt_index: u32 = @truncate((virt >> 30) & 0x1FF, u32)
  var pd_index: u32 = @truncate((virt >> 21) & 0x1FF, u32)
  var pt_index: u32 = @truncate((virt >> 12) & 0x1FF, u32)

  var pml4_entry: u64 = @as(*u64, @ptrFromInt(pml4 + pml4_index * 8)).*
  if (pml4_entry & PAGE_PRESENT) == 0 { return 1 }

  var pdpt: u64 = pml4_entry & ~0xFFF
  var pdpt_entry: u64 = @as(*u64, @ptrFromInt(pdpt + pdpt_index * 8)).*
  if (pdpt_entry & PAGE_PRESENT) == 0 { return 1 }

  var pd: u64 = pdpt_entry & ~0xFFF
  var pd_entry: u64 = @as(*u64, @ptrFromInt(pd + pd_index * 8)).*
  if (pd_entry & PAGE_PRESENT) == 0 { return 1 }

  var pt: u64 = pd_entry & ~0xFFF
  var pt_entry_addr: u64 = pt + pt_index * 8
  var pt_entry: u64 = @as(*u64, @ptrFromInt(pt_entry_addr)).*
  if (pt_entry & PAGE_PRESENT) == 0 { return 1 }

  // Check if this is a COW page
  if (pt_entry & PAGE_COW) == 0 {
    return 1  // Not a COW fault
  }

  var old_phys: u64 = pt_entry & ~0xFFF

  // Allocate new page
  var new_phys: u64 = pmm_alloc_page()
  if new_phys == 0 { return 1 }

  // Copy contents
  memcpy(new_phys, old_phys, PAGE_SIZE)

  // Map with write permission, clear COW flag
  var flags: u64 = PAGE_PRESENT | PAGE_WRITE | PAGE_USER
  @as(*u64, @ptrFromInt(pt_entry_addr)).* = new_phys | flags

  // Flush TLB
  arch_invalidate_tlb_page(virt)

  return 0
}

// Switch to a process's address space
export fn vmm_switch_address_space(pid: u32) {
  var pml4: u64 = get_process_pml4(pid)
  if pml4 == 0 { return }

  foundation.write_cr3(pml4)
}

// Free a process's address space
export fn vmm_free_address_space(pid: u32) {
  if pid >= MAX_PROCESSES { return }
  if pid == 0 { return }  // Never free kernel address space

  var pml4: u64 = process_pml4[pid]
  if pml4 == 0 { return }

  // Free user-space page tables (entries 0-255)
  var pml4_idx: u32 = 0
  while pml4_idx < 256 {
    var pml4_entry: u64 = @as(*u64, @ptrFromInt(pml4 + pml4_idx * 8)).*
    if (pml4_entry & PAGE_PRESENT) != 0 {
      var pdpt: u64 = pml4_entry & ~0xFFF

      var pdpt_idx: u32 = 0
      while pdpt_idx < 512 {
        var pdpt_entry: u64 = @as(*u64, @ptrFromInt(pdpt + pdpt_idx * 8)).*
        if (pdpt_entry & PAGE_PRESENT) != 0 {
          var pd: u64 = pdpt_entry & ~0xFFF

          var pd_idx: u32 = 0
          while pd_idx < 512 {
            var pd_entry: u64 = @as(*u64, @ptrFromInt(pd + pd_idx * 8)).*
            if (pd_entry & PAGE_PRESENT) != 0 {
              var pt: u64 = pd_entry & ~0xFFF

              // Free page table entries
              var pt_idx: u32 = 0
              while pt_idx < 512 {
                var pt_entry: u64 = @as(*u64, @ptrFromInt(pt + pt_idx * 8)).*
                if (pt_entry & PAGE_PRESENT) != 0 {
                  var phys: u64 = pt_entry & ~0xFFF
                  pmm_free_page(phys)
                }
                pt_idx = pt_idx + 1
              }

              pmm_free_page(pt)
            }
            pd_idx = pd_idx + 1
          }

          pmm_free_page(pd)
        }
        pdpt_idx = pdpt_idx + 1
      }

      pmm_free_page(pdpt)
    }
    pml4_idx = pml4_idx + 1
  }

  pmm_free_page(pml4)
  process_pml4[pid] = 0
}

// ============================================================================
// INITIALIZATION
// ============================================================================

export fn memory_init(memory_size: u64) {
  pmm_init(memory_size)
  vmm_init()
  heap_init()
  init_process_pml4()

  foundation.serial_write_string("[Memory] Initialized\n")
}

// ============================================================================
// VOLATILE MMIO ACCESS
// ============================================================================
// Volatile load/store helpers for memory-mapped I/O. Compilers must not
// cache, elide, or reorder MMIO traffic; the *volatile T accesses below
// carry that semantics. framebuffer.home and every ARM64 driver go through
// these.

export fn read_volatile_u8(addr: u64): u8 {
  return @as(*volatile u8, @ptrFromInt(addr)).*
}

export fn read_volatile_u16(addr: u64): u16 {
  return @as(*volatile u16, @ptrFromInt(addr)).*
}

export fn read_volatile_u32(addr: u64): u32 {
  return @as(*volatile u32, @ptrFromInt(addr)).*
}

export fn read_volatile_u64(addr: u64): u64 {
  return @as(*volatile u64, @ptrFromInt(addr)).*
}

export fn write_volatile_u8(addr: u64, value: u8) {
  @as(*volatile u8, @ptrFromInt(addr)).* = value
}

export fn write_volatile_u16(addr: u64, value: u16) {
  @as(*volatile u16, @ptrFromInt(addr)).* = value
}

export fn write_volatile_u32(addr: u64, value: u32) {
  @as(*volatile u32, @ptrFromInt(addr)).* = value
}

export fn write_volatile_u64(addr: u64, value: u64) {
  @as(*volatile u64, @ptrFromInt(addr)).* = value
}
