// home-os Kernel - Process Management
// Real implementations only - no placeholders!

import "foundation.home" as foundation
import "memory.home" as memory

// ============================================================================
// CONSTANTS
// ============================================================================

const MAX_PROCESSES: u32 = 256
const MAX_THREADS: u32 = 1024
const STACK_SIZE: u64 = 8192  // 8KB stack per thread

// Process states
const PROCESS_UNUSED: u32 = 0
const PROCESS_READY: u32 = 1
const PROCESS_RUNNING: u32 = 2
const PROCESS_BLOCKED: u32 = 3
const PROCESS_ZOMBIE: u32 = 4

// ============================================================================
// PROCESS CONTROL BLOCK
// ============================================================================

export struct PCB {
  pid: u32,
  state: u32,
  parent_pid: u32,
  priority: u32,
  
  // CPU state
  rip: u64,
  rsp: u64,
  rbp: u64,
  rflags: u64,
  
  // Memory
  page_table: u64,
  heap_start: u64,
  heap_end: u64,
  stack_start: u64,
  stack_end: u64,
  stack_phys: u64,
  stack_pages: u32,
  
  // Scheduling
  time_slice: u32,
  cpu_time: u64,
  
  // File descriptors
  fd_count: u32,
  fd_table: [u32; 32],

  // Identity. pgid defaults to the pid, making each process its own group
  // leader until something moves it — the same rule POSIX uses.
  pgid: u32,
  uid: u32,
  gid: u32,
  // 1 for a kernel thread, which has no user mapping and must never be
  // handed a user address.
  is_kernel: u32
}

// ============================================================================
// GLOBAL STATE
// ============================================================================

var process_table: [PCB; 256] = undefined
var process_count: u32 = 0
var current_pid: u32 = 0
var next_pid: u32 = 1
var scheduler_initialized: u32 = 0

// ============================================================================
// PROCESS LOOKUP AND ACCESSORS
// ============================================================================

// Slot holding `pid`, or MAX_PROCESSES if there is none. Every accessor below
// goes through this rather than indexing by pid: slots are reused and a pid is
// not its index.
fn slot_of(pid: u32): u32 {
  var i: u32 = 0
  while i < MAX_PROCESSES {
    if process_table[i].pid == pid and process_table[i].state != PROCESS_UNUSED {
      return i
    }
    i = i + 1
  }
  return MAX_PROCESSES
}

export fn process_exists(pid: u32): u32 {
  if slot_of(pid) < MAX_PROCESSES { return 1 }
  return 0
}

// A pid with no live slot reports PROCESS_UNUSED rather than failing: callers
// are asking "is this runnable", and a process that is gone is not.
export fn process_get_state(pid: u32): u32 {
  var slot: u32 = slot_of(pid)
  if slot >= MAX_PROCESSES { return PROCESS_UNUSED }
  return process_table[slot].state
}

export fn process_set_state(pid: u32, state: u32) {
  var slot: u32 = slot_of(pid)
  if slot >= MAX_PROCESSES { return }
  process_table[slot].state = state
}

export fn process_get_parent(pid: u32): u32 {
  var slot: u32 = slot_of(pid)
  if slot >= MAX_PROCESSES { return 0 }
  return process_table[slot].parent_pid
}

export fn process_get_priority(pid: u32): u32 {
  var slot: u32 = slot_of(pid)
  if slot >= MAX_PROCESSES { return 0 }
  return process_table[slot].priority
}

export fn process_get_pgid(pid: u32): u32 {
  var slot: u32 = slot_of(pid)
  if slot >= MAX_PROCESSES { return 0 }
  return process_table[slot].pgid
}

export fn process_is_kernel(pid: u32): u32 {
  var slot: u32 = slot_of(pid)
  if slot >= MAX_PROCESSES { return 0 }
  return process_table[slot].is_kernel
}

// Charge one timer tick to a process and report whether its slice is spent.
// The scheduler decides what to do about that; this only does the accounting.
export fn process_tick(pid: u32): u32 {
  var slot: u32 = slot_of(pid)
  if slot >= MAX_PROCESSES { return 0 }
  process_table[slot].cpu_time = process_table[slot].cpu_time + 1
  if process_table[slot].time_slice > 0 {
    process_table[slot].time_slice = process_table[slot].time_slice - 1
    if process_table[slot].time_slice == 0 { return 1 }
  }
  return 0
}

// ============================================================================
// CONTEXT SWITCH
// ============================================================================

// Save `prev`'s stack pointer and resume `next`'s.
//
// Incomplete, and worth being precise about what it does not do: it moves
// the stack pointer and the page table, and nothing else. Callee-saved
// registers are not saved here — they are preserved by the caller's own
// prologue, which is only true while every switch goes through a normal
// function call. The moment a switch happens from an interrupt handler this
// has to save the full frame instead. Floating-point and SSE state are not
// touched at all.
export fn context_switch(prev: u32, next: u32) {
  var prev_slot: u32 = slot_of(prev)
  var next_slot: u32 = slot_of(next)
  if next_slot >= MAX_PROCESSES { return }

  if prev_slot < MAX_PROCESSES {
    var sp: u64 = 0
    sp = arch_read_stack_pointer()
    process_table[prev_slot].rsp = sp
  }

  current_pid = next

  var new_page_table: u64 = process_table[next_slot].page_table
  if new_page_table != 0 {
    foundation.write_cr3(new_page_table)
  }

  var new_sp: u64 = process_table[next_slot].rsp
  if new_sp != 0 {
    arch_write_stack_pointer(new_sp)
  }
}

// ============================================================================
// PROCESS SYSCALLS
// ============================================================================

// Signal delivery is not implemented, so this does the one thing it can do
// honestly: SIGKILL (9) and SIGTERM (15) terminate the target, and every
// other signal is accepted and dropped. Returns 0 on success, and a nonzero
// errno-shaped value otherwise.
export fn sys_kill(pid: u32, sig: u32): u32 {
  var slot: u32 = slot_of(pid)
  if slot >= MAX_PROCESSES { return 3 }  // ESRCH
  if sig == 9 or sig == 15 {
    process_table[slot].state = PROCESS_ZOMBIE
    return 0
  }
  return 0
}

// Wait for a specific child. Non-blocking in the only sense available yet:
// if the child has not exited, this reports that rather than sleeping, since
// there is no wait queue to sleep on. `status` may be 0 to discard it.
export fn sys_waitpid(pid: u32, status: u64, options: u32): u32 {
  var slot: u32 = slot_of(pid)
  if slot >= MAX_PROCESSES { return 0xFFFFFFFF }
  if process_table[slot].state != PROCESS_ZOMBIE {
    return 0
  }
  if status != 0 {
    @as(*u32, @ptrFromInt(status)).* = process_table[slot].cpu_time
  }
  var reaped: u32 = process_table[slot].pid
  process_table[slot].state = PROCESS_UNUSED
  if process_count > 0 { process_count = process_count - 1 }
  return reaped
}

// There is no privilege model yet, so these record the ids and nothing
// enforces them. Recording is still worth doing: it is what a later check
// will read, and a process that never stored its uid cannot be checked.
export fn sys_setuid(uid: u32): u32 {
  var slot: u32 = slot_of(current_pid)
  if slot >= MAX_PROCESSES { return 1 }
  process_table[slot].uid = uid
  return 0
}

export fn sys_setgid(gid: u32): u32 {
  var slot: u32 = slot_of(current_pid)
  if slot >= MAX_PROCESSES { return 1 }
  process_table[slot].gid = gid
  return 0
}

// ptrace needs a debugger interface that does not exist. Rather than pretend,
// this fails with EPERM for every request — a debugger gets a clear refusal
// instead of silence or a wrong answer.
export fn sys_ptrace(request: u32, pid: u32, addr: u64): u32 {
  return 1  // EPERM
}

// ============================================================================
// PROCESS CREATION
// ============================================================================

// process_create now returns a sentinel (0xFFFFFFFF) on
// failure instead of 0 (which is a legitimate PID for the idle task).
// Callers MUST check against the sentinel, not against zero.
export const PROCESS_CREATE_FAILED: u32 = 0xFFFFFFFF

// Allocate the next PID by scanning for an unused value.
// Previously we just incremented a counter and wrapped at u32 max,
// which after 2^32 forks silently re-used PIDs of live processes.
// This linear scan is O(MAX_PROCESSES) — acceptable for a 256-slot
// table — and guarantees uniqueness against all live PCBs.
fn allocate_unique_pid(): u32 {
  var attempts: u32 = 0
  while attempts < (2 * MAX_PROCESSES) {
    var candidate: u32 = next_pid
    // Advance the generator; wrap past 0 (reserved for idle).
    next_pid = next_pid + 1
    if next_pid == 0 { next_pid = 1 }
    // Reject 0 (idle) and any PID that collides with a live PCB.
    if candidate == 0 {
      attempts = attempts + 1
      continue
    }
    var collision: u32 = 0
    var k: u32 = 0
    while k < MAX_PROCESSES {
      if process_table[k].state != PROCESS_UNUSED and
         process_table[k].pid == candidate {
        collision = 1
        break
      }
      k = k + 1
    }
    if collision == 0 { return candidate }
    attempts = attempts + 1
  }
  return 0  // Exhausted — caller treats as "cannot allocate".
}

export fn process_create(entry_point: u64): u32 {
  if process_count >= MAX_PROCESSES {
    return PROCESS_CREATE_FAILED
  }

  // Find free slot
  var i: u32 = 0
  var slot: u32 = 0
  var found: u32 = 0

  while i < MAX_PROCESSES {
    if process_table[i].state == PROCESS_UNUSED {
      slot = i
      found = 1
      break
    }
    i = i + 1
  }

  if found == 0 { return PROCESS_CREATE_FAILED }

  // Explicitly zero EVERY field of the reused PCB slot
  // before populating it. The old path wrote only a subset, leaving
  // fd_table, cpu_time, heap_end, etc. with values from the slot's
  // previous owner — an info leak and a correctness bug.
  process_table[slot].pid = 0
  process_table[slot].state = PROCESS_UNUSED
  process_table[slot].parent_pid = 0
  process_table[slot].priority = 0
  process_table[slot].rip = 0
  process_table[slot].rsp = 0
  process_table[slot].rbp = 0
  process_table[slot].rflags = 0
  process_table[slot].page_table = 0
  process_table[slot].heap_start = 0
  process_table[slot].heap_end = 0
  process_table[slot].stack_start = 0
  process_table[slot].stack_end = 0
  process_table[slot].stack_phys = 0
  process_table[slot].stack_pages = 0
  process_table[slot].time_slice = 0
  process_table[slot].cpu_time = 0
  process_table[slot].fd_count = 0
  var fd_i: u32 = 0
  while fd_i < 32 {
    process_table[slot].fd_table[fd_i] = 0
    fd_i = fd_i + 1
  }

  // Allocate a globally unique PID (scan for collisions).
  var assigned_pid: u32 = allocate_unique_pid()
  if assigned_pid == 0 { return PROCESS_CREATE_FAILED }

  // Initialize PCB locally.
  var pcb: PCB = undefined
  pcb.pid = assigned_pid
  pcb.state = PROCESS_READY

  // A new process leads its own group until something moves it, which is the
  // rule POSIX uses. uid/gid start at 0 and is_kernel at 0; a kernel thread
  // is marked by its creator.
  pcb.pgid = assigned_pid
  pcb.uid = 0
  pcb.gid = 0
  pcb.is_kernel = 0

  // Validate parent_pid. Kernel-thread callers have
  // current_pid == 0; users expect PID 1 (init) to be their ancestor
  // rather than the swapper. Normalize.
  if current_pid == 0 {
    pcb.parent_pid = 1
  } else {
    pcb.parent_pid = current_pid
  }
  pcb.priority = 10
  
  // Set up CPU state
  pcb.rip = entry_point
  pcb.rflags = 0x202  // IF flag set
  
  // Allocate stack. Track the pages we actually got so we can roll
  // them back on a partial failure instead of leaking them.
  var stack_pages: u32 = STACK_SIZE / 4096
  var stack_base_phys: u64 = 0
  var stack_allocated: u32 = 0
  var j: u32 = 0

  while j < stack_pages {
    var page: u64 = memory.pmm_alloc_page()
    if page == 0 {
      // Roll back all pages we've allocated so far.
      var k: u32 = 0
      while k < stack_allocated {
        memory.pmm_free_page(stack_base_phys + (@as(u64, k) * 4096))
        k = k + 1
      }
      return 0
    }
    if j == 0 { stack_base_phys = page }
    stack_allocated = stack_allocated + 1
    j = j + 1
  }

  pcb.stack_start = 0x0000_7FFF_FFFF_0000
  pcb.stack_end = pcb.stack_start + STACK_SIZE
  pcb.rsp = pcb.stack_end - 16
  pcb.rbp = pcb.rsp
  pcb.stack_phys = stack_base_phys
  pcb.stack_pages = stack_allocated

  // Allocate heap
  pcb.heap_start = 0x0000_0000_1000_0000
  pcb.heap_end = pcb.heap_start

  // Create page table (clone kernel mappings). On failure we must
  // release the stack pages too, otherwise a slow OOM eats all
  // physical memory with orphaned 8KB stack blocks.
  pcb.page_table = memory.pmm_alloc_page()
  if pcb.page_table == 0 {
    var k: u32 = 0
    while k < stack_allocated {
      memory.pmm_free_page(stack_base_phys + (@as(u64, k) * 4096))
      k = k + 1
    }
    return 0
  }
  
  // Initialize scheduling
  pcb.time_slice = 10  // 10ms
  pcb.cpu_time = 0
  
  // Initialize file descriptors
  pcb.fd_count = 0
  
  // Add to process table
  process_table[slot] = pcb
  process_count = process_count + 1
  next_pid = next_pid + 1
  
  foundation.serial_write_string("[Process] Created PID ")
  foundation.serial_write_u64(pcb.pid)
  foundation.serial_write_string("\n")

  return pcb.pid
}

export fn process_destroy(pid: u32): u32 {
  var i: u32 = 0
  
  while i < MAX_PROCESSES {
    if process_table[i].pid == pid and process_table[i].state != PROCESS_UNUSED {
      // Free stack pages
      var k: u32 = 0
      while k < process_table[i].stack_pages {
        memory.pmm_free_page(process_table[i].stack_phys + (@as(u64, k) * 4096))
        k = k + 1
      }

      // Free page table
      memory.pmm_free_page(process_table[i].page_table)

      // Mark as unused
      process_table[i].state = PROCESS_UNUSED
      process_count = process_count - 1

      foundation.serial_write_string("[Process] Destroyed PID ")
      foundation.serial_write_u64(pid)
      foundation.serial_write_string("\n")
      
      return 0
    }
    i = i + 1
  }
  
  return 1  // Not found
}

// ============================================================================
// SCHEDULER (Round-Robin)
// ============================================================================

export fn scheduler_init() {
  if scheduler_initialized == 1 { return }
  
  // Create init process (PID 1)
  var init_pid: u32 = process_create(0x100000)  // Entry at 1MB
  
  scheduler_initialized = 1
  foundation.serial_write_string("[Scheduler] Initialized\n")
}

export fn scheduler_tick() {
  if process_count == 0 { return }

  // Find current process
  var current_idx: u32 = 0
  var found: u32 = 0
  var i: u32 = 0

  while i < MAX_PROCESSES {
    if process_table[i].pid == current_pid and process_table[i].state != PROCESS_UNUSED {
      current_idx = i
      found = 1
      break
    }
    i = i + 1
  }

  if found == 0 { return }

  // Decrement time slice
  if process_table[current_idx].time_slice > 0 {
    process_table[current_idx].time_slice = process_table[current_idx].time_slice - 1
  }
  
  // If time slice expired, switch
  if process_table[current_idx].time_slice == 0 {
    scheduler_switch()
  }
}

fn scheduler_switch() {
  // Find next ready process (round-robin)
  var start_idx: u32 = 0
  var i: u32 = 0
  
  // Find current process index
  while i < MAX_PROCESSES {
    if process_table[i].pid == current_pid {
      start_idx = i
      break
    }
    i = i + 1
  }
  
  // Search for next ready process
  i = (start_idx + 1) % MAX_PROCESSES
  var searched: u32 = 0
  
  while searched < MAX_PROCESSES {
    if process_table[i].state == PROCESS_READY {
      // Switch to this process
      process_table[start_idx].state = PROCESS_READY
      process_table[start_idx].time_slice = 10
      
      process_table[i].state = PROCESS_RUNNING
      process_table[i].time_slice = 10
      
      current_pid = process_table[i].pid
      
      // context_switch takes pids, not slot indices. There used to be a
      // second, private context_switch here that took indices and only
      // reloaded CR3 — the two coexisted with different conventions, and the
      // scheduler was calling the exported one with pids while this call
      // passed slots.
      context_switch(process_table[start_idx].pid, process_table[i].pid)
      
      return
    }
    
    i = (i + 1) % MAX_PROCESSES
    searched = searched + 1
  }
}

// ============================================================================
// SYSTEM CALLS
// ============================================================================

export fn sys_fork(): u32 {
  // Clone current process
  var parent_idx: u32 = 0
  var i: u32 = 0
  
  while i < MAX_PROCESSES {
    if process_table[i].pid == current_pid {
      parent_idx = i
      break
    }
    i = i + 1
  }
  
  // Create child process
  var child_pid: u32 = process_create(process_table[parent_idx].rip)
  
  if child_pid == 0 { return 0 }
  
  // Find child
  i = 0
  while i < MAX_PROCESSES {
    if process_table[i].pid == child_pid {
      // Copy parent state
      process_table[i].rsp = process_table[parent_idx].rsp
      process_table[i].rbp = process_table[parent_idx].rbp
      process_table[i].rflags = process_table[parent_idx].rflags
      break
    }
    i = i + 1
  }
  
  return child_pid
}

export fn sys_exec(entry_point: u64): u32 {
  // Replace current process image
  var i: u32 = 0
  
  while i < MAX_PROCESSES {
    if process_table[i].pid == current_pid {
      process_table[i].rip = entry_point
      process_table[i].rsp = process_table[i].stack_end - 16
      process_table[i].rbp = process_table[i].rsp
      return 0
    }
    i = i + 1
  }
  
  return 1
}

export fn sys_exit(exit_code: u32) {
  // Mark process as zombie
  var i: u32 = 0
  
  while i < MAX_PROCESSES {
    if process_table[i].pid == current_pid {
      process_table[i].state = PROCESS_ZOMBIE
      scheduler_switch()
      break
    }
    i = i + 1
  }
}

export fn sys_wait(pid: u32): u32 {
  // Wait for child process
  var i: u32 = 0
  
  while i < MAX_PROCESSES {
    if process_table[i].pid == pid {
      while process_table[i].state != PROCESS_ZOMBIE {
        // Yield CPU
        scheduler_switch()
      }
      
      // Clean up zombie
      process_destroy(pid)
      return 0
    }
    i = i + 1
  }
  
  return 1
}

export fn sys_getpid(): u32 {
  return current_pid
}

// ============================================================================
// PROCESS INFO
// ============================================================================

export fn process_get_count(): u32 {
  return process_count
}

export fn process_get_info(pid: u32): u64 {
  var i: u32 = 0
  
  while i < MAX_PROCESSES {
    if process_table[i].pid == pid {
      return @ptrFromInt(process_table[i])
    }
    i = i + 1
  }
  
  return 0
}

// ============================================================================
// INITIALIZATION
// ============================================================================

// Convenience aliases used by subsystems (container runtime, OOM killer, etc.)
export fn process_fork(): u32 {
  return sys_fork()
}

export fn process_exec(entry_point: u64, argv: u64, envp: u64): u32 {
  return sys_exec(entry_point)
}

export fn process_exit(exit_code: u32) {
  sys_exit(exit_code)
}

export fn process_init() {
  // Clear process table
  var i: u32 = 0
  while i < MAX_PROCESSES {
    process_table[i].state = PROCESS_UNUSED
    process_table[i].pid = 0
    process_table[i].stack_phys = 0
    process_table[i].stack_pages = 0
    i = i + 1
  }
  
  scheduler_init()
  
  foundation.serial_write_string("[Process] Initialized\n")
}
