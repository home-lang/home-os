// home-os Block Allocator - Stub Module
//
// Minimal stub created for issue #15 to satisfy `import "block_alloc.home"`
// in largefile.home. The consumer is gated behind LARGEFILE_ENABLED = 0
// and contains unparsed Zig syntax, so this stub only needs to expose
// the function names referenced at the import site. A real block
// allocator will replace this when largefile.home is rewritten in
// Home syntax.
//
// TODO(#15): replace with real block allocator. Until then this fails
// closed - read_block returns an empty slice, alloc_blocks returns 0,
// write_block / free_blocks are no-ops. Any caller that actually
// executes against these will silently corrupt nothing because the
// gating const keeps largefile.home dormant.

// Read one filesystem block. Real impl returns the cached/disk block
// data; stub returns an empty slice so any consumer fails fast.
export fn read_block(block_no: u64): []u8 {
    return ""
}

// Write one filesystem block. Stub no-op.
export fn write_block(block_no: u64, data: []u8) {
}

// Allocate `count` contiguous blocks starting near `hint`. Returns the
// first allocated block number, or 0 on failure. Stub always fails.
export fn alloc_blocks(count: u64, hint: u64): u64 {
    return 0
}

// Free `count` blocks starting at `start`. Stub no-op.
export fn free_blocks(start: u64, count: u64) {
}
