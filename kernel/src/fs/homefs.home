// home-os Native Filesystem (homefs) — on-disk structures
//
// STUB(S4): there is no delete path — no way to remove a directory entry or
// an object, so nothing a homefs volume holds can ever be taken off it — and
// objects carry no owner or mode, so the VFS's permission checks have nothing
// to check a homefs file against. MASTER_PLAN §7.
//
// Steps 1–4 and 6 of the plan in docs/design/homefs.md §9 are implemented:
// the on-disk structures and their checksummed encode/decode, a block
// device, copy-on-write B-trees, the commit protocol, snapshots with
// rollback, the object layer — files, directories and extent trees —
// `fsck`, free-space reclamation, and the VFS routing that makes a volume
// reachable through ordinary paths. The
// layers are stacked in that order deliberately: getting the byte layout and
// the integrity check right first meant the tree code was never debugging
// two things at once, and the same for every layer since.
//
// All fields are little-endian on disk regardless of the machine writing
// them, so a volume is portable between architectures — which matters here,
// where the same tree targets both x86-64 and ARM64.

import "../crypto/blake2s.home" as blake2s
import "../drivers/ata.home" as ata
import "../core/foundation.home" as foundation
import "../core/foundation.home" as foundation


// 'HOMS' read as a little-endian u32.
export const HOMEFS_MAGIC: u32 = 0x534D4F48
export const HOMEFS_VERSION: u32 = 1

// The superblock occupies the first 256 bytes of its slot; the rest of the
// two sectors is reserved. The checksum covers everything before it.
export const SUPERBLOCK_SIZE: u32 = 256
export const SUPERBLOCK_CHECKSUM_OFFSET: u32 = 96
export const COMMIT_RECORD_SIZE: u32 = 128
export const COMMIT_CHECKSUM_OFFSET: u32 = 64

// Object IDs are typed by their top bits (design doc §2). A flat 64-bit space
// with the type in the identifier means a snapshot root is an ordinary object
// table entry rather than a separate namespace.
export const OBJ_TYPE_MASK: u64 = 0xC000000000000000
export const OBJ_TYPE_FILE: u64 = 0x0000000000000000
export const OBJ_TYPE_DIR: u64 = 0x8000000000000000
export const OBJ_TYPE_SNAPSHOT: u64 = 0xC000000000000000

// Inode flag referenced by largefile.home::is_extent_based().
export const INODE_EXTENTS: u32 = 0x00000001

// The in-memory form. On-disk it is the byte layout that
// homefs_encode_superblock writes; this struct is what the rest of the kernel
// passes around.
//
// `generation` and `txid` are not in the design document's struct listing but
// are required by its §5: recovery "picks the highest valid (generation,
// txid) pair whose commit record checksums clean". Without both, two
// superblock slots cannot be ordered.
export struct Superblock {
  magic: u32,
  version: u32,
  block_size: u32,
  block_count: u64,
  olog_head: u64,
  olog_tail: u64,
  root_dir_object: u64,
  active_snapshot: u64,
  flags: u64,
  generation: u64,
  txid: u64,
  // Block holding the snapshot table. Inside the checksummed region on
  // purpose: a volume whose superblock verifies but whose snapshot list does
  // not is a volume that has silently lost its rollback points.
  snapshot_table: u64
}

// ============================================================================
// Little-endian primitives
// ============================================================================

fn put8(base: u64, offset: u32, value: u8) {
  @as(*u8, @ptrFromInt(base + @as(u64, offset))).* = value
}

fn get8(base: u64, offset: u32): u8 {
  return @as(*u8, @ptrFromInt(base + @as(u64, offset))).*
}

fn put32(base: u64, offset: u32, value: u32) {
  put8(base, offset, @as(u8, value & 0xFF))
  put8(base, offset + 1, @as(u8, (value >> 8) & 0xFF))
  put8(base, offset + 2, @as(u8, (value >> 16) & 0xFF))
  put8(base, offset + 3, @as(u8, (value >> 24) & 0xFF))
}

fn get32(base: u64, offset: u32): u32 {
  return @as(u32, get8(base, offset))
    | (@as(u32, get8(base, offset + 1)) << 8)
    | (@as(u32, get8(base, offset + 2)) << 16)
    | (@as(u32, get8(base, offset + 3)) << 24)
}

fn put64(base: u64, offset: u32, value: u64) {
  put32(base, offset, @as(u32, value & 0xFFFFFFFF))
  put32(base, offset + 4, @as(u32, (value >> 32) & 0xFFFFFFFF))
}

fn get64(base: u64, offset: u32): u64 {
  return @as(u64, get32(base, offset)) | (@as(u64, get32(base, offset + 4)) << 32)
}

// Every block the allocator hands out is zeroed, and every copy-on-write
// step copies a whole 4 KiB block, so these two are the filesystem's hottest
// loops by a wide margin. Written as byte loops they were four function calls
// per byte, which was enough to push the boot gate past its deadline.
fn zero_range(base: u64, from: u32, to: u32) {
  if to <= from { return }
  @memset(@as(*u8, @ptrFromInt(base + @as(u64, from))), 0, to - from)
}

fn copy_bytes(dest: u64, source: u64, length: u32) {
  if length == 0 { return }
  @memcpy(@as(*u8, @ptrFromInt(dest)), @as(*u8, @ptrFromInt(source)), length)
}

// ============================================================================
// Object IDs
// ============================================================================

export fn object_type(id: u64): u64 {
  // Directory and snapshot ranges are distinguished by the top two bits;
  // files occupy everything below them.
  let top: u64 = id & OBJ_TYPE_MASK
  if top == OBJ_TYPE_SNAPSHOT { return OBJ_TYPE_SNAPSHOT }
  if top == OBJ_TYPE_DIR { return OBJ_TYPE_DIR }
  return OBJ_TYPE_FILE
}

export fn object_is_snapshot(id: u64): u32 {
  if object_type(id) == OBJ_TYPE_SNAPSHOT { return 1 }
  return 0
}

export fn object_is_directory(id: u64): u32 {
  if object_type(id) == OBJ_TYPE_DIR { return 1 }
  return 0
}

// ============================================================================
// Checksums
//
// blake2s, per docs/design/homefs.md §10 question 1. The interim CRC32C that
// question proposed is not needed: STUB(S5) is closed and blake2s is checked
// against RFC 7693 on every boot. Using one digest here and in pantry's signed
// indexes means the filesystem and the updater agree on what a hash is.
// ============================================================================

// Compute the digest of `length` bytes at `base` and write 32 bytes at `out`.
fn digest(out: u64, base: u64, length: u32) {
  blake2s.blake2s(out, base, length)
}

// Verify a structure whose checksum sits at `checksum_offset` and covers
// everything before it. Returns 1 when it matches.
fn checksum_matches(base: u64, checksum_offset: u32): u32 {
  var computed: [u8; 32] = undefined
  digest(@intFromPtr(&computed), base, checksum_offset)
  var i: u32 = 0
  var diff: u32 = 0
  while i < 32 {
    // Compare every byte rather than returning on the first difference. A
    // checksum is not a secret, but the habit is cheap and this code is
    // copied.
    diff = diff | (@as(u32, computed[i]) ^ @as(u32, get8(base, checksum_offset + i)))
    i = i + 1
  }
  if diff == 0 { return 1 }
  return 0
}

// ============================================================================
// Superblock
// ============================================================================

// Write `sb` into a SUPERBLOCK_SIZE buffer at `base`, checksum included.
export fn homefs_encode_superblock(base: u64, sb: *Superblock) {
  zero_range(base, 0, SUPERBLOCK_SIZE)

  put32(base, 0, sb.magic)
  put32(base, 4, sb.version)
  put32(base, 8, sb.block_size)
  // Bytes 12..16 are padding, so every u64 below is eight-byte aligned in the
  // image as well as in memory.
  put64(base, 16, sb.block_count)
  put64(base, 24, sb.olog_head)
  put64(base, 32, sb.olog_tail)
  put64(base, 40, sb.root_dir_object)
  put64(base, 48, sb.active_snapshot)
  put64(base, 56, sb.flags)
  put64(base, 64, sb.generation)
  put64(base, 72, sb.txid)
  put64(base, 80, sb.snapshot_table)
  // 80..96 is the UUID, written by mkfs and preserved across commits.

  digest(base + @as(u64, SUPERBLOCK_CHECKSUM_OFFSET), base, SUPERBLOCK_CHECKSUM_OFFSET)
}

// Read a superblock. Returns 1 on success, 0 if the magic, version or
// checksum says this is not a superblock this kernel should mount.
//
// Checking the checksum before the fields is the point: a torn write leaves a
// slot that still has the right magic.
export fn homefs_decode_superblock(base: u64, sb: *Superblock): u32 {
  if get32(base, 0) != HOMEFS_MAGIC { return 0 }
  if get32(base, 4) != HOMEFS_VERSION { return 0 }
  if checksum_matches(base, SUPERBLOCK_CHECKSUM_OFFSET) == 0 { return 0 }

  sb.magic = get32(base, 0)
  sb.version = get32(base, 4)
  sb.block_size = get32(base, 8)
  sb.block_count = get64(base, 16)
  sb.olog_head = get64(base, 24)
  sb.olog_tail = get64(base, 32)
  sb.root_dir_object = get64(base, 40)
  sb.active_snapshot = get64(base, 48)
  sb.flags = get64(base, 56)
  sb.generation = get64(base, 64)
  sb.txid = get64(base, 72)
  sb.snapshot_table = get64(base, 80)
  return 1
}

// Which of two superblock slots to mount, per §5: the highest valid
// (generation, txid). Returns 0 or 1 for the slot, or 2 when neither is
// valid — a filesystem with no readable superblock must not be mounted, and
// saying so is different from defaulting to slot 0.
export fn homefs_select_superblock(slot0: u64, slot1: u64, out: *Superblock): u32 {
  var a: Superblock = undefined
  var b: Superblock = undefined
  let a_ok: u32 = homefs_decode_superblock(slot0, &a)
  let b_ok: u32 = homefs_decode_superblock(slot1, &b)

  if a_ok == 1 and b_ok == 0 {
    out.* = a
    return 0
  }
  if b_ok == 1 and a_ok == 0 {
    out.* = b
    return 1
  }
  if a_ok == 0 and b_ok == 0 {
    return 2
  }
  if b.generation > a.generation or (b.generation == a.generation and b.txid > a.txid) {
    out.* = b
    return 1
  }
  out.* = a
  return 0
}

// ============================================================================
// Object-log commit record (§5 step 3)
// ============================================================================

export struct CommitRecord {
  txid: u64,
  generation: u64,
  root_dir_object: u64,
  active_snapshot: u64,
  olog_tail: u64
}

export fn homefs_encode_commit(base: u64, rec: *CommitRecord) {
  zero_range(base, 0, COMMIT_RECORD_SIZE)
  put64(base, 0, rec.txid)
  put64(base, 8, rec.generation)
  put64(base, 16, rec.root_dir_object)
  put64(base, 24, rec.active_snapshot)
  put64(base, 32, rec.olog_tail)
  digest(base + @as(u64, COMMIT_CHECKSUM_OFFSET), base, COMMIT_CHECKSUM_OFFSET)
}

// Returns 1 when the record is complete. A commit record is the thing that
// makes a transaction durable, so a partially written one has to read as
// absent rather than as a transaction that happened.
export fn homefs_decode_commit(base: u64, rec: *CommitRecord): u32 {
  if checksum_matches(base, COMMIT_CHECKSUM_OFFSET) == 0 { return 0 }
  rec.txid = get64(base, 0)
  rec.generation = get64(base, 8)
  rec.root_dir_object = get64(base, 16)
  rec.active_snapshot = get64(base, 24)
  rec.olog_tail = get64(base, 32)
  return 1
}

// ============================================================================
// Boot self-test
//
// Step 1 of docs/design/homefs.md §9 is "on-disk struct definitions +
// encode/decode unit tests". These are those tests, run on the machine rather
// than asserted on paper: a round trip through the byte layout, a torn write
// that must not read as valid, and the slot selection recovery depends on.
// ============================================================================

var sb_slot0: [u8; 256] = undefined
var sb_slot1: [u8; 256] = undefined
var commit_buf: [u8; 128] = undefined

export fn homefs_selftest(): u32 {
  var passed: u32 = 0

  // --- round trip -----------------------------------------------------------
  var sb: Superblock = undefined
  sb.magic = HOMEFS_MAGIC
  sb.version = HOMEFS_VERSION
  sb.block_size = 4096
  sb.block_count = 0x0000000100000000
  sb.olog_head = 0x1122334455667788
  sb.olog_tail = 0x0102030405060708
  sb.root_dir_object = OBJ_TYPE_DIR | 1
  sb.active_snapshot = OBJ_TYPE_SNAPSHOT | 7
  sb.flags = 0
  sb.generation = 42
  sb.txid = 1000

  homefs_encode_superblock(@intFromPtr(&sb_slot0), &sb)

  var back: Superblock = undefined
  if homefs_decode_superblock(@intFromPtr(&sb_slot0), &back) == 1 and
     back.block_size == 4096 and
     back.block_count == 0x0000000100000000 and
     back.olog_head == 0x1122334455667788 and
     back.root_dir_object == (OBJ_TYPE_DIR | 1) and
     back.active_snapshot == (OBJ_TYPE_SNAPSHOT | 7) and
     back.generation == 42 and
     back.txid == 1000 {
    passed = passed + 1
  }

  // --- object ID typing -----------------------------------------------------
  if object_is_directory(OBJ_TYPE_DIR | 1) == 1 and
     object_is_snapshot(OBJ_TYPE_SNAPSHOT | 7) == 1 and
     object_is_directory(5) == 0 and
     object_is_snapshot(OBJ_TYPE_DIR | 3) == 0 {
    passed = passed + 1
  }

  // --- a torn write must not read as valid ----------------------------------
  // One flipped bit in a field the checksum covers. The magic and version are
  // untouched, which is exactly the case a magic-only check would wave through.
  put8(@intFromPtr(&sb_slot0), 24, get8(@intFromPtr(&sb_slot0), 24) ^ 0x01)
  if homefs_decode_superblock(@intFromPtr(&sb_slot0), &back) == 0 {
    passed = passed + 1
  }

  // --- slot selection -------------------------------------------------------
  // Slot 0 is the older generation, slot 1 the newer. Recovery must take the
  // newer one; taking the first valid slot would silently roll the filesystem
  // back one transaction on every mount.
  homefs_encode_superblock(@intFromPtr(&sb_slot0), &sb)
  var newer: Superblock = sb
  newer.generation = 43
  newer.txid = 1001
  newer.root_dir_object = OBJ_TYPE_DIR | 9
  homefs_encode_superblock(@intFromPtr(&sb_slot1), &newer)

  var chosen: Superblock = undefined
  if homefs_select_superblock(@intFromPtr(&sb_slot0), @intFromPtr(&sb_slot1), &chosen) == 1 and
     chosen.generation == 43 and chosen.root_dir_object == (OBJ_TYPE_DIR | 9) {
    passed = passed + 1
  }

  // And with the newer slot corrupted, the older one is mounted rather than
  // nothing — that is the whole point of keeping two.
  put8(@intFromPtr(&sb_slot1), 30, get8(@intFromPtr(&sb_slot1), 30) ^ 0xFF)
  if homefs_select_superblock(@intFromPtr(&sb_slot0), @intFromPtr(&sb_slot1), &chosen) == 0 and
     chosen.generation == 42 {
    passed = passed + 1
  }

  // --- commit record --------------------------------------------------------
  var rec: CommitRecord = undefined
  rec.txid = 77
  rec.generation = 43
  rec.root_dir_object = OBJ_TYPE_DIR | 9
  rec.active_snapshot = OBJ_TYPE_SNAPSHOT | 2
  rec.olog_tail = 512
  homefs_encode_commit(@intFromPtr(&commit_buf), &rec)

  var rec_back: CommitRecord = undefined
  if homefs_decode_commit(@intFromPtr(&commit_buf), &rec_back) == 1 and
     rec_back.txid == 77 and rec_back.olog_tail == 512 {
    passed = passed + 1
  }

  // A half-written commit record must read as absent, not as a transaction
  // that happened.
  put8(@intFromPtr(&commit_buf), 16, get8(@intFromPtr(&commit_buf), 16) ^ 0x80)
  if homefs_decode_commit(@intFromPtr(&commit_buf), &rec_back) == 0 {
    passed = passed + 1
  }

  return passed
}

// ============================================================================
// Block device (design doc §9 step 2)
//
// A ramdisk for now. Everything above it addresses blocks, not memory, so the
// same tree code runs against a real device when one is wired up — which is
// the whole reason this layer exists rather than the trees indexing memory
// directly.
// ============================================================================

const HOMEFS_BLOCK_SIZE: u32 = 4096

var device_base: u64 = 0
var device_blocks: u32 = 0
var device_next_free: u32 = 0

// Block 0 is never handed out: zero doubles as "no block" in every pointer
// field, and a tree that could legitimately live there would be
// indistinguishable from an empty one.
export fn homefs_device_init(base: u64, blocks: u32) {
  device_base = base
  device_blocks = blocks
  device_next_free = 1
  alloc_cursor = 1
  @memset(&block_used, 0)
  @memset(&block_dirty, 0)
}

fn block_addr(block: u32): u64 {
  return device_base + @as(u64, block) * @as(u64, HOMEFS_BLOCK_SIZE)
}

// Allocation state. `block_used` is the live set — every block some tree
// reaches — and `block_dirty` is what this transaction has touched and the
// next commit therefore has to write.
//
// The dirty set exists because reclamation makes the allocator go backwards.
// Commit used to write the contiguous range [committed_blocks, next_free),
// which was correct only while allocation was a bump pointer that never
// revisited a block. Reusing a reclaimed block below that watermark would
// have left the new contents in memory and the old ones on disk — a volume
// that mounts, verifies, and is wrong.
//
// Both are bitmaps over the same 65536-block (256 MiB) ceiling fsck has.
const ALLOC_MAX_BLOCKS: u32 = 65536
var block_used: [u8; 8192] = undefined
var block_dirty: [u8; 8192] = undefined
// Where the next linear search for a free block starts, so allocation does
// not rescan the whole volume from 1 every time.
var alloc_cursor: u32 = 1

fn bit_get(map: u64, block: u32): u32 {
  let byte: u8 = @as(*u8, @ptrFromInt(map + @as(u64, block / 8))).*
  if (byte & @as(u8, 1 << (block % 8))) != 0 { return 1 }
  return 0
}

fn bit_set(map: u64, block: u32) {
  let addr: u64 = map + @as(u64, block / 8)
  @as(*u8, @ptrFromInt(addr)).* = @as(*u8, @ptrFromInt(addr)).* | @as(u8, 1 << (block % 8))
}

fn bit_clear(map: u64, block: u32) {
  let addr: u64 = map + @as(u64, block / 8)
  @as(*u8, @ptrFromInt(addr)).* = @as(*u8, @ptrFromInt(addr)).* & ~@as(u8, 1 << (block % 8))
}

fn used_map(): u64 { return @intFromPtr(&block_used) }
fn dirty_map(): u64 { return @intFromPtr(&block_dirty) }

export fn homefs_block_is_used(block: u32): u32 { return bit_get(used_map(), block) }

// Take a block. Reclaimed blocks below the watermark are reused before the
// watermark moves, so a volume that deletes and rewrites does not grow
// without bound. Returns 0 when the device is full — callers must treat that
// as failure rather than as block 0.
export fn homefs_alloc_block(): u32 {
  var block: u32 = 0

  // Reuse first, scanning only what has actually been handed out: the blocks
  // [1, device_next_free). Bounding the scan by the watermark rather than by
  // the device means an empty volume does not walk a large disk to discover
  // that everything past the watermark is untouched — and, more importantly,
  // that a volume whose watermark is still 1 has nothing to reuse. Scanning
  // block 1 itself in that state reported it free and handed it out without
  // moving the watermark, so the next allocation returned it a second time.
  if device_next_free > 1 {
    let span: u32 = device_next_free - 1
    var candidate: u32 = alloc_cursor
    if candidate < 1 or candidate >= device_next_free { candidate = 1 }
    var scanned: u32 = 0
    while scanned < span {
      if bit_get(used_map(), candidate) == 0 {
        block = candidate
        alloc_cursor = candidate + 1
        scanned = span
      } else {
        candidate = candidate + 1
        if candidate >= device_next_free { candidate = 1 }
        scanned = scanned + 1
      }
    }
  }

  if block == 0 {
    if device_next_free >= device_blocks { return 0 }
    if device_next_free >= ALLOC_MAX_BLOCKS { return 0 }
    block = device_next_free
    device_next_free = device_next_free + 1
  }

  bit_set(used_map(), block)
  bit_set(dirty_map(), block)
  zero_range(block_addr(block), 0, HOMEFS_BLOCK_SIZE)
  return block
}

export fn homefs_blocks_used(): u32 { return device_next_free }
export fn homefs_device_blocks(): u32 { return device_blocks }

// ============================================================================
// B-tree (design doc §3)
//
// One node per block, copy-on-write: a modified node is written to a fresh
// block and its parent updated to point at the new copy, all the way to the
// root. Nothing on disk is ever overwritten in place, which is what makes a
// crash leave the previous tree intact.
//
// Node layout: a 32-byte header, then fixed 16-byte entries of (key, value).
// In a leaf the value is the caller's; in an internal node it is the block
// number of a child, and the key is the largest key in that subtree.
// ============================================================================

const BTREE_MAGIC: u32 = 0x52544248        // 'HBTR' little-endian
const NODE_HEADER_SIZE: u32 = 32
const NODE_ENTRY_SIZE: u32 = 16
const NODE_MAX_ENTRIES: u32 = 254          // (4096 - 32) / 16

// A block number that came off disk is not to be trusted: a torn commit can
// leave a superblock pointing at anything. An out-of-range block read through
// block_addr() would land outside the volume's memory entirely, which is a
// page fault in the middle of a mount rather than a filesystem that refuses.
fn block_valid(block: u32): u32 {
  if block == 0 { return 0 }
  if block >= device_blocks { return 0 }
  return 1
}

fn node_magic(block: u32): u32 {
  if block_valid(block) == 0 { return 0 }
  return get32(block_addr(block), 0)
}
fn node_level(block: u32): u32 { return get32(block_addr(block), 4) }
fn node_count(block: u32): u32 {
  if block_valid(block) == 0 { return 0 }
  let count: u32 = get32(block_addr(block), 8)
  // A count past the node's capacity would walk entries off the end of the
  // block. Reading it as empty is the safe answer: it makes the subtree look
  // absent rather than making the walk read the next node's header as keys.
  if count > NODE_MAX_ENTRIES { return 0 }
  return count
}

fn set_node_header(block: u32, level: u32, count: u32) {
  put32(block_addr(block), 0, BTREE_MAGIC)
  put32(block_addr(block), 4, level)
  put32(block_addr(block), 8, count)
}

fn entry_key(block: u32, index: u32): u64 {
  return get64(block_addr(block), NODE_HEADER_SIZE + index * NODE_ENTRY_SIZE)
}

fn entry_value(block: u32, index: u32): u64 {
  return get64(block_addr(block), NODE_HEADER_SIZE + index * NODE_ENTRY_SIZE + 8)
}

fn set_entry(block: u32, index: u32, key: u64, value: u64) {
  put64(block_addr(block), NODE_HEADER_SIZE + index * NODE_ENTRY_SIZE, key)
  put64(block_addr(block), NODE_HEADER_SIZE + index * NODE_ENTRY_SIZE + 8, value)
}

// An empty tree is one empty leaf, so every later operation has a node to
// work against and no case has to special-case "no root".
export fn homefs_btree_create(): u32 {
  let root: u32 = homefs_alloc_block()
  if root == 0 { return 0 }
  set_node_header(root, 0, 0)
  return root
}

// The index of the first entry whose key is >= `key`. Linear because a node
// holds 254 entries and the search is against memory; a binary search is a
// later optimisation, not a correctness matter.
fn find_slot(block: u32, key: u64): u32 {
  var i: u32 = 0
  let count: u32 = node_count(block)
  while i < count {
    if entry_key(block, i) >= key { return i }
    i = i + 1
  }
  return count
}

export fn homefs_btree_lookup(root: u32, key: u64): u64 {
  if root == 0 { return 0 }
  var node: u32 = root
  // Descend until a leaf. The loop is bounded by the tree's height, and a
  // node whose magic is wrong ends the descent rather than being followed —
  // a corrupt pointer must not send this walking arbitrary memory.
  var depth: u32 = 0
  while depth < 16 {
    if node_magic(node) != BTREE_MAGIC { return 0 }
    let slot: u32 = find_slot(node, key)
    if node_level(node) == 0 {
      if slot < node_count(node) and entry_key(node, slot) == key {
        return entry_value(node, slot)
      }
      return 0
    }
    if slot >= node_count(node) { return 0 }
    let child: u32 = @as(u32, entry_value(node, slot))
    if block_valid(child) == 0 { return 0 }
    node = child
    depth = depth + 1
  }
  return 0
}

// Insert carries its result in these rather than through out-parameters: when
// a node splits, its parent needs both halves, and the recursion is single
// threaded through kernel init.
var split_occurred: u32 = 0
var split_key: u64 = 0
var split_block: u32 = 0

// Copy `source` into a fresh block, which is the copy-on-write step. Returns
// 0 when the device is full.
fn copy_node(source: u32): u32 {
  let fresh: u32 = homefs_alloc_block()
  if fresh == 0 { return 0 }
  copy_bytes(block_addr(fresh), block_addr(source), HOMEFS_BLOCK_SIZE)
  return fresh
}

// Insert into the subtree rooted at `node`, returning the block number of its
// rewritten copy. Sets split_occurred when the node had to divide.
fn insert_into(node: u32, key: u64, value: u64): u32 {
  split_occurred = 0
  if node_magic(node) != BTREE_MAGIC { return 0 }

  let level: u32 = node_level(node)
  let count: u32 = node_count(node)
  let slot: u32 = find_slot(node, key)

  if level == 0 {
    let fresh: u32 = copy_node(node)
    if fresh == 0 { return 0 }

    // Replacing an existing key is an update, not an insert: the entry count
    // does not change and nothing can overflow.
    if slot < count and entry_key(node, slot) == key {
      set_entry(fresh, slot, key, value)
      return fresh
    }

    // Shift the tail up by one, from the end, so an entry is never
    // overwritten before it has been moved.
    var i: u32 = count
    while i > slot {
      set_entry(fresh, i, entry_key(fresh, i - 1), entry_value(fresh, i - 1))
      i = i - 1
    }
    set_entry(fresh, slot, key, value)
    set_node_header(fresh, 0, count + 1)

    // Split when the node becomes full, not when it has overflowed. A node
    // holds NODE_MAX_ENTRIES entries at indices 0..NODE_MAX_ENTRIES-1;
    // waiting for the count to exceed that writes entry 254 at offset 4096,
    // which is the first byte of the next block.
    if count + 1 >= NODE_MAX_ENTRIES {
      return split_node(fresh)
    }
    return fresh
  }

  // Internal node: descend into the child that covers this key. A key past
  // every separator belongs in the rightmost child, whose separator then has
  // to grow to cover it.
  var child_slot: u32 = slot
  if child_slot >= count { child_slot = count - 1 }
  let child: u32 = @as(u32, entry_value(node, child_slot))
  let new_child: u32 = insert_into(child, key, value)
  if new_child == 0 { return 0 }

  let child_split: u32 = split_occurred
  let promoted_key: u64 = split_key
  let promoted_block: u32 = split_block

  let fresh: u32 = copy_node(node)
  if fresh == 0 { return 0 }
  split_occurred = 0

  // The child's largest key may have grown, so its separator is rewritten
  // from the child rather than left as it was.
  set_entry(fresh, child_slot, largest_key(new_child), @as(u64, new_child))

  if child_split == 0 {
    return fresh
  }

  // The child divided, so its right half needs a separator of its own.
  var i: u32 = count
  while i > child_slot + 1 {
    set_entry(fresh, i, entry_key(fresh, i - 1), entry_value(fresh, i - 1))
    i = i - 1
  }
  set_entry(fresh, child_slot + 1, promoted_key, @as(u64, promoted_block))
  set_node_header(fresh, level, count + 1)

  if count + 1 >= NODE_MAX_ENTRIES {
    return split_node(fresh)
  }
  return fresh
}

fn largest_key(block: u32): u64 {
  let count: u32 = node_count(block)
  if count == 0 { return 0 }
  return entry_key(block, count - 1)
}

// Divide a node in half. The left half keeps its block; the right half gets a
// fresh one, and its largest key is what the parent will use as its separator.
fn split_node(node: u32): u32 {
  let count: u32 = node_count(node)
  let half: u32 = count / 2

  let right: u32 = homefs_alloc_block()
  if right == 0 { return 0 }
  set_node_header(right, node_level(node), count - half)

  var i: u32 = half
  while i < count {
    set_entry(right, i - half, entry_key(node, i), entry_value(node, i))
    i = i + 1
  }
  set_node_header(node, node_level(node), half)

  split_occurred = 1
  split_key = largest_key(right)
  split_block = right
  return node
}

// Insert into the tree, returning its new root. Copy-on-write means the root
// moves on every insert, and the caller must keep the value returned — the
// old root still describes the tree as it was, which is exactly what a
// snapshot is.
export fn homefs_btree_insert(root: u32, key: u64, value: u64): u32 {
  if root == 0 { return 0 }
  let new_root: u32 = insert_into(root, key, value)
  if new_root == 0 { return 0 }
  if split_occurred == 0 { return new_root }

  // The root divided, so the tree grows a level.
  let grown: u32 = homefs_alloc_block()
  if grown == 0 { return 0 }
  set_node_header(grown, node_level(new_root) + 1, 2)
  set_entry(grown, 0, largest_key(new_root), @as(u64, new_root))
  set_entry(grown, 1, split_key, @as(u64, split_block))
  split_occurred = 0
  return grown
}

// ============================================================================
// Tree tests (design doc §9 step 2: "executed tree tests")
//
// Run against the ramdisk at boot. The interesting case is the one that
// splits: a tree that never divides exercises none of the copy-on-write path
// through a parent, which is where the bugs live.
// ============================================================================

// 600 keys against 254 entries per node still forces the root to split and
// the tree to grow a level, which is the case worth testing. Each insert
// copies its whole path, so the block cost is roughly two per insert until
// the refcount reclamation of design doc §6 exists to give blocks back.
const TREE_TEST_KEYS: u32 = 600

export fn homefs_btree_selftest(base: u64, blocks: u32): u32 {
  homefs_device_init(base, blocks)
  var passed: u32 = 0

  var root: u32 = homefs_btree_create()
  if root == 0 { return 0 }

  // Insert ascending. 900 keys against 254 entries per node forces the root
  // to split and the tree to grow a level.
  var i: u32 = 0
  var ok: u32 = 1
  while i < TREE_TEST_KEYS {
    let key: u64 = @as(u64, i) + 1
    root = homefs_btree_insert(root, key, key * 7)
    if root == 0 {
      ok = 0
      break
    }
    i = i + 1
  }
  if ok == 1 and node_level(root) > 0 { passed = passed + 1 }

  // Every key must read back. A tree that lost entries during a split still
  // answers most lookups, so all of them are checked rather than a sample.
  ok = 1
  i = 0
  while i < TREE_TEST_KEYS {
    let key: u64 = @as(u64, i) + 1
    if homefs_btree_lookup(root, key) != key * 7 { ok = 0 }
    i = i + 1
  }
  if ok == 1 { passed = passed + 1 }

  // A key that was never inserted must not be found. Without this a lookup
  // that returns the neighbouring entry passes the test above.
  if homefs_btree_lookup(root, 0) == 0 and
     homefs_btree_lookup(root, @as(u64, TREE_TEST_KEYS) + 1) == 0 {
    passed = passed + 1
  }

  // Updating a key changes its value and not the tree's shape.
  let before: u32 = homefs_blocks_used()
  root = homefs_btree_insert(root, 500, 12345)
  if root != 0 and homefs_btree_lookup(root, 500) == 12345 and
     homefs_btree_lookup(root, 499) == 499 * 7 {
    passed = passed + 1
  }

  // Copy-on-write: the old root still describes the tree as it was. This is
  // the property snapshots are built on, so it is checked directly rather
  // than assumed from the absence of overwrites.
  let old_root: u32 = root
  let newer: u32 = homefs_btree_insert(root, 4242, 999)
  if newer != 0 and newer != old_root and
     homefs_btree_lookup(newer, 4242) == 999 and
     homefs_btree_lookup(old_root, 4242) == 0 {
    passed = passed + 1
  }

  // An insert must consume blocks; a tree that rewrote in place would not.
  if homefs_blocks_used() > before { passed = passed + 1 }

  return passed
}

// ============================================================================
// Disk backing and the commit protocol (design doc §5, §9 step 3)
//
// The volume lives in memory and is written through to disk at a commit —
// the "in-memory mirror" of §9 step 2. Copy-on-write is what makes that safe
// to do in bulk: newly allocated blocks are not referenced by anything on disk
// until the superblock is updated to point at them, so their order of arrival
// does not matter. Only the last two writes are ordered, and they are the
// whole protocol.
//
// On-disk layout, in 512-byte sectors:
//   0..7    superblock slot 0
//   8..15   superblock slot 1
//   16..23  commit record
//   32..    data blocks, eight sectors each, homefs block N at 32 + N*8
// ============================================================================

const SECTORS_PER_BLOCK: u32 = 8
const SB_SLOT0_LBA: u64 = 0
const SB_SLOT1_LBA: u64 = 8
const COMMIT_LBA: u64 = 16
const DATA_START_LBA: u64 = 32

// Declared here with the rest of the volume state rather than beside the
// snapshot code below. A module-level var used by a function defined earlier
// in the file did not resolve to this storage: homefs_commit read zero while
// homefs_snapshot_create had just written to it, so a snapshot was taken and
// then not recorded in the superblock that was supposed to carry it.
var snapshot_table_block: u32 = 0
var next_snapshot_id: u64 = 1

var volume_drive: u32 = 0
var volume_mounted: u32 = 0
var committed_blocks: u32 = 0
var current_generation: u64 = 0
var current_txid: u64 = 0
var current_root: u64 = 0

// A volume with no backing disk: the tree lives in the ramdisk and commits
// stop at memory. Needed because drive 0 is a real drive — the primary master,
// which is the boot disk — so it cannot double as "no device". A self-test
// that formatted drive 0 would commit its tree over whatever was booted from.
export const HOMEFS_NO_DEVICE: u32 = 0xFFFFFFFF

fn disk_write_block(drive: u32, lba: u64, addr: u64): u32 {
  if drive == HOMEFS_NO_DEVICE { return 0 }
  return ata.ata_write_sectors(drive, lba, SECTORS_PER_BLOCK, addr)
}

fn disk_read_block(drive: u32, lba: u64, addr: u64): u32 {
  if drive == HOMEFS_NO_DEVICE { return 1 }
  return ata.ata_read_sectors(drive, lba, SECTORS_PER_BLOCK, addr)
}

// Lay down a fresh volume: an empty tree, a commit record for it, and both
// superblocks. Both slots are written so a first mount has two valid
// generations to choose between rather than one valid and one arbitrary.
export fn homefs_format(drive: u32, base: u64, blocks: u32): u32 {
  homefs_device_init(base, blocks)
  volume_drive = drive

  let root: u32 = homefs_btree_create()
  if root == 0 { return 0 }

  current_generation = 1
  current_txid = 1
  current_root = @as(u64, root)
  snapshot_table_block = 0
  next_snapshot_id = 1
  committed_blocks = 0
  next_file_id = 1
  next_dir_id = 2

  // A volume without a root directory is not a filesystem, so it is made
  // here rather than lazily on first use: every later path resolution can
  // then assume the root exists instead of testing for it.
  if create_root_directory() == 0 { return 0 }

  if homefs_commit() == 0 { return 0 }
  // The second slot starts as a copy of the first, one generation behind, so
  // the ping-pong has somewhere to land on the next commit.
  current_generation = 2
  current_txid = 2
  if homefs_commit() == 0 { return 0 }

  volume_mounted = 1
  return 1
}

// Write everything this transaction allocated, then the commit record, then
// the superblock. The order is the design document's §5 and it is the entire
// crash-consistency argument:
//
//   1. New blocks first. Nothing on disk points at them yet, so a crash here
//      leaves the previous tree whole and the blocks merely orphaned.
//   2. The commit record. A torn one fails its checksum and reads as absent.
//   3. The superblock last, into the slot the *older* generation occupies.
//      Until this write lands the volume still mounts the previous
//      transaction; after it lands it mounts this one. There is no moment at
//      which it mounts a mixture.
export fn homefs_commit(): u32 {
  if volume_drive == 0 and volume_mounted == 0 and committed_blocks == 0 {
    // formatting: fall through, the drive was set by homefs_format
  }

  // Every block this transaction touched, not a contiguous range: see the
  // allocator's note. A reclaimed block reused below the old watermark is
  // dirty and gets written; a block nothing touched is skipped, which is also
  // why a commit after a no-op transaction costs nothing.
  var block: u32 = 1
  while block < device_next_free {
    if bit_get(dirty_map(), block) == 1 {
      if disk_write_block(volume_drive, DATA_START_LBA + @as(u64, block) * @as(u64, SECTORS_PER_BLOCK),
                          block_addr(block)) != 0 {
        return 0
      }
    }
    block = block + 1
  }

  var record: CommitRecord = undefined
  record.txid = current_txid
  record.generation = current_generation
  record.root_dir_object = current_root
  record.active_snapshot = 0
  record.olog_tail = @as(u64, device_next_free)
  homefs_encode_commit(commit_scratch_addr(), &record)
  if disk_write_block(volume_drive, COMMIT_LBA, commit_scratch_addr()) != 0 { return 0 }

  var sb: Superblock = undefined
  sb.magic = HOMEFS_MAGIC
  sb.version = HOMEFS_VERSION
  sb.block_size = HOMEFS_BLOCK_SIZE
  sb.block_count = @as(u64, device_blocks)
  sb.olog_head = @as(u64, device_next_free)
  sb.olog_tail = 0
  sb.root_dir_object = current_root
  sb.active_snapshot = 0
  sb.flags = 0
  sb.generation = current_generation
  sb.txid = current_txid
  sb.snapshot_table = @as(u64, snapshot_table_block)
  homefs_encode_superblock(sb_scratch_addr(), &sb)

  // Alternate slots, so the one being overwritten is never the one a crash
  // would have to fall back to.
  var target: u64 = SB_SLOT0_LBA
  if (current_generation % 2) == 0 { target = SB_SLOT1_LBA }
  if disk_write_block(volume_drive, target, sb_scratch_addr()) != 0 { return 0 }

  committed_blocks = device_next_free
  // Clean only after the superblock landed. A commit that failed partway
  // leaves everything dirty, so the retry writes it all again rather than
  // assuming the first attempt got there.
  @memset(&block_dirty, 0)
  return 1
}

var sb_scratch: [u8; 4096] = undefined
var commit_scratch: [u8; 4096] = undefined
fn sb_scratch_addr(): u64 { return @intFromPtr(&sb_scratch) }
fn commit_scratch_addr(): u64 { return @intFromPtr(&commit_scratch) }

// Read both superblock slots, take the newer valid one, and load the blocks
// it says are live back into the mirror.
//
// Returns 1 on success. A volume whose superblocks are both unreadable is not
// mounted at all — that is a different answer from mounting an empty one, and
// conflating them would present a wiped disk as a fresh install.
export fn homefs_mount(drive: u32, base: u64, blocks: u32): u32 {
  homefs_device_init(base, blocks)
  volume_drive = drive
  volume_mounted = 0

  if disk_read_block(drive, SB_SLOT0_LBA, sb_scratch_addr()) != 0 { return 0 }
  var slot0: Superblock = undefined
  let slot0_ok: u32 = homefs_decode_superblock(sb_scratch_addr(), &slot0)

  if disk_read_block(drive, SB_SLOT1_LBA, commit_scratch_addr()) != 0 { return 0 }
  var slot1: Superblock = undefined
  let slot1_ok: u32 = homefs_decode_superblock(commit_scratch_addr(), &slot1)

  var chosen: Superblock = undefined
  if slot0_ok == 1 and slot1_ok == 1 {
    if slot1.generation > slot0.generation { chosen = slot1 } else { chosen = slot0 }
  } else {
    if slot0_ok == 1 {
      chosen = slot0
    } else {
      if slot1_ok == 1 { chosen = slot1 } else { return 0 }
    }
  }

  // Load the live blocks back. olog_head carries the allocation watermark,
  // which is how many blocks the committed tree can reach.
  //
  // Both it and the root are checked against the device before anything is
  // read through them. A superblock whose checksum passes can still describe
  // a volume this device cannot hold — a torn write that happened to land on
  // a checksum boundary, or an image from a larger disk — and following it
  // reads outside the volume.
  let live: u32 = @as(u32, chosen.olog_head)
  let root_block: u32 = @as(u32, chosen.root_dir_object)
  if live > blocks or live < 2 { return 0 }
  if root_block == 0 or root_block >= live { return 0 }
  var block: u32 = 1
  while block < live {
    if disk_read_block(drive, DATA_START_LBA + @as(u64, block) * @as(u64, SECTORS_PER_BLOCK),
                       block_addr(block)) != 0 {
      return 0
    }
    block = block + 1
  }

  device_next_free = live
  committed_blocks = live
  // The root has to be a B-tree node. Everything above mount trusts that the
  // root it was handed is one, so this is where it is established rather than
  // assumed.
  if node_magic(root_block) != BTREE_MAGIC { return 0 }
  current_generation = chosen.generation
  current_txid = chosen.txid
  current_root = chosen.root_dir_object
  snapshot_table_block = @as(u32, chosen.snapshot_table)
  // Any id already in the table has been used, so a new snapshot must start
  // past the highest of them or two snapshots would share an id.
  next_snapshot_id = 1
  var si: u32 = 0
  let scount: u32 = snapshot_count_in(snapshot_table_block)
  while si < scount {
    let sid: u64 = snapshot_entry_id(snapshot_table_block, si)
    if sid >= next_snapshot_id { next_snapshot_id = sid + 1 }
    si = si + 1
  }
  volume_mounted = 1
  // Object ids are counted past what the table already holds, and the table
  // is only readable now that the root is loaded.
  refresh_id_watermarks()
  // Nothing on disk records which blocks are free, so the live set is
  // recomputed from the trees. Without this the maps are still zero from
  // device_init and the allocator would hand out blocks the volume is
  // built from.
  rebuild_used_map()
  // Everything just read is what is on disk, so nothing is dirty yet.
  @memset(&block_dirty, 0)
  return 1
}

export fn homefs_is_mounted(): u32 { return volume_mounted }
export fn homefs_root(): u32 { return @as(u32, current_root) }
export fn homefs_generation(): u64 { return current_generation }
export fn homefs_txid(): u64 { return current_txid }

// Advance the transaction and commit whatever this one changed. Callers that
// mutate through the object layer — which does not commit on its own, so a
// sequence of creates and writes lands as one transaction — end with this.
export fn homefs_commit_transaction(): u32 {
  if volume_mounted == 0 { return 0 }
  current_generation = current_generation + 1
  current_txid = current_txid + 1
  return homefs_commit()
}

// Insert a key and commit it, advancing the transaction. Returns 1 on
// success.
export fn homefs_insert_and_commit(key: u64, value: u64): u32 {
  if volume_mounted == 0 { return 0 }
  let new_root: u32 = homefs_btree_insert(@as(u32, current_root), key, value)
  if new_root == 0 { return 0 }
  current_root = @as(u64, new_root)
  current_generation = current_generation + 1
  current_txid = current_txid + 1
  return homefs_commit()
}

export fn homefs_lookup(key: u64): u64 {
  if volume_mounted == 0 { return 0 }
  return homefs_btree_lookup(@as(u32, current_root), key)
}

// ============================================================================
// Snapshots (design doc §7)
//
// A snapshot is a root of the tree that nothing will overwrite. Copy-on-write
// already guarantees that: every insert writes a new root and leaves the old
// one describing the tree exactly as it was. Taking a snapshot is therefore
// recording a block number, and rolling back is choosing a different one —
// both O(1) and independent of how much data the volume holds.
//
// The snapshot table is one block: a count, then entries of
// (id, root block, generation). It is written copy-on-write like everything
// else, so a crash during a snapshot leaves the previous table intact.
// ============================================================================

const SNAPSHOT_TABLE_MAGIC: u32 = 0x50414E53      // 'SNAP'
const SNAPSHOT_HEADER_SIZE: u32 = 16
const SNAPSHOT_ENTRY_SIZE: u32 = 16
const SNAPSHOT_MAX: u32 = 254

fn snapshot_count_in(block: u32): u32 {
  if block_valid(block) == 0 { return 0 }
  if get32(block_addr(block), 0) != SNAPSHOT_TABLE_MAGIC { return 0 }
  let count: u32 = get32(block_addr(block), 4)
  if count > SNAPSHOT_MAX { return 0 }
  return count
}

fn snapshot_entry_id(block: u32, index: u32): u64 {
  return get64(block_addr(block), SNAPSHOT_HEADER_SIZE + index * SNAPSHOT_ENTRY_SIZE)
}

fn snapshot_entry_root(block: u32, index: u32): u32 {
  return get32(block_addr(block), SNAPSHOT_HEADER_SIZE + index * SNAPSHOT_ENTRY_SIZE + 8)
}

fn snapshot_entry_generation(block: u32, index: u32): u32 {
  return get32(block_addr(block), SNAPSHOT_HEADER_SIZE + index * SNAPSHOT_ENTRY_SIZE + 12)
}

export fn homefs_snapshot_count(): u32 {
  return snapshot_count_in(snapshot_table_block)
}

export fn homefs_snapshot_id_at(index: u32): u64 {
  if index >= homefs_snapshot_count() { return 0 }
  return snapshot_entry_id(snapshot_table_block, index)
}

// Pin the current root under a new snapshot id. Returns the id, or 0.
//
// The table is rewritten to a fresh block rather than appended in place, for
// the same reason every tree node is: a crash midway through must leave the
// previous table whole, not a table with a half-written entry on the end.
export fn homefs_snapshot_create(): u64 {
  if volume_mounted == 0 { return 0 }
  let existing: u32 = homefs_snapshot_count()
  if existing >= SNAPSHOT_MAX { return 0 }

  let fresh: u32 = homefs_alloc_block()
  if fresh == 0 { return 0 }
  put32(block_addr(fresh), 0, SNAPSHOT_TABLE_MAGIC)
  put32(block_addr(fresh), 4, existing + 1)

  var i: u32 = 0
  while i < existing {
    put64(block_addr(fresh), SNAPSHOT_HEADER_SIZE + i * SNAPSHOT_ENTRY_SIZE,
          snapshot_entry_id(snapshot_table_block, i))
    put32(block_addr(fresh), SNAPSHOT_HEADER_SIZE + i * SNAPSHOT_ENTRY_SIZE + 8,
          snapshot_entry_root(snapshot_table_block, i))
    put32(block_addr(fresh), SNAPSHOT_HEADER_SIZE + i * SNAPSHOT_ENTRY_SIZE + 12,
          snapshot_entry_generation(snapshot_table_block, i))
    i = i + 1
  }

  let id: u64 = next_snapshot_id
  put64(block_addr(fresh), SNAPSHOT_HEADER_SIZE + existing * SNAPSHOT_ENTRY_SIZE, id)
  put32(block_addr(fresh), SNAPSHOT_HEADER_SIZE + existing * SNAPSHOT_ENTRY_SIZE + 8,
        @as(u32, current_root))
  put32(block_addr(fresh), SNAPSHOT_HEADER_SIZE + existing * SNAPSHOT_ENTRY_SIZE + 12,
        @as(u32, current_generation))

  snapshot_table_block = fresh
  next_snapshot_id = next_snapshot_id + 1
  current_generation = current_generation + 1
  current_txid = current_txid + 1
  if homefs_commit() == 0 { return 0 }
  return id
}

// Roll the active tree back to a snapshot.
//
// The snapshot's root becomes the current root and a new transaction records
// it. History is not rewritten: the root being left behind is still a valid
// tree, and a snapshot taken now would pin it. That is what §7 means by
// rolling back "by branching, never mutating history" — a rollback is
// reversible because the state it left is still reachable.
export fn homefs_snapshot_rollback(id: u64): u32 {
  if volume_mounted == 0 { return 0 }
  let count: u32 = homefs_snapshot_count()
  var i: u32 = 0
  while i < count {
    if snapshot_entry_id(snapshot_table_block, i) == id {
      let root: u32 = snapshot_entry_root(snapshot_table_block, i)
      if block_valid(root) == 0 { return 0 }
      if node_magic(root) != BTREE_MAGIC { return 0 }
      current_root = @as(u64, root)
      current_generation = current_generation + 1
      current_txid = current_txid + 1
      return homefs_commit()
    }
    i = i + 1
  }
  return 0
}

// ============================================================================
// Objects, directories and extents (design doc §9 step 4)
//
// Everything above this point is a key/value store: the root B-tree maps a
// u64 to a u64 and nothing interprets either. This section is what turns that
// into a filesystem — files with contents, directories with names, and the
// extent trees that map a file's logical offsets onto physical blocks.
//
// Layering, so the two namespaces cannot collide: the root tree keeps its
// raw key/value meaning (scripts/crash-gate.sh writes into it directly, with
// small integer keys), and the object table is a *separate* tree hanging off
// one reserved key. An object id and a crash-gate key can therefore both be 3
// without meaning the same thing.
//
// Every mutation here is copy-on-write, like the trees underneath: a modified
// object record is written to a fresh block and the object table updated to
// point at it, so a crash leaves the previous version of the file intact.
// ============================================================================

// The reserved root-tree key under which the object table's root block lives.
// At the very top of the space so it cannot be reached by counting upward
// from 0, which is how every other writer of this tree picks keys.
const OBJTABLE_KEY: u64 = 0xFFFFFFFFFFFFFFFE

const OBJ_RECORD_MAGIC: u32 = 0x4A424F48   // 'HOBJ' little-endian
export const OBJ_KIND_FILE: u32 = 0
export const OBJ_KIND_DIR: u32 = 1

// Names are bounded so an object record is a fixed shape. 64 bytes is the
// same ceiling ext2 uses for a single component.
export const HOMEFS_MAX_NAME: u32 = 64

// The root directory's id is a constant rather than something stored in the
// superblock: it is the one object whose identity cannot be discovered by
// looking it up in a parent, because it has no parent.
export const HOMEFS_ROOT_DIR: u64 = 0x8000000000000001

// Object record layout, one per block. A whole 4 KiB block for ~112 bytes of
// record is the v1 cost of not having a packed-record allocator; it is
// written down here rather than hidden because it is the first thing worth
// fixing when object density starts to matter. The on-disk *shape* below is
// what a packing change would have to preserve, and it would not have to
// change: only where records are placed would.
//
//    0  u32  magic
//    4  u32  kind (file or directory)
//    8  u64  size — bytes for a file, entry count for a directory
//   16  u64  generation the record was written in
//   24  u32  data_root — extent-tree root for a file, directory-tree root
//            for a directory
//   28  u32  refcount
//   32  u64  object id
//   40  u32  name length
//   44  ..   name bytes
const OBJ_NAME_OFFSET: u32 = 44

fn obj_magic(block: u32): u32 {
  if block_valid(block) == 0 { return 0 }
  return get32(block_addr(block), 0)
}

fn obj_kind(block: u32): u32 { return get32(block_addr(block), 4) }
fn obj_size(block: u32): u64 { return get64(block_addr(block), 8) }
fn obj_data_root(block: u32): u32 { return get32(block_addr(block), 24) }
fn obj_id_of(block: u32): u64 { return get64(block_addr(block), 32) }
fn obj_name_len(block: u32): u32 {
  let n: u32 = get32(block_addr(block), 40)
  // A length off the disk decides how far a comparison walks, so it is capped
  // here rather than trusted. Past the cap the name reads as empty, which
  // fails a match instead of walking into the next field.
  if n > HOMEFS_MAX_NAME { return 0 }
  return n
}

fn set_obj_kind(block: u32, v: u32) { put32(block_addr(block), 4, v) }
fn set_obj_size(block: u32, v: u64) { put64(block_addr(block), 8, v) }
fn set_obj_generation(block: u32, v: u64) { put64(block_addr(block), 16, v) }
fn set_obj_data_root(block: u32, v: u32) { put32(block_addr(block), 24, v) }
fn set_obj_refcount(block: u32, v: u32) { put32(block_addr(block), 28, v) }
fn set_obj_id(block: u32, v: u64) { put64(block_addr(block), 32, v) }

// Whether the record's stored name equals the caller's.
fn obj_name_matches(block: u32, name_ptr: u64, name_len: u32): u32 {
  if obj_name_len(block) != name_len { return 0 }
  var i: u32 = 0
  while i < name_len {
    let stored: u8 = get8(block_addr(block), OBJ_NAME_OFFSET + i)
    let given: u8 = @as(*u8, @ptrFromInt(name_ptr + @as(u64, i))).*
    if stored != given { return 0 }
    i = i + 1
  }
  return 1
}

// Copy a record into a fresh block. This is the copy-on-write step for an
// object: callers patch the copy and leave the original describing the
// version a snapshot may still be pinning.
fn obj_record_clone(source: u32): u32 {
  let fresh: u32 = homefs_alloc_block()
  if fresh == 0 { return 0 }
  copy_bytes(block_addr(fresh), block_addr(source), HOMEFS_BLOCK_SIZE)
  return fresh
}

fn obj_record_new(kind: u32, id: u64, name_ptr: u64, name_len: u32): u32 {
  if name_len > HOMEFS_MAX_NAME { return 0 }
  let block: u32 = homefs_alloc_block()
  if block == 0 { return 0 }
  put32(block_addr(block), 0, OBJ_RECORD_MAGIC)
  set_obj_kind(block, kind)
  set_obj_size(block, 0)
  set_obj_generation(block, current_generation)
  set_obj_data_root(block, 0)
  set_obj_refcount(block, 1)
  set_obj_id(block, id)
  put32(block_addr(block), 40, name_len)
  var i: u32 = 0
  while i < name_len {
    put8(block_addr(block), OBJ_NAME_OFFSET + i,
         @as(*u8, @ptrFromInt(name_ptr + @as(u64, i))).*)
    i = i + 1
  }
  return block
}

// ============================================================================
// Object table
// ============================================================================

fn objtable_root(): u32 {
  return @as(u32, homefs_btree_lookup(@as(u32, current_root), OBJTABLE_KEY))
}

// Point the root tree at a new object-table root. The root tree is itself
// copy-on-write, so this moves `current_root` too.
fn objtable_set(new_root: u32): u32 {
  let grown: u32 = homefs_btree_insert(@as(u32, current_root), OBJTABLE_KEY,
                                       @as(u64, new_root))
  if grown == 0 { return 0 }
  current_root = @as(u64, grown)
  return 1
}

// The block holding an object's record, or 0 if there is no such object.
export fn homefs_object_record(id: u64): u32 {
  let table: u32 = objtable_root()
  if table == 0 { return 0 }
  let block: u32 = @as(u32, homefs_btree_lookup(table, id))
  if obj_magic(block) != OBJ_RECORD_MAGIC { return 0 }
  return block
}

fn objtable_put(id: u64, block: u32): u32 {
  var table: u32 = objtable_root()
  if table == 0 {
    table = homefs_btree_create()
    if table == 0 { return 0 }
  }
  let grown: u32 = homefs_btree_insert(table, id, @as(u64, block))
  if grown == 0 { return 0 }
  return objtable_set(grown)
}

export fn homefs_object_size(id: u64): u64 {
  let rec: u32 = homefs_object_record(id)
  if rec == 0 { return 0 }
  return obj_size(rec)
}

export fn homefs_object_kind(id: u64): u32 {
  let rec: u32 = homefs_object_record(id)
  if rec == 0 { return 0xFFFFFFFF }
  return obj_kind(rec)
}

export fn homefs_object_name(id: u64, out: u64, max: u32): u32 {
  let rec: u32 = homefs_object_record(id)
  if rec == 0 { return 0 }
  var n: u32 = obj_name_len(rec)
  if n > max { n = max }
  var i: u32 = 0
  while i < n {
    @as(*u8, @ptrFromInt(out + @as(u64, i))).* = get8(block_addr(rec), OBJ_NAME_OFFSET + i)
    i = i + 1
  }
  return n
}

// ============================================================================
// Tree iteration
//
// The B-tree has no sibling pointers, so walking it in order means descending
// again for each position. That is O(height) per step rather than O(1), which
// for a directory listing against an in-memory device is not worth another
// on-disk field to fix.
// ============================================================================

var iter_target: u32 = 0
var iter_seen: u32 = 0
var iter_found: u32 = 0
var iter_key: u64 = 0
var iter_value: u64 = 0
var iter_counting: u32 = 0

fn iter_walk(node: u32, depth: u32) {
  if depth >= 16 { return }
  if node_magic(node) != BTREE_MAGIC { return }
  let count: u32 = node_count(node)
  if node_level(node) == 0 {
    var i: u32 = 0
    while i < count {
      if iter_counting == 0 and iter_found == 0 and iter_seen == iter_target {
        iter_key = entry_key(node, i)
        iter_value = entry_value(node, i)
        iter_found = 1
      }
      iter_seen = iter_seen + 1
      i = i + 1
    }
    return
  }
  var i: u32 = 0
  while i < count {
    if iter_counting == 0 and iter_found == 1 { return }
    iter_walk(@as(u32, entry_value(node, i)), depth + 1)
    i = i + 1
  }
}

fn btree_count(root: u32): u32 {
  if root == 0 { return 0 }
  iter_counting = 1
  iter_seen = 0
  iter_found = 0
  iter_walk(root, 0)
  iter_counting = 0
  return iter_seen
}

// Load the nth entry in key order into iter_key/iter_value. Returns 1 if
// there is one.
fn btree_nth(root: u32, index: u32): u32 {
  if root == 0 { return 0 }
  iter_counting = 0
  iter_target = index
  iter_seen = 0
  iter_found = 0
  iter_key = 0
  iter_value = 0
  iter_walk(root, 0)
  return iter_found
}

// ============================================================================
// Extents
//
// An extent value packs the triple the design document asks for (§3):
// physical block, run length, and the `shared` flag. v1's writer only ever
// emits runs of one block, but the encoding is the full one so that a writer
// which coalesces runs later does not change the on-disk format.
//
//   bits  0..31  physical block
//   bits 32..47  length in blocks
//   bits 48..63  flags
// ============================================================================

export const EXTENT_SHARED: u32 = 0x0001

fn extent_pack(physical: u32, length: u32, flags: u32): u64 {
  return @as(u64, physical)
    | (@as(u64, length & 0xFFFF) << 32)
    | (@as(u64, flags & 0xFFFF) << 48)
}

fn extent_physical(value: u64): u32 { return @as(u32, value & 0xFFFFFFFF) }
fn extent_length(value: u64): u32 { return @as(u32, (value >> 32) & 0xFFFF) }
fn extent_flags(value: u64): u32 { return @as(u32, (value >> 48) & 0xFFFF) }

// ============================================================================
// Names
// ============================================================================

// FNV-1a, 64-bit. A directory tree is keyed by this rather than by the name
// itself because a B-tree entry is a fixed 16 bytes. Collisions are handled
// by probing rather than ignored — see homefs_dir_lookup.
fn name_hash(ptr: u64, len: u32): u64 {
  var hash: u64 = 0xCBF29CE484222325
  var i: u32 = 0
  while i < len {
    let c: u64 = @as(u64, @as(*u8, @ptrFromInt(ptr + @as(u64, i))).*)
    hash = hash ^ c
    hash = hash * 0x00000100000001B3
    i = i + 1
  }
  // 0 is the tree's "absent" value, so a name that hashes to it would be
  // invisible. Displace it rather than letting one name in 2^64 vanish.
  if hash == 0 { return 1 }
  return hash
}

// How far a lookup or an insert will probe past a colliding hash. Two names
// colliding under a 64-bit hash is already unlikely; nine in a row is not
// something to keep walking a tree over.
const NAME_PROBE_LIMIT: u32 = 8

// ============================================================================
// Directories
// ============================================================================

// The object id of `name` in `dir_id`, or 0.
export fn homefs_dir_lookup(dir_id: u64, name_ptr: u64, name_len: u32): u64 {
  let dir: u32 = homefs_object_record(dir_id)
  if dir == 0 { return 0 }
  if obj_kind(dir) != OBJ_KIND_DIR { return 0 }
  let tree: u32 = obj_data_root(dir)
  if tree == 0 { return 0 }

  let base: u64 = name_hash(name_ptr, name_len)
  var probe: u32 = 0
  while probe < NAME_PROBE_LIMIT {
    let child: u64 = homefs_btree_lookup(tree, base + @as(u64, probe))
    // An empty slot ends the probe: an insert would have taken it, so no
    // later slot can hold this name.
    if child == 0 { return 0 }
    let rec: u32 = homefs_object_record(child)
    if rec != 0 and obj_name_matches(rec, name_ptr, name_len) == 1 { return child }
    probe = probe + 1
  }
  return 0
}

// Number of entries in a directory.
export fn homefs_dir_count(dir_id: u64): u32 {
  let dir: u32 = homefs_object_record(dir_id)
  if dir == 0 { return 0 }
  if obj_kind(dir) != OBJ_KIND_DIR { return 0 }
  return btree_count(obj_data_root(dir))
}

// The object id of the nth entry, in hash order. Hash order is not name
// order; readdir does not promise one, and sorting would mean holding the
// whole directory in memory.
export fn homefs_dir_at(dir_id: u64, index: u32): u64 {
  let dir: u32 = homefs_object_record(dir_id)
  if dir == 0 { return 0 }
  if obj_kind(dir) != OBJ_KIND_DIR { return 0 }
  if btree_nth(obj_data_root(dir), index) == 0 { return 0 }
  return iter_value
}

// Ids are handed out by counting past the highest already in the object
// table, which is recomputed at mount rather than stored. A counter in the
// superblock would be one more thing a torn write could set back, and
// setting it back would reissue a live id.
var next_file_id: u64 = 0
var next_dir_id: u64 = 0

fn refresh_id_watermarks() {
  next_file_id = 1
  next_dir_id = 2                      // 1 is the root directory
  let table: u32 = objtable_root()
  if table == 0 { return }
  let total: u32 = btree_count(table)
  var i: u32 = 0
  while i < total {
    if btree_nth(table, i) == 1 {
      let id: u64 = iter_key
      let bare: u64 = id & ~OBJ_TYPE_MASK
      if object_type(id) == OBJ_TYPE_DIR {
        if bare >= next_dir_id { next_dir_id = bare + 1 }
      } else {
        if object_type(id) == OBJ_TYPE_FILE {
          if bare >= next_file_id { next_file_id = bare + 1 }
        }
      }
    }
    i = i + 1
  }
}

// Create a file or directory under `parent_id`. Returns the new object's id,
// or 0. The caller commits.
export fn homefs_create(parent_id: u64, name_ptr: u64, name_len: u32, kind: u32): u64 {
  if volume_mounted == 0 { return 0 }
  if name_len == 0 or name_len > HOMEFS_MAX_NAME { return 0 }
  let parent: u32 = homefs_object_record(parent_id)
  if parent == 0 { return 0 }
  if obj_kind(parent) != OBJ_KIND_DIR { return 0 }
  if homefs_dir_lookup(parent_id, name_ptr, name_len) != 0 { return 0 }

  var id: u64 = 0
  if kind == OBJ_KIND_DIR {
    id = OBJ_TYPE_DIR | next_dir_id
    next_dir_id = next_dir_id + 1
  } else {
    id = OBJ_TYPE_FILE | next_file_id
    next_file_id = next_file_id + 1
  }

  let rec: u32 = obj_record_new(kind, id, name_ptr, name_len)
  if rec == 0 { return 0 }
  if objtable_put(id, rec) == 0 { return 0 }

  // Link it into the parent. The parent's record is copied first, because the
  // version on disk may be pinned by a snapshot.
  var tree: u32 = obj_data_root(parent)
  if tree == 0 {
    tree = homefs_btree_create()
    if tree == 0 { return 0 }
  }
  let base: u64 = name_hash(name_ptr, name_len)
  var slot: u64 = 0
  var probe: u32 = 0
  while probe < NAME_PROBE_LIMIT {
    if homefs_btree_lookup(tree, base + @as(u64, probe)) == 0 {
      slot = base + @as(u64, probe)
      probe = NAME_PROBE_LIMIT
    } else {
      probe = probe + 1
    }
  }
  if slot == 0 { return 0 }

  let grown: u32 = homefs_btree_insert(tree, slot, id)
  if grown == 0 { return 0 }

  // homefs_object_record is re-read rather than reused: objtable_put above
  // rewrote the root tree, and the parent's record block is unchanged but the
  // path to it is not.
  let parent_now: u32 = homefs_object_record(parent_id)
  if parent_now == 0 { return 0 }
  let fresh_parent: u32 = obj_record_clone(parent_now)
  if fresh_parent == 0 { return 0 }
  set_obj_data_root(fresh_parent, grown)
  set_obj_size(fresh_parent, obj_size(parent_now) + 1)
  set_obj_generation(fresh_parent, current_generation)
  if objtable_put(parent_id, fresh_parent) == 0 { return 0 }

  return id
}

// ============================================================================
// File data
// ============================================================================

// Write `len` bytes from `src` at `offset`. Returns the number of bytes
// written, which is `len` or 0 — a partial write would leave the file in a
// state no caller asked for, and the allocator is the only thing that can
// fail here, so failing whole is both possible and honest.
export fn homefs_file_write(id: u64, offset: u64, src: u64, len: u32): u32 {
  if volume_mounted == 0 { return 0 }
  let rec: u32 = homefs_object_record(id)
  if rec == 0 { return 0 }
  if obj_kind(rec) != OBJ_KIND_FILE { return 0 }

  var tree: u32 = obj_data_root(rec)
  if tree == 0 {
    tree = homefs_btree_create()
    if tree == 0 { return 0 }
  }

  var done: u32 = 0
  while done < len {
    let pos: u64 = offset + @as(u64, done)
    let logical: u64 = pos / @as(u64, HOMEFS_BLOCK_SIZE)
    let within: u32 = @as(u32, pos % @as(u64, HOMEFS_BLOCK_SIZE))
    var chunk: u32 = HOMEFS_BLOCK_SIZE - within
    if chunk > len - done { chunk = len - done }

    // Copy-on-write, even for a full-block overwrite: the block being
    // replaced may belong to a snapshot, and the allocator only ever hands
    // out blocks nothing references.
    let fresh: u32 = homefs_alloc_block()
    if fresh == 0 { return 0 }
    let existing: u64 = homefs_btree_lookup(tree, logical)
    if existing != 0 {
      let old_block: u32 = extent_physical(existing)
      if block_valid(old_block) == 1 {
        copy_bytes(block_addr(fresh), block_addr(old_block), HOMEFS_BLOCK_SIZE)
      }
    }

    var i: u32 = 0
    while i < chunk {
      put8(block_addr(fresh), within + i,
           @as(*u8, @ptrFromInt(src + @as(u64, done) + @as(u64, i))).*)
      i = i + 1
    }

    let grown: u32 = homefs_btree_insert(tree, logical, extent_pack(fresh, 1, 0))
    if grown == 0 { return 0 }
    tree = grown
    done = done + chunk
  }

  let now: u32 = homefs_object_record(id)
  if now == 0 { return 0 }
  let fresh_rec: u32 = obj_record_clone(now)
  if fresh_rec == 0 { return 0 }
  set_obj_data_root(fresh_rec, tree)
  var size: u64 = obj_size(now)
  if offset + @as(u64, len) > size { size = offset + @as(u64, len) }
  set_obj_size(fresh_rec, size)
  set_obj_generation(fresh_rec, current_generation)
  if objtable_put(id, fresh_rec) == 0 { return 0 }
  return len
}

// Read up to `len` bytes into `dst`. Returns the number of bytes read, which
// is short at end of file. A logical block with no extent reads as zeroes —
// that is a hole, not an error, and a file written at a high offset has them.
export fn homefs_file_read(id: u64, offset: u64, dst: u64, len: u32): u32 {
  let rec: u32 = homefs_object_record(id)
  if rec == 0 { return 0 }
  if obj_kind(rec) != OBJ_KIND_FILE { return 0 }
  let size: u64 = obj_size(rec)
  if offset >= size { return 0 }

  var want: u32 = len
  if offset + @as(u64, want) > size { want = @as(u32, size - offset) }
  let tree: u32 = obj_data_root(rec)

  var done: u32 = 0
  while done < want {
    let pos: u64 = offset + @as(u64, done)
    let logical: u64 = pos / @as(u64, HOMEFS_BLOCK_SIZE)
    let within: u32 = @as(u32, pos % @as(u64, HOMEFS_BLOCK_SIZE))
    var chunk: u32 = HOMEFS_BLOCK_SIZE - within
    if chunk > want - done { chunk = want - done }

    let existing: u64 = homefs_btree_lookup(tree, logical)
    let physical: u32 = extent_physical(existing)
    var i: u32 = 0
    if existing != 0 and block_valid(physical) == 1 {
      while i < chunk {
        @as(*u8, @ptrFromInt(dst + @as(u64, done) + @as(u64, i))).* =
          get8(block_addr(physical), within + i)
        i = i + 1
      }
    } else {
      while i < chunk {
        @as(*u8, @ptrFromInt(dst + @as(u64, done) + @as(u64, i))).* = 0
        i = i + 1
      }
    }
    done = done + chunk
  }
  return done
}

// The root directory is the one object created without a parent, so it does
// not go through homefs_create: there is nothing to link it into and no name
// lookup to lose a race with.
var root_dir_name: [u8; 1] = undefined

fn create_root_directory(): u32 {
  root_dir_name[0] = 47                          // '/'
  let rec: u32 = obj_record_new(OBJ_KIND_DIR, HOMEFS_ROOT_DIR,
                                @intFromPtr(&root_dir_name), 1)
  if rec == 0 { return 0 }
  return objtable_put(HOMEFS_ROOT_DIR, rec)
}

// ============================================================================
// Object-layer self-test (design doc §9 step 4)
//
// Run against the ramdisk at boot, like the tree test above. It asserts what
// the layer is *for* — that a named file written through the object layer
// reads back byte for byte — rather than that its functions return without
// crashing. Every check compares against a value stated here, so a function
// that quietly does nothing fails it.
//
// Returns a count of the checks that passed; the caller asserts the total.
// ============================================================================

const OBJ_TEST_CHECKS: u32 = 15

// Deliberately larger than one block, so the write crosses an extent
// boundary and the read has to reassemble it. A test that fits in a single
// block never exercises the loop that made extents necessary.
const OBJ_TEST_BYTES: u32 = 5000

var obj_test_name: [u8; 8] = undefined
var obj_test_dir: [u8; 4] = undefined
var obj_test_out: [u8; 8] = undefined
var obj_test_write: [u8; 5000] = undefined
var obj_test_read: [u8; 5000] = undefined

fn obj_test_fill_names() {
  obj_test_name[0] = 104                         // 'h'
  obj_test_name[1] = 101                         // 'e'
  obj_test_name[2] = 108                         // 'l'
  obj_test_name[3] = 108                         // 'l'
  obj_test_name[4] = 111                         // 'o'
  obj_test_name[5] = 46                          // '.'
  obj_test_name[6] = 116                         // 't'
  obj_test_name[7] = 120                         // 'x'

  obj_test_dir[0] = 101                          // 'e'
  obj_test_dir[1] = 116                          // 't'
  obj_test_dir[2] = 99                           // 'c'
  obj_test_dir[3] = 0
}

export fn homefs_object_selftest(base: u64, blocks: u32): u32 {
  var passed: u32 = 0
  obj_test_fill_names()

  // A fresh volume. This test owns the device, so it formats rather than
  // mounting whatever a previous test left.
  if homefs_format(HOMEFS_NO_DEVICE, base, blocks) == 0 { return passed }

  // 1: format made a root directory, and it is a directory.
  if homefs_object_kind(HOMEFS_ROOT_DIR) == OBJ_KIND_DIR { passed = passed + 1 }

  // 2: an empty root has no entries.
  if homefs_dir_count(HOMEFS_ROOT_DIR) == 0 { passed = passed + 1 }

  let dir: u64 = homefs_create(HOMEFS_ROOT_DIR, @intFromPtr(&obj_test_dir), 3,
                               OBJ_KIND_DIR)
  // 3: creating a directory returns an id in the directory range.
  if dir != 0 and object_is_directory(dir) == 1 { passed = passed + 1 }

  // 4: it is findable by name, and by the same id.
  if homefs_dir_lookup(HOMEFS_ROOT_DIR, @intFromPtr(&obj_test_dir), 3) == dir {
    passed = passed + 1
  }

  let file: u64 = homefs_create(dir, @intFromPtr(&obj_test_name), 8, OBJ_KIND_FILE)
  // 5: a file created inside it is found by name from *that* directory.
  if file != 0 and
     homefs_dir_lookup(dir, @intFromPtr(&obj_test_name), 8) == file {
    passed = passed + 1
  }

  // 6: and is not found from the root, which is a different directory.
  if homefs_dir_lookup(HOMEFS_ROOT_DIR, @intFromPtr(&obj_test_name), 8) == 0 {
    passed = passed + 1
  }

  // A pattern that differs per byte, so a read that returns the wrong block,
  // or the same block twice, does not pass by looking like the right one.
  var i: u32 = 0
  while i < OBJ_TEST_BYTES {
    obj_test_write[i] = @as(u8, (i * 7 + 13) & 0xFF)
    obj_test_read[i] = 0
    i = i + 1
  }

  // 7: the whole write lands.
  if homefs_file_write(file, 0, @intFromPtr(&obj_test_write), OBJ_TEST_BYTES) ==
     OBJ_TEST_BYTES {
    passed = passed + 1
  }

  // 8: and the file's size is what was written, across a commit.
  current_generation = current_generation + 1
  current_txid = current_txid + 1
  if homefs_commit() == 1 and homefs_object_size(file) == @as(u64, OBJ_TEST_BYTES) {
    passed = passed + 1
  }

  // 9: it reads back byte for byte, including across the block boundary at
  // 4096 that made this file more than one extent.
  let got: u32 = homefs_file_read(file, 0, @intFromPtr(&obj_test_read),
                                  OBJ_TEST_BYTES)
  var same: u32 = 1
  if got != OBJ_TEST_BYTES { same = 0 }
  var j: u32 = 0
  while j < OBJ_TEST_BYTES {
    if obj_test_read[j] != obj_test_write[j] { same = 0 }
    j = j + 1
  }
  if same == 1 { passed = passed + 1 }

  // 10: fsck agrees the volume is clean, and counts the three objects that
  // were created — root, the directory, and the file. A checker that always
  // says OK would pass check 10 and fail check 11.
  if homefs_fsck() == FSCK_OK and homefs_fsck_objects() == 3 {
    passed = passed + 1
  }

  // 11: and catches a volume that is not. Two keys in the object table are
  // swapped so they no longer ascend — the shape a tree bug produces, which
  // parses perfectly and answers lookups wrongly. Nothing else about the
  // volume is touched.
  let table: u32 = objtable_root()
  var detected: u32 = 0
  if node_count(table) >= 2 {
    let key0: u64 = entry_key(table, 0)
    let val0: u64 = entry_value(table, 0)
    let key1: u64 = entry_key(table, 1)
    let val1: u64 = entry_value(table, 1)
    set_entry(table, 0, key1, val1)
    set_entry(table, 1, key0, val0)
    if homefs_fsck() == FSCK_UNSORTED { detected = 1 }
    set_entry(table, 0, key0, val0)
    set_entry(table, 1, key1, val1)
  }
  if detected == 1 { passed = passed + 1 }

  // 12: and says so again once it is put back, so check 11 was detection and
  // not a checker that had simply started failing.
  if homefs_fsck() == FSCK_OK { passed = passed + 1 }

  // 13: reclamation gives back the copy-on-write garbage every insert above
  // left behind, and the live count drops by exactly what it reported.
  let live_before: u32 = homefs_blocks_live()
  let freed: u32 = homefs_reclaim()
  if freed > 0 and homefs_blocks_live() == live_before - freed {
    passed = passed + 1
  }

  // 14: and freed nothing the file still needs. A sweep that is too eager
  // passes check 13 by freeing more.
  var intact: u32 = 1
  if homefs_file_read(file, 0, @intFromPtr(&obj_test_read), OBJ_TEST_BYTES) !=
     OBJ_TEST_BYTES {
    intact = 0
  }
  var k: u32 = 0
  while k < OBJ_TEST_BYTES {
    if obj_test_read[k] != @as(u8, (k * 7 + 13) & 0xFF) { intact = 0 }
    k = k + 1
  }
  if intact == 1 { passed = passed + 1 }

  // 15: a snapshot's copy of the file survives being overwritten in the
  // active tree and then swept. This is the check that fails if fsck walks a
  // snapshot's root but not the object table hanging off it: the snapshot's
  // records and extents would look unreferenced and go back to the allocator,
  // and the rollback below would read whatever was written over them.
  let snap: u64 = homefs_snapshot_create()
  var m: u32 = 0
  while m < OBJ_TEST_BYTES {
    obj_test_write[m] = @as(u8, (m * 11 + 29) & 0xFF)
    m = m + 1
  }
  var survived: u32 = 0
  if snap != 0 and
     homefs_file_write(file, 0, @intFromPtr(&obj_test_write), OBJ_TEST_BYTES) ==
       OBJ_TEST_BYTES {
    current_generation = current_generation + 1
    current_txid = current_txid + 1
    if homefs_commit() == 1 {
      let swept: u32 = homefs_reclaim()
      if swept >= 0 and homefs_snapshot_rollback(snap) == 1 {
        if homefs_file_read(file, 0, @intFromPtr(&obj_test_read), OBJ_TEST_BYTES) ==
           OBJ_TEST_BYTES {
          survived = 1
          var q: u32 = 0
          while q < OBJ_TEST_BYTES {
            if obj_test_read[q] != @as(u8, (q * 7 + 13) & 0xFF) { survived = 0 }
            q = q + 1
          }
        }
      }
    }
  }
  if survived == 1 { passed = passed + 1 }

  return passed
}

// ============================================================================
// fsck (design doc §5)
//
// "verifies reachability from all pinned snapshot roots + active root; runs
// online (read-only against a frozen view)."
//
// Read-only is meant literally: nothing here allocates, writes a block, or
// advances a transaction, so it is safe to run against a mounted volume. What
// it produces is a verdict and three counts.
//
// The checks are the ones that catch a *silently* wrong volume, not just an
// unreadable one. A torn write that lands on a checksum boundary, or a bug in
// the tree code, does not usually produce a block that fails to parse — it
// produces one that parses into the wrong shape: keys out of order, a child
// pointer outside the volume, a directory entry whose name does not hash to
// the key it was filed under. Each of those is checked by name below, so a
// failure says which invariant broke rather than only that something did.
// ============================================================================

export const FSCK_OK: u32 = 0
export const FSCK_NOT_MOUNTED: u32 = 1
export const FSCK_BAD_NODE: u32 = 2          // missing or wrong node magic
export const FSCK_BAD_CHILD: u32 = 3         // child pointer outside the volume
export const FSCK_UNSORTED: u32 = 4          // keys not ascending within a node
export const FSCK_TOO_DEEP: u32 = 5          // deeper than a tree can legally be
export const FSCK_BAD_OBJECT: u32 = 6        // object record magic wrong
export const FSCK_BAD_EXTENT: u32 = 7        // extent points outside the volume
export const FSCK_BAD_DIRENT: u32 = 8        // name does not hash to its key
export const FSCK_CYCLE: u32 = 9             // a block reachable twice in one tree

// The visited bitmap is fixed, so fsck has a volume-size ceiling it must not
// exceed silently: 65536 blocks is a 256 MiB volume. Past that it reports
// FSCK_TOO_LARGE rather than checking part of the volume and calling it
// clean, which would be the dangerous answer.
export const FSCK_TOO_LARGE: u32 = 10
const FSCK_MAX_BLOCKS: u32 = 65536
var fsck_seen: [u8; 8192] = undefined

var fsck_status: u32 = 0
var fsck_blocks: u32 = 0
var fsck_objects: u32 = 0
var fsck_dirs: u32 = 0

export fn homefs_fsck_blocks(): u32 { return fsck_blocks }
export fn homefs_fsck_objects(): u32 { return fsck_objects }
export fn homefs_fsck_directories(): u32 { return fsck_dirs }

fn fsck_clear() {
  var i: u32 = 0
  while i < 8192 {
    fsck_seen[i] = 0
    i = i + 1
  }
}

fn fsck_mark(block: u32): u32 {
  let byte: u32 = block / 8
  let bit: u8 = @as(u8, 1 << (block % 8))
  if (fsck_seen[byte] & bit) != 0 { return 0 }
  fsck_seen[byte] = fsck_seen[byte] | bit
  fsck_blocks = fsck_blocks + 1
  return 1
}

fn fsck_fail(code: u32) {
  // The first failure is the one reported. A tree that has gone wrong tends
  // to go wrong in several places at once, and the later ones are usually
  // consequences of the first.
  if fsck_status == FSCK_OK { fsck_status = code }
}

// Walk one B-tree, checking node invariants. `visit_kind` says what a leaf
// value means: 0 = nothing (raw key/value), 1 = object record block,
// 2 = extent.
fn fsck_tree(root: u32, depth: u32, visit_kind: u32) {
  if fsck_status != FSCK_OK { return }
  if depth >= 16 {
    fsck_fail(FSCK_TOO_DEEP)
    return
  }
  if block_valid(root) == 0 {
    fsck_fail(FSCK_BAD_CHILD)
    return
  }
  if node_magic(root) != BTREE_MAGIC {
    fsck_fail(FSCK_BAD_NODE)
    return
  }
  // A block reached twice within one walk means two parents point at it. The
  // tree code never produces that, and following it would loop.
  if fsck_mark(root) == 0 {
    fsck_fail(FSCK_CYCLE)
    return
  }

  let count: u32 = node_count(root)
  let level: u32 = node_level(root)

  // Keys ascend. A node whose keys do not is one every lookup will answer
  // wrongly rather than fail on, which is why it is checked rather than
  // assumed from the insert path being correct.
  var i: u32 = 1
  while i < count {
    if entry_key(root, i) <= entry_key(root, i - 1) {
      fsck_fail(FSCK_UNSORTED)
      return
    }
    i = i + 1
  }

  if level != 0 {
    var c: u32 = 0
    while c < count {
      fsck_tree(@as(u32, entry_value(root, c)), depth + 1, visit_kind)
      if fsck_status != FSCK_OK { return }
      c = c + 1
    }
    return
  }

  if visit_kind == 0 { return }

  var e: u32 = 0
  while e < count {
    let value: u64 = entry_value(root, e)
    if visit_kind == 2 {
      let physical: u32 = extent_physical(value)
      if block_valid(physical) == 0 {
        fsck_fail(FSCK_BAD_EXTENT)
        return
      }
      fsck_mark(physical)
    } else {
      fsck_check_object(entry_key(root, e), @as(u32, value))
      if fsck_status != FSCK_OK { return }
    }
    e = e + 1
  }
}

fn fsck_check_object(id: u64, record: u32) {
  if obj_magic(record) != OBJ_RECORD_MAGIC {
    fsck_fail(FSCK_BAD_OBJECT)
    return
  }
  // The record has to agree with the key it was filed under, or a lookup by
  // id returns someone else's file.
  if obj_id_of(record) != id {
    fsck_fail(FSCK_BAD_OBJECT)
    return
  }
  fsck_mark(record)
  fsck_objects = fsck_objects + 1

  let data_root: u32 = obj_data_root(record)
  if data_root == 0 { return }

  if obj_kind(record) == OBJ_KIND_DIR {
    fsck_dirs = fsck_dirs + 1
    fsck_tree(data_root, 0, 0)
    if fsck_status != FSCK_OK { return }
    fsck_check_dir_entries(data_root)
    return
  }
  fsck_tree(data_root, 0, 2)
}

// Every directory entry must be filed under a key its child's own name
// hashes to, allowing for the collision probe. Otherwise the entry is
// unreachable by name: a lookup would hash the name, find a different child
// or nothing, and report the file missing while it is plainly in the tree.
fn fsck_check_dir_entries(tree: u32) {
  let total: u32 = btree_count(tree)
  var i: u32 = 0
  while i < total {
    if btree_nth(tree, i) == 1 {
      let key: u64 = iter_key
      let child: u64 = iter_value
      let record: u32 = homefs_object_record(child)
      if record == 0 {
        fsck_fail(FSCK_BAD_DIRENT)
        return
      }
      // The copy runs first and the hash second; written as two statements
      // because as one call it would read as though the buffer's address
      // were meaningful before the copy filled it.
      let name_len: u32 = fsck_copy_name(record)
      let base: u64 = name_hash(@intFromPtr(&fsck_name_scratch), name_len)
      if key < base or key >= base + @as(u64, NAME_PROBE_LIMIT) {
        fsck_fail(FSCK_BAD_DIRENT)
        return
      }
    }
    i = i + 1
  }
}

var fsck_name_scratch: [u8; 64] = undefined

fn fsck_copy_name(record: u32): u32 {
  let n: u32 = obj_name_len(record)
  var i: u32 = 0
  while i < n {
    fsck_name_scratch[i] = get8(block_addr(record), OBJ_NAME_OFFSET + i)
    i = i + 1
  }
  return n
}

// Check the active root and every pinned snapshot root. Returns FSCK_OK or
// the first invariant that broke.
export fn homefs_fsck(): u32 {
  if volume_mounted == 0 { return FSCK_NOT_MOUNTED }
  if device_blocks > FSCK_MAX_BLOCKS { return FSCK_TOO_LARGE }

  fsck_status = FSCK_OK
  fsck_blocks = 0
  fsck_objects = 0
  fsck_dirs = 0
  fsck_clear()

  // The root tree's own values are raw, except the reserved key that carries
  // the object table. Walking the object table by hand rather than through
  // the generic leaf visitor keeps the reserved key from being mistaken for
  // an object id.
  fsck_tree(@as(u32, current_root), 0, 0)
  if fsck_status != FSCK_OK { return fsck_status }

  let table: u32 = objtable_root()
  if table != 0 {
    fsck_tree(table, 0, 1)
    if fsck_status != FSCK_OK { return fsck_status }
  }

  // Snapshot roots are trees in their own right and share most of their
  // blocks with the active one; the visited bitmap is deliberately not
  // cleared between them, so a shared block is counted once and a cycle
  // within a single tree is still caught (each walk marks as it descends).
  // The snapshot table is a plain block, not a tree, so nothing above would
  // have reached it. Unmarked it would look unreferenced, and reclamation
  // would hand the volume's whole rollback history back to the allocator.
  if block_valid(snapshot_table_block) == 1 {
    fsck_mark(snapshot_table_block)
  }

  let snapshots: u32 = homefs_snapshot_count()
  var i: u32 = 0
  while i < snapshots {
    let root: u32 = snapshot_entry_root(snapshot_table_block, i)
    if block_valid(root) == 0 {
      fsck_fail(FSCK_BAD_CHILD)
      return fsck_status
    }
    // A snapshot's root already visited by the active walk is the same tree,
    // not a cycle: sharing is what a snapshot *is*. Only descend into one
    // that has not been seen.
    if bit_get(@intFromPtr(&fsck_seen), root) == 0 {
      fsck_tree(root, 0, 0)
      if fsck_status != FSCK_OK { return fsck_status }
    }
    // A snapshot has its own object table, and its objects are live even
    // when the active tree has since deleted them — that is the whole point
    // of pinning one. Walking only the snapshot's root tree would leave its
    // records and file extents unmarked, and reclamation would free the
    // files the snapshot exists to preserve.
    let table: u32 = @as(u32, homefs_btree_lookup(root, OBJTABLE_KEY))
    if table != 0 and bit_get(@intFromPtr(&fsck_seen), table) == 0 {
      fsck_tree(table, 0, 1)
      if fsck_status != FSCK_OK { return fsck_status }
    }
    i = i + 1
  }

  return FSCK_OK
}

// ============================================================================
// Free-space reclamation (design doc §6)
//
// The design document specifies a refcount tree updated at commit boundaries.
// This is mark-and-sweep against the same reachability walk fsck already
// performs, and the deviation is deliberate: an incremental refcount that
// drifts low frees a live block, which is silent corruption discovered much
// later, while a walk that is wrong is wrong in the direction of leaking.
// The walk is also self-healing, which §6 asks the refcount tree to be
// ("rebuilt by inverting the refcount tree if corrupted") — here there is
// nothing to invert, because free space is never stored, only derived.
//
// The cost is a full walk rather than an O(1) update. At the 256 MiB ceiling
// the bitmap already imposes, that is bounded; past it, refcounts become
// worth the risk and this is the thing to replace.
// ============================================================================

// Recompute the live set from what the trees actually reach.
fn rebuild_used_map() {
  @memset(&block_used, 0)
  alloc_cursor = 1
  if homefs_fsck() == FSCK_OK {
    copy_bytes(used_map(), @intFromPtr(&fsck_seen), 8192)
    // Block 0 holds the superblocks and is not the allocator's to give.
    bit_set(used_map(), 0)
    return
  }
  // The walk could not establish what is live, so nothing is treated as
  // free. The volume then only grows — a leak, which is recoverable — rather
  // than handing out a block something still points at.
  var b: u32 = 0
  while b < device_next_free {
    bit_set(used_map(), b)
    b = b + 1
  }
}

// Give back every block no tree reaches. Returns how many.
//
// Only safe between operations: a tree part-way through being built holds its
// new blocks in local variables that no root reaches yet, and a sweep run
// then would free them out from under the caller. Every call site here is
// after a commit.
export fn homefs_reclaim(): u32 {
  if volume_mounted == 0 { return 0 }
  if homefs_fsck() != FSCK_OK { return 0 }

  var freed: u32 = 0
  var block: u32 = 1
  while block < device_next_free {
    if bit_get(used_map(), block) == 1 and
       bit_get(@intFromPtr(&fsck_seen), block) == 0 {
      bit_clear(used_map(), block)
      freed = freed + 1
    }
    block = block + 1
  }
  // Reuse starts from the bottom again, so the freed blocks are the next
  // ones handed out rather than the watermark continuing to climb.
  if freed > 0 { alloc_cursor = 1 }
  return freed
}

// How many blocks below the watermark are live. Distinct from
// homefs_blocks_used(), which is the watermark itself — the difference
// between them is what reclamation has given back.
export fn homefs_blocks_live(): u32 {
  var live: u32 = 0
  var block: u32 = 1
  while block < device_next_free {
    if bit_get(used_map(), block) == 1 { live = live + 1 }
    block = block + 1
  }
  return live
}
