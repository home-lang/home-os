// home-os Native Filesystem (homefs) - Stub Module
//
// STUB(S4): this file exists only to satisfy imports. homefs is the CoW
// filesystem the whole snapshot-and-rollback story rests on, and it needs a
// design document (docs/design/homefs.md) before any implementation.
// Blocks Phase 2 storage and the Phase 6 snapshot-rollback gate. MASTER_PLAN §7.
//
// Minimal stub created for issue #15 to satisfy `import "homefs.home"`
// in fsck.home and largefile.home. Both consumers are gated behind
// `*_ENABLED = 0` and contain unparsed Zig syntax, so this stub only
// needs to expose the symbols their import sites reference. A real
// homefs implementation will replace this when the consumers are
// rewritten in Home syntax.
//
// TODO(#15): replace with real homefs implementation. Until then this
// fails closed - any caller that actually executes against these
// values will see zero/empty fields, which is intentional.

// Inode flag referenced by largefile.home::is_extent_based().
// Real homefs will define the full INODE_* flag set.
export const INODE_EXTENTS: u32 = 0x0000_0001

// Filesystem superblock referenced by fsck.home as `*homefs.Superblock`.
// Fields are placeholders sufficient to let the type name resolve.
pub struct Superblock {
    magic: u32,
    version: u32,
    block_size: u32,
    block_count: u64,
    inode_count: u64,
    free_blocks: u64,
    free_inodes: u64,
}
