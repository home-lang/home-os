// home-os Kernel - ARM64 Architecture Intrinsics
//
// The minimal CPU surface `arch/arm64/rpi/bcm2711.home` and the other ARM64
// drivers reach for. Every function here lowers to a real instruction through
// the Home compiler's architecture-neutral intrinsics, which pick the right
// one for the target being compiled.
//
// This module used to be STUB(S8): `mmio_read32` returned 0 and
// `mmio_write32` did nothing, so every ARM64 and Raspberry Pi driver in the
// tree was inert no matter how complete it looked. Closing it needed volatile
// MMIO semantics in the backend (milestone A3) and an arm64 lowering (A6);
// both landed in home-lang/home@bc1a87bef.

// 32-bit MMIO read, ordered against later accesses.
//
// The `arch_` alias rather than the bare intrinsic name: this module exports
// its own `mmio_read32`, and a program's own definition wins over an
// intrinsic of the same name, so calling `mmio_read32` here would be a call
// to this function.
//
// On aarch64 the load is followed by `dmb oshld`, so a register read cannot
// be reordered after an access that depends on it. On x86-64 nothing is
// emitted, because that memory model already orders loads with loads.
export fn mmio_read32(addr: u64): u32 {
  return arch_mmio_read32(addr)
}

// 32-bit MMIO write, ordered against earlier accesses.
//
// On aarch64 `dmb oshst` precedes the store, so earlier writes are visible to
// the device first. Without it a driver's register writes can reach the
// device in a different order than the source wrote them, which is the
// classic silent Raspberry Pi driver bug.
export fn mmio_write32(addr: u64, value: u32) {
  arch_mmio_write32(addr, value)
}

// 8-bit and 64-bit forms, for registers that are not word-width.
export fn mmio_read8(addr: u64): u8 {
  return arch_mmio_read8(addr)
}

export fn mmio_write8(addr: u64, value: u8) {
  arch_mmio_write8(addr, value)
}

export fn mmio_read64(addr: u64): u64 {
  return arch_mmio_read64(addr)
}

export fn mmio_write64(addr: u64, value: u64) {
  arch_mmio_write64(addr, value)
}

// Hint instruction — yield in busy loops. `yield` on aarch64, `pause` on
// x86-64.
export fn nop() {
  arch_spin_hint()
}

// Wait-for-event — sleep until another core signals. `wfe` on aarch64. x86-64
// has no equivalent, so it lowers to the spin hint: a caller polling a flag
// still makes progress, it just does not sleep.
export fn wfe() {
  arch_wait_event()
}

// Wait-for-interrupt — sleep until an interrupt arrives. `wfi` on aarch64,
// `hlt` on x86-64.
export fn wfi() {
  arch_halt()
}

// A full system barrier: `dsb sy` on aarch64, `mfence` on x86-64. Drivers
// need this between programming a device and expecting it to have observed
// the programming.
export fn barrier() {
  barrier_full()
}

// The counter-timer value. Fixed-frequency on aarch64 (ask CNTFRQ_EL0 for the
// rate); core cycles on x86-64. The two are different clocks and must not be
// compared across architectures.
export fn timestamp(): u64 {
  return arch_read_timestamp()
}
