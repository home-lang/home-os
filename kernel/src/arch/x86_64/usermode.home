// home-os Kernel — ring 3 entry and the system call path
//
// The Phase 1 exit gate asks for a userspace binary that runs via real write
// and exit syscalls. This is the path it takes: a flat binary is read out of
// the initramfs, mapped into user-accessible pages, and entered at ring 3;
// its `int $0x80` lands in syscall_dispatch below.

import "../../core/foundation.home" as foundation
import "../../core/memory.home" as memory
import "../../core/filesystem.home" as filesystem
import "../../sys/syscall.home" as syscall
import "../../loader/elf.home" as elf

// Where a user program is mapped. Well clear of the identity-mapped kernel,
// and inside the first PML4 slot so the existing tables are reused.
const USER_TEXT_BASE: u64 = 0x0000_0000_4000_0000
const USER_STACK_TOP: u64 = 0x0000_0000_4010_0000

const PAGE_PRESENT: u64 = 0x1
const PAGE_WRITE: u64 = 0x2
const PAGE_USER: u64 = 0x4

// home-os's own numbering, from kernel/src/sys/syscall.home. Not Linux's:
// this kernel defines its own ABI and userland/ is built against it.
const SYS_EXIT: u64 = 0
const SYS_READ: u64 = 2
const SYS_WRITE: u64 = 3
const SYS_OPEN: u64 = 4
const SYS_FORK: u64 = 1
const SYS_WAIT: u64 = 6
const SYS_YIELD: u64 = 24
const SYS_KILL_SIG: u64 = 9
const SYS_SIGACTION: u64 = 63
const SYS_SIGRETURN: u64 = 64

// Every other call whose first argument is a path, and the three whose second
// is one too. Taken from kernel/src/sys/syscall.home, which owns the numbering.
const SYS_CHROOT: u64 = 18
const SYS_MKNOD: u64 = 21
const SYS_MKDIR: u64 = 14
const SYS_RMDIR: u64 = 15
const SYS_STAT: u64 = 29
const SYS_LSTAT: u64 = 31
const SYS_UNLINK: u64 = 32
const SYS_LINK: u64 = 33
const SYS_SYMLINK: u64 = 34
const SYS_READLINK: u64 = 35
const SYS_RENAME: u64 = 36
const SYS_ACCESS: u64 = 37
const SYS_CHMOD: u64 = 38
const SYS_CHOWN: u64 = 39

// Where a user program's standard input and output go.
//
// Zero means the usual place: stdin has nothing to read, stdout goes to the
// console. A shell sets these around a program so `<`, `>` and the two halves
// of a pipeline reach files instead. This is what those need — not fork. A
// program reading its own stdin and writing its own stdout does not care
// whether a second process exists, only where the two ends are attached.
var user_stdin_fd: u32 = 0
var user_stdout_fd: u32 = 0

// Set before running a program, cleared after. Returning the previous value
// lets a caller nest them without keeping its own stack of what to restore.
export fn set_user_stdin(fd: u32): u32 {
  let previous: u32 = user_stdin_fd
  user_stdin_fd = fd
  return previous
}

export fn set_user_stdout(fd: u32): u32 {
  let previous: u32 = user_stdout_fd
  user_stdout_fd = fd
  return previous
}

// ============================================================================
// FORK
//
// A child is created with an address space of its own, a copy of the parent's
// user pages, and the parent's register state with a return value of 0 — so
// the one call returns a pid to the parent and zero to the child.
//
// The child does not run at the moment it is created. It runs when the parent
// waits for it, on the parent's kernel stack, and the parent's wait returns
// the child's exit status. That is enough for fork-exec-wait, which is what a
// shell does; it is not enough for a parent and child that both expect to make
// progress, and a parent that never waits never runs its child at all. Saying
// so is the point — the alternative is a fork that looks concurrent and is
// not. S13 stays open for the scheduler that would make it so.
//
// Copying eagerly rather than on write. Copy-on-write needs a fault handler
// that can tell a write to a shared page from a genuine fault, and this kernel
// does not have one; an eager copy is slower and correct.
// ============================================================================

const FORK_FRAME_WORDS: u32 = 15   // 10 saved registers + the 5-word iretq frame
const MAX_CHILDREN: u32 = 4

// A kernel stack per child. Entry from ring 3 reloads rsp from the TSS, so a
// child making a syscall while its parent is inside wait() would otherwise
// land on the parent's kernel stack and overwrite the frames the parent has
// to return through. Flat rather than two-dimensional so the arithmetic for a
// slot's stack is visible where it is used.
// ============================================================================
// COOPERATIVE SCHEDULING
//
// Tasks run until they yield. That is real concurrency — two tasks each making
// progress, interleaved, in their own address spaces — and it is not
// preemption: a task that never yields runs until it exits. Taking the CPU
// away on a timer means switching from inside an interrupt handler, which
// needs every task to be safe to stop anywhere. That is the next piece.
//
// A task is its kernel stack. Switching is choosing which one the CPU is on;
// where the task was in its syscall and what it meant to return to are already
// sitting on that stack.
// ============================================================================

const MAX_TASKS: u32 = 4
const TASK_UNUSED: u32 = 0
const TASK_RUNNABLE: u32 = 1
const TASK_RUNNING: u32 = 2
const TASK_DONE: u32 = 3

var task_kernel_rsp: [4]u64 = undefined
var task_cr3: [4]u64 = undefined
var task_kstack_top: [4]u64 = undefined
var task_frame: [4]u64 = undefined
var task_state: [4]u32 = undefined
var task_exit: [4]u64 = undefined
var current_task: u32 = 0
var task_count: u32 = 0

fn next_runnable(from: u32): u32 {
  var i: u32 = 1
  while i <= MAX_TASKS {
    let candidate: u32 = (from + i) % MAX_TASKS
    if task_state[candidate] == TASK_RUNNABLE { return candidate }
    i = i + 1
  }
  return from
}

// Hand the CPU to another runnable task. Returns when one hands it back.
// ============================================================================
// SIGNALS
//
// A signal is delivered where a task's whole context already is: the frame the
// syscall stub pushed. Delivery rewrites that frame so the iretq at the end of
// the stub enters the handler instead of resuming the interrupted code, and
// sigreturn puts the original frame back.
//
// That is the whole mechanism, and it is only possible because the frame is
// reachable — which is what fork needed too. sys/signal.home's version does
// the mask bookkeeping, prints that it is delivering, and then says "Would set
// up the signal frame on the user stack here": it never enters a handler.
// That path is registered as S16.
//
// Delivered on return from a syscall. A task computing without making one will
// not see a signal until it does, which is a consequence of cooperative
// scheduling rather than a separate limitation: the same task would not yield
// either.
// ============================================================================

const MAX_SIGNALS: u32 = 32
const SIGKILL: u32 = 9
const SIGTERM: u32 = 15

var task_pending: [4]u32 = undefined
var task_sig_handler: [128]u64 = undefined       // task * MAX_SIGNALS + signal
var task_trampoline: [4]u64 = undefined
var task_sigframe: [60]u64 = undefined           // task * FORK_FRAME_WORDS
var task_in_handler: [4]u32 = undefined

fn signals_reset(task: u32) {
  task_pending[task] = 0
  task_trampoline[task] = 0
  task_in_handler[task] = 0
  var i: u32 = 0
  while i < MAX_SIGNALS {
    task_sig_handler[task * MAX_SIGNALS + i] = 0
    i = i + 1
  }
}

// Register a handler, and the address the handler returns through. The
// trampoline is the program's: the kernel cannot invent code in a user
// address space, so libc supplies a stub that calls sigreturn.
fn do_signal(sig: u64, handler: u64, trampoline: u64): u64 {
  if sig == 0 or sig >= @as(u64, MAX_SIGNALS) { return 0xFFFFFFFFFFFFFFFF }
  // SIGKILL cannot be caught. A program that could catch it could refuse to
  // die, and then nothing could stop it.
  if sig == @as(u64, SIGKILL) { return 0xFFFFFFFFFFFFFFFF }
  task_sig_handler[current_task * MAX_SIGNALS + @as(u32, sig)] = handler
  task_trampoline[current_task] = trampoline
  return 0
}

// Mark a signal pending on a task. It is delivered when that task next returns
// from a syscall.
fn do_kill(target: u64, sig: u64): u64 {
  if target >= @as(u64, MAX_TASKS) { return 0xFFFFFFFFFFFFFFFF }
  if sig == 0 or sig >= @as(u64, MAX_SIGNALS) { return 0xFFFFFFFFFFFFFFFF }
  let task: u32 = @as(u32, target)
  if task_state[task] == TASK_UNUSED or task_state[task] == TASK_DONE {
    return 0xFFFFFFFFFFFFFFFF
  }
  task_pending[task] = task_pending[task] | (1 << @as(u32, sig))
  return 0
}

// Rewrite the outgoing frame so the stub's iretq enters the handler.
//
// Returns 1 when the task was terminated and the caller must not return to it.
// `result` is what the interrupted syscall was going to return. It is passed
// in rather than read from the frame: the frame's first slot is the %rax the
// stub pushed, which still held the syscall *number* at that point, not its
// result. Saving that instead made a kill() that delivered a signal return 9
// — its own syscall number — which is exactly what the test caught.
fn deliver_signals(frame: u64, result: u64): u32 {
  let task: u32 = current_task
  if task_pending[task] == 0 { return 0 }
  // One at a time, and not while already in a handler: re-entering would
  // overwrite the frame the first delivery saved for sigreturn.
  if task_in_handler[task] == 1 { return 0 }

  var sig: u32 = 1
  while sig < MAX_SIGNALS {
    if (task_pending[task] & (1 << sig)) != 0 { break }
    sig = sig + 1
  }
  if sig >= MAX_SIGNALS { return 0 }

  task_pending[task] = task_pending[task] & ~(1 << sig)

  let handler: u64 = task_sig_handler[task * MAX_SIGNALS + sig]
  if handler == 0 {
    // No handler. Terminating signals terminate; everything else is ignored,
    // which is stated rather than silently assumed.
    if sig == SIGKILL or sig == SIGTERM {
      foundation.serial_write_string("[signal] task ")
      foundation.serial_write_u64(@as(u64, task))
      foundation.serial_write_string(" terminated by signal ")
      foundation.serial_write_u64(@as(u64, sig))
      foundation.serial_write_string("\n")
      task_state[task] = TASK_DONE
      task_exit[task] = 128 + @as(u64, sig)
      return 1
    }
    return 0
  }

  // Save the interrupted frame whole, so sigreturn can put it back exactly.
  var i: u32 = 0
  while i < FORK_FRAME_WORDS {
    task_sigframe[task * FORK_FRAME_WORDS + i] =
      @as(*u64, @ptrFromInt(frame + @as(u64, i * 8))).*
    i = i + 1
  }
  // The value the interrupted call returns, in the slot sigreturn reads back.
  task_sigframe[task * FORK_FRAME_WORDS] = result

  // The handler's return address goes on the task's own stack, which is
  // mapped in the address space in force right now — this runs inside that
  // task's syscall.
  var user_rsp: u64 = @as(*u64, @ptrFromInt(frame + 13 * 8)).*
  user_rsp = user_rsp - 8
  @as(*u64, @ptrFromInt(user_rsp)).* = task_trampoline[task]

  @as(*u64, @ptrFromInt(frame + 6 * 8)).* = @as(u64, sig)   // rdi: the signal
  @as(*u64, @ptrFromInt(frame + 10 * 8)).* = handler        // rip
  @as(*u64, @ptrFromInt(frame + 13 * 8)).* = user_rsp       // rsp
  task_in_handler[task] = 1
  return 0
}

// Put the interrupted frame back. The restored rax is the value the
// interrupted syscall was going to return, so the program resumes as though
// the handler had never run.
// Put the interrupted frame back and return what the interrupted call was
// going to return, so the program resumes as though the handler never ran.
fn do_sigreturn(frame: u64): u64 {
  let task: u32 = current_task
  if task_in_handler[task] == 0 { return 0xFFFFFFFFFFFFFFFF }
  var i: u32 = 0
  while i < FORK_FRAME_WORDS {
    @as(*u64, @ptrFromInt(frame + @as(u64, i * 8))).* =
      task_sigframe[task * FORK_FRAME_WORDS + i]
    i = i + 1
  }
  task_in_handler[task] = 0
  return @as(*u64, @ptrFromInt(frame)).*
}

// Make the program the kernel is about to enter task 0.
//
// Both loaders call this. It lived inline in one of them and the other was
// reached by `exec`, so a program started that way inherited task 0's state
// from whichever program ran last — which by then was DONE, so the scheduler
// could find nothing to switch back to and a child's exit unwound the kernel
// carrying the child's status.
fn scheduler_reset() {
  current_task = 0
  task_count = 1
  child_count = 0
  task_state[0] = TASK_RUNNING
  task_cr3[0] = current_space
  task_kstack_top[0] = foundation.tss_get_rsp0()
  task_frame[0] = 0
  task_exit[0] = 0
  signals_reset(0)
  var t: u32 = 1
  while t < MAX_TASKS {
    task_state[t] = TASK_UNUSED
    signals_reset(t)
    t = t + 1
  }
}

fn scheduler_yield() {
  let me: u32 = current_task
  let next: u32 = next_runnable(me)
  if next == me { return }

  if task_state[me] == TASK_RUNNING { task_state[me] = TASK_RUNNABLE }
  task_state[next] = TASK_RUNNING
  current_task = next

  // The incoming task's syscalls must land on its own kernel stack, not on
  // whichever stack happened to be current when it was created.
  foundation.tss_set_rsp0(task_kstack_top[next])
  current_space = task_cr3[next]

  process_switch(@intFromPtr(&task_kernel_rsp) + @as(u64, me * 8),
                 task_kernel_rsp[next], task_cr3[next])
}

const CHILD_KSTACK_BYTES: u32 = 8192
var child_kstack: [32768]u8 = undefined

var child_frame: [4][15]u64 = undefined
var child_space: [4]u64 = undefined
var child_exit: [4]u64 = undefined
var child_live: [4]u32 = undefined
var child_count: u32 = 0

// The address space the running program is in, so a fork knows what to copy.
var current_space: u64 = 0

var user_exited: u32 = 0
var user_exit_code: u64 = 0
var syscalls_served: u64 = 0

// Loading buffer. A user program is read here before being copied into the
// pages it will actually run from.
var load_buffer: [4096]u8 = undefined

extern fn enter_usermode(rip: u64, rsp: u64, argc: u64, argv: u64)
extern fn enter_usermode_resume(frame: u64, cr3: u64)
extern fn process_switch(save_slot: u64, next_rsp: u64, next_cr3: u64)
extern fn process_first_run()
extern fn return_to_kernel()

// ============================================================================
// SYSCALLS
// ============================================================================

// ============================================================================
// USER POINTER VALIDATION
//
// A syscall argument that is an address comes from ring 3, and ring 3 is not
// a source of valid pointers. Until this existed, a user program that passed
// a bad one page-faulted the *kernel*: `exec /bin/cp` halted the machine with
//
//   [Exception] vector=000000000000000E rip=0000000000100C02 cr2=000000004020F000
//
// — the kernel dereferencing an address two pages past the program's own BSS.
// Any user program could do that, deliberately or by accident, so this is a
// denial of service as much as a robustness gap.
//
// Validation covers the syscalls userspace actually reaches today: read,
// write and open. A syscall that grows a pointer argument later must be added
// here; the check is deliberately not silent about what it does not cover.
// ============================================================================

// The window this loader maps a program into: its image from USER_TEXT_BASE
// and its stack below USER_STACK_TOP. An address outside it was never handed
// out by the kernel and cannot be legitimate.
const USER_ADDR_MIN: u64 = 0x0000_0000_4000_0000
const USER_ADDR_MAX: u64 = 0x0000_0000_5000_0000

// The largest buffer a single syscall may name. A length is as untrusted as
// an address, and one that is merely enormous would otherwise walk the page
// tables for a very long time before failing.
const USER_XFER_MAX: u64 = 0x0010_0000

// Whether every page of [addr, addr + len) is mapped. Checked a page at a
// time rather than at the ends: a buffer may span an unmapped hole.
fn user_range_ok(addr: u64, len: u64): u32 {
  if len == 0 { return 1 }
  if len > USER_XFER_MAX { return 0 }
  if addr < USER_ADDR_MIN { return 0 }
  if addr >= USER_ADDR_MAX { return 0 }

  let end: u64 = addr + len
  // A length that wraps past the top of the address space is not a length.
  if end < addr { return 0 }
  if end > USER_ADDR_MAX { return 0 }

  var page: u64 = addr & 0xFFFF_FFFF_FFFF_F000
  while page < end {
    if memory.vmm_get_kernel_physical(page) == 0 { return 0 }
    page = page + 4096
  }
  return 1
}

// Whether `addr` points at a NUL-terminated string that stays inside mapped
// user memory. Returns 1 when a terminator was found before the limit.
fn user_cstr_ok(addr: u64, max: u64): u32 {
  if addr < USER_ADDR_MIN { return 0 }
  if addr >= USER_ADDR_MAX { return 0 }

  var i: u64 = 0
  var checked_page: u64 = 0xFFFF_FFFF_FFFF_FFFF
  while i < max {
    let at: u64 = addr + i
    if at >= USER_ADDR_MAX { return 0 }
    let page: u64 = at & 0xFFFF_FFFF_FFFF_F000
    // One page-table walk per page, not per byte.
    if page != checked_page {
      if memory.vmm_get_kernel_physical(page) == 0 { return 0 }
      checked_page = page
    }
    if @as(*u8, @ptrFromInt(at)).* == 0 { return 1 }
    i = i + 1
  }
  return 0
}

// Whether this syscall's first argument is a path. Listed rather than ranged:
// the numbering has gaps, and a range would quietly cover a syscall added
// later whose first argument is not a pointer at all.
fn takes_path_in_arg1(nr: u64): u32 {
  if nr == SYS_OPEN { return 1 }
  if nr == SYS_MKDIR { return 1 }
  if nr == SYS_RMDIR { return 1 }
  if nr == SYS_CHROOT { return 1 }
  if nr == SYS_MKNOD { return 1 }
  if nr == SYS_STAT { return 1 }
  if nr == SYS_LSTAT { return 1 }
  if nr == SYS_UNLINK { return 1 }
  if nr == SYS_LINK { return 1 }
  if nr == SYS_SYMLINK { return 1 }
  if nr == SYS_READLINK { return 1 }
  if nr == SYS_RENAME { return 1 }
  if nr == SYS_ACCESS { return 1 }
  if nr == SYS_CHMOD { return 1 }
  if nr == SYS_CHOWN { return 1 }
  return 0
}

// What a syscall returns when it was handed an address it cannot use. Negative
// so a caller testing for failure sees one, and -14 is EFAULT, which is what
// this is.
const USER_EFAULT: u64 = 0xFFFF_FFFF_FFFF_FFF2

// Called from syscall_entry in idt_stubs.s. The name is unmangled because the
// stub names it directly, and distinct from sys/syscall.home's
// syscall_dispatch — this is the arch-level trampoline into that table, not a
// second copy of it.
//
// Anything the table does not implement returns -ENOSYS rather than 0, so a
// program that depends on one fails visibly instead of continuing on a
// fabricated success.
// Copy every mapped user page from one address space into another.
//
// Walks the user window a page at a time rather than the page tables, because
// the window is small and bounded and a walk of it cannot be led astray by a
// table entry that is not what it claims to be.
fn copy_user_pages(from_space: u64, to_space: u64): u32 {
  var addr: u64 = USER_ADDR_MIN
  var copied: u32 = 0
  while addr < USER_ADDR_MAX {
    let src: u64 = memory.vmm_space_physical(from_space, addr)
    if src != 0 {
      let dst: u64 = memory.pmm_alloc_page()
      if dst == 0 { return 0 }
      var i: u64 = 0
      while i < 4096 {
        @as(*u8, @ptrFromInt(dst + i)).* = @as(*u8, @ptrFromInt(src + i)).*
        i = i + 1
      }
      if memory.vmm_map_page_in(to_space, addr, dst,
                                PAGE_PRESENT | PAGE_WRITE | PAGE_USER) != 0 {
        memory.pmm_free_page(dst)
        return 0
      }
      copied = copied + 1
    }
    addr = addr + 4096
  }
  return copied
}

// fork(). Returns the child's index plus one to the parent, and 0 to the child
// when it is later resumed. Returns -1 as a u64 when it cannot.
fn do_fork(frame: u64): u64 {
  if child_count >= MAX_CHILDREN {
    foundation.serial_write_string("[fork] too many children\n")
    return 0xFFFFFFFFFFFFFFFF
  }
  if current_space == 0 {
    foundation.serial_write_string("[fork] no address space to fork\n")
    return 0xFFFFFFFFFFFFFFFF
  }

  let space: u64 = memory.vmm_create_user_space()
  if space == 0 {
    foundation.serial_write_string("[fork] could not create an address space\n")
    return 0xFFFFFFFFFFFFFFFF
  }
  if copy_user_pages(current_space, space) == 0 {
    foundation.serial_write_string("[fork] could not copy the parent's pages\n")
    return 0xFFFFFFFFFFFFFFFF
  }

  let slot: u32 = child_count
  var i: u32 = 0
  while i < FORK_FRAME_WORDS {
    child_frame[slot][i] = @as(*u64, @ptrFromInt(frame + @as(u64, i * 8))).*
    i = i + 1
  }
  // The child returns 0 from the call the parent returns a pid from. Slot 0
  // is the %rax the stub pushed, which is what enter_usermode_resume pops
  // into %rax before its iretq.
  child_frame[slot][0] = 0

  child_space[slot] = space
  child_exit[slot] = 0
  child_live[slot] = 1
  child_count = child_count + 1

  // The child becomes a task the scheduler can run rather than something
  // deferred until its parent waits. Its kernel stack is primed so that
  // process_switch's `ret` lands in process_first_run: six callee-saved
  // registers below a return address, which is exactly what that `ret` pops.
  let task: u32 = slot + 1
  if task >= MAX_TASKS {
    foundation.serial_write_string("[fork] no task slot\n")
    return 0xFFFFFFFFFFFFFFFF
  }
  let ktop: u64 = @intFromPtr(&child_kstack) +
                  @as(u64, (slot + 1) * CHILD_KSTACK_BYTES)
  let primed: u64 = ktop - 56
  var z: u32 = 0
  while z < 6 {
    @as(*u64, @ptrFromInt(primed + @as(u64, z * 8))).* = 0
    z = z + 1
  }
  // process_switch pops r15, r14, r13, r12, rbp, rbx and then returns, so the
  // slot at 40 becomes %rbx and the slot at 48 is where the `ret` goes. The
  // trampoline takes its frame from %rbx, which is how it learns which task
  // it is entering without a call.
  @as(*u64, @ptrFromInt(primed + 40)).* = @intFromPtr(&child_frame[slot])
  @as(*u64, @ptrFromInt(primed + 48)).* = @intFromPtr(&process_first_run)

  task_kernel_rsp[task] = primed
  task_cr3[task] = space
  task_kstack_top[task] = ktop
  task_frame[task] = @intFromPtr(&child_frame[slot])
  task_state[task] = TASK_RUNNABLE
  task_exit[task] = 0
  // The child inherits none of the parent's handlers. POSIX says a child keeps
  // them; this kernel cannot yet, because a handler address is only meaningful
  // with the code that registered it and the child's copy has not been
  // exercised. Saying so beats inheriting an address that may not be reached.
  signals_reset(task)
  if task_count <= task { task_count = task + 1 }

  return @as(u64, slot + 1)
}

// wait(pid). Yields until the child has finished, then returns its status.
//
// Yielding rather than running the child inline. Running it inline meant a
// child could only ever run inside its parent's wait, so a parent that never
// waited never ran its child at all. The child is runnable from the moment it
// is forked; wait is what a parent does when it has nothing else to do.
fn do_wait(pid: u64): u64 {
  if pid == 0 or pid > @as(u64, child_count) { return 0xFFFFFFFFFFFFFFFF }
  let task: u32 = @as(u32, pid)
  if task >= MAX_TASKS { return 0xFFFFFFFFFFFFFFFF }

  while task_state[task] != TASK_DONE {
    // Nothing else runnable and the child unfinished means it can never
    // finish. Saying so beats spinning until the gate times out.
    if next_runnable(current_task) == current_task {
      foundation.serial_write_string("[sched] nothing runnable and the child is unfinished\n")
      return 0xFFFFFFFFFFFFFFFF
    }
    scheduler_yield()
  }

  memory.vmm_destroy_user_space(child_space[task - 1])
  child_space[task - 1] = 0
  return task_exit[task]
}

// Every syscall leaves through here, which is the only place a pending signal
// can be delivered: delivery rewrites the frame the stub is about to return
// through, so it has to happen after the work and before the return.
//
// This was one function, and the early returns for fork, kill and the rest
// skipped the delivery at the bottom — so a signal was only ever delivered by
// a syscall that happened to fall through to the generic table. kill(self)
// returned 0 and the handler never ran.
export fn syscall_entry_dispatch(nr: u64, a1: u64, a2: u64, a3: u64, frame: u64): u64 {
  let result: u64 = syscall_body(nr, a1, a2, a3, frame)

  if deliver_signals(frame, result) == 1 {
    // The signal terminated this task; there is nothing to return to.
    let next: u32 = next_runnable(current_task)
    if next != current_task {
      let me: u32 = current_task
      task_state[next] = TASK_RUNNING
      current_task = next
      foundation.tss_set_rsp0(task_kstack_top[next])
      current_space = task_cr3[next]
      process_switch(@intFromPtr(&task_kernel_rsp) + @as(u64, me * 8),
                     task_kernel_rsp[next], task_cr3[next])
    }
    user_exit_code = task_exit[current_task]
    return_to_kernel()
  }

  return result
}

fn syscall_body(nr: u64, a1: u64, a2: u64, a3: u64, frame: u64): u64 {
  syscalls_served = syscalls_served + 1

  // exit is handled here rather than in the table because it does not
  // return: it has to unwind to the kernel context enter_usermode saved,
  // which the table has no way to reach.
  if nr == SYS_EXIT {
    user_exit_code = a1
    user_exited = 1
    foundation.serial_write_string("[User] exit(")
    foundation.serial_write_u64(a1)
    foundation.serial_write_string(")\n")

    // A task that is not the one the kernel entered hands the CPU on rather
    // than unwinding: return_to_kernel would return through the *entering*
    // task's kernel stack, which is not this task's, and the program that is
    // still running would be abandoned mid-syscall.
    task_state[current_task] = TASK_DONE
    task_exit[current_task] = a1
    if current_task != 0 {
      let next: u32 = next_runnable(current_task)
      if next != current_task {
        task_state[next] = TASK_RUNNING
        let me: u32 = current_task
        current_task = next
        foundation.tss_set_rsp0(task_kstack_top[next])
        current_space = task_cr3[next]
        process_switch(@intFromPtr(&task_kernel_rsp) + @as(u64, me * 8),
                       task_kernel_rsp[next], task_cr3[next])
      }
      // Nothing else to run: fall through and unwind, which returns to
      // whoever started the program in the first place.
    }
    return_to_kernel()
  }

  if nr == SYS_YIELD {
    scheduler_yield()
    return 0
  }

  // Every pointer argument is checked before anything dereferences it.
  //
  // This is the one place ring 3 enters the kernel, which makes it the trust
  // boundary and the right place for the check. Kernel-internal callers of
  // syscall_handler are not crossing one and are not slowed by it.
  if nr == SYS_WRITE or nr == SYS_READ {
    if user_range_ok(a2, a3) == 0 {
      // The address and length are printed because a refused buffer is a bug
      // in the program that passed it, and "EFAULT" alone says nothing about
      // which buffer or how far out of range it was.
      foundation.serial_write_string("[User] EFAULT: write/read buffer ")
      foundation.serial_write_ptr(a2)
      foundation.serial_write_string(" len ")
      foundation.serial_write_u64(a3)
      foundation.serial_write_string("\n")
      return USER_EFAULT
    }
  }
  if takes_path_in_arg1(nr) == 1 {
    if user_cstr_ok(a1, 4096) == 0 {
      foundation.serial_write_string("[User] EFAULT: path ")
      foundation.serial_write_ptr(a1)
      foundation.serial_write_string("\n")
      return USER_EFAULT
    }
  }

  // link, symlink and rename name a second path.
  if nr == SYS_LINK or nr == SYS_SYMLINK or nr == SYS_RENAME {
    if user_cstr_ok(a2, 4096) == 0 {
      foundation.serial_write_string("[User] EFAULT: second path ")
      foundation.serial_write_ptr(a2)
      foundation.serial_write_string("\n")
      return USER_EFAULT
    }
  }

  // stat and its variants write a structure back through arg2. The size is
  // not known here, so a page is required to be there — which is what the
  // structure lives in, and is enough to stop a wild pointer.
  if nr == SYS_STAT or nr == SYS_LSTAT {
    if user_range_ok(a2, 8) == 0 {
      foundation.serial_write_string("[User] EFAULT: stat buffer ")
      foundation.serial_write_ptr(a2)
      foundation.serial_write_string("\n")
      return USER_EFAULT
    }
  }

  if nr == SYS_FORK { return do_fork(frame) }
  if nr == SYS_SIGACTION { return do_signal(a1, a2, a3) }
  if nr == SYS_KILL_SIG { return do_kill(a1, a2) }
  if nr == SYS_SIGRETURN { return do_sigreturn(frame) }
  if nr == SYS_WAIT { return do_wait(a1) }

  // Reads from standard input come from wherever the shell attached it. With
  // nothing attached there is nothing to read, which is end of file — the
  // same answer a program gets from an empty pipe, and the reason a utility
  // given no input finishes instead of hanging.
  if nr == SYS_READ {
    if a1 == 0 {
      if user_stdin_fd == 0 { return 0 }
      return filesystem.vfs_read(user_stdin_fd, a2, a3)
    }
  }

  // Writes to the standard streams go to the console, unless the shell has
  // attached standard output to a file. Standard error is left alone: a
  // program's complaint about a failure should not vanish into the file the
  // failure was about.
  if nr == SYS_WRITE {
    if a1 == 1 and user_stdout_fd != 0 {
      return filesystem.vfs_write(user_stdout_fd, a2, a3)
    }
    if a1 < 3 {
      return write_console(a2, a3)
    }
  }

  // Everything else goes to the kernel's own table, so there is one syscall
  // implementation rather than a second one growing in the arch directory.
  var rc: i64 = syscall.syscall_dispatch(@as(u32, nr), a1, a2, a3, 0, 0, 0)
  return @as(u64, rc)
}

fn write_console(buf: u64, count: u64): u64 {
  var i: u64 = 0
  while i < count {
    foundation.serial_write_char(@as(*u8, @ptrFromInt(buf + i)).*)
    i = i + 1
  }
  return count
}

// ============================================================================
// LOADING
// ============================================================================

// Unmap and free every page of the user address space.
//
// Nothing did this before, so a program loaded into pages a previous program
// had already mapped — and map_segment only zeroes a page it *allocates*, so
// the new program started with the old one's memory in its .bss. A counter
// initialised to zero began at whatever the last program left there, and one
// program could read another's data.
//
// Called before each load, so a program always begins in an address space of
// its own with its .bss actually zero.
fn release_user_pages() {
  var addr: u64 = USER_ADDR_MIN
  while addr < USER_ADDR_MAX {
    let phys: u64 = memory.vmm_get_kernel_physical(addr)
    if phys != 0 {
      memory.vmm_unmap_page(addr)
      memory.pmm_free_page(phys)
    }
    addr = addr + 4096
  }
}

// Map one page of user-accessible memory at `virt`, returning its physical
// address or 0.
fn map_user_page(virt: u64): u64 {
  var phys: u64 = memory.pmm_alloc_page()
  if phys == 0 { return 0 }

  var rc: u32 = memory.vmm_map_page(virt, phys, PAGE_PRESENT | PAGE_WRITE | PAGE_USER)
  if rc != 0 { return 0 }

  return phys
}

// Read a flat binary from the filesystem and run it at ring 3.
//
// Flat, not ELF: the loader is the next piece of work, and a raw image is
// enough to prove the privilege transition and the syscall path, which is
// what the gate asks about. Returns nonzero if the program could not be
// started; if it starts, this does not return.
// `command_line` is the whole invocation — the program's own name first, the
// way a shell passes it — and becomes the program's argv. A caller with
// nothing to pass gives 0, and the program is entered with argc 0.
export fn run_user_program(path: u64, command_line: u64 = 0): u32 {
  // A fresh address space, so this program cannot see the last one's memory.
  release_user_pages()

  var fd: u32 = filesystem.vfs_open(path, 0)
  if fd == 0 {
    foundation.serial_write_string("[User] not found\n")
    return 1
  }

  var size: u64 = filesystem.vfs_read(fd, @intFromPtr(&load_buffer), 4096)
  var closed: u32 = filesystem.vfs_close(fd)

  if size == 0 {
    foundation.serial_write_string("[User] empty program\n")
    return 1
  }

  // Text page.
  var text_phys: u64 = map_user_page(USER_TEXT_BASE)
  if text_phys == 0 {
    foundation.serial_write_string("[User] could not map text\n")
    return 1
  }

  // Copy through the physical address: the virtual mapping is user-accessible
  // but this is the same address space, so either works. Physical is used to
  // keep the copy independent of whether the new mapping is live yet.
  var i: u64 = 0
  while i < size {
    @as(*u8, @ptrFromInt(text_phys + i)).* = load_buffer[i]
    i = i + 1
  }

  // Programs still run in the kernel's address space, with the user window
  // cleared between them. That window is what a fork copies out of.
  current_space = memory.vmm_kernel_space()

  scheduler_reset()

  if map_user_stack() == 0 {
    foundation.serial_write_string("[User] could not map stack\n")
    return 1
  }

  foundation.serial_write_string("[User] entering ring 3 at ")
  foundation.serial_write_hex(USER_TEXT_BASE)
  foundation.serial_write_string(", ")
  foundation.serial_write_u64(size)
  foundation.serial_write_string(" bytes\n")

  // Leave a little headroom below the top: the program is entered with an
  // empty stack and nothing pushed for it.
  let stack_at: u64 = build_argv(command_line)
  enter_usermode(USER_TEXT_BASE, stack_at, @as(u64, argv_count), argv_base)

  return 0
}

// ============================================================================
// The argument vector
//
// A program is entered with argc in %rdi and argv in %rsi. The strings and
// the pointer array they contain have to live somewhere the program can read
// at ring 3, so they are built at the top of its own stack page and the
// initial %rsp is set below them.
//
// Laid out downward from the top of the stack: the strings first, then the
// array of pointers to them, then a null terminator. That order matters only
// in that the pointers must be written after the strings are placed, since
// they are the addresses the strings ended up at.
// ============================================================================

// How much stack a user program gets. One page was enough for hand-written
// assembly and is not enough for compiled code: a program with a few nested
// calls and a buffer or two runs off the bottom, and the argument vector at
// the top takes a further kilobyte before the program starts. Sixteen
// kilobytes is still small, and it is a number rather than an assumption.
const USER_STACK_PAGES: u32 = 4

// Map the stack, top page first so the argument vector can be written into it
// before the rest exist. Returns 1 on success.
fn map_user_stack(): u32 {
  var i: u32 = 0
  while i < USER_STACK_PAGES {
    let at: u64 = USER_STACK_TOP - @as(u64, (i + 1) * 4096)
    if map_user_page(at) == 0 { return 0 }
    i = i + 1
  }
  return 1
}

const ARGV_MAX: u32 = 16
const ARGV_BYTES_MAX: u32 = 1024

// Where the argument array ended up, and how many entries it has. Written by
// build_argv and read by the two launch paths.
var argv_base: u64 = 0
var argv_count: u32 = 0

// Split a command line into arguments, copying it into the user stack.
//
// `line` is a NUL-terminated string in kernel memory; it is copied because
// the program must be able to read it, and kernel memory at ring 3 is not
// readable. Returns the address the initial stack pointer should take.
fn build_argv(line: u64): u64 {
  argv_base = 0
  argv_count = 0

  // Reserve the top of the stack for the strings, and the region below it
  // for the pointer array. Both are inside the one mapped stack page.
  let strings_top: u64 = USER_STACK_TOP - 16
  var strings_at: u64 = strings_top - @as(u64, ARGV_BYTES_MAX)
  let array_at: u64 = strings_at - @as(u64, (ARGV_MAX + 1) * 8)

  var written: u32 = 0
  var count: u32 = 0
  var i: u32 = 0

  if line != 0 {
    loop {
      if count >= ARGV_MAX { break }
      // Skip the spaces before the next word.
      while @as(*u8, @ptrFromInt(line + @as(u64, i))).* == 32 { i = i + 1 }
      if @as(*u8, @ptrFromInt(line + @as(u64, i))).* == 0 { break }

      // The word starts here; copy it, terminator included.
      let word_at: u64 = strings_at + @as(u64, written)
      loop {
        let c: u8 = @as(*u8, @ptrFromInt(line + @as(u64, i))).*
        if c == 0 or c == 32 { break }
        if written + 1 >= ARGV_BYTES_MAX { break }
        @as(*u8, @ptrFromInt(strings_at + @as(u64, written))).* = c
        written = written + 1
        i = i + 1
      }
      @as(*u8, @ptrFromInt(strings_at + @as(u64, written))).* = 0
      written = written + 1

      @as(*u64, @ptrFromInt(array_at + @as(u64, count) * 8)).* = word_at
      count = count + 1
    }
  }

  // A null after the last pointer, so a program can walk argv without
  // consulting argc — which is what most of them do.
  @as(*u64, @ptrFromInt(array_at + @as(u64, count) * 8)).* = 0

  argv_base = array_at
  argv_count = count
  // Below the array, aligned to sixteen: the ABI's stack alignment, and the
  // first thing a compiled prologue relies on.
  return (array_at - 64) & ~@as(u64, 15)
}

// Load an ELF64 executable and run it at ring 3.
//
// Unlike run_user_program, the image says where it wants to live and what its
// entry point is, so nothing here picks an address. Returns nonzero if it
// could not be started; when it starts, this returns once the program exits.
// ============================================================================
// BACKGROUND JOBS
//
// A job is a task the shell starts and does not enter. It becomes runnable,
// and it makes progress whenever something hands the CPU over — which the
// console does between lines, and `fg` does until the job finishes.
//
// The program is loaded into the kernel's user window as usual and then copied
// into an address space of its own, the same way fork copies a parent. Loading
// straight into the new space would mean teaching the ELF loader to map
// somewhere other than the space it is running in; copying reuses what fork
// already proved.
// ============================================================================

// Start `path` as a background task. Returns its task id, or 0.
export fn spawn_background(path: u64, command_line: u64 = 0): u32 {
  var slot: u32 = 1
  while slot < MAX_TASKS {
    if task_state[slot] == TASK_UNUSED or task_state[slot] == TASK_DONE { break }
    slot = slot + 1
  }
  if slot >= MAX_TASKS {
    foundation.serial_write_string("[job] no free task slot\n")
    return 0
  }

  // Load it where the loader can reach, then take a copy.
  current_space = memory.vmm_kernel_space()
  release_user_pages()

  let entry: u64 = elf.elf_load(path)
  if entry == 0 { return 0 }
  if map_user_stack() == 0 {
    foundation.serial_write_string("[job] could not map a stack\n")
    return 0
  }
  let stack_at: u64 = build_argv(command_line)

  let space: u64 = memory.vmm_create_user_space()
  if space == 0 {
    foundation.serial_write_string("[job] could not create an address space\n")
    return 0
  }
  if copy_user_pages(memory.vmm_kernel_space(), space) == 0 {
    foundation.serial_write_string("[job] could not copy the image\n")
    memory.vmm_destroy_user_space(space)
    return 0
  }

  // The frame a task starts from, in the shape process_first_run pops: the
  // registers, then rip, cs, rflags, rsp, ss. Everything not named is zero
  // rather than whatever the kernel had — a register carried across the
  // privilege drop is a kernel value readable at ring 3.
  var i: u32 = 0
  while i < FORK_FRAME_WORDS {
    child_frame[slot - 1][i] = 0
    i = i + 1
  }
  child_frame[slot - 1][6] = @as(u64, argv_count)   // rdi: argc
  child_frame[slot - 1][5] = argv_base              // rsi: argv
  child_frame[slot - 1][10] = entry                 // rip
  child_frame[slot - 1][11] = 0x1b                  // cs, ring 3
  child_frame[slot - 1][12] = 0x202                 // rflags, interrupts on
  child_frame[slot - 1][13] = stack_at              // rsp
  child_frame[slot - 1][14] = 0x23                  // ss, ring 3

  let ktop: u64 = @intFromPtr(&child_kstack) + @as(u64, slot * CHILD_KSTACK_BYTES)
  let primed: u64 = ktop - 56
  var z: u32 = 0
  while z < 6 {
    @as(*u64, @ptrFromInt(primed + @as(u64, z * 8))).* = 0
    z = z + 1
  }
  @as(*u64, @ptrFromInt(primed + 40)).* = @intFromPtr(&child_frame[slot - 1])
  @as(*u64, @ptrFromInt(primed + 48)).* = @intFromPtr(&process_first_run)

  task_kernel_rsp[slot] = primed
  task_cr3[slot] = space
  task_kstack_top[slot] = ktop
  task_frame[slot] = @intFromPtr(&child_frame[slot - 1])
  task_state[slot] = TASK_RUNNABLE
  task_exit[slot] = 0
  child_space[slot - 1] = space
  signals_reset(slot)
  if task_count <= slot { task_count = slot + 1 }
  if child_count <= slot - 1 { child_count = slot }

  return slot
}

// Give a runnable task a turn, from the shell. Returns 1 if one ran.
//
// The shell is not a user program, but it is a kernel stack, which is all a
// task needs to be switched away from and back to. Slot 0 stands for it here
// exactly as it stands for a foreground program elsewhere.
export fn scheduler_run_ready(): u32 {
  let next: u32 = next_runnable(0)
  if next == 0 { return 0 }
  if next == current_task { return 0 }

  current_task = next
  task_state[next] = TASK_RUNNING
  task_cr3[0] = memory.vmm_kernel_space()
  task_kstack_top[0] = foundation.tss_get_rsp0()
  task_state[0] = TASK_RUNNABLE

  foundation.tss_set_rsp0(task_kstack_top[next])
  current_space = task_cr3[next]
  process_switch(@intFromPtr(&task_kernel_rsp), task_kernel_rsp[next], task_cr3[next])

  // Back here when that task yielded or finished.
  //
  // Interrupts first. The task left through a syscall, which arrived by an
  // interrupt gate and so cleared IF, and it switched away rather than
  // returning through an iretq that would have restored it. Without this the
  // shell resumes with interrupts masked and its idle loop halts forever:
  // the prompt prints and the console never responds again.
  foundation.sti()

  current_task = 0
  task_state[0] = TASK_RUNNING
  current_space = memory.vmm_kernel_space()
  memory.vmm_switch_user_space(current_space)
  foundation.tss_set_rsp0(task_kstack_top[0])
  return 1
}

// What a job is doing, for `jobs`: 0 unused, 1 runnable, 2 running, 3 done.
export fn job_state(task: u32): u32 {
  if task >= MAX_TASKS { return TASK_UNUSED }
  return task_state[task]
}

export fn job_exit_code(task: u32): u64 {
  if task >= MAX_TASKS { return 0 }
  return task_exit[task]
}

export fn job_max(): u32 {
  return MAX_TASKS
}

export fn run_user_elf(path: u64, command_line: u64 = 0): u32 {
  current_space = memory.vmm_kernel_space()
  scheduler_reset()

  // Before the loader maps anything: elf_load reuses a page that is already
  // mapped rather than allocating a fresh zeroed one, so without this the
  // program's .bss arrives holding the previous program's data.
  release_user_pages()

  var entry: u64 = elf.elf_load(path)
  if entry == 0 { return 1 }

  if map_user_stack() == 0 {
    foundation.serial_write_string("[User] could not map stack\n")
    return 1
  }

  foundation.serial_write_string("[User] entering ring 3 at ")
  foundation.serial_write_hex(entry)
  foundation.serial_write_string("\n")

  let stack_at: u64 = build_argv(command_line)
  enter_usermode(entry, stack_at, @as(u64, argv_count), argv_base)

  return 0
}

export fn get_syscall_count(): u64 {
  return syscalls_served
}

export fn get_user_exit_code(): u64 {
  return user_exit_code
}
