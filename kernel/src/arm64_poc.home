// HomeOS ARM64 Minimum Viable Kernel — serial proof-of-life
//
// The aarch64 counterpart of kernel/src/mvk_poc.home, and the first Home code
// that executes on an ARM machine. It compiles through the Home compiler's
// kernel backend with `--target=aarch64-freestanding`, links against
// kernel/src/arch/arm64/boot.s via kernel/linker-virt.ld, and runs on QEMU's
// `virt` machine, where scripts/boot-gate.sh asserts the message on the serial
// console.
//
// QEMU has no Raspberry Pi 5 machine model — there is no RP1 — so `virt` is
// what proves the compiler, the frame layout, the MMIO path and the boot
// handoff on every commit. Only the Pi's own peripherals are left for the
// hardware gate (home-lang/home-os#63).
//
// What this file exercises that mvk_poc.home cannot: MMIO through a real
// device-memory address rather than an I/O port, 64-bit constants (the PL011
// sits at 0x09000000 here, but every Pi 5 peripheral is above 2^32 and takes
// the same movz/movk path), and `wfi` as the idle instruction.

// PL011 UART on QEMU's `virt` machine. The address comes from the machine's
// device tree; it is stated here rather than discovered because discovering it
// needs a device-tree parser, which needs a working kernel, which is what this
// file exists to prove.
const UART0: int = 0x09000000
const UART_DR: int = 0x09000000     // data register
const UART_FR: int = 0x09000018     // flag register
const UART_IBRD: int = 0x09000024   // integer baud rate divisor
const UART_FBRD: int = 0x09000028   // fractional baud rate divisor
const UART_LCRH: int = 0x0900002c   // line control
const UART_CR: int = 0x09000030     // control register
const UART_IMSC: int = 0x09000038   // interrupt mask

const FR_TXFF: int = 0x20           // transmit FIFO full
const LCRH_FEN: int = 0x10          // enable FIFOs
const LCRH_WLEN_8: int = 0x60       // 8 data bits
const CR_UARTEN: int = 0x01         // UART enable
const CR_TXE: int = 0x100           // transmit enable
const CR_RXE: int = 0x200           // receive enable

// Read one byte at an address.
//
// This must be a genuine byte load, not the word-load-and-mask that
// mvk_poc.home uses on x86. With the MMU off, ARMv8 treats *all* memory as
// Device-nGnRnE, and an unaligned access to Device memory raises an alignment
// fault rather than being fixed up in hardware. Reading a string one character
// at a time is unaligned by construction, so the x86 idiom faults on the
// second character — it prints exactly "H" and stops.
//
// A `*u8` parameter makes the deref one byte wide, which the backend lowers to
// `ldrb`. Aligned or not, that is legal against Device memory.
fn byte_at(p: *u8): int {
  return *p
}

fn uart_init() {
  // Disable while reprogramming: changing the line control of a running UART
  // is undefined, and QEMU is more forgiving here than a real PL011.
  mmio_write32(UART_CR, 0)
  mmio_write32(UART_IMSC, 0)

  // 115200 baud from the 24 MHz reference clock QEMU's virt machine supplies:
  // divisor = 24000000 / (16 * 115200) = 13.02, so 13 integer and 1 fractional
  // (0.02 * 64 rounds to 1).
  mmio_write32(UART_IBRD, 13)
  mmio_write32(UART_FBRD, 1)

  mmio_write32(UART_LCRH, LCRH_FEN | LCRH_WLEN_8)
  mmio_write32(UART_CR, CR_UARTEN | CR_TXE | CR_RXE)
}

fn putc(c: int) {
  // Spin until the transmit FIFO has room, so characters are not dropped when
  // the line is slower than the CPU.
  loop {
    if (mmio_read32(UART_FR) & FR_TXFF) == 0 { break }
  }
  mmio_write32(UART_DR, c)
}

fn puts(s: str) {
  var p = s
  loop {
    let c = byte_at(p)
    if c == 0 { break }
    putc(c)
    p = p + 1
  }
}

export fn kernel_main(): void {
  uart_init()
  puts("HomeOS v0.1: aarch64 kernel_main reached\n")

  loop {
    hlt()
  }
}
