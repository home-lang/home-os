// home-os Kernel - Unified Main Entry Point
// Consolidates all architecture-specific entry points and interrupt handlers

// Import the kernel initialization orchestrator
import "core/kernel_init.home" as kernel_init
import "arch/x86_64/interrupts.home" as interrupts
import "console/serial_shell.home" as serial_shell
import "boot/initramfs.home" as initramfs
import "drivers/fb_console.home" as fb_console
import "drivers/bochs_vbe.home" as vbe
import "drivers/pci.home" as pci
import "drivers/ata.home" as ata
import "fs/ext2.home" as ext2
import "drivers/framebuffer.home" as framebuffer
import "core/foundation.home" as foundation
import "core/memory.home" as memory
import "core/process.home" as process
import "core/filesystem.home" as filesystem
import "core/vfs_block_io.home" as block_io
import "core/vfs_mmap_integration.home" as vfs_mmap

// Import scheduler
import "sched/scheduler.home" as scheduler

// Import system
import "sys/syscall.home" as syscall
import "sys/signal.home" as signal

// Import memory management
import "mm/mm_integration.home" as mm

// Import drivers
import "drivers/keyboard.home" as keyboard
import "drivers/timer.home" as timer
import "drivers/framebuffer.home" as framebuffer

// Import network

// Import security
import "security/caps.home" as caps
import "security/seccomp.home" as seccomp

// Import integration libraries
import "lib/shell_syscall.home" as shell_syscall
import "net/netdev.home" as netdev
import "crypto/crypto_selftest.home" as crypto_selftest
import "drivers/acpi.home" as acpi
import "fs/homefs.home" as homefs
import "drivers/usb.home" as usb
import "net/arp.home" as arp

// Where the boot module was loaded, if one was passed. Read in
// parse_boot_info_mb1 and consumed after the filesystem is up, since
// extracting into the VFS needs the VFS.
var initramfs_base: u64 = 0
var initramfs_size: u64 = 0

// Where the console font is staged in the initramfs. Spelled out as bytes
// because a string literal is not yet usable as a path pointer here.
var font_path: [32]u8 = undefined

// Framebuffer geometry, as the bootloader reported it. Zero width means no
// framebuffer was provided and the console stays on the serial line.
var fb_addr: u64 = 0
var fb_pitch: u32 = 0
var fb_width: u32 = 0
var fb_height: u32 = 0
var fb_bpp: u8 = 0

// ============================================================================
// CONSTANTS
// ============================================================================

// Exception vectors (x86_64)
const EXCEPTION_DIVIDE_ERROR: u32 = 0
const EXCEPTION_DEBUG: u32 = 1
const EXCEPTION_NMI: u32 = 2
const EXCEPTION_BREAKPOINT: u32 = 3
const EXCEPTION_OVERFLOW: u32 = 4
const EXCEPTION_BOUND_RANGE: u32 = 5
const EXCEPTION_INVALID_OPCODE: u32 = 6
const EXCEPTION_DEVICE_NOT_AVAILABLE: u32 = 7
const EXCEPTION_DOUBLE_FAULT: u32 = 8
const EXCEPTION_INVALID_TSS: u32 = 10
const EXCEPTION_SEGMENT_NOT_PRESENT: u32 = 11
const EXCEPTION_STACK_SEGMENT_FAULT: u32 = 12
const EXCEPTION_GENERAL_PROTECTION: u32 = 13
const EXCEPTION_PAGE_FAULT: u32 = 14
const EXCEPTION_X87_FP: u32 = 16
const EXCEPTION_ALIGNMENT_CHECK: u32 = 17
const EXCEPTION_MACHINE_CHECK: u32 = 18
const EXCEPTION_SIMD_FP: u32 = 19

// IRQ vectors
const IRQ_TIMER: u32 = 32
const IRQ_KEYBOARD: u32 = 33
const IRQ_CASCADE: u32 = 34
const IRQ_COM2: u32 = 35
const IRQ_COM1: u32 = 36
const IRQ_LPT2: u32 = 37
const IRQ_FLOPPY: u32 = 38
const IRQ_LPT1: u32 = 39
const IRQ_RTC: u32 = 40
const IRQ_FREE1: u32 = 41
const IRQ_FREE2: u32 = 42
const IRQ_FREE3: u32 = 43
const IRQ_MOUSE: u32 = 44
const IRQ_FPU: u32 = 45
const IRQ_PRIMARY_ATA: u32 = 46
const IRQ_SECONDARY_ATA: u32 = 47

// Syscall vector
const SYSCALL_VECTOR: u32 = 0x80

// ============================================================================
// GLOBAL STATE
// ============================================================================

var kernel_running: u32 = 0
var in_interrupt: u32 = 0
var interrupt_nesting: u32 = 0

// ============================================================================
// UNIFIED KERNEL ENTRY POINT
// ============================================================================

export fn kernel_main(magic: u32, boot_info: u32): never {
  // Disable interrupts during initialization
  foundation.cli()

  // Which boot protocol brought us here.
  //
  // The kernel carries both headers (see boot.s): GRUB loads it as
  // Multiboot2, and QEMU's -kernel loader — which implements only
  // Multiboot1 — loads it as Multiboot1. The two hand over *different*
  // info structures, so the magic decides how boot_info is read. Parsing a
  // Multiboot1 structure as Multiboot2 walks a length field that is not
  // there, which is what this used to do.
  if magic == MULTIBOOT2_BOOTLOADER_MAGIC {
    if boot_info != 0 {
      parse_boot_info(boot_info)
    }
  } else if magic == MULTIBOOT1_BOOTLOADER_MAGIC {
    foundation.serial_write_string("[Boot] Multiboot1 loader\n")
    if boot_info != 0 {
      parse_boot_info_mb1(boot_info)
    }
  } else {
    foundation.serial_write_string("[Boot] Warning: unrecognized bootloader magic\n")
  }

  // Run the comprehensive kernel initialization
  kernel_init.kernel_init()

  // Initialize additional integration layers
  post_init_integrations()

  // Load the IDT and remap the PIC before enabling interrupts.
  //
  // sti() used to run with IDTR still zero from boot: the first timer tick
  // took a #GP, then a #DF, then reset the machine. Nothing after this point
  // in kernel_main had ever executed.
  // Unpack the boot module now that the filesystem exists.
  if initramfs_size > 0 {
    initramfs.initramfs_init(initramfs_base, initramfs_size)
    var rc: u32 = initramfs.initramfs_extract()
  } else {
    foundation.serial_write_string("[InitramFS] No boot module supplied\n")
  }

  // Bring up a graphical console.
  //
  // The bootloader gave us no framebuffer — QEMU's -kernel loader ignores the
  // video request in the Multiboot header — so the display is programmed
  // directly. PCI is scanned first because the framebuffer's address is a BAR
  // and guessing it would write over whatever else lives there.
  pci.pci_init()
  pci.pci_list()
  ata.ata_init()
  // Mount whatever ext2 filesystem is on the first disk, if any. A failure
  // here is not fatal: the kernel's own root is the in-memory tree the
  // initramfs was unpacked into, and a machine may have no disk at all.
  var ext2_rc: u32 = ext2.ext2_init()
  if vbe.bochs_vbe_set_mode(1024, 768, 32) == 0 {
    // Map the framebuffer before anything draws into it. The linear
    // framebuffer sits at the top of the physical address space — QEMU puts
    // it near 0xFD000000 — which is far outside the gigabyte the boot page
    // tables identity-map, so the first pixel written faults.
    var lfb: u64 = vbe.bochs_vbe_get_base()
    var lfb_bytes: u64 = @as(u64, vbe.bochs_vbe_get_width()) *
                         @as(u64, vbe.bochs_vbe_get_height()) *
                         @as(u64, vbe.bochs_vbe_get_bpp() / 8)
    var mapped: u64 = 0
    while mapped < lfb_bytes {
      var mrc: u32 = memory.vmm_map_page(lfb + mapped, lfb + mapped, 3)
      if mrc != 0 { break }
      mapped = mapped + 4096
    }
    foundation.serial_write_string("[Boot] Mapped framebuffer, ")
    foundation.serial_write_u64(mapped / 1024)
    foundation.serial_write_string(" KB\n")

    var fbrc: u32 = framebuffer.fb_init(
      vbe.bochs_vbe_get_base(),
      vbe.bochs_vbe_get_width(),
      vbe.bochs_vbe_get_height(),
      vbe.bochs_vbe_get_bpp(),
      2)
    if fbrc == 0 {
      var crc: u32 = fb_console.fb_console_init()
    }
  }

  // The console font lives in the image, so it can only be loaded once the
  // initramfs is unpacked. Until then every glyph is blank.
  // "/usr/share/fonts/default.psf"
  font_path[0] = 47
  font_path[1] = 117
  font_path[2] = 115
  font_path[3] = 114
  font_path[4] = 47
  font_path[5] = 115
  font_path[6] = 104
  font_path[7] = 97
  font_path[8] = 114
  font_path[9] = 101
  font_path[10] = 47
  font_path[11] = 102
  font_path[12] = 111
  font_path[13] = 110
  font_path[14] = 116
  font_path[15] = 115
  font_path[16] = 47
  font_path[17] = 100
  font_path[18] = 101
  font_path[19] = 102
  font_path[20] = 97
  font_path[21] = 117
  font_path[22] = 108
  font_path[23] = 116
  font_path[24] = 46
  font_path[25] = 112
  font_path[26] = 115
  font_path[27] = 102
  font_path[28] = 0
  var font_rc: u32 = fb_console.fb_console_load_font(@intFromPtr(&font_path))

  // Replay everything the kernel has said so far onto the framebuffer
  // console, which could not exist until PCI was scanned and a mode set. From
  // here both consoles carry the same output.
  if fb_console.fb_console_font_loaded() == 1 {
    fb_console.fb_console_write_n(foundation.get_boot_log(), foundation.get_boot_log_len())
    fb_console.fb_console_refresh()
    foundation.serial_write_string("[FB] boot log rendered, ")
    foundation.serial_write_u64(@as(u64, foundation.get_boot_log_len()))
    foundation.serial_write_string(" bytes\n")
  }

  interrupts.interrupts_init()
  foundation.sti()

  serial_shell.serial_shell_init()

  // Drive real frames through the RX path. Until recently netdev dropped
  // every frame it was handed, so the whole protocol stack below it was
  // unreachable; these lines are what proves it is not any more.
  arp.arp_init()
  netdev.netdev_selftest()
  crypto_selftest.crypto_selftest()

  // ACPI table discovery against the firmware tables QEMU actually publishes:
  // real checksums, a real RSDT, real FADT and MADT. Nothing here is
  // synthesised by the test.
  acpi.acpi_init()
  if acpi.acpi_is_initialized() == 1 and acpi.acpi_table_count() > 0 {
    foundation.serial_write_string("[ACPI] root table walked, checksums verified\n")
  }
  if acpi.acpi_find_table(70, 65, 67, 80) != 0 {
    foundation.serial_write_string("[ACPI] FADT found and validated\n")
  }
  if acpi.acpi_find_table(65, 80, 73, 67) != 0 and acpi.acpi_enabled_cpu_count() > 0 {
    foundation.serial_write_string("[ACPI] MADT parsed, ")
    foundation.serial_write_u64(@as(u64, acpi.acpi_enabled_cpu_count()))
    foundation.serial_write_string(" CPU(s) enabled\n")
  }
  if acpi.acpi_checksum_failures() == 0 {
    foundation.serial_write_string("[ACPI] no table failed its checksum\n")
  }

  // homefs step 1: the on-disk structures, exercised on the machine.
  if homefs.homefs_selftest() == 7 {
    foundation.serial_write_string("[homefs] on-disk structures round-trip, 7/7\n")
  }

  // The B-tree runs against a ramdisk carved out of physical memory: 4 MB is
  // enough for the 900-key tree below, with room for the copies every insert
  // makes.
  // 16 MB. Copy-on-write spends a block per node touched and gives none back
  // until reclamation exists, so the ramdisk is sized for the whole test
  // rather than for the tree it ends up holding.
  let ramdisk: u64 = memory.pmm_alloc_pages(4096)
  if ramdisk != 0 {
    if homefs.homefs_btree_selftest(ramdisk, 4096) == 6 {
      foundation.serial_write_string("[homefs] copy-on-write B-tree, 6/6\n")
    }

    // homefs step 4: objects, directories and extents. It reuses the tree
    // test's ramdisk rather than asking for a second one: it formats the
    // device it is given, which resets the allocator, so the blocks the tree
    // test spent are handed out again. Claiming another 16 MB pushed the
    // whole boot past the gate's deadline and got QEMU killed mid-shell.
    if homefs.homefs_object_selftest(ramdisk, 4096) == 15 {
      foundation.serial_write_string("[homefs] objects, directories and extents, 15/15\n")
    }
  }

  // A homefs volume on the second ATA drive, if one is attached. The boot
  // gate's own disk is the first drive and stays ext2, so the two gates share
  // an image without sharing a filesystem.
  //
  // Mount what is there; format only if nothing is. Then commit a run of keys
  // and check every key the volume claims to hold. scripts/crash-gate.sh kills
  // the machine partway through that loop and boots again into this same
  // path — so "mounted and every committed key readable" is the assertion
  // that a crash left a whole transaction rather than half of one.
  if ata.ata_device_exists(1) == 1 {
    let fsmem: u64 = memory.pmm_alloc_pages(2048)
    if fsmem != 0 {
      var mounted: u32 = homefs.homefs_mount(1, fsmem, 2048)
      if mounted == 0 {
        if homefs.homefs_format(1, fsmem, 2048) == 1 {
          foundation.serial_write_string("[homefs] volume formatted\n")
          mounted = 1
        }
      } else {
        foundation.serial_write_string("[homefs] mounted generation ")
        foundation.serial_write_u64(homefs.homefs_generation())
        foundation.serial_write_string("\n")
      }

      if mounted == 1 {
        // Whatever the last boot committed must still be readable. The keys
        // are 1..N with value key*3, so a key that is present with the wrong
        // value is as much a failure as one that is missing — a torn commit
        // would show up as exactly that.
        var checked: u64 = 0
        var consistent: u32 = 1
        var k: u64 = 1
        while k <= 400 {
          let v: u64 = homefs.homefs_lookup(k)
          if v != 0 {
            if v != k * 3 { consistent = 0 }
            checked = checked + 1
          }
          k = k + 1
        }
        if consistent == 0 {
          foundation.serial_write_string("[homefs] mount inconsistent\n")
        } else {
          foundation.serial_write_string("[homefs] volume consistent, ")
          foundation.serial_write_u64(checked)
          foundation.serial_write_string(" keys\n")

          // Commit more, one transaction per key, so a kill lands inside the
          // protocol rather than between runs of it.
          var next: u64 = checked + 1
          while next <= 400 {
            if homefs.homefs_insert_and_commit(next, next * 3) == 0 { break }
            next = next + 1
          }
          foundation.serial_write_string("[homefs] committed to key ")
          foundation.serial_write_u64(next - 1)
          foundation.serial_write_string("\n")

          // Snapshot, then diverge from it, then roll back. Each step is
          // checked against the tree rather than against the call's return
          // value: a rollback that reported success while leaving the newer
          // keys in place would be the failure worth catching.
          if homefs.homefs_snapshot_count() == 0 {
            let snap: u64 = homefs.homefs_snapshot_create()
            if snap != 0 {
              foundation.serial_write_string("[homefs] snapshot ")
              foundation.serial_write_u64(snap)
              foundation.serial_write_string(" taken\n")

              // Diverge: a key the snapshot never saw.
              if homefs.homefs_insert_and_commit(9001, 12345) == 1 and
                 homefs.homefs_lookup(9001) == 12345 {
                if homefs.homefs_snapshot_rollback(snap) == 1 and
                   homefs.homefs_lookup(9001) == 0 and
                   homefs.homefs_lookup(1) == 3 and
                   homefs.homefs_lookup(400) == 1200 {
                  foundation.serial_write_string("[homefs] rolled back, divergence gone, history intact\n")
                }
              }
            }
          } else {
            foundation.serial_write_string("[homefs] snapshots survived reboot: ")
            foundation.serial_write_u64(@as(u64, homefs.homefs_snapshot_count()))
            foundation.serial_write_string("\n")
          }
        }
      }
    }
  }

  // xHCI discovery against the controller QEMU presents on the PCI bus.
  usb.usb_init()
  if usb.usb_controller_found() == 1 and usb.usb_max_ports() > 0 and usb.usb_max_slots() > 0 {
    foundation.serial_write_string("[USB] controller registers readable\n")
  }
  if usb.xhci_start() == 1 and usb.usb_is_halted() == 0 {
    foundation.serial_write_string("[USB] xHCI running, rings armed\n")
    if usb.xhci_noop_command() == 1 {
      foundation.serial_write_string("[USB] command ring round trip: no-op completed\n")
    }

    // Find a populated port, reset it, and ask the controller for a slot.
    // Enumeration proper needs the device context and an Address Device
    // command; this is the step before those.
    var p: u32 = 1
    while p <= usb.usb_max_ports() {
      if usb.usb_port_connected(p) == 1 {
        foundation.serial_write_string("[USB] device on port ")
        foundation.serial_write_u64(@as(u64, p))
        foundation.serial_write_string("\n")
        if usb.xhci_port_reset(p) == 1 {
          foundation.serial_write_string("[USB] port reset, device enabled\n")
          let slot: u32 = usb.xhci_enable_slot()
          if slot != 0 {
            foundation.serial_write_string("[USB] slot ")
            foundation.serial_write_u64(@as(u64, slot))
            foundation.serial_write_string(" allocated\n")
            if usb.xhci_address_device(slot, p) == 1 {
              foundation.serial_write_string("[USB] device addressed\n")
              if usb.xhci_read_device_descriptor(slot) == 1 {
                foundation.serial_write_string("[USB] descriptor read: ")
                foundation.serial_write_hex_word(@as(u16, usb.usb_device_vendor()))
                foundation.serial_write_string(":")
                foundation.serial_write_hex_word(@as(u16, usb.usb_device_product()))
                foundation.serial_write_string("\n")

                if usb.xhci_read_config_descriptor(slot) == 1 {
                  foundation.serial_write_string("[USB] configuration ")
                  foundation.serial_write_u64(@as(u64, usb.usb_config_value()))
                  foundation.serial_write_string(", interface class ")
                  foundation.serial_write_u64(@as(u64, usb.usb_interface_class()))
                  foundation.serial_write_string("\n")
                  if usb.xhci_set_configuration(slot) == 1 {
                    foundation.serial_write_string("[USB] device configured\n")

                    // Class 8 is mass storage. Its endpoints are bulk, so
                    // this is where data first moves on something other than
                    // the control endpoint.
                    if usb.usb_interface_class() == 8 and usb.xhci_configure_bulk_endpoints(slot) == 1 {
                      foundation.serial_write_string("[USB] bulk endpoints configured, in ")
                      foundation.serial_write_hex_byte(@as(u8, usb.usb_bulk_in_address()))
                      foundation.serial_write_string(" out ")
                      foundation.serial_write_hex_byte(@as(u8, usb.usb_bulk_out_address()))
                      foundation.serial_write_string("\n")

                      if usb.usb_storage_inquiry(slot) == 1 {
                        foundation.serial_write_string("[USB] SCSI INQUIRY: ")
                        var vi: u32 = 0
                        while vi < 8 {
                          foundation.serial_write_char(usb.usb_storage_vendor_byte(vi))
                          vi = vi + 1
                        }
                        foundation.serial_write_string("\n")

                        if usb.usb_storage_read_capacity(slot) == 1 {
                          foundation.serial_write_string("[USB] capacity ")
                          foundation.serial_write_u64(@as(u64, usb.usb_storage_last_lba()) + 1)
                          foundation.serial_write_string(" blocks of ")
                          foundation.serial_write_u64(@as(u64, usb.usb_storage_block_size()))
                          foundation.serial_write_string("\n")

                          // Read LBA 0 and check it against the signature the
                          // harness wrote. Bytes coming back is not the same
                          // as the right bytes coming back.
                          if usb.usb_storage_read_block(slot, 0) == 1 {
                            foundation.serial_write_string("[USB] block 0: ")
                            var bi: u32 = 0
                            while bi < 17 {
                              foundation.serial_write_char(usb.usb_storage_data_byte(bi))
                              bi = bi + 1
                            }
                            foundation.serial_write_string("\n")
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
        break
      }
      p = p + 1
    }
  }

  // Mark kernel as running
  kernel_running = 1

  // Kernel is now running
  foundation.serial_write_string("\n[Kernel] Entering main loop\n")

  // Main kernel loop - scheduler runs from timer interrupt
  var irq_reported: u32 = 0
  loop {
    // Report once, after the timer has had time to prove itself. A kernel
    // that merely survives sti() looks identical to one whose lines are all
    // masked; a rising tick count does not.
    if irq_reported == 0 {
      if interrupts.get_timer_ticks() >= 100 {
        foundation.serial_write_string("[IRQ] timer=")
        foundation.serial_write_u64(interrupts.get_timer_ticks())
        foundation.serial_write_string(" keyboard=")
        foundation.serial_write_u64(interrupts.get_keyboard_irqs())
        foundation.serial_write_string(" spurious=")
        foundation.serial_write_u64(interrupts.get_spurious_irqs())
        foundation.serial_write_string("\n")
        irq_reported = 1
      }
    }

    // Check for pending signals on current process
    var current_pid: u32 = scheduler.get_current_pid()
    if current_pid != 0 {
      signal.signal_deliver_pending(current_pid)
    }

    // Check memory pressure
    var pressure: u32 = mm.check_memory_pressure()
    if pressure == 3 {  // PRESSURE_CRITICAL
      foundation.serial_write_string("[Kernel] Critical memory pressure detected\n")
      mm.oom_kill()
    }

    // Drain the console before halting. The shell reaches into the
    // filesystem and the process table, so it runs here rather than from the
    // serial interrupt: none of those are reentrant.
    serial_shell.serial_shell_poll()

    // Halt until next interrupt. The timer at 100 Hz bounds how long an
    // unread keystroke waits.
    foundation.hlt()
  }
}

// ============================================================================
// ARCHITECTURE-SPECIFIC ENTRY POINTS
// ============================================================================

// x86_64 entry point (from boot.s)
export fn _start_x86_64(magic: u32, boot_info: u32): never {
  kernel_main(magic, boot_info)
}

// ARM64/AArch64 entry point
export fn _start_aarch64(dtb_ptr: u64): never {
  // ARM64 doesn't use multiboot
  // DTB (Device Tree Blob) pointer is passed instead
  kernel_main(0, @intCast(dtb_ptr))
}

// Raspberry Pi entry point
export fn _start_rpi(dtb_ptr: u64): never {
  // Raspberry Pi uses DTB
  kernel_main(0, @intCast(dtb_ptr))
}

// RISC-V entry point
export fn _start_riscv(hart_id: u64, dtb_ptr: u64): never {
  // RISC-V passes hart (hardware thread) ID and DTB
  kernel_main(0, @intCast(dtb_ptr))
}

// ============================================================================
// BOOT INFO PARSING
// ============================================================================

// Magic values a bootloader leaves in eax.
const MULTIBOOT1_BOOTLOADER_MAGIC: u32 = 0x2BADB002
const MULTIBOOT2_BOOTLOADER_MAGIC: u32 = 0x36D76289

// Multiboot1 information structure. Flat and fixed-layout, unlike
// Multiboot2's tag list: a flags word says which of the following fields the
// loader filled in.
//
//   offset 0   flags
//   offset 4   mem_lower  (KB below 1M)   valid when flags bit 0
//   offset 8   mem_upper  (KB above 1M)   valid when flags bit 0
//   offset 20  mods_count                 valid when flags bit 3
//   offset 24  mods_addr                  valid when flags bit 3
//   offset 44  mmap_length                valid when flags bit 6
//   offset 48  mmap_addr                  valid when flags bit 6
//
// Each module descriptor at mods_addr is four words: start, end, string,
// reserved.
fn parse_boot_info_mb1(info_addr: u32) {
  var base: u64 = @as(u64, info_addr)
  foundation.serial_write_string("[Boot] Boot info at ")
  foundation.serial_write_hex(info_addr)
  foundation.serial_write_string("\n")

  var flags: u32 = @as(*u32, @ptrFromInt(base)).*
  foundation.serial_write_string("[Boot] flags=")
  foundation.serial_write_hex(flags)
  foundation.serial_write_string("\n")

  // Boot modules: QEMU's -initrd and GRUB's `module` both arrive here. The
  // first one is taken as the initramfs; nothing in this kernel loads a
  // second module yet.
  if (flags & 8) != 0 {
    var mods_count: u32 = @as(*u32, @ptrFromInt(base + 20)).*
    var mods_addr: u32 = @as(*u32, @ptrFromInt(base + 24)).*
    if mods_count > 0 {
      if mods_addr != 0 {
        var mod_start: u32 = @as(*u32, @ptrFromInt(@as(u64, mods_addr))).*
        var mod_end: u32 = @as(*u32, @ptrFromInt(@as(u64, mods_addr) + 4)).*
        if mod_end > mod_start {
          initramfs_base = @as(u64, mod_start)
          initramfs_size = @as(u64, mod_end - mod_start)
          foundation.serial_write_string("[Boot] Module at ")
          foundation.serial_write_hex(initramfs_base)
          foundation.serial_write_string(" size=")
          foundation.serial_write_u64(initramfs_size)
          foundation.serial_write_string("\n")
        }
      }
    }
  }

  // Framebuffer, when the loader answered the video request in the header.
  // Info flags bit 12 says these fields are present.
  //
  //   offset 88  framebuffer_addr (u64)
  //   offset 96  framebuffer_pitch
  //   offset 100 framebuffer_width
  //   offset 104 framebuffer_height
  //   offset 108 framebuffer_bpp (u8)
  //   offset 109 framebuffer_type (u8)
  if (flags & 0x1000) != 0 {
    fb_addr = @as(*u64, @ptrFromInt(base + 88)).*
    fb_pitch = @as(*u32, @ptrFromInt(base + 96)).*
    fb_width = @as(*u32, @ptrFromInt(base + 100)).*
    fb_height = @as(*u32, @ptrFromInt(base + 104)).*
    fb_bpp = @as(*u8, @ptrFromInt(base + 108)).*
    foundation.serial_write_string("[Boot] Framebuffer ")
    foundation.serial_write_u64(@as(u64, fb_width))
    foundation.serial_write_string("x")
    foundation.serial_write_u64(@as(u64, fb_height))
    foundation.serial_write_string("x")
    foundation.serial_write_u64(@as(u64, fb_bpp))
    foundation.serial_write_string(" at ")
    foundation.serial_write_hex(fb_addr)
    foundation.serial_write_string("\n")
  } else {
    foundation.serial_write_string("[Boot] No framebuffer from loader\n")
  }

  if (flags & 1) != 0 {
    var mem_lower: u32 = @as(*u32, @ptrFromInt(base + 4)).*
    var mem_upper: u32 = @as(*u32, @ptrFromInt(base + 8)).*
    var total_kb: u64 = @as(u64, mem_lower) + @as(u64, mem_upper)
    foundation.serial_write_string("[Boot] Memory: ")
    foundation.serial_write_u64(total_kb / 1024)
    foundation.serial_write_string(" MB\n")
  }
}

fn parse_boot_info(info_addr: u32) {
  // Parse multiboot2 info structure
  var ptr: *u32 = @ptrFromInt(@as(u64, info_addr))
  var total_size: u32 = ptr.*

  foundation.serial_write_string("[Boot] Boot info at ")
  foundation.serial_write_hex(info_addr)
  foundation.serial_write_string(", size=")
  foundation.serial_write_hex(total_size)
  foundation.serial_write_string("\n")

  // Parse tags
  var offset: u32 = 8  // Skip size and reserved
  while offset < total_size {
    var tag_ptr: *u32 = @ptrFromInt(@as(u64, info_addr + offset))
    var tag_type: u32 = tag_ptr.*
    var tag_size: u32 = @ptrFromInt(@as(u64, info_addr + offset + 4)).*

    if tag_type == 0 { break }
    if tag_size < 8 { break }

    // Handle specific tags
    if tag_type == 6 {
      // Memory map tag
      foundation.serial_write_string("[Boot] Found memory map\n")
    } else if tag_type == 8 {
      // Framebuffer tag
      foundation.serial_write_string("[Boot] Found framebuffer info\n")
    }

    // Align to 8 bytes
    offset = offset + ((tag_size + 7) & 0xFFFFFFF8)
  }
}

fn post_init_integrations() {
  foundation.serial_write_string("[Kernel] Post-init integrations\n")

  // Initialize shell syscall layer
  shell_syscall.shell_syscall_init()
  foundation.serial_write_string("  - Shell syscall layer... OK\n")

  // Initialize VFS mmap
  vfs_mmap.vfs_mmap_init()
  foundation.serial_write_string("  - VFS mmap... OK\n")

  // Initialize block I/O layer
  block_io.block_io_init()
  foundation.serial_write_string("  - Block I/O layer... OK\n")

  // Initialize memory integration
  mm.mm_integration_init()
  foundation.serial_write_string("  - Memory integration... OK\n")

  // integration.home — which initializes the package manager, the den shell
  // and the Craft GUI toolkit — is deliberately not called here. Those are
  // Phase 3 and Phase 4 concerns; a kernel whose job is to reach a serial
  // console has no business starting any of them, and pulling them in left
  // 61 unresolved symbols in the MVK link. See MASTER_PLAN Appendix A.
}

// ============================================================================
// EXCEPTION HANDLERS
// ============================================================================

export fn exception_handler(vector: u32, error_code: u64, rip: u64, rsp: u64) {
  in_interrupt = 1

  if vector == EXCEPTION_PAGE_FAULT {
    // Page fault - get CR2 (faulting address)
    var fault_addr: u64 = foundation.read_cr2()

    // Try to handle via VFS mmap
    var current_pid: u32 = scheduler.get_current_pid()
    var result: u32 = vfs_mmap.handle_page_fault(current_pid, fault_addr, @intCast(error_code))

    if result == 0 {
      // Handled successfully
      in_interrupt = 0
      return
    }

    // Unhandled page fault - send SIGSEGV
    foundation.serial_write_string("[Exception] Page fault at ")
    foundation.serial_write_hex64(fault_addr)
    foundation.serial_write_string(", error=")
    foundation.serial_write_hex64(error_code)
    foundation.serial_write_string(", PID=")
    foundation.serial_write_hex(current_pid)
    foundation.serial_write_string("\n")

    if current_pid != 0 {
      signal.signal_send(current_pid, 11, 0)  // SIGSEGV
    } else {
      kernel_panic("Page fault in kernel mode", rip, rsp)
    }
  } else if vector == EXCEPTION_GENERAL_PROTECTION {
    foundation.serial_write_string("[Exception] General protection fault\n")
    foundation.serial_write_string("  Error code: ")
    foundation.serial_write_hex64(error_code)
    foundation.serial_write_string("\n  RIP: ")
    foundation.serial_write_hex64(rip)
    foundation.serial_write_string("\n")

    var current_pid: u32 = scheduler.get_current_pid()
    if current_pid != 0 {
      signal.signal_send(current_pid, 11, 0)  // SIGSEGV
    } else {
      kernel_panic("GPF in kernel mode", rip, rsp)
    }
  } else if vector == EXCEPTION_DOUBLE_FAULT {
    kernel_panic("Double fault", rip, rsp)
  } else if vector == EXCEPTION_DIVIDE_ERROR {
    var current_pid: u32 = scheduler.get_current_pid()
    if current_pid != 0 {
      signal.signal_send(current_pid, 8, 0)  // SIGFPE
    } else {
      kernel_panic("Divide error in kernel", rip, rsp)
    }
  } else if vector == EXCEPTION_INVALID_OPCODE {
    var current_pid: u32 = scheduler.get_current_pid()
    if current_pid != 0 {
      signal.signal_send(current_pid, 4, 0)  // SIGILL
    } else {
      kernel_panic("Invalid opcode in kernel", rip, rsp)
    }
  } else if vector == EXCEPTION_BREAKPOINT {
    foundation.serial_write_string("[Debug] Breakpoint at ")
    foundation.serial_write_hex64(rip)
    foundation.serial_write_string("\n")
    var current_pid: u32 = scheduler.get_current_pid()
    if current_pid != 0 {
      signal.signal_send(current_pid, 5, 0)  // SIGTRAP
    }
  } else {
    foundation.serial_write_string("[Exception] Unhandled exception ")
    foundation.serial_write_hex(vector)
    foundation.serial_write_string(" at ")
    foundation.serial_write_hex64(rip)
    foundation.serial_write_string("\n")
    kernel_panic("Unhandled exception", rip, rsp)
  }

  in_interrupt = 0
}

// ============================================================================
// INTERRUPT HANDLERS
// ============================================================================

export fn irq_handler(irq: u32) {
  in_interrupt = 1
  interrupt_nesting = interrupt_nesting + 1

  if irq == IRQ_TIMER {
    // Timer interrupt - scheduler tick
    timer.timer_tick()
    scheduler.scheduler_tick()

    // Check for pending signals
    var current_pid: u32 = scheduler.get_current_pid()
    if current_pid != 0 {
      signal.signal_deliver_pending(current_pid)
    }
  } else if irq == IRQ_KEYBOARD {
    // Keyboard interrupt
    keyboard.keyboard_interrupt_handler()
  } else if irq == IRQ_PRIMARY_ATA or irq == IRQ_SECONDARY_ATA {
    // ATA disk interrupt
    block_io.block_io_interrupt(irq)
  }
  // The network IRQ branch (48-55, dispatching to socket_rx_interrupt) is
  // deliberately absent. The MVK has no NIC driver, so no such interrupt can
  // arrive, and importing the socket layer to service one pulled net/tcp,
  // net/udp and drivers/e1000 into the minimum viable kernel. It returns with
  // the Phase 2 net-echo gate. See MASTER_PLAN Appendix A.

  // Send EOI to PIC
  foundation.pic_eoi(irq)

  if interrupt_nesting > 0 { interrupt_nesting = interrupt_nesting - 1 }
  if interrupt_nesting == 0 { in_interrupt = 0 }
}

// ============================================================================
// SYSCALL ENTRY POINT
// ============================================================================

export fn syscall_entry(syscall_num: u32, arg1: u64, arg2: u64, arg3: u64, arg4: u64, arg5: u64, arg6: u64): i64 {
  // Get current process
  var pid: u32 = scheduler.get_current_pid()

  // Check seccomp filter
  if seccomp.seccomp_check(pid, syscall_num) != 0 {
    return -1  // EPERM
  }

  // Dispatch syscall
  return syscall.syscall_dispatch(syscall_num, arg1, arg2, arg3, arg4, arg5, arg6)
}

// ============================================================================
// KERNEL PANIC
// ============================================================================

fn kernel_panic(msg: *u8, rip: u64, rsp: u64) {
  foundation.cli()  // Disable interrupts

  foundation.serial_write_string("\n")
  foundation.serial_write_string("===============================================\n")
  foundation.serial_write_string("!!! KERNEL PANIC !!!\n")
  foundation.serial_write_string("===============================================\n")
  foundation.serial_write_string("Message: ")
  
  foundation.serial_write_string("\n")
  foundation.serial_write_string("RIP: ")
  foundation.serial_write_hex64(rip)
  foundation.serial_write_string("\n")
  foundation.serial_write_string("RSP: ")
  foundation.serial_write_hex64(rsp)
  foundation.serial_write_string("\n")
  foundation.serial_write_string("Current PID: ")
  foundation.serial_write_hex(scheduler.get_current_pid())
  foundation.serial_write_string("\n")
  foundation.serial_write_string("Kernel phase: ")
  foundation.serial_write_hex(kernel_init.kernel_get_phase())
  foundation.serial_write_string("\n")

  // Print stack trace
  print_stack_trace(rsp)

  foundation.serial_write_string("\nSystem halted.\n")

  // Halt forever
  loop {
    foundation.hlt()
  }
}

fn print_stack_trace(rsp: u64) {
  foundation.serial_write_string("\nStack trace:\n")

  var frame: u64 = rsp
  var i: u32 = 0

  while i < 16 and frame != 0 and frame > 0x1000 and frame < 0xFFFFFFFF80000000 {
    var addr: *u64 = @ptrFromInt(frame)
    if addr.* != 0 {
      foundation.serial_write_string("  [")
      foundation.serial_write_hex(i)
      foundation.serial_write_string("] ")
      foundation.serial_write_hex64(addr.*)
      foundation.serial_write_string("\n")
    }
    frame = frame + 8
    i = i + 1
  }
}

// ============================================================================
// UTILITY FUNCTIONS
// ============================================================================

export fn kernel_is_running(): u32 {
  return kernel_running
}

export fn in_interrupt_context(): u32 {
  return in_interrupt
}

export fn get_interrupt_nesting(): u32 {
  return interrupt_nesting
}

// ============================================================================
// SHUTDOWN / REBOOT
// ============================================================================

export fn kernel_shutdown() {
  foundation.serial_write_string("\n[Kernel] Initiating shutdown...\n")

  kernel_running = 0

  // Use kernel_init's shutdown
  kernel_init.kernel_shutdown()
}

export fn kernel_reboot() {
  foundation.serial_write_string("\n[Kernel] Initiating reboot...\n")

  kernel_running = 0

  // Use kernel_init's reboot
  kernel_init.kernel_reboot()
}
