// home-os InitramFS - Initial RAM Filesystem
// Compressed CPIO archive support for fast boot
// Supports gzip and uncompressed formats

import "../core/foundation.home" as foundation
import "../core/memory.home" as memory
import "../fs/tmpfs.home" as tmpfs

// CPIO format constants
const CPIO_MAGIC_NEWC: u64 = 0x30373037_30310000  // "070701" in hex
const CPIO_MAGIC_CRC: u64 = 0x30373037_30320000   // "070702" in hex

// Compression types
const COMPRESSION_NONE: u32 = 0
const COMPRESSION_GZIP: u32 = 1
const COMPRESSION_BZIP2: u32 = 2
const COMPRESSION_LZMA: u32 = 3

// CPIO header (newc format)
struct CpioHeader {
  magic: [6]u8       // "070701" or "070702"
  ino: [8]u8         // Inode number
  mode: [8]u8        // File mode
  uid: [8]u8         // User ID
  gid: [8]u8         // Group ID
  nlink: [8]u8       // Number of links
  mtime: [8]u8       // Modification time
  filesize: [8]u8    // File size
  devmajor: [8]u8    // Device major
  devminor: [8]u8    // Device minor
  rdevmajor: [8]u8   // Special file major
  rdevminor: [8]u8   // Special file minor
  namesize: [8]u8    // Filename length
  check: [8]u8       // Checksum
}

const CPIO_HEADER_SIZE: u32 = 110

var initramfs_base: u64 = 0
var initramfs_size: u64 = 0
var initramfs_compression: u32 = COMPRESSION_NONE
var initramfs_initialized: u32 = 0

// Statistics
var files_extracted: u32 = 0
var dirs_created: u32 = 0
var bytes_extracted: u64 = 0
var compression_ratio: u32 = 100  // Percentage

// Initialize initramfs
export fn initramfs_init(base: u64, size: u64) {
  initramfs_base = base
  initramfs_size = size
  initramfs_compression = detect_compression(base)
  initramfs_initialized = 1

  files_extracted = 0
  dirs_created = 0
  bytes_extracted = 0

  tmpfs.tmpfs_init()

  foundation.serial_write_string("[InitramFS] Initialized at 0x")
  foundation.serial_write_u64(base)
  foundation.serial_write_string(", size: ")
  foundation.serial_write_u64(size / 1024)
  foundation.serial_write_string(" KB")

  if initramfs_compression == COMPRESSION_GZIP {
    foundation.serial_write_string(" (gzip compressed)")
  } else if initramfs_compression == COMPRESSION_BZIP2 {
    foundation.serial_write_string(" (bzip2 compressed)")
  }

  foundation.serial_write_string("\n")
}

// Detect compression type.
//
// The previous code cast the buffer to `*u16` and compared
// to a host-order constant. On big-endian machines that fails to
// match gzip headers (which are stored as the byte pair 0x1F 0x8B on
// disk). Read each byte individually so detection works regardless
// of host endianness.
fn detect_compression(addr: u64): u32 {
  let b0: u8 = @as(*u8, @ptrFromInt(addr)).*
  let b1: u8 = @as(*u8, @ptrFromInt(addr + 1)).*

  // gzip: 0x1F 0x8B
  if b0 == 0x1F and b1 == 0x8B {
    return COMPRESSION_GZIP
  }

  // bzip2: "BZ" (0x42 0x5A)
  if b0 == 0x42 and b1 == 0x5A {
    return COMPRESSION_BZIP2
  }

  // CPIO newc: literal ASCII "0707"
  let b2: u8 = @as(*u8, @ptrFromInt(addr + 2)).*
  let b3: u8 = @as(*u8, @ptrFromInt(addr + 3)).*
  if b0 == '0' and b1 == '7' and b2 == '0' and b3 == '7' {
    return COMPRESSION_NONE
  }

  return COMPRESSION_NONE
}

// Parse hex string from CPIO header.
//
// Reject non-hex characters instead of silently
// treating them as 0 (which corrupted every computed offset). Also
// switch the C-style `&&` to Home-style `and` for consistency with
// the rest of the file.
//
// Returns 0 on a malformed input; callers should compare against an
// explicit sentinel or record whether parse_hex_valid last returned true.
var parse_hex_valid: u32 = 1

fn parse_hex(data: *u8, len: u32): u64 {
  var result: u64 = 0
  var i: u32 = 0
  parse_hex_valid = 1

  loop {
    if i >= len { break }

    let ch_ptr: *u8 = data + i
    let ch: u8 = *ch_ptr

    result = result << 4

    if ch >= '0' and ch <= '9' {
      result = result | @as(u64, ch - '0')
    } else if ch >= 'a' and ch <= 'f' {
      result = result | @as(u64, ch - 'a' + 10)
    } else if ch >= 'A' and ch <= 'F' {
      result = result | @as(u64, ch - 'A' + 10)
    } else {
      // Malformed hex digit — flag failure so the caller can abort.
      parse_hex_valid = 0
    }

    i = i + 1
  }

  return result
}

// Gzip decompression.
//
// The previous "decompress" was a byte-copy that produced
// garbage when called on actually-compressed data. DEFLATE is a
// substantial algorithm; rather than ship a broken stub that
// silently corrupts initramfs data, refuse and return 0 so the
// caller surfaces the failure. A minimal stored-block fast-path is
// included for the case where the payload uses DEFLATE with only
// stored (type=00) blocks (as some mkinitramfs configurations do).
fn decompress_gzip(src: u64, src_len: u64, dst: u64, dst_capacity: u64): u64 {
  // Need at least 10-byte gzip header + 2-byte DEFLATE block header.
  if src_len < 12 { return 0 }

  // Verify gzip magic 0x1f 0x8b.
  let m0: u8 = @as(*u8, @ptrFromInt(src)).*
  let m1: u8 = @as(*u8, @ptrFromInt(src + 1)).*
  if m0 != 0x1F or m1 != 0x8B { return 0 }

  // Skip fixed 10-byte header; a full decoder would also consume
  // optional fields FNAME / FCOMMENT / FHCRC / FEXTRA based on FLG byte.
  let flg: u8 = @as(*u8, @ptrFromInt(src + 3)).*
  var src_offset: u64 = 10
  // Reject FEXTRA (0x04) / FNAME (0x08) / FCOMMENT (0x10) / FHCRC (0x02)
  // because we don't skip them. A real implementation would parse them.
  if (flg & 0x1E) != 0 { return 0 }

  // DEFLATE stored-block fast path: block header BFINAL=1, BTYPE=00.
  // Layout: [1 byte block header] [2 byte LEN] [2 byte NLEN] [LEN bytes raw]
  // We only accept a single final stored block (the format mkinitramfs
  // --format=cpio --compressor=stored produces).
  let block_header: u8 = @as(*u8, @ptrFromInt(src + src_offset)).*
  if (block_header & 0x07) != 0x01 {
    // Not BFINAL=1, BTYPE=00 — we cannot decode this.
    return 0
  }
  src_offset = src_offset + 1

  if src_offset + 4 > src_len { return 0 }
  let len_lo: u8 = @as(*u8, @ptrFromInt(src + src_offset)).*
  let len_hi: u8 = @as(*u8, @ptrFromInt(src + src_offset + 1)).*
  let nlen_lo: u8 = @as(*u8, @ptrFromInt(src + src_offset + 2)).*
  let nlen_hi: u8 = @as(*u8, @ptrFromInt(src + src_offset + 3)).*
  src_offset = src_offset + 4

  var block_len: u32 = (@as(u32, len_hi) << 8) | @as(u32, len_lo)
  var block_nlen: u32 = (@as(u32, nlen_hi) << 8) | @as(u32, nlen_lo)
  // DEFLATE invariant: NLEN is the one's complement of LEN.
  if (block_len ^ 0xFFFF) != block_nlen { return 0 }

  if src_offset + @as(u64, block_len) > src_len { return 0 }
  if @as(u64, block_len) > dst_capacity { return 0 }

  // Copy stored block bytes verbatim.
  var copied: u64 = 0
  while copied < @as(u64, block_len) {
    let s: u8 = @as(*u8, @ptrFromInt(src + src_offset + copied)).*
    @as(*u8, @ptrFromInt(dst + copied)).* = s
    copied = copied + 1
  }

  return copied
}

// Align offset to 4-byte boundary
fn align_4(offset: u64): u64 {
  return (offset + 3) & ~3
}

// Extract initramfs contents
export fn initramfs_extract(): u32 {
  if initramfs_initialized == 0 {
    foundation.serial_write_string("[InitramFS] Not initialized\n")
    return 1
  }

  foundation.serial_write_string("[InitramFS] Extracting...\n")

  var data_base: u64 = initramfs_base
  var data_size: u64 = initramfs_size

  // Decompress if needed
  if initramfs_compression == COMPRESSION_GZIP {
    foundation.serial_write_string("[InitramFS] Decompressing gzip...\n")

    // Allocate decompression buffer (assume 3:1 compression ratio)
    let decomp_size: u64 = initramfs_size * 3
    let decomp_buffer: u64 = memory.kmalloc(decomp_size)

    if decomp_buffer == 0 {
      foundation.serial_write_string("[InitramFS] Failed to allocate decompression buffer\n")
      return 1
    }

    let actual_size: u64 = decompress_gzip(initramfs_base, initramfs_size, decomp_buffer, decomp_size)

    if actual_size == 0 {
      foundation.serial_write_string("[InitramFS] Decompression failed\n")
      memory.kfree(decomp_buffer)
      return 1
    }

    data_base = decomp_buffer
    data_size = actual_size

    compression_ratio = (initramfs_size * 100) / actual_size

    foundation.serial_write_string("[InitramFS] Decompressed ")
    foundation.serial_write_u64(initramfs_size / 1024)
    foundation.serial_write_string(" KB -> ")
    foundation.serial_write_u64(actual_size / 1024)
    foundation.serial_write_string(" KB (")
    foundation.serial_write_u64(compression_ratio)
    foundation.serial_write_string("% ratio)\n")
  }

  // Parse CPIO archive
  var offset: u64 = 0

  loop {
    if offset >= data_size { break }

    // Align to 4-byte boundary
    offset = align_4(offset)

    if offset + CPIO_HEADER_SIZE > data_size { break }

    let header_ptr: *CpioHeader = data_base + offset
    let header: *CpioHeader = header_ptr

    // Check magic.: use Home's `or` instead of C's `||`.
    if header.magic[0] != '0' or header.magic[1] != '7' or
       header.magic[2] != '0' or header.magic[3] != '7' {
      foundation.serial_write_string("[InitramFS] Invalid CPIO magic, stopping\n")
      break
    }

    // Parse header fields and abort on any malformed hex.
    // silently accepting bad characters used to scale the
    // computed offsets by ~16× per bad digit, overrunning the buffer.
    let namesize: u64 = parse_hex(&header.namesize[0], 8)
    if parse_hex_valid == 0 { break }
    let filesize: u64 = parse_hex(&header.filesize[0], 8)
    if parse_hex_valid == 0 { break }
    let mode: u64 = parse_hex(&header.mode[0], 8)
    if parse_hex_valid == 0 { break }

    offset = offset + CPIO_HEADER_SIZE

    // Read filename. All size comparisons use the remaining-budget
    // form (`field > data_size - offset`) so a hex field crafted to
    // be near u64 max can't wrap `offset + field` around zero and
    // sneak past the bounds check.
    if offset > data_size { break }
    if namesize > data_size - offset { break }

    let filename_ptr: *u8 = data_base + offset
    offset = offset + namesize
    offset = align_4(offset)

    // Match the full "TRAILER!!!" sentinel rather than
    // just the first two characters. The old check accepted any file
    // whose name began with "TR" (e.g. "TRACE-000", "TRAINING.log")
    // and prematurely terminated extraction.
    let is_trailer: u32 = 0
    if namesize == 11 {  // "TRAILER!!!" + null
      let expected: [u8; 11] = [
        'T','R','A','I','L','E','R','!','!','!', 0
      ]
      var m: u32 = 0
      var ok: u32 = 1
      while m < 11 {
        let cur: u8 = @as(*u8, @ptrFromInt(@intFromPtr(filename_ptr) + m)).*
        if cur != expected[m] { ok = 0; break }
        m = m + 1
      }
      if ok == 1 { is_trailer = 1 }
    }

    if is_trailer == 1 {
      foundation.serial_write_string("[InitramFS] Found TRAILER, extraction complete\n")
      break
    }

    // Extract file data
    if filesize > 0 {
      if offset > data_size { break }
      if filesize > data_size - offset { break }

      // Check if directory (mode & 0x4000)
      if (mode & 0x4000) != 0 {
        // Directory
        dirs_created = dirs_created + 1
      } else {
        // Regular file - would write to tmpfs here
        files_extracted = files_extracted + 1
        bytes_extracted = bytes_extracted + filesize
      }

      offset = offset + filesize
      offset = align_4(offset)
    }

    // Safety check
    if files_extracted + dirs_created > 10000 {
      foundation.serial_write_string("[InitramFS] Too many files, stopping\n")
      break
    }
  }

  // Free the decompression buffer for ANY compression,
  // not just gzip. Previously a bzip2/LZMA path would allocate but
  // never free, leaking the full decompressed image until reboot.
  if initramfs_compression != COMPRESSION_NONE and data_base != initramfs_base {
    memory.kfree(data_base)
  }

  foundation.serial_write_string("[InitramFS] Extracted ")
  foundation.serial_write_u64(files_extracted)
  foundation.serial_write_string(" files, ")
  foundation.serial_write_u64(dirs_created)
  foundation.serial_write_string(" directories (")
  foundation.serial_write_u64(bytes_extracted / 1024)
  foundation.serial_write_string(" KB)\n")

  return 0
}

// Get extraction statistics
export fn initramfs_get_stats() {
  foundation.serial_write_string("\n[InitramFS] Statistics:\n")
  foundation.serial_write_string("  Files extracted: ")
  foundation.serial_write_u64(files_extracted)
  foundation.serial_write_string("\n")

  foundation.serial_write_string("  Directories created: ")
  foundation.serial_write_u64(dirs_created)
  foundation.serial_write_string("\n")

  foundation.serial_write_string("  Bytes extracted: ")
  foundation.serial_write_u64(bytes_extracted / 1024)
  foundation.serial_write_string(" KB\n")

  if initramfs_compression != COMPRESSION_NONE {
    foundation.serial_write_string("  Compression ratio: ")
    foundation.serial_write_u64(compression_ratio)
    foundation.serial_write_string("%\n")
  }
}

// Build minimal initramfs in memory (for testing)
export fn initramfs_build_minimal(): u64 {
  // Allocate 1MB for minimal initramfs
  let size: u64 = 1024 * 1024
  let buffer: u64 = memory.kmalloc(size)

  if buffer == 0 {
    return 0
  }

  // Would build CPIO archive with essential files
  // For now, just return empty buffer

  foundation.serial_write_string("[InitramFS] Built minimal initramfs in memory\n")

  return buffer
}
