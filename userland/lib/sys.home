// home-os userspace — the system call layer
//
// Everything above this file is an ordinary Home program. This is the one
// place that knows how a request crosses into the kernel: `int $0x80`, with
// the call number in %rax and arguments in %rdi, %rsi, %rdx, %rcx, and the
// result back in %rax.
//
// The numbering is home-os's own, not Linux's. It is defined in
// kernel/src/sys/syscall.home and repeated here because a userspace program
// cannot import kernel source — the two lists are the ABI, and a mismatch
// between them is a call that does something other than what it says.

export const SYS_EXIT: u64 = 0
export const SYS_FORK: u64 = 1
export const SYS_READ: u64 = 2
export const SYS_WRITE: u64 = 3
export const SYS_OPEN: u64 = 4
export const SYS_CLOSE: u64 = 5
export const SYS_WAIT: u64 = 6
export const SYS_EXEC: u64 = 7
export const SYS_GETPID: u64 = 8
export const SYS_KILL: u64 = 9
export const SYS_LSEEK: u64 = 13
export const SYS_MKDIR: u64 = 14
export const SYS_RMDIR: u64 = 15
export const SYS_YIELD: u64 = 108
export const SYS_SIGACTION: u64 = 63
export const SYS_SIGRETURN: u64 = 109
export const SYS_STAT: u64 = 29
export const SYS_UNLINK: u64 = 32

export const STDIN: u64 = 0
export const STDOUT: u64 = 1
export const STDERR: u64 = 2

// Open flags, matching the kernel's.
export const O_RDONLY: u64 = 0
export const O_WRONLY: u64 = 1
export const O_RDWR: u64 = 2
export const O_CREAT: u64 = 0x40
export const O_TRUNC: u64 = 0x200
export const O_APPEND: u64 = 0x400

// The raw trap. Four arguments is what the kernel's handler takes; a call
// needing fewer passes zeros, which cost nothing and keep one shape.
fn syscall4(number: u64, a: u64, b: u64, c: u64, d: u64): u64 {
  var result: u64 = 0
  asm volatile ("int $0x80"
    : [result] "={rax}" (result)
    : [number] "{rax}" (number),
      [a] "{rdi}" (a),
      [b] "{rsi}" (b),
      [c] "{rdx}" (c),
      [d] "{rcx}" (d)
  )
  return result
}

export fn sys_exit(code: u64): u64 {
  return syscall4(SYS_EXIT, code, 0, 0, 0)
}

export fn sys_write(fd: u64, buf: u64, len: u64): u64 {
  return syscall4(SYS_WRITE, fd, buf, len, 0)
}

export fn sys_read(fd: u64, buf: u64, len: u64): u64 {
  return syscall4(SYS_READ, fd, buf, len, 0)
}

export fn sys_open(path: u64, flags: u64, mode: u64): u64 {
  return syscall4(SYS_OPEN, path, flags, mode, 0)
}

export fn sys_close(fd: u64): u64 {
  return syscall4(SYS_CLOSE, fd, 0, 0, 0)
}

export fn sys_getpid(): u64 {
  return syscall4(SYS_GETPID, 0, 0, 0, 0)
}

export fn sys_mkdir(path: u64, mode: u64): u64 {
  return syscall4(SYS_MKDIR, path, mode, 0, 0)
}

export fn sys_fork(): u64 {
  return syscall4(SYS_FORK, 0, 0, 0, 0)
}

// Register a signal handler. `trampoline` is where the handler returns to;
// the kernel cannot invent code in this address space, so the program has to
// supply the stub that calls sigreturn. libc.signal fills it in.
export fn sys_sigaction(sig: u64, handler: u64, trampoline: u64): u64 {
  return syscall4(SYS_SIGACTION, sig, handler, trampoline, 0)
}

export fn sys_sigreturn(): u64 {
  return syscall4(SYS_SIGRETURN, 0, 0, 0, 0)
}

export fn sys_kill(target: u64, sig: u64): u64 {
  return syscall4(SYS_KILL, target, sig, 0, 0)
}

export fn sys_yield(): u64 {
  return syscall4(SYS_YIELD, 0, 0, 0, 0)
}

export fn sys_wait(pid: u64): u64 {
  return syscall4(SYS_WAIT, pid, 0, 0, 0)
}

export fn sys_rmdir(path: u64): u64 {
  return syscall4(SYS_RMDIR, path, 0, 0, 0)
}

export fn sys_lseek(fd: u64, offset: u64, whence: u64): u64 {
  return syscall4(SYS_LSEEK, fd, offset, whence, 0)
}

export fn sys_unlink(path: u64): u64 {
  return syscall4(SYS_UNLINK, path, 0, 0, 0)
}

// ---------------------------------------------------------------------------
// Metadata, links and directories
//
// These numbers come from kernel/src/sys/syscall.home and are repeated here
// for the reason at the top of this file: the two lists are the ABI.

export const SYS_FSTAT: u64 = 30
export const SYS_LSTAT: u64 = 31
export const SYS_LINK: u64 = 33
export const SYS_SYMLINK: u64 = 34
export const SYS_READLINK: u64 = 35
export const SYS_RENAME: u64 = 36
export const SYS_ACCESS: u64 = 37
export const SYS_TRUNCATE: u64 = 42
export const SYS_FTRUNCATE: u64 = 43
export const SYS_CHDIR: u64 = 44
export const SYS_GETCWD: u64 = 46
export const SYS_GETDENTS: u64 = 47
export const SYS_GETPPID: u64 = 48
export const SYS_NANOSLEEP: u64 = 62

// access() modes.
export const F_OK: u64 = 0
export const X_OK: u64 = 1
export const W_OK: u64 = 2
export const R_OK: u64 = 4

// The file kinds stat reports.
export const KIND_REGULAR: u64 = 1
export const KIND_DIRECTORY: u64 = 2
export const KIND_SYMLINK: u64 = 3
export const KIND_DEVICE: u64 = 4

// The stat buffer, field by field. Fixed offsets into 88 bytes, matching the
// layout written by kernel/src/sys/syscall.home — a program declares an
// 88-byte array and reads fields out of it with these, so there is one place
// that knows the offsets rather than one per utility.
export const STAT_SIZE: u64 = 88
export const ST_INO: u64 = 0
export const ST_MODE: u64 = 8
export const ST_KIND: u64 = 16
export const ST_UID: u64 = 24
export const ST_GID: u64 = 32
export const ST_NLINK: u64 = 40
export const ST_SIZE: u64 = 48
export const ST_BLOCKS: u64 = 56

// One directory entry as getdents writes it: 280 bytes, the name at 24.
export const DIRENT_SIZE: u64 = 280
export const DE_INO: u64 = 0
export const DE_KIND: u64 = 8
export const DE_SIZE: u64 = 16
export const DE_NAME: u64 = 24

export fn sys_stat(path: u64, statbuf: u64): u64 {
  return syscall4(SYS_STAT, path, statbuf, 0, 0)
}

export fn sys_fstat(fd: u64, statbuf: u64): u64 {
  return syscall4(SYS_FSTAT, fd, statbuf, 0, 0)
}

// Reports on the link itself where stat reports on what it points at.
export fn sys_lstat(path: u64, statbuf: u64): u64 {
  return syscall4(SYS_LSTAT, path, statbuf, 0, 0)
}

export fn sys_link(oldpath: u64, newpath: u64): u64 {
  return syscall4(SYS_LINK, oldpath, newpath, 0, 0)
}

export fn sys_symlink(target: u64, linkpath: u64): u64 {
  return syscall4(SYS_SYMLINK, target, linkpath, 0, 0)
}

// Returns the number of bytes written, which is 0 when `path` is not a
// symlink. No terminator is written — the length is the answer.
export fn sys_readlink(path: u64, buf: u64, size: u64): u64 {
  return syscall4(SYS_READLINK, path, buf, size, 0)
}

export fn sys_rename(oldpath: u64, newpath: u64): u64 {
  return syscall4(SYS_RENAME, oldpath, newpath, 0, 0)
}

export fn sys_access(path: u64, mode: u64): u64 {
  return syscall4(SYS_ACCESS, path, mode, 0, 0)
}

export fn sys_truncate(path: u64, length: u64): u64 {
  return syscall4(SYS_TRUNCATE, path, length, 0, 0)
}

export fn sys_ftruncate(fd: u64, length: u64): u64 {
  return syscall4(SYS_FTRUNCATE, fd, length, 0, 0)
}

export fn sys_chdir(path: u64): u64 {
  return syscall4(SYS_CHDIR, path, 0, 0, 0)
}

export fn sys_getcwd(buf: u64, size: u64): u64 {
  return syscall4(SYS_GETCWD, buf, size, 0, 0)
}

// Named for what it takes. The kernel's directory reader works from a path,
// not a descriptor — a descriptor does not carry the path it was opened on —
// so calling this getdents and passing it a path would be a name that lies
// about its argument. Returns the number of entries written.
export fn sys_getdents_path(path: u64, buf: u64, max_entries: u64): u64 {
  return syscall4(SYS_GETDENTS, path, buf, max_entries, 0)
}

export fn sys_getppid(): u64 {
  return syscall4(SYS_GETPPID, 0, 0, 0, 0)
}

// `req` points at two u64s: seconds, then nanoseconds. `rem` may be 0.
export fn sys_nanosleep(req: u64, rem: u64): u64 {
  return syscall4(SYS_NANOSLEEP, req, rem, 0, 0)
}

// The calls this kernel does not implement. They are here so a program can
// establish that they *say* so: MASTER_PLAN §7 S14 was about twenty calls
// that returned 0 without doing the work, and a refusal is only worth
// anything if something checks for it.

export const SYS_SOCKET: u64 = 22
export const SYS_MPROTECT: u64 = 67
export const SYS_DUP: u64 = 92
export const SYS_PIPE: u64 = 95
export const SYS_POLL: u64 = 83

export fn sys_socket(domain: u64, sock_type: u64, protocol: u64): u64 {
  return syscall4(SYS_SOCKET, domain, sock_type, protocol, 0)
}

export fn sys_mprotect(addr: u64, len: u64, prot: u64): u64 {
  return syscall4(SYS_MPROTECT, addr, len, prot, 0)
}

export fn sys_dup(fd: u64): u64 {
  return syscall4(SYS_DUP, fd, 0, 0, 0)
}

export fn sys_pipe(pipefd: u64): u64 {
  return syscall4(SYS_PIPE, pipefd, 0, 0, 0)
}

export fn sys_poll(fds: u64, nfds: u64, timeout: u64): u64 {
  return syscall4(SYS_POLL, fds, nfds, timeout, 0)
}

// The monotonic clock, in seconds and nanoseconds through a two-u64 buffer.
// It counts from boot and only goes forward, which is what makes it the one
// to measure an interval with.
export const SYS_CLOCK_GETTIME: u64 = 60
export const CLOCK_MONOTONIC: u64 = 1

export fn sys_clock_gettime(clk_id: u64, tp: u64): u64 {
  return syscall4(SYS_CLOCK_GETTIME, clk_id, tp, 0, 0)
}
