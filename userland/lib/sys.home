// home-os userspace — the system call layer
//
// Everything above this file is an ordinary Home program. This is the one
// place that knows how a request crosses into the kernel: `int $0x80`, with
// the call number in %rax and arguments in %rdi, %rsi, %rdx, %rcx, and the
// result back in %rax.
//
// The numbering is home-os's own, not Linux's. It is defined in
// kernel/src/sys/syscall.home and repeated here because a userspace program
// cannot import kernel source — the two lists are the ABI, and a mismatch
// between them is a call that does something other than what it says.

export const SYS_EXIT: u64 = 0
export const SYS_FORK: u64 = 1
export const SYS_READ: u64 = 2
export const SYS_WRITE: u64 = 3
export const SYS_OPEN: u64 = 4
export const SYS_CLOSE: u64 = 5
export const SYS_WAIT: u64 = 6
export const SYS_EXEC: u64 = 7
export const SYS_GETPID: u64 = 8
export const SYS_KILL: u64 = 9
export const SYS_LSEEK: u64 = 13
export const SYS_MKDIR: u64 = 14
export const SYS_RMDIR: u64 = 15
export const SYS_STAT: u64 = 29
export const SYS_UNLINK: u64 = 32

export const STDIN: u64 = 0
export const STDOUT: u64 = 1
export const STDERR: u64 = 2

// Open flags, matching the kernel's.
export const O_RDONLY: u64 = 0
export const O_WRONLY: u64 = 1
export const O_RDWR: u64 = 2
export const O_CREAT: u64 = 0x40
export const O_TRUNC: u64 = 0x200
export const O_APPEND: u64 = 0x400

// The raw trap. Four arguments is what the kernel's handler takes; a call
// needing fewer passes zeros, which cost nothing and keep one shape.
fn syscall4(number: u64, a: u64, b: u64, c: u64, d: u64): u64 {
  var result: u64 = 0
  asm volatile ("int $0x80"
    : [result] "={rax}" (result)
    : [number] "{rax}" (number),
      [a] "{rdi}" (a),
      [b] "{rsi}" (b),
      [c] "{rdx}" (c),
      [d] "{rcx}" (d)
  )
  return result
}

export fn sys_exit(code: u64): u64 {
  return syscall4(SYS_EXIT, code, 0, 0, 0)
}

export fn sys_write(fd: u64, buf: u64, len: u64): u64 {
  return syscall4(SYS_WRITE, fd, buf, len, 0)
}

export fn sys_read(fd: u64, buf: u64, len: u64): u64 {
  return syscall4(SYS_READ, fd, buf, len, 0)
}

export fn sys_open(path: u64, flags: u64, mode: u64): u64 {
  return syscall4(SYS_OPEN, path, flags, mode, 0)
}

export fn sys_close(fd: u64): u64 {
  return syscall4(SYS_CLOSE, fd, 0, 0, 0)
}

export fn sys_getpid(): u64 {
  return syscall4(SYS_GETPID, 0, 0, 0, 0)
}

export fn sys_mkdir(path: u64, mode: u64): u64 {
  return syscall4(SYS_MKDIR, path, mode, 0, 0)
}

export fn sys_unlink(path: u64): u64 {
  return syscall4(SYS_UNLINK, path, 0, 0, 0)
}
