// home-os userspace — the C library, such as it is
//
// String and memory primitives, buffered output, and number formatting. What
// a coreutil needs and nothing else: there is no allocator here, because a
// program that reads a file into a fixed buffer and writes it out does not
// need one, and an allocator nobody exercises is an allocator that does not
// work.
//
// Output is buffered and flushed explicitly. Writing a byte at a time through
// a syscall costs a trap per character, and `cat` of a file is the exact case
// where that shows.

import "sys.home" as sys

const OUT_CAPACITY: u32 = 4096
var out_buffer: [u8; 4096] = undefined
var out_used: u32 = 0

// ============================================================================
// Arguments
//
// A program is entered with argc in the first parameter and argv in the
// second — home-os's process ABI, described where enter_usermode builds it.
// argv points at an array of NUL-terminated strings with a null after the
// last, so a program can walk it either way.
// ============================================================================

export fn arg_at(argv: u64, index: u32): u64 {
  if argv == 0 { return 0 }
  return @as(*u64, @ptrFromInt(argv + @as(u64, index) * 8)).*
}

// ============================================================================
// Strings
// ============================================================================

export fn strlen(s: u64): u32 {
  var n: u32 = 0
  // Bounded: a string that is not terminated would otherwise walk memory
  // until it faulted, and a fault in a coreutil is a worse report than a
  // truncated one.
  while n < 65535 {
    if @as(*u8, @ptrFromInt(s + @as(u64, n))).* == 0 { return n }
    n = n + 1
  }
  return n
}

export fn strcmp(a: u64, b: u64): i32 {
  var i: u32 = 0
  while i < 65535 {
    let ca: u8 = @as(*u8, @ptrFromInt(a + @as(u64, i))).*
    let cb: u8 = @as(*u8, @ptrFromInt(b + @as(u64, i))).*
    if ca != cb {
      if ca < cb { return -1 }
      return 1
    }
    if ca == 0 { return 0 }
    i = i + 1
  }
  return 0
}

export fn memcpy(dest: u64, src: u64, n: u32) {
  if n == 0 { return }
  @memcpy(@as(*u8, @ptrFromInt(dest)), @as(*u8, @ptrFromInt(src)), n)
}

export fn memset(dest: u64, value: u8, n: u32) {
  if n == 0 { return }
  @memset(@as(*u8, @ptrFromInt(dest)), value, n)
}

// ============================================================================
// Output
// ============================================================================

export fn flush() {
  if out_used == 0 { return }
  sys.sys_write(sys.STDOUT, @intFromPtr(&out_buffer), @as(u64, out_used))
  out_used = 0
}

export fn putc(c: u8) {
  if out_used >= OUT_CAPACITY { flush() }
  out_buffer[out_used] = c
  out_used = out_used + 1
}

export fn write_bytes(buf: u64, len: u32) {
  var i: u32 = 0
  while i < len {
    putc(@as(*u8, @ptrFromInt(buf + @as(u64, i))).*)
    i = i + 1
  }
}

export fn puts(s: u64) {
  write_bytes(s, strlen(s))
}

export fn putln(s: u64) {
  puts(s)
  putc(10)
}

// Unsigned decimal. Digits are built backwards into a small buffer and
// emitted in order, which is the only way round that does not need division
// by a varying power of ten.
export fn put_u64(value: u64) {
  if value == 0 {
    putc(48)
    return
  }
  var digits: [u8; 20] = undefined
  var count: u32 = 0
  var v: u64 = value
  while v > 0 {
    digits[count] = @as(u8, (v % 10)) + 48
    v = v / 10
    count = count + 1
  }
  while count > 0 {
    count = count - 1
    putc(digits[count])
  }
}

export fn put_i64(value: i64) {
  if value < 0 {
    putc(45)
    put_u64(@as(u64, 0 - value))
    return
  }
  put_u64(@as(u64, value))
}

// ============================================================================
// Files
//
// A fixed read buffer rather than an allocator: every utility here streams,
// and the one that does not — sort — would need to hold its input anyway and
// can say so when it is written.
// ============================================================================

const READ_CAPACITY: u32 = 4096
var read_buffer: [u8; 4096] = undefined

export fn read_buffer_addr(): u64 { return @intFromPtr(&read_buffer) }
export fn read_buffer_size(): u32 { return READ_CAPACITY }

// Open for reading. Returns the descriptor, or 0 — the kernel uses 0 for
// failure here, and 0 is also stdin, which no open ever returns.
export fn open_read(path: u64): u64 {
  return sys.sys_open(path, sys.O_RDONLY, 0)
}

export fn open_write(path: u64): u64 {
  return sys.sys_open(path, sys.O_WRONLY | sys.O_CREAT | sys.O_TRUNC, 0o644)
}

export fn close(fd: u64) {
  sys.sys_close(fd)
}

// Copy a descriptor to standard output. Returns the number of bytes moved.
export fn copy_to_stdout(fd: u64): u64 {
  var total: u64 = 0
  loop {
    let got: u64 = sys.sys_read(fd, @intFromPtr(&read_buffer), @as(u64, READ_CAPACITY))
    if got == 0 { return total }
    if got > @as(u64, READ_CAPACITY) { return total }
    write_bytes(@intFromPtr(&read_buffer), @as(u32, got))
    total = total + got
  }
}

// ============================================================================
// Lines
//
// A reader that hands out one line at a time, over the same fixed buffer the
// streaming helpers use. Utilities that work line by line — head, nl, uniq,
// tac — all want this and none of them wants to write it again.
//
// A line longer than the buffer is delivered in pieces rather than truncated:
// losing the tail of a long line silently is the kind of thing that only
// shows up on someone else's data.
// ============================================================================

const LINE_CAPACITY: u32 = 1024
var line_buffer: [u8; 1024] = undefined
var line_fd: u64 = 0
var line_fill: u32 = 0
var line_at: u32 = 0
var line_eof: u32 = 0

export fn line_reader_open(fd: u64) {
  line_fd = fd
  line_fill = 0
  line_at = 0
  line_eof = 0
}

fn line_refill(): u32 {
  if line_eof == 1 { return 0 }
  let got: u64 = sys.sys_read(line_fd, @intFromPtr(&read_buffer),
                              @as(u64, READ_CAPACITY))
  if got == 0 or got > @as(u64, READ_CAPACITY) {
    line_eof = 1
    return 0
  }
  line_fill = @as(u32, got)
  line_at = 0
  return 1
}

// Read the next line into `out`, without its newline. Returns its length, or
// 0xFFFFFFFF at end of input — which is distinct from a line of length 0,
// since an empty line is a line.
export fn read_line(out: u64, max: u32): u32 {
  var length: u32 = 0
  loop {
    if line_at >= line_fill {
      if line_refill() == 0 {
        if length == 0 { return 0xFFFFFFFF }
        return length
      }
    }
    let c: u8 = read_buffer[line_at]
    line_at = line_at + 1
    if c == 10 { return length }
    if length < max {
      @as(*u8, @ptrFromInt(out + @as(u64, length))).* = c
      length = length + 1
    }
  }
}

export fn line_buffer_addr(): u64 { return @intFromPtr(&line_buffer) }
export fn line_buffer_size(): u32 { return LINE_CAPACITY }

// ============================================================================
// Numbers
// ============================================================================

// Parse a non-negative decimal. Returns 0xFFFFFFFFFFFFFFFF for anything that
// is not one, so a caller can tell "zero" from "not a number".
export fn parse_u64(s: u64): u64 {
  var i: u32 = 0
  var value: u64 = 0
  var digits: u32 = 0
  while i < 20 {
    let c: u8 = @as(*u8, @ptrFromInt(s + @as(u64, i))).*
    if c == 0 { break }
    if c < 48 or c > 57 { return 0xFFFFFFFFFFFFFFFF }
    value = value * 10 + @as(u64, c - 48)
    digits = digits + 1
    i = i + 1
  }
  if digits == 0 { return 0xFFFFFFFFFFFFFFFF }
  return value
}

// ============================================================================
// Errors
// ============================================================================

// Write straight to stderr rather than through the buffer: a message about
// something going wrong should not be waiting behind output that may never be
// flushed.
export fn error_line(s: u64) {
  sys.sys_write(sys.STDERR, s, @as(u64, strlen(s)))
  var newline: [u8; 1] = undefined
  newline[0] = 10
  sys.sys_write(sys.STDERR, @intFromPtr(&newline), 1)
}

// Flush and leave. Every program ends through here, so no program has to
// remember that its output is buffered.
export fn exit(code: u64): never {
  flush()
  sys.sys_exit(code)
  // The kernel does not return from exit; this loop is what makes that a
  // fact the type system knows rather than one it has to trust.
  loop {}
}
