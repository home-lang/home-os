// ls — list a directory, or name a file that is not one.
//
// -l adds the kind, the size and the link count. Entries come out in the
// order the directory holds them: sorting would mean holding every name at
// once, and readdir promises no order anyway.

import "../lib/libc.home" as libc
import "../lib/sys.home" as sys

const MAX_ENTRIES: u64 = 64

var entries: [u8; 17920] = undefined     // MAX_ENTRIES * DIRENT_SIZE
var st: [u8; 88] = undefined

fn entry_field(index: u64, offset: u64): u64 {
  return @as(*u64, @ptrFromInt(@intFromPtr(&entries) + index * sys.DIRENT_SIZE + offset)).*
}

fn entry_name(index: u64): u64 {
  return @intFromPtr(&entries) + index * sys.DIRENT_SIZE + sys.DE_NAME
}

fn kind_char(kind: u64): u8 {
  if kind == sys.KIND_DIRECTORY { return 'd' }
  if kind == sys.KIND_SYMLINK { return 'l' }
  if kind == sys.KIND_DEVICE { return 'c' }
  return '-'
}

export fn _start(argc: u64, argv: u64): never {
  var long: u32 = 0
  var path: u64 = @intFromPtr("/")
  var named: u32 = 0

  var a: u32 = 1
  while a < @as(u32, argc) {
    let arg: u64 = libc.arg_at(argv, a)
    if libc.strcmp(arg, @intFromPtr("-l")) == 0 {
      long = 1
    } else {
      path = arg
      named = 1
    }
    a = a + 1
  }

  // A path that is not a directory lists as itself, which is what ls does and
  // what makes `ls file` useful for checking a file is there.
  if sys.sys_lstat(path, @intFromPtr(&st)) != 0 {
    libc.error_line(path)
    libc.exit(1)
  }
  if @as(*u64, @ptrFromInt(@intFromPtr(&st) + sys.ST_KIND)).* != sys.KIND_DIRECTORY {
    libc.putln(path)
    libc.flush()
    libc.exit(0)
  }

  let count: u64 = sys.sys_getdents_path(path, @intFromPtr(&entries), MAX_ENTRIES)
  var i: u64 = 0
  while i < count {
    if long == 1 {
      libc.putc(kind_char(entry_field(i, sys.DE_KIND)))
      libc.puts(" ")
      libc.put_u64(entry_field(i, sys.DE_SIZE))
      libc.puts(" ")
    }
    libc.putln(entry_name(i))
    i = i + 1
  }
  libc.flush()
  libc.exit(0)
}
