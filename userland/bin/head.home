// head — the first lines of each file, ten by default.
//
// `-n N` sets the count. The option is read before the operands so that
// `head -n 2 file` and `head file` take the same path afterwards.

import "../lib/libc.home" as libc
import "../lib/sys.home" as sys

fn head_fd(fd: u64, limit: u64) {
  libc.line_reader_open(fd)
  var shown: u64 = 0
  while shown < limit {
    let length: u32 = libc.read_line(libc.line_buffer_addr(), libc.line_buffer_size())
    if length == 0xFFFFFFFF { return }
    libc.write_bytes(libc.line_buffer_addr(), length)
    libc.putc(10)
    shown = shown + 1
  }
}

export fn _start(argc: u64, argv: u64): never {
  init_options()

  var limit: u64 = 10
  var first: u32 = 1

  // -n N
  if argc >= 3 {
    let opt: u64 = libc.arg_at(argv, 1)
    if libc.strcmp(opt, @intFromPtr(&dash_n)) == 0 {
      let parsed: u64 = libc.parse_u64(libc.arg_at(argv, 2))
      if parsed != 0xFFFFFFFFFFFFFFFF {
        limit = parsed
        first = 3
      }
    }
  }

  if @as(u32, argc) <= first {
    head_fd(sys.STDIN, limit)
    libc.exit(0)
  }

  var status: u64 = 0
  var i: u32 = first
  while i < @as(u32, argc) {
    let path: u64 = libc.arg_at(argv, i)
    let fd: u64 = libc.open_read(path)
    if fd == 0 {
      libc.error_line(path)
      status = 1
    } else {
      head_fd(fd, limit)
      libc.close(fd)
    }
    i = i + 1
  }
  libc.exit(status)
}

var dash_n: [u8; 3] = undefined
fn init_options() {
  dash_n[0] = 45
  dash_n[1] = 110
  dash_n[2] = 0
}
