// expr — evaluate an integer expression given as arguments.
//
// `expr A OP B`, with + - * / %. The result goes to standard output and the
// exit status is 0 for a nonzero result and 1 for zero, which is what expr
// does and what scripts test.

import "../lib/libc.home" as libc
import "../lib/sys.home" as sys

export fn _start(argc: u64, argv: u64): never {
  if argc < 4 {
    libc.error_line("expr: usage is expr A OP B")
    libc.exit(2)
  }

  let a: u64 = libc.parse_u64(libc.arg_at(argv, 1))
  let b: u64 = libc.parse_u64(libc.arg_at(argv, 3))
  if a == 0xFFFFFFFFFFFFFFFF or b == 0xFFFFFFFFFFFFFFFF {
    libc.error_line("expr: not a number")
    libc.exit(2)
  }

  let op: u64 = libc.arg_at(argv, 2)
  var result: u64 = 0

  if libc.strcmp(op, "+") == 0 {
    result = a + b
  } else if libc.strcmp(op, "-") == 0 {
    // Unsigned throughout: a result below zero is an error rather than a very
    // large number, which is what the wraparound would otherwise print.
    if b > a {
      libc.error_line("expr: negative result")
      libc.exit(2)
    }
    result = a - b
  } else if libc.strcmp(op, "*") == 0 {
    result = a * b
  } else if libc.strcmp(op, "/") == 0 {
    if b == 0 {
      libc.error_line("expr: division by zero")
      libc.exit(2)
    }
    result = a / b
  } else if libc.strcmp(op, "%") == 0 {
    if b == 0 {
      libc.error_line("expr: division by zero")
      libc.exit(2)
    }
    result = a % b
  } else {
    libc.error_line("expr: unknown operator")
    libc.exit(2)
  }

  libc.put_u64(result)
  libc.putc(10)
  if result == 0 { libc.exit(1) }
  libc.exit(0)
}
