// cp — copy one file to another.
//
// The destination is created and truncated; a partial copy is reported
// rather than left looking complete.

import "../lib/libc.home" as libc
import "../lib/sys.home" as sys

export fn _start(argc: u64, argv: u64): never {
  if argc < 3 { libc.exit(1) }

  let source: u64 = libc.open_read(libc.arg_at(argv, 1))
  if source == 0 {
    libc.error_line(libc.arg_at(argv, 1))
    libc.exit(1)
  }

  let target: u64 = libc.open_write(libc.arg_at(argv, 2))
  if target == 0 {
    libc.error_line(libc.arg_at(argv, 2))
    libc.close(source)
    libc.exit(1)
  }

  var status: u64 = 0
  loop {
    let got: u64 = sys.sys_read(source, libc.read_buffer_addr(),
                                @as(u64, libc.read_buffer_size()))
    if got == 0 { break }
    if got > @as(u64, libc.read_buffer_size()) { break }
    if libc.write_all(target, libc.read_buffer_addr(), @as(u32, got)) == 0 {
      libc.error_line(libc.arg_at(argv, 2))
      status = 1
      break
    }
  }

  libc.close(source)
  libc.close(target)
  libc.exit(status)
}
