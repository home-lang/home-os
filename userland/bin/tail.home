// tail — the last lines of each file, ten by default.
//
// Cannot stream: the last line is only known once the input has ended, so the
// lines are held and the tail of them printed. The store is bounded and says
// so rather than quietly dropping the front of a long file.

import "../lib/libc.home" as libc
import "../lib/sys.home" as sys

fn tail_fd(fd: u64, limit: u32): u64 {
  libc.store_reset()
  if libc.store_read_all(fd) == 0 {
    libc.error_line("tail: input too large to hold")
    return 1
  }
  let total: u32 = libc.store_lines()
  var first: u32 = 0
  if total > limit { first = total - limit }
  var i: u32 = first
  while i < total {
    libc.write_bytes(libc.store_line_addr(i), libc.store_line_length(i))
    libc.putc(10)
    i = i + 1
  }
  return 0
}

export fn _start(argc: u64, argv: u64): never {
  var limit: u32 = 10
  var first: u32 = 1

  if argc >= 3 and libc.strcmp(libc.arg_at(argv, 1), "-n") == 0 {
    let parsed: u64 = libc.parse_u64(libc.arg_at(argv, 2))
    if parsed != 0xFFFFFFFFFFFFFFFF {
      limit = @as(u32, parsed)
      first = 3
    }
  }

  if @as(u32, argc) <= first {
    libc.exit(tail_fd(sys.STDIN, limit))
  }

  var status: u64 = 0
  var i: u32 = first
  while i < @as(u32, argc) {
    let path: u64 = libc.arg_at(argv, i)
    let fd: u64 = libc.open_read(path)
    if fd == 0 {
      libc.error_line(path)
      status = 1
    } else {
      if tail_fd(fd, limit) != 0 { status = 1 }
      libc.close(fd)
    }
    i = i + 1
  }
  libc.exit(status)
}
