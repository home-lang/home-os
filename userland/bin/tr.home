// tr — replace characters of one set with another, or delete them.
//
// `tr SET1 SET2` maps by position; a SET2 shorter than SET1 repeats its last
// character, as POSIX says. `tr -d SET1` deletes. No ranges and no classes:
// what is not supported is refused rather than half-applied.

import "../lib/libc.home" as libc
import "../lib/sys.home" as sys

fn set_index(set: u64, c: u8): u32 {
  var i: u32 = 0
  while i < 256 {
    let s: u8 = @as(*u8, @ptrFromInt(set + @as(u64, i))).*
    if s == 0 { return 0xFFFFFFFF }
    if s == c { return i }
    i = i + 1
  }
  return 0xFFFFFFFF
}

fn translate(fd: u64, from: u64, to: u64, delete: u32) {
  let to_len: u32 = libc.strlen(to)
  loop {
    let got: u64 = sys.sys_read(fd, libc.read_buffer_addr(),
                                @as(u64, libc.read_buffer_size()))
    if got == 0 { return }
    if got > @as(u64, libc.read_buffer_size()) { return }
    var i: u64 = 0
    while i < got {
      let c: u8 = @as(*u8, @ptrFromInt(libc.read_buffer_addr() + i)).*
      let at: u32 = set_index(from, c)
      if at == 0xFFFFFFFF {
        libc.putc(c)
      } else if delete == 0 {
        // A shorter SET2 repeats its last character.
        var pick: u32 = at
        if pick >= to_len { pick = to_len - 1 }
        libc.putc(@as(*u8, @ptrFromInt(to + @as(u64, pick))).*)
      }
      i = i + 1
    }
  }
}

// tr reads standard input. Until input redirection exists (S12) there is no
// way to give it one, so a file operand is accepted after the sets — an
// extension, and a smaller one than leaving tr untestable.
fn input_from(argc: u64, argv: u64, at: u32): u64 {
  if @as(u32, argc) <= at { return sys.STDIN }
  let path: u64 = libc.arg_at(argv, at)
  let fd: u64 = libc.open_read(path)
  if fd == 0 {
    libc.error_line(path)
    return 0xFFFFFFFFFFFFFFFF
  }
  return fd
}

export fn _start(argc: u64, argv: u64): never {
  if argc < 2 {
    libc.error_line("tr: missing operand")
    libc.exit(1)
  }

  if libc.strcmp(libc.arg_at(argv, 1), "-d") == 0 {
    if argc < 3 {
      libc.error_line("tr: -d needs a set")
      libc.exit(1)
    }
    let fd: u64 = input_from(argc, argv, 3)
    if fd == 0xFFFFFFFFFFFFFFFF { libc.exit(1) }
    translate(fd, libc.arg_at(argv, 2), 0, 1)
    if fd != sys.STDIN { libc.close(fd) }
    libc.exit(0)
  }

  if argc < 3 {
    libc.error_line("tr: two sets are required")
    libc.exit(1)
  }
  let to: u64 = libc.arg_at(argv, 2)
  if libc.strlen(to) == 0 {
    libc.error_line("tr: the second set is empty")
    libc.exit(1)
  }
  let fd: u64 = input_from(argc, argv, 3)
  if fd == 0xFFFFFFFFFFFFFFFF { libc.exit(1) }
  translate(fd, libc.arg_at(argv, 1), to, 0)
  if fd != sys.STDIN { libc.close(fd) }
  libc.exit(0)
}
