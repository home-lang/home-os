// printf — write the arguments under the control of a format.
//
// %s, %d, %i, %c and %% ; the escapes \n \t \r \\ \0. An unknown conversion
// is written through literally rather than swallowed, because output that
// silently disappears is the hardest kind of bug to see.

import "../lib/libc.home" as libc
import "../lib/sys.home" as sys

export fn _start(argc: u64, argv: u64): never {
  if argc < 2 {
    libc.error_line("printf: a format is required")
    libc.exit(1)
  }
  let fmt: u64 = libc.arg_at(argv, 1)
  let n: u32 = libc.strlen(fmt)
  var next: u32 = 2
  var i: u32 = 0

  while i < n {
    let c: u8 = @as(*u8, @ptrFromInt(fmt + @as(u64, i))).*

    if c == 92 and (i + 1) < n {
      let e: u8 = @as(*u8, @ptrFromInt(fmt + @as(u64, i + 1))).*
      if e == 110 {
        libc.putc(10)
        i = i + 2
        continue
      }
      if e == 116 {
        libc.putc(9)
        i = i + 2
        continue
      }
      if e == 114 {
        libc.putc(13)
        i = i + 2
        continue
      }
      if e == 92 {
        libc.putc(92)
        i = i + 2
        continue
      }
      if e == 48 {
        i = i + 2
        continue
      }
      libc.putc(c)
      i = i + 1
      continue
    }

    if c == 37 and (i + 1) < n {
      let f: u8 = @as(*u8, @ptrFromInt(fmt + @as(u64, i + 1))).*
      if f == 37 {
        libc.putc(37)
        i = i + 2
        continue
      }
      if f == 115 {
        if next < @as(u32, argc) { libc.puts(libc.arg_at(argv, next)) }
        next = next + 1
        i = i + 2
        continue
      }
      if f == 100 or f == 105 {
        if next < @as(u32, argc) {
          let v: u64 = libc.parse_u64(libc.arg_at(argv, next))
          if v == 0xFFFFFFFFFFFFFFFF { libc.put_u64(0) } else { libc.put_u64(v) }
        }
        next = next + 1
        i = i + 2
        continue
      }
      if f == 99 {
        if next < @as(u32, argc) {
          libc.putc(@as(*u8, @ptrFromInt(libc.arg_at(argv, next))).*)
        }
        next = next + 1
        i = i + 2
        continue
      }
      libc.putc(c)
      i = i + 1
      continue
    }

    libc.putc(c)
    i = i + 1
  }
  libc.exit(0)
}
