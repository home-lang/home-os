// base64 — encode to RFC 4648 base64, or decode with -d.
//
// Encoding pads with '=' so the output round-trips through any decoder; the
// decoder ignores newlines, since encoders wrap.

import "../lib/libc.home" as libc
import "../lib/sys.home" as sys

var alphabet: [u8; 65] = undefined

fn init_alphabet() {
  var i: u32 = 0
  while i < 26 {
    alphabet[i] = @as(u8, 65 + @as(u8, @truncate(i)))
    i = i + 1
  }
  while i < 52 {
    alphabet[i] = @as(u8, 97 + @as(u8, @truncate(i - 26)))
    i = i + 1
  }
  while i < 62 {
    alphabet[i] = @as(u8, 48 + @as(u8, @truncate(i - 52)))
    i = i + 1
  }
  alphabet[62] = 43   // '+'
  alphabet[63] = 47   // '/'
  alphabet[64] = 0
}

fn value_of(c: u8): u32 {
  if c >= 65 and c <= 90 { return @as(u32, c - 65) }
  if c >= 97 and c <= 122 { return @as(u32, c - 97) + 26 }
  if c >= 48 and c <= 57 { return @as(u32, c - 48) + 52 }
  if c == 43 { return 62 }
  if c == 47 { return 63 }
  return 0xFFFFFFFF
}

fn encode(fd: u64) {
  var acc: u32 = 0
  var bits: u32 = 0
  loop {
    let got: u64 = sys.sys_read(fd, libc.read_buffer_addr(),
                                @as(u64, libc.read_buffer_size()))
    if got == 0 or got > @as(u64, libc.read_buffer_size()) { break }
    var i: u64 = 0
    while i < got {
      acc = (acc << 8) | @as(u32, @as(*u8, @ptrFromInt(libc.read_buffer_addr() + i)).*)
      bits = bits + 8
      while bits >= 6 {
        bits = bits - 6
        libc.putc(alphabet[(acc >> bits) & 63])
      }
      i = i + 1
    }
  }
  if bits > 0 {
    // The remaining bits are left-aligned in the final sextet.
    libc.putc(alphabet[(acc << (6 - bits)) & 63])
    if bits == 2 {
      libc.putc(61)
      libc.putc(61)
    } else {
      libc.putc(61)
    }
  }
  libc.putc(10)
}

fn decode(fd: u64) {
  var acc: u32 = 0
  var bits: u32 = 0
  loop {
    let got: u64 = sys.sys_read(fd, libc.read_buffer_addr(),
                                @as(u64, libc.read_buffer_size()))
    if got == 0 or got > @as(u64, libc.read_buffer_size()) { break }
    var i: u64 = 0
    while i < got {
      let c: u8 = @as(*u8, @ptrFromInt(libc.read_buffer_addr() + i)).*
      let v: u32 = value_of(c)
      if v != 0xFFFFFFFF {
        acc = (acc << 6) | v
        bits = bits + 6
        if bits >= 8 {
          bits = bits - 8
          libc.putc(@as(u8, @truncate((acc >> bits) & 255)))
        }
      }
      i = i + 1
    }
  }
}

export fn _start(argc: u64, argv: u64): never {
  init_alphabet()
  var decoding: u32 = 0
  var first: u32 = 1
  if argc >= 2 and libc.strcmp(libc.arg_at(argv, 1), "-d") == 0 {
    decoding = 1
    first = 2
  }

  var fd: u64 = sys.STDIN
  if @as(u32, argc) > first {
    let path: u64 = libc.arg_at(argv, first)
    fd = libc.open_read(path)
    if fd == 0 {
      libc.error_line(path)
      libc.exit(1)
    }
  }
  if decoding == 1 { decode(fd) } else { encode(fd) }
  if fd != sys.STDIN { libc.close(fd) }
  libc.exit(0)
}
