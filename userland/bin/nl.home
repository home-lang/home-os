// nl — number the lines, starting at one.

import "../lib/libc.home" as libc
import "../lib/sys.home" as sys

fn number_fd(fd: u64, start: u64): u64 {
  libc.line_reader_open(fd)
  var n: u64 = start
  loop {
    let length: u32 = libc.read_line(libc.line_buffer_addr(), libc.line_buffer_size())
    if length == 0xFFFFFFFF { return n }
    libc.put_u64(n)
    libc.putc(9)
    libc.write_bytes(libc.line_buffer_addr(), length)
    libc.putc(10)
    n = n + 1
  }
}

export fn _start(argc: u64, argv: u64): never {
  if argc <= 1 {
    number_fd(sys.STDIN, 1)
    libc.exit(0)
  }
  var status: u64 = 0
  var next: u64 = 1
  var i: u32 = 1
  while i < @as(u32, argc) {
    let path: u64 = libc.arg_at(argv, i)
    let fd: u64 = libc.open_read(path)
    if fd == 0 {
      libc.error_line(path)
      status = 1
    } else {
      // Numbering continues across files, which is what nl does when given
      // several — restarting at each would renumber the same line twice.
      next = number_fd(fd, next)
      libc.close(fd)
    }
    i = i + 1
  }
  libc.exit(status)
}
