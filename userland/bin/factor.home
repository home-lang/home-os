// factor — the prime factorisation of each number given.
//
// Trial division by 2 and then odd numbers, stopping at the square root: the
// numbers this is asked about fit in 64 bits, and a sieve would cost more to
// build than the division costs to run.

import "../lib/libc.home" as libc
import "../lib/sys.home" as sys

fn factor(n: u64) {
  libc.put_u64(n)
  libc.putc(58)

  if n < 2 {
    libc.putc(10)
    return
  }

  var value: u64 = n
  while value % 2 == 0 {
    libc.putc(32)
    libc.put_u64(2)
    value = value / 2
  }

  var d: u64 = 3
  // d*d <= value, written as division so a large d cannot overflow.
  while d <= value / d {
    while value % d == 0 {
      libc.putc(32)
      libc.put_u64(d)
      value = value / d
    }
    d = d + 2
  }

  // What is left is prime, unless everything divided out.
  if value > 1 {
    libc.putc(32)
    libc.put_u64(value)
  }
  libc.putc(10)
}

export fn _start(argc: u64, argv: u64): never {
  if argc < 2 {
    libc.error_line("factor: a number is required")
    libc.exit(1)
  }
  var status: u64 = 0
  var i: u32 = 1
  while i < @as(u32, argc) {
    let text: u64 = libc.arg_at(argv, i)
    let parsed: u64 = libc.parse_u64(text)
    if parsed == 0xFFFFFFFFFFFFFFFF {
      libc.error_line(text)
      status = 1
    } else {
      factor(parsed)
    }
    i = i + 1
  }
  libc.exit(status)
}
