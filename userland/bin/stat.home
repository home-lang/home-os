// stat — report what the filesystem knows about each named file.
//
// One line per file: the kind, the size, the link count and the octal mode.
// The point is that every one of those comes from the kernel rather than from
// this program: sys_stat used to leave the buffer untouched and report
// success, so a stat of a file that did not exist printed whatever the stack
// happened to hold.

import "../lib/libc.home" as libc
import "../lib/sys.home" as sys

var buf: [u8; 88] = undefined

fn field(offset: u64): u64 {
  return @as(*u64, @ptrFromInt(@intFromPtr(&buf) + offset)).*
}

fn put_octal(value: u64) {
  var digits: [u8; 8] = undefined
  var n: u32 = 0
  var v: u64 = value
  if v == 0 {
    libc.putc('0')
    return
  }
  while v != 0 and n < 8 {
    digits[n] = @truncate(48 + (v & 7), u8)
    v = v >> 3
    n = n + 1
  }
  while n > 0 {
    n = n - 1
    libc.putc(digits[n])
  }
}

fn kind_name(kind: u64): u64 {
  if kind == sys.KIND_DIRECTORY { return @intFromPtr("directory") }
  if kind == sys.KIND_SYMLINK { return @intFromPtr("symlink") }
  if kind == sys.KIND_DEVICE { return @intFromPtr("device") }
  return @intFromPtr("regular")
}

export fn _start(argc: u64, argv: u64): never {
  if argc < 2 {
    libc.error_line("stat: a file is required")
    libc.exit(1)
  }

  var status: u64 = 0
  var i: u32 = 1
  while i < @as(u32, argc) {
    let path: u64 = libc.arg_at(argv, i)

    // lstat, so that a symlink reports as one instead of reporting on the
    // file it points at. `stat -L` would be the other way round.
    if sys.sys_lstat(path, @intFromPtr(&buf)) != 0 {
      libc.error_line(path)
      status = 1
    } else {
      libc.puts(path)
      libc.puts(" ")
      libc.puts(kind_name(field(sys.ST_KIND)))
      libc.puts(" size=")
      libc.put_u64(field(sys.ST_SIZE))
      libc.puts(" links=")
      libc.put_u64(field(sys.ST_NLINK))
      libc.puts(" mode=")
      put_octal(field(sys.ST_MODE))
      libc.putc(10)
    }
    i = i + 1
  }
  libc.flush()
  libc.exit(status)
}
