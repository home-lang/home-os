// rev — reverse the characters of each line.

import "../lib/libc.home" as libc
import "../lib/sys.home" as sys

fn rev_fd(fd: u64) {
  libc.line_reader_open(fd)
  loop {
    let length: u32 = libc.read_line(libc.line_buffer_addr(), libc.line_buffer_size())
    if length == 0xFFFFFFFF { return }
    var i: u32 = length
    while i > 0 {
      i = i - 1
      libc.putc(@as(*u8, @ptrFromInt(libc.line_buffer_addr() + @as(u64, i))).*)
    }
    libc.putc(10)
  }
}

export fn _start(argc: u64, argv: u64): never {
  if argc <= 1 {
    rev_fd(sys.STDIN)
    libc.exit(0)
  }
  var status: u64 = 0
  var i: u32 = 1
  while i < @as(u32, argc) {
    let fd: u64 = libc.open_read(libc.arg_at(argv, i))
    if fd == 0 {
      libc.error_line(libc.arg_at(argv, i))
      status = 1
    } else {
      rev_fd(fd)
      libc.close(fd)
    }
    i = i + 1
  }
  libc.exit(status)
}
