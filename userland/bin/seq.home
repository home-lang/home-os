// seq — print a range of numbers, one per line.
//
// seq LAST, seq FIRST LAST. A descending range prints nothing, which is what
// seq does without an explicit negative increment.

import "../lib/libc.home" as libc

export fn _start(argc: u64, argv: u64): never {
  var first: u64 = 1
  var last: u64 = 0

  if argc == 2 {
    last = libc.parse_u64(libc.arg_at(argv, 1))
  } else {
    if argc >= 3 {
      first = libc.parse_u64(libc.arg_at(argv, 1))
      last = libc.parse_u64(libc.arg_at(argv, 2))
    } else {
      libc.exit(1)
    }
  }

  if first == 0xFFFFFFFFFFFFFFFF or last == 0xFFFFFFFFFFFFFFFF {
    libc.exit(1)
  }

  var n: u64 = first
  while n <= last {
    libc.put_u64(n)
    libc.putc(10)
    n = n + 1
  }
  libc.exit(0)
}
