// strings — the printable runs in a file, four characters or more.
//
// Printable means space through tilde. A run is ended by anything else, and a
// run shorter than the minimum is dropped rather than printed as noise.

import "../lib/libc.home" as libc
import "../lib/sys.home" as sys

var run: [u8; 256] = undefined

fn strings_fd(fd: u64, minimum: u32) {
  var held: u32 = 0
  loop {
    let got: u64 = sys.sys_read(fd, libc.read_buffer_addr(),
                                @as(u64, libc.read_buffer_size()))
    if got == 0 or got > @as(u64, libc.read_buffer_size()) { break }
    var i: u64 = 0
    while i < got {
      let c: u8 = @as(*u8, @ptrFromInt(libc.read_buffer_addr() + i)).*
      if c >= 32 and c <= 126 {
        if held < 256 {
          run[held] = c
          held = held + 1
        }
      } else {
        if held >= minimum {
          libc.write_bytes(@intFromPtr(&run), held)
          libc.putc(10)
        }
        held = 0
      }
      i = i + 1
    }
  }
  if held >= minimum {
    libc.write_bytes(@intFromPtr(&run), held)
    libc.putc(10)
  }
}

export fn _start(argc: u64, argv: u64): never {
  var minimum: u32 = 4
  var first: u32 = 1
  if argc >= 3 and libc.strcmp(libc.arg_at(argv, 1), "-n") == 0 {
    let parsed: u64 = libc.parse_u64(libc.arg_at(argv, 2))
    if parsed != 0xFFFFFFFFFFFFFFFF and parsed > 0 {
      minimum = @as(u32, parsed)
      first = 3
    }
  }
  if @as(u32, argc) <= first {
    strings_fd(sys.STDIN, minimum)
    libc.exit(0)
  }
  var status: u64 = 0
  var i: u32 = first
  while i < @as(u32, argc) {
    let path: u64 = libc.arg_at(argv, i)
    let fd: u64 = libc.open_read(path)
    if fd == 0 {
      libc.error_line(path)
      status = 1
    } else {
      strings_fd(fd, minimum)
      libc.close(fd)
    }
    i = i + 1
  }
  libc.exit(status)
}
