// basename — the last component of a path.

import "../lib/libc.home" as libc

export fn _start(argc: u64, argv: u64): never {
  if argc < 2 { libc.exit(1) }
  let path: u64 = libc.arg_at(argv, 1)
  let length: u32 = libc.strlen(path)

  // Trailing slashes are not part of the name: basename /usr/bin/ is "bin".
  var end: u32 = length
  while end > 1 {
    if @as(*u8, @ptrFromInt(path + @as(u64, end - 1))).* != 47 { break }
    end = end - 1
  }

  var start: u32 = 0
  var i: u32 = 0
  while i < end {
    if @as(*u8, @ptrFromInt(path + @as(u64, i))).* == 47 { start = i + 1 }
    i = i + 1
  }

  libc.write_bytes(path + @as(u64, start), end - start)
  libc.putc(10)
  libc.exit(0)
}
