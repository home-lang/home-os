// rm — remove each named file.
//
// A failure on one operand does not stop the rest: rm removes what it can and
// reports what it could not, so a wildcard that includes one unreadable name
// still does the rest of its work.

import "../lib/libc.home" as libc
import "../lib/sys.home" as sys

export fn _start(argc: u64, argv: u64): never {
  if argc < 2 {
    libc.error_line("rm: a file is required")
    libc.exit(1)
  }
  var status: u64 = 0
  var i: u32 = 1
  while i < @as(u32, argc) {
    let path: u64 = libc.arg_at(argv, i)
    if sys.sys_unlink(path) != 0 {
      libc.error_line(path)
      status = 1
    }
    i = i + 1
  }
  libc.exit(status)
}
