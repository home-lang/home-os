// ln — give a file a second name. -s makes that name a symlink instead.

import "../lib/libc.home" as libc
import "../lib/sys.home" as sys

export fn _start(argc: u64, argv: u64): never {
  var symbolic: u32 = 0
  var target: u64 = 0
  var linkpath: u64 = 0

  var a: u32 = 1
  while a < @as(u32, argc) {
    let arg: u64 = libc.arg_at(argv, a)
    if libc.strcmp(arg, @intFromPtr("-s")) == 0 {
      symbolic = 1
    } else if target == 0 {
      target = arg
    } else if linkpath == 0 {
      linkpath = arg
    }
    a = a + 1
  }

  if target == 0 or linkpath == 0 {
    libc.error_line("ln: a target and a link name are required")
    libc.exit(1)
  }

  var rc: u64 = 0
  if symbolic == 1 {
    rc = sys.sys_symlink(target, linkpath)
  } else {
    rc = sys.sys_link(target, linkpath)
  }
  if rc != 0 {
    libc.error_line(linkpath)
    libc.exit(1)
  }
  libc.exit(0)
}
