// tac — the lines of each file, last first.
//
// Cannot stream: the last line has to be seen before the first is printed.
// The store it uses is bounded, and input that overruns it is reported rather
// than silently truncated.

import "../lib/libc.home" as libc
import "../lib/sys.home" as sys

var too_big: [u8; 32] = undefined

fn init_messages() {
  // "tac: input too large"
  too_big[0] = 116
  too_big[1] = 97
  too_big[2] = 99
  too_big[3] = 58
  too_big[4] = 32
  too_big[5] = 105
  too_big[6] = 110
  too_big[7] = 112
  too_big[8] = 117
  too_big[9] = 116
  too_big[10] = 32
  too_big[11] = 116
  too_big[12] = 111
  too_big[13] = 111
  too_big[14] = 32
  too_big[15] = 98
  too_big[16] = 105
  too_big[17] = 103
  too_big[18] = 0
}

fn tac_fd(fd: u64): u64 {
  libc.store_reset()
  let fitted: u32 = libc.store_read_all(fd)
  var i: u32 = libc.store_lines()
  while i > 0 {
    i = i - 1
    libc.write_bytes(libc.store_line_addr(i), libc.store_line_length(i))
    libc.putc(10)
  }
  if fitted == 0 {
    libc.error_line(@intFromPtr(&too_big))
    return 1
  }
  return 0
}

export fn _start(argc: u64, argv: u64): never {
  init_messages()
  if argc <= 1 { libc.exit(tac_fd(sys.STDIN)) }

  var status: u64 = 0
  var i: u32 = 1
  while i < @as(u32, argc) {
    let fd: u64 = libc.open_read(libc.arg_at(argv, i))
    if fd == 0 {
      libc.error_line(libc.arg_at(argv, i))
      status = 1
    } else {
      if tac_fd(fd) != 0 { status = 1 }
      libc.close(fd)
    }
    i = i + 1
  }
  libc.exit(status)
}
