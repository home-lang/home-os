// tee — copy standard input to standard output and to each named file.

import "../lib/libc.home" as libc
import "../lib/sys.home" as sys

const MAX_FILES: u32 = 8
var files: [u64; 8] = undefined
var file_count: u32 = 0

export fn _start(argc: u64, argv: u64): never {
  var status: u64 = 0

  var i: u32 = 1
  while i < @as(u32, argc) {
    if file_count >= MAX_FILES { break }
    let fd: u64 = libc.open_write(libc.arg_at(argv, i))
    if fd == 0 {
      libc.error_line(libc.arg_at(argv, i))
      status = 1
    } else {
      files[file_count] = fd
      file_count = file_count + 1
    }
    i = i + 1
  }

  loop {
    let got: u64 = sys.sys_read(sys.STDIN, libc.read_buffer_addr(),
                                @as(u64, libc.read_buffer_size()))
    if got == 0 { break }
    if got > @as(u64, libc.read_buffer_size()) { break }
    libc.write_bytes(libc.read_buffer_addr(), @as(u32, got))
    var f: u32 = 0
    while f < file_count {
      if libc.write_all(files[f], libc.read_buffer_addr(), @as(u32, got)) == 0 {
        status = 1
      }
      f = f + 1
    }
  }

  var c: u32 = 0
  while c < file_count {
    libc.close(files[c])
    c = c + 1
  }
  libc.exit(status)
}
