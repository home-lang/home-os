// uniq — drop each line that repeats the one before it.
//
// Adjacent only, like POSIX uniq: it does not sort, and two identical lines
// with something between them both survive.

import "../lib/libc.home" as libc
import "../lib/sys.home" as sys

var previous: [u8; 1024] = undefined
var previous_length: u32 = 0
var have_previous: u32 = 0

fn same_as_previous(addr: u64, length: u32): u32 {
  if have_previous == 0 { return 0 }
  if length != previous_length { return 0 }
  var i: u32 = 0
  while i < length {
    if previous[i] != @as(*u8, @ptrFromInt(addr + @as(u64, i))).* { return 0 }
    i = i + 1
  }
  return 1
}

fn remember(addr: u64, length: u32) {
  var n: u32 = length
  if n > 1024 { n = 1024 }
  var i: u32 = 0
  while i < n {
    previous[i] = @as(*u8, @ptrFromInt(addr + @as(u64, i))).*
    i = i + 1
  }
  previous_length = n
  have_previous = 1
}

fn uniq_fd(fd: u64) {
  libc.line_reader_open(fd)
  loop {
    let length: u32 = libc.read_line(libc.line_buffer_addr(), libc.line_buffer_size())
    if length == 0xFFFFFFFF { return }
    if same_as_previous(libc.line_buffer_addr(), length) == 0 {
      libc.write_bytes(libc.line_buffer_addr(), length)
      libc.putc(10)
      remember(libc.line_buffer_addr(), length)
    }
  }
}

export fn _start(argc: u64, argv: u64): never {
  if argc <= 1 {
    uniq_fd(sys.STDIN)
    libc.exit(0)
  }
  let fd: u64 = libc.open_read(libc.arg_at(argv, 1))
  if fd == 0 {
    libc.error_line(libc.arg_at(argv, 1))
    libc.exit(1)
  }
  uniq_fd(fd)
  libc.close(fd)
  libc.exit(0)
}
