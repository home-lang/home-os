// forktest — prove that fork returns twice and that wait collects the child.
//
// The child does not run when it is created; it runs when the parent waits for
// it. So the ordering here is deliberate and is what the gate asserts: the
// parent prints first, then the child runs to completion inside the parent's
// wait, then the parent prints what it collected.
//
// A test that only printed from both sides would pass whether or not the two
// were separate. This writes to a variable on both sides of the fork and each
// side prints what it sees, so a child sharing the parent's memory would be
// visible as the wrong number.

import "../lib/libc.home" as libc
import "../lib/sys.home" as sys

var shared: u64 = 100

export fn _start(argc: u64, argv: u64): never {
  shared = 100

  let pid: u64 = sys.sys_fork()

  if pid == 0xFFFFFFFFFFFFFFFF {
    libc.puts("forktest: fork failed\n")
    libc.flush()
    libc.exit(1)
  }

  if pid == 0 {
    // The child. Its copy of `shared` starts at the parent's value and moves
    // independently of it.
    shared = shared + 11
    libc.puts("forktest child sees ")
    libc.put_u64(shared)
    libc.putc(10)
    libc.flush()
    libc.exit(7)
  }

  // The parent. It changes its own copy before waiting, so if the child were
  // sharing this memory the child's number would come out wrong.
  shared = shared + 1
  libc.puts("forktest parent sees ")
  libc.put_u64(shared)
  libc.putc(10)
  libc.flush()

  let status: u64 = sys.sys_wait(pid)

  libc.puts("forktest child exited ")
  libc.put_u64(status)
  libc.putc(10)
  libc.puts("forktest parent still sees ")
  libc.put_u64(shared)
  libc.putc(10)
  libc.flush()
  libc.exit(0)
}
