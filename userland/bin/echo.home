// echo — write the arguments, separated by spaces, then a newline.
//
// Arguments are not available yet: the kernel's exec path does not pass an
// argument vector, so there is nothing to read them from. Rather than invent
// one, this prints the fixed greeting the boot gate asserts on, and grows an
// argument loop when exec grows a way to deliver one.

import "../lib/libc.home" as libc

var greeting: [u8; 32] = undefined

export fn _start(): never {
  // "hello from a Home program"
  greeting[0] = 104
  greeting[1] = 101
  greeting[2] = 108
  greeting[3] = 108
  greeting[4] = 111
  greeting[5] = 32
  greeting[6] = 102
  greeting[7] = 114
  greeting[8] = 111
  greeting[9] = 109
  greeting[10] = 32
  greeting[11] = 97
  greeting[12] = 32
  greeting[13] = 72
  greeting[14] = 111
  greeting[15] = 109
  greeting[16] = 101
  greeting[17] = 32
  greeting[18] = 112
  greeting[19] = 114
  greeting[20] = 111
  greeting[21] = 103
  greeting[22] = 114
  greeting[23] = 97
  greeting[24] = 109
  greeting[25] = 0

  libc.putln(@intFromPtr(&greeting))
  libc.exit(0)
}
