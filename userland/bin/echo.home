// echo — write the arguments, separated by spaces, then a newline.
//
// argv[0] is the program's own name, so the arguments proper start at 1. A
// call with none prints an empty line, which is what echo does.

import "../lib/libc.home" as libc

export fn _start(argc: u64, argv: u64): never {
  var i: u32 = 1
  while i < @as(u32, argc) {
    if i > 1 { libc.putc(32) }
    libc.puts(libc.arg_at(argv, i))
    i = i + 1
  }
  libc.putc(10)
  libc.exit(0)
}
