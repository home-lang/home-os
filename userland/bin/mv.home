// mv — give a file a different name.
//
// This is the utility the stub register named: rename returned 0 without
// moving anything, so mv reported success on every call and left both the old
// name and the absent new one exactly as they were.

import "../lib/libc.home" as libc
import "../lib/sys.home" as sys

export fn _start(argc: u64, argv: u64): never {
  if argc < 3 {
    libc.error_line("mv: a source and a destination are required")
    libc.exit(1)
  }
  let src: u64 = libc.arg_at(argv, 1)
  let dst: u64 = libc.arg_at(argv, 2)
  if sys.sys_rename(src, dst) != 0 {
    libc.error_line(src)
    libc.exit(1)
  }
  libc.exit(0)
}
