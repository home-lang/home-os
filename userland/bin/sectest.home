// sectest — prove a seccomp filter binds where the syscalls actually are.
//
// The filter used to sit in the kernel's syscall table, which two dozen calls
// never reach: write, read, exit, fork, wait, kill, getpid and the rest are
// answered at the ring-3 entry point, because they need the caller's frame or
// address space. So a filter forbidding one of them forbade nothing
// (MASTER_PLAN §7, S18). This checks the half that was broken:
//
//   an allowed call still works    — the lines below are written, and write
//                                    is on the whitelist
//   a denied call is refused       — getpid is answered at the entry point
//                                    and is *not* on the whitelist
//   forking does not escape it     — the child asks for the same denied call
//                                    and reports what it got through its exit
//                                    status, which the parent prints
//
// The third is the one worth having: a filter a program sheds by forking is
// not a filter.

import "../lib/libc.home" as libc
import "../lib/sys.home" as sys

// -1, EPERM: what a refused call returns.
const EPERM: u64 = 0xFFFF_FFFF_FFFF_FFFF

// What the child exits with, so the parent can tell the two apart. Neither is
// 0 or 1: those are the statuses everything else uses, and a status that
// collides with "it worked" cannot say which happened.
const CHILD_DENIED: u64 = 7
const CHILD_ALLOWED: u64 = 8

// exit, fork, wait and write. Not getpid — that is the point.
var allowed: [u32; 4] = undefined

export fn _start(argc: u64, argv: u64): never {
  allowed[0] = 0   // exit
  allowed[1] = 1   // fork
  allowed[2] = 3   // write
  allowed[3] = 6   // wait

  if sys.sys_seccomp(@intFromPtr(&allowed), 4) != 0 {
    libc.puts("sectest: could not install a filter\n")
    libc.flush()
    libc.exit(1)
  }

  // write is whitelisted, so this arrives. If it does not, the filter denied
  // something it was told to allow and nothing below would be readable
  // anyway.
  libc.puts("sectest filter installed\n")

  let pid: u64 = sys.sys_getpid()
  if pid != EPERM {
    libc.puts("sectest: getpid was allowed through the filter\n")
    libc.flush()
    libc.exit(1)
  }
  libc.puts("sectest getpid refused by the filter\n")
  libc.flush()

  let child: u64 = sys.sys_fork()
  if child == 0 {
    if sys.sys_getpid() == EPERM {
      libc.exit(CHILD_DENIED)
    }
    libc.exit(CHILD_ALLOWED)
  }
  if child == EPERM {
    libc.puts("sectest: fork was refused, though it is whitelisted\n")
    libc.flush()
    libc.exit(1)
  }

  let status: u64 = sys.sys_wait(child)
  if status != CHILD_DENIED {
    libc.puts("sectest: the child escaped the filter, status ")
    libc.put_u64(status)
    libc.putc(10)
    libc.flush()
    libc.exit(1)
  }
  libc.puts("sectest child inherited the filter\n")
  libc.flush()
  libc.exit(0)
}
