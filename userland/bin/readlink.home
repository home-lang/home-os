// readlink — print what a symlink points at.
//
// Nothing is printed for a path that is not a symlink, and the exit status
// says so: readlink's answer is the target, and a file has none.

import "../lib/libc.home" as libc
import "../lib/sys.home" as sys

var target: [u8; 256] = undefined

export fn _start(argc: u64, argv: u64): never {
  if argc < 2 {
    libc.error_line("readlink: a path is required")
    libc.exit(1)
  }
  let path: u64 = libc.arg_at(argv, 1)
  let n: u64 = sys.sys_readlink(path, @intFromPtr(&target), 255)
  if n == 0 {
    libc.exit(1)
  }
  target[@as(u32, n)] = 0
  libc.putln(@intFromPtr(&target))
  libc.flush()
  libc.exit(0)
}
