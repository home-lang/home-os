// cat — write each file to standard output, in order.
//
// With no operands it copies standard input, which is what POSIX says and
// what makes it usable in a pipeline once there are pipes.

import "../lib/libc.home" as libc
import "../lib/sys.home" as sys

export fn _start(argc: u64, argv: u64): never {
  var status: u64 = 0

  if argc <= 1 {
    libc.copy_to_stdout(sys.STDIN)
    libc.exit(0)
  }

  var i: u32 = 1
  while i < @as(u32, argc) {
    let path: u64 = libc.arg_at(argv, i)
    let fd: u64 = libc.open_read(path)
    if fd == 0 {
      libc.error_line(path)
      status = 1
    } else {
      libc.copy_to_stdout(fd)
      libc.close(fd)
    }
    i = i + 1
  }
  libc.exit(status)
}
