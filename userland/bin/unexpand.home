// unexpand — turn runs of leading spaces back into tabs, every eight columns.
//
// Leading whitespace only, which is unexpand's default: converting spaces
// inside a line would change text that meant to be spaces.

import "../lib/libc.home" as libc
import "../lib/sys.home" as sys

fn unexpand_fd(fd: u64, stop: u32) {
  libc.line_reader_open(fd)
  loop {
    let length: u32 = libc.read_line(libc.line_buffer_addr(), libc.line_buffer_size())
    if length == 0xFFFFFFFF { return }
    let base: u64 = libc.line_buffer_addr()

    // Count the leading blanks, expanding any tab already there so the column
    // arithmetic is over columns and not over characters.
    var column: u32 = 0
    var i: u32 = 0
    while i < length {
      let c: u8 = @as(*u8, @ptrFromInt(base + @as(u64, i))).*
      if c == 32 {
        column = column + 1
      } else if c == 9 {
        column = column + (stop - (column % stop))
      } else {
        break
      }
      i = i + 1
    }

    var written: u32 = 0
    while written + stop <= column {
      libc.putc(9)
      written = written + stop
    }
    while written < column {
      libc.putc(32)
      written = written + 1
    }
    libc.write_bytes(base + @as(u64, i), length - i)
    libc.putc(10)
  }
}

export fn _start(argc: u64, argv: u64): never {
  if argc <= 1 {
    unexpand_fd(sys.STDIN, 8)
    libc.exit(0)
  }
  var status: u64 = 0
  var i: u32 = 1
  while i < @as(u32, argc) {
    let path: u64 = libc.arg_at(argv, i)
    let fd: u64 = libc.open_read(path)
    if fd == 0 {
      libc.error_line(path)
      status = 1
    } else {
      unexpand_fd(fd, 8)
      libc.close(fd)
    }
    i = i + 1
  }
  libc.exit(status)
}
