// od — an octal dump: the offset, then sixteen bytes a line as octal words.
//
// The default GNU format (-t o2, two-byte words, little-endian) so the output
// can be compared against a real od rather than only against itself.

import "../lib/libc.home" as libc
import "../lib/sys.home" as sys

var chunk: [u8; 16] = undefined

fn put_octal(value: u32, digits: u32) {
  var out: [u8; 8] = undefined
  var i: u32 = digits
  var v: u32 = value
  while i > 0 {
    i = i - 1
    out[i] = @as(u8, 48 + @as(u8, @truncate(v % 8)))
    v = v / 8
  }
  var k: u32 = 0
  while k < digits {
    libc.putc(out[k])
    k = k + 1
  }
}

fn od_fd(fd: u64) {
  var offset: u64 = 0
  var held: u32 = 0
  loop {
    let got: u64 = sys.sys_read(fd, libc.read_buffer_addr(),
                                @as(u64, libc.read_buffer_size()))
    if got == 0 or got > @as(u64, libc.read_buffer_size()) { break }
    var i: u64 = 0
    while i < got {
      chunk[held] = @as(*u8, @ptrFromInt(libc.read_buffer_addr() + i)).*
      held = held + 1
      if held == 16 {
        put_octal(@as(u32, @truncate(offset)), 7)
        var w: u32 = 0
        while w < 16 {
          libc.putc(32)
          // Little-endian pairs, which is what od prints on this machine.
          put_octal(@as(u32, chunk[w]) | (@as(u32, chunk[w + 1]) << 8), 6)
          w = w + 2
        }
        libc.putc(10)
        offset = offset + 16
        held = 0
      }
      i = i + 1
    }
  }

  if held > 0 {
    put_octal(@as(u32, @truncate(offset)), 7)
    // A short tail is padded with a zero byte, as od does when the last word
    // is incomplete.
    var p: u32 = held
    while p < 16 {
      chunk[p] = 0
      p = p + 1
    }
    var w: u32 = 0
    while w < held {
      libc.putc(32)
      put_octal(@as(u32, chunk[w]) | (@as(u32, chunk[w + 1]) << 8), 6)
      w = w + 2
    }
    libc.putc(10)
    offset = offset + @as(u64, held)
  }
  put_octal(@as(u32, @truncate(offset)), 7)
  libc.putc(10)
}

export fn _start(argc: u64, argv: u64): never {
  if argc <= 1 {
    od_fd(sys.STDIN)
    libc.exit(0)
  }
  var status: u64 = 0
  var i: u32 = 1
  while i < @as(u32, argc) {
    let path: u64 = libc.arg_at(argv, i)
    let fd: u64 = libc.open_read(path)
    if fd == 0 {
      libc.error_line(path)
      status = 1
    } else {
      od_fd(fd)
      libc.close(fd)
    }
    i = i + 1
  }
  libc.exit(status)
}
