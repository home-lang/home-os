// fold — break each line at a width, 80 columns by default.
//
// Breaks on the column, not on a word boundary: `-s` is not implemented, and
// pretending otherwise would silently produce different output.

import "../lib/libc.home" as libc
import "../lib/sys.home" as sys

fn fold_fd(fd: u64, width: u32) {
  libc.line_reader_open(fd)
  loop {
    let length: u32 = libc.read_line(libc.line_buffer_addr(), libc.line_buffer_size())
    if length == 0xFFFFFFFF { return }
    let base: u64 = libc.line_buffer_addr()
    if length == 0 {
      libc.putc(10)
      continue
    }
    var at: u32 = 0
    while at < length {
      var take: u32 = width
      if at + take > length { take = length - at }
      libc.write_bytes(base + @as(u64, at), take)
      libc.putc(10)
      at = at + take
    }
  }
}

export fn _start(argc: u64, argv: u64): never {
  var width: u32 = 80
  var first: u32 = 1

  if argc >= 3 and libc.strcmp(libc.arg_at(argv, 1), "-w") == 0 {
    let parsed: u64 = libc.parse_u64(libc.arg_at(argv, 2))
    if parsed != 0xFFFFFFFFFFFFFFFF and parsed > 0 {
      width = @as(u32, parsed)
      first = 3
    }
  }

  if @as(u32, argc) <= first {
    fold_fd(sys.STDIN, width)
    libc.exit(0)
  }
  var status: u64 = 0
  var i: u32 = first
  while i < @as(u32, argc) {
    let path: u64 = libc.arg_at(argv, i)
    let fd: u64 = libc.open_read(path)
    if fd == 0 {
      libc.error_line(path)
      status = 1
    } else {
      fold_fd(fd, width)
      libc.close(fd)
    }
    i = i + 1
  }
  libc.exit(status)
}
