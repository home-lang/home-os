// sum — a checksum and a block count for each file.
//
// The BSD algorithm: a 16-bit rotate-then-add over every byte, and the size
// in 1024-byte blocks rounded up. Named for what it is rather than left to
// look like a cryptographic digest, which it is not.

import "../lib/libc.home" as libc
import "../lib/sys.home" as sys

var buf: [u8; 512] = undefined

fn sum_fd(fd: u64) {
  var checksum: u32 = 0
  var total: u64 = 0
  loop {
    let got: u64 = sys.sys_read(fd, @intFromPtr(&buf), 512)
    if got == 0 or got > 512 { break }
    var i: u64 = 0
    while i < got {
      // Rotate right within 16 bits, then add the byte, then truncate.
      checksum = (checksum >> 1) | ((checksum & 1) << 15)
      checksum = (checksum + @as(u32, buf[@as(u32, i)])) & 0xFFFF
      i = i + 1
    }
    total = total + got
  }
  libc.put_u64(@as(u64, checksum))
  libc.putc(32)
  libc.put_u64((total + 1023) / 1024)
  libc.putc(10)
}

export fn _start(argc: u64, argv: u64): never {
  if argc <= 1 {
    sum_fd(sys.STDIN)
    libc.exit(0)
  }
  var status: u64 = 0
  var i: u32 = 1
  while i < @as(u32, argc) {
    let path: u64 = libc.arg_at(argv, i)
    let fd: u64 = libc.open_read(path)
    if fd == 0 {
      libc.error_line(path)
      status = 1
    } else {
      sum_fd(fd)
      libc.close(fd)
    }
    i = i + 1
  }
  libc.exit(status)
}
