// cksum — the POSIX CRC-32 of each file, with its length.
//
// The CRC the POSIX spec defines: a big-endian CRC-32 over the bytes followed
// by the length itself, which is what makes two files of different lengths
// and the same bytes differ.

import "../lib/libc.home" as libc
import "../lib/sys.home" as sys

const POLY: u32 = 0x04C11DB7

fn crc_byte(crc: u32, byte: u8): u32 {
  var c: u32 = crc ^ (@as(u32, byte) << 24)
  var bit: u32 = 0
  while bit < 8 {
    if (c & 0x80000000) != 0 {
      c = (c << 1) ^ POLY
    } else {
      c = c << 1
    }
    bit = bit + 1
  }
  return c
}

fn cksum_fd(fd: u64) {
  var crc: u32 = 0
  var total: u64 = 0
  loop {
    let got: u64 = sys.sys_read(fd, libc.read_buffer_addr(),
                                @as(u64, libc.read_buffer_size()))
    if got == 0 or got > @as(u64, libc.read_buffer_size()) { break }
    var i: u64 = 0
    while i < got {
      crc = crc_byte(crc, @as(*u8, @ptrFromInt(libc.read_buffer_addr() + i)).*)
      i = i + 1
    }
    total = total + got
  }

  // The length goes through the same CRC, least significant byte first, and
  // then the whole thing is complemented.
  var length: u64 = total
  while length > 0 {
    crc = crc_byte(crc, @as(u8, @truncate(length & 255)))
    length = length >> 8
  }
  crc = crc ^ 0xFFFFFFFF

  libc.put_u64(@as(u64, crc))
  libc.putc(32)
  libc.put_u64(total)
  libc.putc(10)
}

export fn _start(argc: u64, argv: u64): never {
  if argc <= 1 {
    cksum_fd(sys.STDIN)
    libc.exit(0)
  }
  var status: u64 = 0
  var i: u32 = 1
  while i < @as(u32, argc) {
    let path: u64 = libc.arg_at(argv, i)
    let fd: u64 = libc.open_read(path)
    if fd == 0 {
      libc.error_line(path)
      status = 1
    } else {
      cksum_fd(fd)
      libc.close(fd)
    }
    i = i + 1
  }
  libc.exit(status)
}
