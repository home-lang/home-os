// schedtest — prove two tasks interleave, not merely both run.
//
// A test where the parent prints twice and the child prints twice would pass
// whether the two ran together or one after the other. This alternates: each
// side prints one line and yields, so the output can only come out in this
// order if the CPU is actually changing hands between them.
//
//   sched A1   parent
//   sched B1   child
//   sched A2   parent
//   sched B2   child
//
// If yielding did nothing, the parent's lines would come out together and the
// child's after them, and the milestones — which are matched in order — would
// not line up.

import "../lib/libc.home" as libc
import "../lib/sys.home" as sys

fn say(tag: u64, n: u64) {
  libc.puts("sched ")
  libc.puts(tag)
  libc.put_u64(n)
  libc.putc(10)
  libc.flush()
}

export fn _start(argc: u64, argv: u64): never {
  let pid: u64 = sys.sys_fork()

  if pid == 0xFFFFFFFFFFFFFFFF {
    libc.puts("schedtest: fork failed\n")
    libc.flush()
    libc.exit(1)
  }

  if pid == 0 {
    // The child. It runs first at B1 because the parent yields to it.
    var i: u64 = 1
    while i <= 2 {
      say("B", i)
      sys.sys_yield()
      i = i + 1
    }
    libc.exit(3)
  }

  var i: u64 = 1
  while i <= 2 {
    say("A", i)
    sys.sys_yield()
    i = i + 1
  }

  let status: u64 = sys.sys_wait(pid)
  libc.puts("schedtest child exited ")
  libc.put_u64(status)
  libc.putc(10)
  libc.flush()
  libc.exit(0)
}
