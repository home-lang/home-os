// schedtest — prove two tasks interleave, not merely both run.
//
// A test where the parent prints twice and the child prints twice would pass
// whether the two ran together or one after the other. Each side prints a
// line and yields, so the lines can only come out mixed if the CPU is really
// changing hands.
//
// What this does *not* assert is which of them goes first. It used to: the
// milestones were A1, B1, A2, B2, in that order, because cooperative yields
// made the order a guarantee. Preemption (MASTER_PLAN §7, S13) takes that
// guarantee away — the timer can hand the CPU over between any two
// instructions, so B1 may well print before A1, and on the run that first
// showed this it did. An order the scheduler does not promise is not a thing
// a test may require.
//
// So each side counts its own turns and reports the count, and the parent
// prints one line that says both ran. The interleaving is still visible in
// the log for a person reading it; what is *asserted* is what the scheduler
// actually owes: that both tasks made progress, and that the child's turns
// were its own.

import "../lib/libc.home" as libc
import "../lib/sys.home" as sys

fn say(tag: u64, n: u64) {
  libc.puts("sched ")
  libc.puts(tag)
  libc.put_u64(n)
  libc.putc(10)
  libc.flush()
}

export fn _start(argc: u64, argv: u64): never {
  let pid: u64 = sys.sys_fork()

  if pid == 0xFFFFFFFFFFFFFFFF {
    libc.puts("schedtest: fork failed\n")
    libc.flush()
    libc.exit(1)
  }

  if pid == 0 {
    // The child. Its exit status is the number of turns it took, so the
    // parent can check that it ran rather than assuming it did.
    var turns: u64 = 0
    var i: u64 = 1
    while i <= 2 {
      say("B", i)
      turns = turns + 1
      sys.sys_yield()
      i = i + 1
    }
    libc.exit(turns)
  }

  var mine: u64 = 0
  var i: u64 = 1
  while i <= 2 {
    say("A", i)
    mine = mine + 1
    sys.sys_yield()
    i = i + 1
  }

  let status: u64 = sys.sys_wait(pid)

  // One line, order-independent, and it names both counts: a parent that ran
  // alone reports the child at zero, and a child that never returned would
  // not be waited for at all.
  libc.puts("schedtest: parent ")
  libc.put_u64(mine)
  libc.puts(" turns, child ")
  libc.put_u64(status)
  libc.puts(" turns\n")
  libc.flush()
  libc.exit(0)
}
