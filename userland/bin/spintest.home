// spintest — hold the CPU without asking for it.
//
// A program that makes no system calls at all between its first line and its
// last. Under the cooperative scheduler this held the machine: nothing else
// ran until it chose to exit, because a task only ever gave up the CPU by
// asking to. It is here to be interrupted, and the kernel's preemption count
// is what says whether it was.
//
// The loop is long enough to cross many timer ticks and short enough to
// finish, because a test that never ends is not a test.

import "../lib/libc.home" as libc

export fn _start(argc: u64, argv: u64): never {
  libc.putln("spintest: spinning without a syscall")
  libc.flush()

  // Pure computation. No syscall, no memory the kernel touches, nothing that
  // could yield — the sum exists only so the loop cannot be optimised into
  // nothing.
  var sum: u64 = 0
  var i: u64 = 0
  while i < 40_000_000 {
    sum = sum + (i & 7)
    i = i + 1
  }

  libc.puts("spintest: done, sum ")
  libc.put_u64(sum)
  libc.putc(10)
  libc.flush()
  libc.exit(0)
}
