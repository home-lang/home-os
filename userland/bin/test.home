// test — evaluate an expression and say so in the exit status.
//
// Nothing is printed: a test that prints on success cannot be used in a
// script. `[` is the same program and requires a closing `]`.

import "../lib/libc.home" as libc
import "../lib/sys.home" as sys

fn exists(path: u64): u32 {
  let fd: u64 = libc.open_read(path)
  if fd == 0 { return 0 }
  libc.close(fd)
  return 1
}

export fn _start(argc: u64, argv: u64): never {
  var last: u32 = @as(u32, argc)

  // Invoked as `[`, the final argument must be `]` and is not part of the
  // expression.
  let name: u64 = libc.arg_at(argv, 0)
  if libc.strcmp(name, "[") == 0 or libc.strcmp(name, "/bin/[") == 0 {
    if last < 2 or libc.strcmp(libc.arg_at(argv, last - 1), "]") != 0 {
      libc.error_line("[: missing ]")
      libc.exit(2)
    }
    last = last - 1
  }

  let n: u32 = last - 1
  if n == 0 { libc.exit(1) }

  if n == 1 {
    if libc.strlen(libc.arg_at(argv, 1)) == 0 { libc.exit(1) }
    libc.exit(0)
  }

  if n == 2 {
    let op: u64 = libc.arg_at(argv, 1)
    let target: u64 = libc.arg_at(argv, 2)
    if libc.strcmp(op, "-z") == 0 {
      if libc.strlen(target) == 0 { libc.exit(0) }
      libc.exit(1)
    }
    if libc.strcmp(op, "-n") == 0 {
      if libc.strlen(target) == 0 { libc.exit(1) }
      libc.exit(0)
    }
    if libc.strcmp(op, "-e") == 0 or libc.strcmp(op, "-f") == 0 or libc.strcmp(op, "-r") == 0 {
      if exists(target) == 1 { libc.exit(0) }
      libc.exit(1)
    }
    if libc.strcmp(op, "!") == 0 {
      if libc.strlen(target) == 0 { libc.exit(0) }
      libc.exit(1)
    }
    libc.exit(2)
  }

  if n == 3 {
    let lhs: u64 = libc.arg_at(argv, 1)
    let op: u64 = libc.arg_at(argv, 2)
    let rhs: u64 = libc.arg_at(argv, 3)

    if libc.strcmp(op, "=") == 0 {
      if libc.strcmp(lhs, rhs) == 0 { libc.exit(0) }
      libc.exit(1)
    }
    if libc.strcmp(op, "!=") == 0 {
      if libc.strcmp(lhs, rhs) == 0 { libc.exit(1) }
      libc.exit(0)
    }

    let a: u64 = libc.parse_u64(lhs)
    let b: u64 = libc.parse_u64(rhs)
    if a == 0xFFFFFFFFFFFFFFFF or b == 0xFFFFFFFFFFFFFFFF { libc.exit(2) }

    if libc.strcmp(op, "-eq") == 0 {
      if a == b { libc.exit(0) }
      libc.exit(1)
    }
    if libc.strcmp(op, "-ne") == 0 {
      if a != b { libc.exit(0) }
      libc.exit(1)
    }
    if libc.strcmp(op, "-lt") == 0 {
      if a < b { libc.exit(0) }
      libc.exit(1)
    }
    if libc.strcmp(op, "-le") == 0 {
      if a <= b { libc.exit(0) }
      libc.exit(1)
    }
    if libc.strcmp(op, "-gt") == 0 {
      if a > b { libc.exit(0) }
      libc.exit(1)
    }
    if libc.strcmp(op, "-ge") == 0 {
      if a >= b { libc.exit(0) }
      libc.exit(1)
    }
    libc.exit(2)
  }

  libc.exit(2)
}
