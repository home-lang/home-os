// comm — compare two sorted files line by line.
//
// Three columns: lines only in the first, lines only in the second, and lines
// in both, each indented by the number of columns before it. -1, -2 and -3
// suppress a column.

import "../lib/libc.home" as libc
import "../lib/sys.home" as sys

const MAX_LINES: u32 = 256
var a_text: [u8; 8192] = undefined
var a_off: [u32; 256] = undefined
var a_len: [u32; 256] = undefined
var a_count: u32 = 0

fn load_a(fd: u64): u32 {
  a_count = 0
  var used: u32 = 0
  libc.line_reader_open(fd)
  loop {
    let length: u32 = libc.read_line(libc.line_buffer_addr(), libc.line_buffer_size())
    if length == 0xFFFFFFFF { return 1 }
    if a_count >= MAX_LINES or used + length > 8192 { return 0 }
    var k: u32 = 0
    while k < length {
      a_text[used + k] = @as(*u8, @ptrFromInt(libc.line_buffer_addr() + @as(u64, k))).*
      k = k + 1
    }
    a_off[a_count] = used
    a_len[a_count] = length
    used = used + length
    a_count = a_count + 1
  }
}

// Byte order, the order comm and sort agree on.
fn compare(ao: u32, al: u32, b: u64, bl: u32): i32 {
  var i: u32 = 0
  while i < al and i < bl {
    let x: u8 = a_text[ao + i]
    let y: u8 = @as(*u8, @ptrFromInt(b + @as(u64, i))).*
    if x < y { return -1 }
    if x > y { return 1 }
    i = i + 1
  }
  if al < bl { return -1 }
  if al > bl { return 1 }
  return 0
}

export fn _start(argc: u64, argv: u64): never {
  var show1: u32 = 1
  var show2: u32 = 1
  var show3: u32 = 1
  var first: u32 = 1

  while first < @as(u32, argc) {
    let opt: u64 = libc.arg_at(argv, first)
    if libc.strcmp(opt, "-1") == 0 {
      show1 = 0
      first = first + 1
    } else if libc.strcmp(opt, "-2") == 0 {
      show2 = 0
      first = first + 1
    } else if libc.strcmp(opt, "-3") == 0 {
      show3 = 0
      first = first + 1
    } else {
      break
    }
  }

  if first + 1 >= @as(u32, argc) {
    libc.error_line("comm: two files are required")
    libc.exit(1)
  }

  let pa: u64 = libc.arg_at(argv, first)
  let pb: u64 = libc.arg_at(argv, first + 1)
  let fa: u64 = libc.open_read(pa)
  if fa == 0 {
    libc.error_line(pa)
    libc.exit(1)
  }
  if load_a(fa) == 0 {
    libc.error_line("comm: first file too large to hold")
    libc.exit(1)
  }
  libc.close(fa)

  let fb: u64 = libc.open_read(pb)
  if fb == 0 {
    libc.error_line(pb)
    libc.exit(1)
  }

  var ai: u32 = 0
  libc.line_reader_open(fb)
  loop {
    let blen: u32 = libc.read_line(libc.line_buffer_addr(), libc.line_buffer_size())
    if blen == 0xFFFFFFFF { break }
    let b: u64 = libc.line_buffer_addr()

    // Every remaining line of the first file that sorts before this one is
    // unique to it.
    while ai < a_count and compare(a_off[ai], a_len[ai], b, blen) < 0 {
      if show1 == 1 {
        libc.write_bytes(@intFromPtr(&a_text) + @as(u64, a_off[ai]), a_len[ai])
        libc.putc(10)
      }
      ai = ai + 1
    }

    if ai < a_count and compare(a_off[ai], a_len[ai], b, blen) == 0 {
      if show3 == 1 {
        if show1 == 1 { libc.putc(9) }
        if show2 == 1 { libc.putc(9) }
        libc.write_bytes(b, blen)
        libc.putc(10)
      }
      ai = ai + 1
    } else {
      if show2 == 1 {
        if show1 == 1 { libc.putc(9) }
        libc.write_bytes(b, blen)
        libc.putc(10)
      }
    }
  }
  libc.close(fb)

  while ai < a_count {
    if show1 == 1 {
      libc.write_bytes(@intFromPtr(&a_text) + @as(u64, a_off[ai]), a_len[ai])
      libc.putc(10)
    }
    ai = ai + 1
  }
  libc.exit(0)
}
