// wc — count lines, words and bytes.
//
// A word is a run of non-whitespace, so the count increments on each
// transition into one. Counting separators instead gets the answer wrong for
// leading, trailing and repeated whitespace, which is most real input.

import "../lib/libc.home" as libc
import "../lib/sys.home" as sys

fn is_space(c: u8): u32 {
  if c == 32 or c == 9 or c == 10 or c == 13 { return 1 }
  return 0
}

fn count_fd(fd: u64) {
  var lines: u64 = 0
  var words: u64 = 0
  var bytes: u64 = 0
  var in_word: u32 = 0

  loop {
    let got: u64 = sys.sys_read(fd, libc.read_buffer_addr(),
                                @as(u64, libc.read_buffer_size()))
    if got == 0 { break }
    if got > @as(u64, libc.read_buffer_size()) { break }
    var i: u32 = 0
    while i < @as(u32, got) {
      let c: u8 = @as(*u8, @ptrFromInt(libc.read_buffer_addr() + @as(u64, i))).*
      bytes = bytes + 1
      if c == 10 { lines = lines + 1 }
      if is_space(c) == 1 {
        in_word = 0
      } else {
        if in_word == 0 {
          words = words + 1
          in_word = 1
        }
      }
      i = i + 1
    }
  }

  libc.put_u64(lines)
  libc.putc(32)
  libc.put_u64(words)
  libc.putc(32)
  libc.put_u64(bytes)
  libc.putc(10)
}

export fn _start(argc: u64, argv: u64): never {
  if argc <= 1 {
    count_fd(sys.STDIN)
    libc.exit(0)
  }
  var status: u64 = 0
  var i: u32 = 1
  while i < @as(u32, argc) {
    let path: u64 = libc.arg_at(argv, i)
    let fd: u64 = libc.open_read(path)
    if fd == 0 {
      libc.error_line(path)
      status = 1
    } else {
      count_fd(fd)
      libc.close(fd)
    }
    i = i + 1
  }
  libc.exit(status)
}
