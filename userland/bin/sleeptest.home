// sleeptest — check that sleeping takes time, measured by a clock that moves.
//
// Both halves of this were stubs until preemption existed. nanosleep returned
// 0 at once, so a program pacing itself with it became a busy loop that looked
// correct; and CLOCK_MONOTONIC read a variable nothing advanced, so an
// interval measured with it was always zero. Either one alone would make this
// test pass vacuously, which is why it asserts the *relationship* between
// them: the clock must move by at least as much as the sleep asked for.

import "../lib/libc.home" as libc
import "../lib/sys.home" as sys

var before: [u64; 2] = undefined
var after: [u64; 2] = undefined
var req: [u64; 2] = undefined

fn millis(buf: u64): u64 {
  let sec: u64 = @as(*u64, @ptrFromInt(buf)).*
  let nsec: u64 = @as(*u64, @ptrFromInt(buf + 8)).*
  return sec * 1000 + nsec / 1_000_000
}

export fn _start(argc: u64, argv: u64): never {
  // The clock has to move on its own before it can measure anything. Read it
  // twice around a sleep and it would move even if the sleep did nothing —
  // so this first check is that it is a clock at all.
  if sys.sys_clock_gettime(sys.CLOCK_MONOTONIC, @intFromPtr(&before)) != 0 {
    libc.putln("sleeptest: clock_gettime failed")
    libc.flush()
    libc.exit(1)
  }

  req[0] = 0
  req[1] = 60_000_000        // 60ms, comfortably more than one timer tick
  if sys.sys_nanosleep(@intFromPtr(&req), 0) != 0 {
    libc.putln("sleeptest: nanosleep failed")
    libc.flush()
    libc.exit(1)
  }

  if sys.sys_clock_gettime(sys.CLOCK_MONOTONIC, @intFromPtr(&after)) != 0 {
    libc.putln("sleeptest: clock_gettime failed")
    libc.flush()
    libc.exit(1)
  }

  let elapsed: u64 = millis(@intFromPtr(&after)) - millis(@intFromPtr(&before))

  // At least as long as asked. A sleep that returns early is the failure this
  // is here to catch, and an upper bound is not asserted: the machine is
  // allowed to be busy, and a test that fails because something else ran is
  // a test that fails for being right.
  if elapsed >= 60 {
    libc.puts("sleeptest: slept ")
    libc.put_u64(elapsed)
    libc.puts("ms for 60ms asked\n")
    libc.putln("sleeptest: the clock moved and the sleep waited")
    libc.flush()
    libc.exit(0)
  }

  libc.puts("sleeptest: only ")
  libc.put_u64(elapsed)
  libc.puts("ms elapsed for 60ms asked\n")
  libc.flush()
  libc.exit(1)
}
