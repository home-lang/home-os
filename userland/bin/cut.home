// cut — select fields of each line, separated by a single character.
//
// `-f LIST` with `-d DELIM`; the default delimiter is a tab, as POSIX says.
// A line with no delimiter is printed whole, which is what cut does rather
// than dropping it.

import "../lib/libc.home" as libc
import "../lib/sys.home" as sys

// Field numbers are one-based and given as a comma-separated list.
var wanted: [u8; 64] = undefined
var wanted_count: u32 = 0

fn want_field(n: u32): u32 {
  var i: u32 = 0
  while i < wanted_count {
    if @as(u32, wanted[i]) == n { return 1 }
    i = i + 1
  }
  return 0
}

fn parse_fields(spec: u64) {
  wanted_count = 0
  var value: u32 = 0
  var have: u32 = 0
  var i: u32 = 0
  while i < 256 {
    let c: u8 = @as(*u8, @ptrFromInt(spec + @as(u64, i))).*
    if c == 0 or c == 44 {
      if have == 1 and wanted_count < 64 {
        wanted[wanted_count] = @as(u8, @truncate(value))
        wanted_count = wanted_count + 1
      }
      value = 0
      have = 0
      if c == 0 { return }
    } else if c >= 48 and c <= 57 {
      value = value * 10 + @as(u32, c - 48)
      have = 1
    }
    i = i + 1
  }
}

fn cut_fd(fd: u64, delim: u8) {
  libc.line_reader_open(fd)
  loop {
    let length: u32 = libc.read_line(libc.line_buffer_addr(), libc.line_buffer_size())
    if length == 0xFFFFFFFF { return }
    let base: u64 = libc.line_buffer_addr()

    // A line without the delimiter has one field, and cut passes it through.
    var has: u32 = 0
    var scan: u32 = 0
    while scan < length {
      if @as(*u8, @ptrFromInt(base + @as(u64, scan))).* == delim { has = 1 }
      scan = scan + 1
    }
    if has == 0 {
      libc.write_bytes(base, length)
      libc.putc(10)
      continue
    }

    var field: u32 = 1
    var start: u32 = 0
    var i: u32 = 0
    var printed: u32 = 0
    while i <= length {
      let at_end: u32 = if i == length { 1 } else { 0 }
      var is_delim: u32 = 0
      if at_end == 0 {
        if @as(*u8, @ptrFromInt(base + @as(u64, i))).* == delim { is_delim = 1 }
      }
      if is_delim == 1 or at_end == 1 {
        if want_field(field) == 1 {
          if printed == 1 { libc.putc(delim) }
          libc.write_bytes(base + @as(u64, start), i - start)
          printed = 1
        }
        field = field + 1
        start = i + 1
      }
      i = i + 1
    }
    libc.putc(10)
  }
}

export fn _start(argc: u64, argv: u64): never {
  var delim: u8 = 9
  var i: u32 = 1
  var have_fields: u32 = 0

  while i + 1 < @as(u32, argc) {
    let opt: u64 = libc.arg_at(argv, i)
    if libc.strcmp(opt, "-d") == 0 {
      delim = @as(*u8, @ptrFromInt(libc.arg_at(argv, i + 1))).*
      i = i + 2
    } else if libc.strcmp(opt, "-f") == 0 {
      parse_fields(libc.arg_at(argv, i + 1))
      have_fields = 1
      i = i + 2
    } else {
      break
    }
  }

  if have_fields == 0 {
    libc.error_line("cut: -f is required")
    libc.exit(1)
  }

  if i >= @as(u32, argc) {
    cut_fd(sys.STDIN, delim)
    libc.exit(0)
  }

  var status: u64 = 0
  while i < @as(u32, argc) {
    let path: u64 = libc.arg_at(argv, i)
    let fd: u64 = libc.open_read(path)
    if fd == 0 {
      libc.error_line(path)
      status = 1
    } else {
      cut_fd(fd, delim)
      libc.close(fd)
    }
    i = i + 1
  }
  libc.exit(status)
}
