// cmp — report the first byte at which two files differ.
//
// Silent when they match, as POSIX requires: a comparison that prints on
// success cannot be used in a script.

import "../lib/libc.home" as libc
import "../lib/sys.home" as sys

var buf_a: [u8; 512] = undefined
var buf_b: [u8; 512] = undefined

export fn _start(argc: u64, argv: u64): never {
  if argc < 3 {
    libc.error_line("cmp: two files are required")
    libc.exit(2)
  }
  let pa: u64 = libc.arg_at(argv, 1)
  let pb: u64 = libc.arg_at(argv, 2)
  let fa: u64 = libc.open_read(pa)
  if fa == 0 {
    libc.error_line(pa)
    libc.exit(2)
  }
  let fb: u64 = libc.open_read(pb)
  if fb == 0 {
    libc.error_line(pb)
    libc.close(fa)
    libc.exit(2)
  }

  var offset: u64 = 0
  var line: u64 = 1
  loop {
    let ga: u64 = sys.sys_read(fa, @intFromPtr(&buf_a), 512)
    let gb: u64 = sys.sys_read(fb, @intFromPtr(&buf_b), 512)
    if ga > 512 or gb > 512 { break }

    var n: u64 = ga
    if gb < n { n = gb }
    var i: u64 = 0
    while i < n {
      let ca: u8 = buf_a[@as(u32, i)]
      let cb: u8 = buf_b[@as(u32, i)]
      if ca != cb {
        libc.puts(pa)
        libc.puts(" ")
        libc.puts(pb)
        libc.puts(" differ: byte ")
        libc.put_u64(offset + i + 1)
        libc.puts(", line ")
        libc.put_u64(line)
        libc.putc(10)
        libc.exit(1)
      }
      if ca == 10 { line = line + 1 }
      i = i + 1
    }

    if ga != gb {
      // The shorter file ended first.
      libc.puts("cmp: EOF on ")
      if ga < gb { libc.puts(pa) } else { libc.puts(pb) }
      libc.putc(10)
      libc.exit(1)
    }
    offset = offset + n
    if ga == 0 { break }
  }

  libc.close(fa)
  libc.close(fb)
  libc.exit(0)
}
