// expand — replace tabs with spaces to the next tab stop, every eight columns.
//
// To the next stop, not eight spaces each: a tab is a position, and replacing
// it with a fixed run misaligns every column after the first.

import "../lib/libc.home" as libc
import "../lib/sys.home" as sys

fn expand_fd(fd: u64, stop: u32) {
  libc.line_reader_open(fd)
  loop {
    let length: u32 = libc.read_line(libc.line_buffer_addr(), libc.line_buffer_size())
    if length == 0xFFFFFFFF { return }
    let base: u64 = libc.line_buffer_addr()
    var column: u32 = 0
    var i: u32 = 0
    while i < length {
      let c: u8 = @as(*u8, @ptrFromInt(base + @as(u64, i))).*
      if c == 9 {
        var pad: u32 = stop - (column % stop)
        var p: u32 = 0
        while p < pad {
          libc.putc(32)
          p = p + 1
        }
        column = column + pad
      } else {
        libc.putc(c)
        column = column + 1
      }
      i = i + 1
    }
    libc.putc(10)
  }
}

export fn _start(argc: u64, argv: u64): never {
  var stop: u32 = 8
  var first: u32 = 1
  if argc >= 3 and libc.strcmp(libc.arg_at(argv, 1), "-t") == 0 {
    let parsed: u64 = libc.parse_u64(libc.arg_at(argv, 2))
    if parsed != 0xFFFFFFFFFFFFFFFF and parsed > 0 {
      stop = @as(u32, parsed)
      first = 3
    }
  }
  if @as(u32, argc) <= first {
    expand_fd(sys.STDIN, stop)
    libc.exit(0)
  }
  var status: u64 = 0
  var i: u32 = first
  while i < @as(u32, argc) {
    let path: u64 = libc.arg_at(argv, i)
    let fd: u64 = libc.open_read(path)
    if fd == 0 {
      libc.error_line(path)
      status = 1
    } else {
      expand_fd(fd, stop)
      libc.close(fd)
    }
    i = i + 1
  }
  libc.exit(status)
}
