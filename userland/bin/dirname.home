// dirname — everything but the last component.
//
// A path with no slash is ".", and a path that is all slashes is "/".

import "../lib/libc.home" as libc

var dot: [u8; 2] = undefined
var slash: [u8; 2] = undefined

export fn _start(argc: u64, argv: u64): never {
  dot[0] = 46
  dot[1] = 0
  slash[0] = 47
  slash[1] = 0

  if argc < 2 { libc.exit(1) }
  let path: u64 = libc.arg_at(argv, 1)
  let length: u32 = libc.strlen(path)

  var end: u32 = length
  while end > 1 {
    if @as(*u8, @ptrFromInt(path + @as(u64, end - 1))).* != 47 { break }
    end = end - 1
  }

  var cut: u32 = 0xFFFFFFFF
  var i: u32 = 0
  while i < end {
    if @as(*u8, @ptrFromInt(path + @as(u64, i))).* == 47 { cut = i }
    i = i + 1
  }

  if cut == 0xFFFFFFFF {
    libc.putln(@intFromPtr(&dot))
    libc.exit(0)
  }
  if cut == 0 {
    libc.putln(@intFromPtr(&slash))
    libc.exit(0)
  }
  libc.write_bytes(path, cut)
  libc.putc(10)
  libc.exit(0)
}
