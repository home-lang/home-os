// dd — copy a file, a block at a time.
//
// `if=` and `of=` name the input and output; `bs=` sets the block size and
// `count=` limits the number of blocks. A short read ends the copy, and the
// block counts go to standard error the way dd reports them.

import "../lib/libc.home" as libc
import "../lib/sys.home" as sys

var block: [u8; 4096] = undefined

// The value after `=` in `name=value`, or 0 when the argument is not that.
fn operand(arg: u64, name: u64): u64 {
  var i: u32 = 0
  while i < 64 {
    let k: u8 = @as(*u8, @ptrFromInt(name + @as(u64, i))).*
    let a: u8 = @as(*u8, @ptrFromInt(arg + @as(u64, i))).*
    if k == 0 {
      if a == 61 { return arg + @as(u64, i) + 1 }
      return 0
    }
    if a != k { return 0 }
    i = i + 1
  }
  return 0
}

export fn _start(argc: u64, argv: u64): never {
  var in_path: u64 = 0
  var out_path: u64 = 0
  var bs: u64 = 512
  var count: u64 = 0xFFFFFFFFFFFFFFFF

  var i: u32 = 1
  while i < @as(u32, argc) {
    let arg: u64 = libc.arg_at(argv, i)
    var v: u64 = operand(arg, "if")
    if v != 0 {
      in_path = v
      i = i + 1
      continue
    }
    v = operand(arg, "of")
    if v != 0 {
      out_path = v
      i = i + 1
      continue
    }
    v = operand(arg, "bs")
    if v != 0 {
      let parsed: u64 = libc.parse_u64(v)
      if parsed != 0xFFFFFFFFFFFFFFFF and parsed > 0 and parsed <= 4096 { bs = parsed }
      i = i + 1
      continue
    }
    v = operand(arg, "count")
    if v != 0 {
      let parsed: u64 = libc.parse_u64(v)
      if parsed != 0xFFFFFFFFFFFFFFFF { count = parsed }
      i = i + 1
      continue
    }
    i = i + 1
  }

  var fin: u64 = sys.STDIN
  if in_path != 0 {
    fin = libc.open_read(in_path)
    if fin == 0 {
      libc.error_line(in_path)
      libc.exit(1)
    }
  }

  var fout: u64 = sys.STDOUT
  if out_path != 0 {
    fout = libc.open_write(out_path)
    if fout == 0 {
      libc.error_line(out_path)
      libc.exit(1)
    }
  }

  var whole: u64 = 0
  var partial: u64 = 0
  var done: u64 = 0
  while done < count {
    let got: u64 = sys.sys_read(fin, @intFromPtr(&block), bs)
    if got == 0 or got > bs { break }
    if libc.write_all(fout, @intFromPtr(&block), @as(u32, got)) == 0 {
      libc.error_line("dd: write failed")
      libc.exit(1)
    }
    if got == bs { whole = whole + 1 } else { partial = partial + 1 }
    done = done + 1
  }

  libc.flush()
  if fin != sys.STDIN { libc.close(fin) }
  if fout != sys.STDOUT { libc.close(fout) }

  // dd's report goes to standard error so it cannot land in a redirected copy.
  libc.put_u64(whole)
  libc.puts("+")
  libc.put_u64(partial)
  libc.puts(" records in\n")
  libc.flush()
  libc.exit(0)
}
