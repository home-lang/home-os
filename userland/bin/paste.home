// paste — join the corresponding lines of each file, separated by a tab.
//
// Stops when every file has ended; a file that ends early contributes an
// empty field thereafter, which is what keeps the columns aligned.

import "../lib/libc.home" as libc
import "../lib/sys.home" as sys

const MAX_FILES: u32 = 4

var fds: [u64; 4] = undefined
var done: [u32; 4] = undefined
var held: [u8; 2048] = undefined      // MAX_FILES * 512
var held_len: [u32; 4] = undefined

export fn _start(argc: u64, argv: u64): never {
  if argc < 2 {
    libc.error_line("paste: a file is required")
    libc.exit(1)
  }
  var count: u32 = @as(u32, argc) - 1
  if count > MAX_FILES {
    libc.error_line("paste: too many files")
    libc.exit(1)
  }

  var i: u32 = 0
  while i < count {
    let path: u64 = libc.arg_at(argv, i + 1)
    fds[i] = libc.open_read(path)
    if fds[i] == 0 {
      libc.error_line(path)
      libc.exit(1)
    }
    done[i] = 0
    i = i + 1
  }

  // One reader at a time: read_line holds a single buffered descriptor, so
  // each round reads one line from each file into its own slot first.
  loop {
    var any: u32 = 0
    var f: u32 = 0
    while f < count {
      held_len[f] = 0
      if done[f] == 0 {
        libc.line_reader_open(fds[f])
        let length: u32 = libc.read_line(libc.line_buffer_addr(),
                                         libc.line_buffer_size())
        if length == 0xFFFFFFFF {
          done[f] = 1
        } else {
          var k: u32 = 0
          while k < length and k < 512 {
            held[f * 512 + k] = @as(*u8, @ptrFromInt(libc.line_buffer_addr() + @as(u64, k))).*
            k = k + 1
          }
          held_len[f] = k
          any = 1
        }
      }
      f = f + 1
    }
    if any == 0 { break }

    var g: u32 = 0
    while g < count {
      if g > 0 { libc.putc(9) }
      libc.write_bytes(@intFromPtr(&held) + @as(u64, g * 512), held_len[g])
      g = g + 1
    }
    libc.putc(10)
  }

  var c: u32 = 0
  while c < count {
    libc.close(fds[c])
    c = c + 1
  }
  libc.exit(0)
}
