// sort — the lines of the input in byte order.
//
// A selection sort over the line index rather than over the text: the lines
// stay where they were read and only their order is chosen, so a long line
// costs no more to move than a short one. n^2 on a bounded store is
// bounded work, and the store is what limits the input, not the algorithm.

import "../lib/libc.home" as libc
import "../lib/sys.home" as sys

var order: [u32; 1024] = undefined
var too_big: [u8; 32] = undefined

fn init_messages() {
  too_big[0] = 115  // 's'
  too_big[1] = 111  // 'o'
  too_big[2] = 114  // 'r'
  too_big[3] = 116  // 't'
  too_big[4] = 58   // ':'
  too_big[5] = 32
  too_big[6] = 116  // 't'
  too_big[7] = 111  // 'o'
  too_big[8] = 111  // 'o'
  too_big[9] = 32
  too_big[10] = 98  // 'b'
  too_big[11] = 105 // 'i'
  too_big[12] = 103 // 'g'
  too_big[13] = 0
}

export fn _start(argc: u64, argv: u64): never {
  init_messages()
  libc.store_reset()

  var status: u64 = 0
  var fitted: u32 = 1
  if argc <= 1 {
    fitted = libc.store_read_all(sys.STDIN)
  } else {
    var i: u32 = 1
    while i < @as(u32, argc) {
      let fd: u64 = libc.open_read(libc.arg_at(argv, i))
      if fd == 0 {
        libc.error_line(libc.arg_at(argv, i))
        status = 1
      } else {
        if libc.store_read_all(fd) == 0 { fitted = 0 }
        libc.close(fd)
      }
      i = i + 1
    }
  }

  let count: u32 = libc.store_lines()
  var i: u32 = 0
  while i < count {
    order[i] = i
    i = i + 1
  }

  // Selection sort: for each position, find the smallest remaining line.
  var a: u32 = 0
  while a < count {
    var smallest: u32 = a
    var b: u32 = a + 1
    while b < count {
      if libc.store_line_less(order[b], order[smallest]) == 1 { smallest = b }
      b = b + 1
    }
    let swap: u32 = order[a]
    order[a] = order[smallest]
    order[smallest] = swap
    a = a + 1
  }

  i = 0
  while i < count {
    libc.write_bytes(libc.store_line_addr(order[i]), libc.store_line_length(order[i]))
    libc.putc(10)
    i = i + 1
  }

  if fitted == 0 {
    libc.error_line(@intFromPtr(&too_big))
    status = 1
  }
  libc.exit(status)
}
