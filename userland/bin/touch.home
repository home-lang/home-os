// touch — create each named file if it does not exist.
//
// Timestamps are not updated on a file that already exists: there is no clock
// syscall yet, and writing a fabricated time would be worse than leaving the
// old one. Creating is the half that can be done honestly.

import "../lib/libc.home" as libc
import "../lib/sys.home" as sys

export fn _start(argc: u64, argv: u64): never {
  if argc < 2 {
    libc.error_line("touch: a file is required")
    libc.exit(1)
  }
  var status: u64 = 0
  var i: u32 = 1
  while i < @as(u32, argc) {
    let path: u64 = libc.arg_at(argv, i)
    let fd: u64 = sys.sys_open(path, sys.O_WRONLY | sys.O_CREAT, 0o644)
    if fd == 0 {
      libc.error_line(path)
      status = 1
    } else {
      libc.close(fd)
    }
    i = i + 1
  }
  libc.exit(status)
}
