// split — break a file into pieces of a fixed number of lines.
//
// `-l N` sets the size, 1000 by default. Pieces are named by a prefix and two
// letters: xaa, xab, and so on. Running out of suffixes is an error rather
// than a wrap that would overwrite the first piece.

import "../lib/libc.home" as libc
import "../lib/sys.home" as sys

var name: [u8; 128] = undefined

fn build_name(prefix: u64, index: u32): u32 {
  if index >= 676 { return 0 }   // 26 * 26 two-letter suffixes
  var n: u32 = 0
  while n < 120 {
    let c: u8 = @as(*u8, @ptrFromInt(prefix + @as(u64, n))).*
    if c == 0 { break }
    name[n] = c
    n = n + 1
  }
  name[n] = @as(u8, 97 + @as(u8, @truncate(index / 26)))
  name[n + 1] = @as(u8, 97 + @as(u8, @truncate(index % 26)))
  name[n + 2] = 0
  return 1
}

export fn _start(argc: u64, argv: u64): never {
  var per: u64 = 1000
  var first: u32 = 1

  if argc >= 3 and libc.strcmp(libc.arg_at(argv, 1), "-l") == 0 {
    let parsed: u64 = libc.parse_u64(libc.arg_at(argv, 2))
    if parsed != 0xFFFFFFFFFFFFFFFF and parsed > 0 {
      per = parsed
      first = 3
    }
  }

  if @as(u32, argc) <= first {
    libc.error_line("split: a file is required")
    libc.exit(1)
  }

  let path: u64 = libc.arg_at(argv, first)
  let fd: u64 = libc.open_read(path)
  if fd == 0 {
    libc.error_line(path)
    libc.exit(1)
  }

  var prefix: u64 = @intFromPtr("x")
  if @as(u32, argc) > first + 1 { prefix = libc.arg_at(argv, first + 1) }

  libc.line_reader_open(fd)
  var piece: u32 = 0
  var out: u64 = 0
  var in_piece: u64 = 0

  loop {
    let length: u32 = libc.read_line(libc.line_buffer_addr(), libc.line_buffer_size())
    if length == 0xFFFFFFFF { break }

    if out == 0 or in_piece >= per {
      if out != 0 {
        libc.close(out)
        piece = piece + 1
      }
      if build_name(prefix, piece) == 0 {
        libc.error_line("split: too many pieces")
        libc.exit(1)
      }
      out = libc.open_write(@intFromPtr(&name))
      if out == 0 {
        libc.error_line(@intFromPtr(&name))
        libc.exit(1)
      }
      in_piece = 0
    }

    if libc.write_all(out, libc.line_buffer_addr(), length) == 0 {
      libc.error_line(@intFromPtr(&name))
      libc.exit(1)
    }
    var nl: [u8; 1] = undefined
    nl[0] = 10
    libc.write_all(out, @intFromPtr(&nl), 1)
    in_piece = in_piece + 1
  }

  if out != 0 { libc.close(out) }
  libc.close(fd)
  libc.exit(0)
}
