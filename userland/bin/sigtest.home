// sigtest — prove a signal handler actually runs, and that the interrupted
// code resumes afterwards.
//
// A test that only printed from the handler would pass even if the program
// never came back from it. This checks both halves:
//
//   the handler runs        — it prints, with the signal number it was given
//   the program resumes     — the line after the kill() prints afterwards
//   the interrupted call's
//   return value survives   — kill() returned 0 and that 0 is still there
//
// The last one is the reason sigreturn restores the whole frame rather than
// just the instruction pointer.

import "../lib/libc.home" as libc
import "../lib/sys.home" as sys

const SIGUSR1: u64 = 10

var handled: u64 = 0

fn on_signal(signum: u64) {
  handled = signum
  libc.puts("sigtest handler ran with ")
  libc.put_u64(signum)
  libc.putc(10)
  libc.flush()
}

export fn _start(argc: u64, argv: u64): never {
  if libc.signal(SIGUSR1, @intFromPtr(&on_signal)) != 0 {
    libc.puts("sigtest: could not install a handler\n")
    libc.flush()
    libc.exit(1)
  }

  // Task 0 is this program. Signalling itself delivers on the way back out of
  // this very syscall, which is the path being tested.
  let rc: u64 = sys.sys_kill(0, SIGUSR1)

  libc.puts("sigtest resumed, kill returned ")
  libc.put_u64(rc)
  libc.putc(10)
  libc.puts("sigtest handled ")
  libc.put_u64(handled)
  libc.putc(10)
  libc.flush()

  if handled != SIGUSR1 { libc.exit(1) }
  libc.exit(0)
}
