{
  "name": "home-os",
  "version": "0.1.0",
  "description": "A modern, minimal operating system built with Home, Craft, and Pantry",
  // System tooling the gates need. Install with `pantry install`.
  //
  // Zig is deliberately absent: it is used only as an assembler and linker
  // for freestanding targets, and its version must match the one the pinned
  // Home compiler was built with, so scripts/build.sh resolves it from the
  // Home toolchain rather than pinning a second, independently-drifting copy.
  "dependencies": {
    // Boots the kernel for the boot-qemu-x86_64 gate (scripts/boot-test.sh).
    "qemu.org": "^10.2.2"
  },
  // Repository information
  "repository": {
    "type": "git",
    "url": "https://github.com/home-lang/home-os"
  },
  // Build configuration. The entry is the Minimum Viable Kernel — the only
  // file that currently compiles end-to-end. The previous entry here was
  // kernel/src/kernel.zig, which has never existed in this tree.
  "build": {
    "entry": "kernel/src/mvk_poc.home",
    "output": "kernel/build",
    "linkerScript": "kernel/linker.ld"
  },
  // Environment variables for build
  // KERNEL_DIR defaults to <repo-root>/kernel; override via the env var.
  "env": {
    "KERNEL_DIR": "${KERNEL_DIR:-./kernel}",
    "ISO_DIR": "$KERNEL_DIR/iso",
    "BUILD_DIR": "$KERNEL_DIR/build"
  }
}
