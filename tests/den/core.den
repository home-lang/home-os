# Words, quoting and escapes.
printf "%s|%s|%s\n" a "b  c" d
printf "%s\n" 'single  quoted'
printf "%s\n" "double  quoted"
printf "a\tb\n"
# Variables.
GREETING=hello
NAME=world
printf "%s %s\n" $GREETING $NAME
printf "%s\n" "${GREETING}${NAME}"
printf "%s\n" "$GREETING there"
UNSET_ONE=
printf "[%s]\n" "$UNSET_ONE"
printf "[%s]\n" "$NEVER_SET_AT_ALL"
# Status and the operators that read it.
true && printf "%s\n" and-taken
false || printf "%s\n" or-taken
true || printf "%s\n" or-skipped
false && printf "%s\n" and-skipped
printf "%s\n" first ; printf "%s\n" second
# test, both spellings.
test 3 -lt 5 && printf "%s\n" lt-ok
test 5 -le 5 && printf "%s\n" le-ok
test abc = abc && printf "%s\n" streq-ok
test abc != abd && printf "%s\n" strne-ok
test -z "" && printf "%s\n" empty-ok
test -n x && printf "%s\n" nonempty-ok
[ 2 -gt 1 ] && printf "%s\n" bracket-ok
# Aliases.
alias say=printf
say "%s\n" alias-ok
unalias say
# Builtins that compute.
basename /usr/share/fonts/default.psf
dirname /usr/share/fonts/default.psf
basename /single
dirname /single
basename plain
dirname plain
# Exit status is observable.
false
printf "%s\n" "$?"
true
printf "%s\n" "$?"
