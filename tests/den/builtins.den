# eval re-reads its arguments as a command.
eval 'printf "%s\n" evaled'
# let: integer arithmetic, with multiplication binding tighter than addition.
let x = 2 + 3 * 4
printf "%s\n" $x
let y = 10 / 3
printf "%s\n" $y
let z = 7 - 2 - 3
printf "%s\n" $z
# command and builtin both drop their own name and run what follows.
command printf "%s\n" cmd-ok
builtin printf "%s\n" bi-ok
# declare sets a variable.
declare d=dv
printf "%s\n" $d
# type reports what a name is.
type echo
type printf
# Aliases are bypassed by command.
alias printf-alias=printf
type printf-alias
unalias printf-alias
# Assignment then reassignment.
v=one
printf "%s\n" $v
v=two
printf "%s\n" $v
# umask prints three octal digits.
umask
