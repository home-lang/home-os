// home-os Snake Game
// Classic snake game

import "../../kernel/src/core/foundation.home" as foundation
import "../../kernel/src/drivers/keyboard.home" as keyboard
import "../../kernel/src/drivers/timer.home" as timer

const GRID_WIDTH: u32 = 40
const GRID_HEIGHT: u32 = 20
const MAX_SNAKE_LENGTH: u32 = 800

struct Point {
  x: u32,
  y: u32
}

var snake: [Point; 800]
var snake_length: u32 = 3
var snake_dir_x: i32 = 1
var snake_dir_y: i32 = 0
var food: Point
var score: u32 = 0
var game_over: u32 = 0

// FIX R7 #1, #2: Complete Snake — xorshift PRNG for food, movement
// with wall + self-collision, growth on food pickup, and a draw
// routine that renders both the snake and the food. The previous
// `snake_update` just incremented the score and `snake_draw` only
// painted a grid of dots.

var snake_rng: u32 = 0x12345678
fn snake_rand(): u32 {
  var x: u32 = snake_rng
  x = x ^ (x << 13)
  x = x ^ (x >> 17)
  x = x ^ (x << 5)
  snake_rng = x
  return x
}

fn snake_place_food() {
  // Bound the rejection-sampling loop so a near-full board (rare but
  // possible when the snake gets long) doesn't lock up the game.
  // After MAX_TRIES random picks we fall back to a linear scan for
  // the first free cell, and if the board is genuinely full we just
  // park the food under the head — the player has already won.
  const MAX_TRIES: u32 = 64
  var tries: u32 = 0
  while tries < MAX_TRIES {
    var fx: u32 = snake_rand() % GRID_WIDTH
    var fy: u32 = snake_rand() % GRID_HEIGHT
    var on_snake: u32 = 0
    var i: u32 = 0
    while i < snake_length {
      if snake[i].x == fx and snake[i].y == fy {
        on_snake = 1
        break
      }
      i = i + 1
    }
    if on_snake == 0 {
      food.x = fx
      food.y = fy
      return
    }
    tries = tries + 1
  }

  var sy: u32 = 0
  while sy < GRID_HEIGHT {
    var sx: u32 = 0
    while sx < GRID_WIDTH {
      var occupied: u32 = 0
      var k: u32 = 0
      while k < snake_length {
        if snake[k].x == sx and snake[k].y == sy { occupied = 1; break }
        k = k + 1
      }
      if occupied == 0 {
        food.x = sx
        food.y = sy
        return
      }
      sx = sx + 1
    }
    sy = sy + 1
  }
  food.x = snake[0].x
  food.y = snake[0].y
}

fn snake_cell_at(x: u32, y: u32): u8 {
  if food.x == x and food.y == y { return '*' }
  var i: u32 = 0
  while i < snake_length {
    if snake[i].x == x and snake[i].y == y {
      if i == 0 { return '@' }
      return '#'
    }
    i = i + 1
  }
  return ' '
}

fn snake_draw() {
  foundation.vga_clear()
  foundation.vga_write_string("=== Snake Game ===\n")
  foundation.vga_write_string("Score: ")
  foundation.vga_write_u64(score)
  foundation.vga_write_string("  Length: ")
  foundation.vga_write_u64(@as(u64, snake_length))
  foundation.vga_write_string("\n")

  var b: u32 = 0
  while b < GRID_WIDTH + 2 { foundation.vga_write_char('-'); b = b + 1 }
  foundation.vga_write_char('\n')

  var y: u32 = 0
  while y < GRID_HEIGHT {
    foundation.vga_write_char('|')
    var x: u32 = 0
    while x < GRID_WIDTH {
      foundation.vga_write_char(snake_cell_at(x, y))
      x = x + 1
    }
    foundation.vga_write_char('|')
    foundation.vga_write_char('\n')
    y = y + 1
  }

  b = 0
  while b < GRID_WIDTH + 2 { foundation.vga_write_char('-'); b = b + 1 }
  foundation.vga_write_char('\n')

  if game_over == 1 {
    foundation.vga_write_string("\nGAME OVER!  (Q to quit)\n")
  } else {
    foundation.vga_write_string("(WASD to move, Q to quit)\n")
  }
}

fn snake_update() {
  if game_over == 1 { return }
  if snake_length == 0 { return }

  var head: Point = snake[0]
  var new_x: i32 = @as(i32, @intCast(head.x, i32)) + snake_dir_x
  var new_y: i32 = @as(i32, @intCast(head.y, i32)) + snake_dir_y

  if new_x < 0 or new_y < 0 or
     new_x >= @as(i32, @intCast(GRID_WIDTH, i32)) or
     new_y >= @as(i32, @intCast(GRID_HEIGHT, i32)) {
    game_over = 1
    return
  }

  var head_x: u32 = @intCast(new_x, u32)
  var head_y: u32 = @intCast(new_y, u32)

  // Self-collision (skip the tail that's about to move away).
  var i: u32 = 0
  while i + 1 < snake_length {
    if snake[i].x == head_x and snake[i].y == head_y {
      game_over = 1
      return
    }
    i = i + 1
  }

  var ate_food: u32 = 0
  if head_x == food.x and head_y == food.y {
    ate_food = 1
    score = score + 10
  }

  if ate_food == 1 and snake_length < MAX_SNAKE_LENGTH {
    var j: u32 = snake_length
    while j > 0 {
      snake[j] = snake[j - 1]
      j = j - 1
    }
    snake_length = snake_length + 1
  } else {
    var j: u32 = snake_length - 1
    while j > 0 {
      snake[j] = snake[j - 1]
      j = j - 1
    }
  }

  snake[0].x = head_x
  snake[0].y = head_y

  if ate_food == 1 { snake_place_food() }
}

export fn snake_main() {
  snake_rng = @truncate(timer.timer_get_ticks(), u32)
  if snake_rng == 0 { snake_rng = 0xDEADBEEF }

  snake_length = 3
  snake[0].x = GRID_WIDTH / 2 + 1
  snake[0].y = GRID_HEIGHT / 2
  snake[1].x = GRID_WIDTH / 2
  snake[1].y = GRID_HEIGHT / 2
  snake[2].x = GRID_WIDTH / 2 - 1
  snake[2].y = GRID_HEIGHT / 2
  snake_dir_x = 1
  snake_dir_y = 0
  score = 0
  game_over = 0
  snake_place_food()

  snake_draw()

  var running: u32 = 1
  while running == 1 {
    if game_over == 0 {
      snake_update()
    }
    snake_draw()

    timer.timer_delay_ms(100)

    if keyboard.keyboard_has_char() == 1 {
      var ch: u8 = keyboard.keyboard_getchar()
      if ch == 'q' or ch == 'Q' {
        running = 0
      } else if game_over == 0 {
        // 180° reversal is not allowed.
        if (ch == 'w' or ch == 'W') and snake_dir_y != 1 {
          snake_dir_x = 0
          snake_dir_y = -1
        } else if (ch == 's' or ch == 'S') and snake_dir_y != -1 {
          snake_dir_x = 0
          snake_dir_y = 1
        } else if (ch == 'a' or ch == 'A') and snake_dir_x != 1 {
          snake_dir_x = -1
          snake_dir_y = 0
        } else if (ch == 'd' or ch == 'D') and snake_dir_x != -1 {
          snake_dir_x = 1
          snake_dir_y = 0
        }
      }
    }
  }
}
