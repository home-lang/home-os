// home-os Pong Game
// Classic pong

import "../../kernel/src/core/foundation.home" as foundation
import "../../kernel/src/drivers/keyboard.home" as keyboard
import "../../kernel/src/drivers/vga_graphics.home" as vga

const SCREEN_WIDTH: u32 = 320
const SCREEN_HEIGHT: u32 = 200
const PADDLE_HEIGHT: u32 = 40
const PADDLE_WIDTH: u32 = 5
const BALL_SIZE: u32 = 5

// FIX R7 #3: Use signed `i32` for positions so bouncing off the left
// wall doesn't wrap through u32. Ball velocity already was i32 but
// adding to a u32 was undefined-leaning behavior.
var paddle1_y: i32 = 80
var paddle2_y: i32 = 80
var ball_x: i32 = 160
var ball_y: i32 = 100
var ball_dx: i32 = 2
var ball_dy: i32 = 2
var score1: u32 = 0
var score2: u32 = 0

fn pong_draw() {
  vga.vga_fill_screen(0)

  // Draw paddles (clamp to non-negative before the u32 cast).
  if paddle1_y >= 0 {
    vga.vga_draw_rect(10, @intCast(paddle1_y, u32), PADDLE_WIDTH, PADDLE_HEIGHT, 15)
  }
  if paddle2_y >= 0 {
    vga.vga_draw_rect(305, @intCast(paddle2_y, u32), PADDLE_WIDTH, PADDLE_HEIGHT, 15)
  }

  // Draw ball
  if ball_x >= 0 and ball_y >= 0 {
    vga.vga_draw_rect(@intCast(ball_x, u32), @intCast(ball_y, u32), BALL_SIZE, BALL_SIZE, 15)
  }

  // Draw center line
  var y: u32 = 0
  while y < SCREEN_HEIGHT {
    vga.vga_put_pixel(160, y, 8)
    y = y + 5
  }
}

fn pong_update() {
  // Move ball.
  ball_x = ball_x + ball_dx
  ball_y = ball_y + ball_dy

  // FIX R7 #4: Bounce off top/bottom in signed space.
  if ball_y <= 0 {
    ball_y = 0
    ball_dy = -ball_dy
  } else if ball_y >= @as(i32, @intCast(SCREEN_HEIGHT, i32)) - @as(i32, @intCast(BALL_SIZE, i32)) {
    ball_y = @as(i32, @intCast(SCREEN_HEIGHT, i32)) - @as(i32, @intCast(BALL_SIZE, i32))
    ball_dy = -ball_dy
  }

  // FIX R7 #5: Paddle collisions. Paddle 1 at x=10, paddle 2 at x=305.
  var p1_top: i32 = paddle1_y
  var p1_bot: i32 = paddle1_y + @as(i32, @intCast(PADDLE_HEIGHT, i32))
  var p2_top: i32 = paddle2_y
  var p2_bot: i32 = paddle2_y + @as(i32, @intCast(PADDLE_HEIGHT, i32))
  var ball_bot: i32 = ball_y + @as(i32, @intCast(BALL_SIZE, i32))

  if ball_dx < 0 and ball_x <= 10 + @as(i32, @intCast(PADDLE_WIDTH, i32)) and ball_x >= 10 {
    if ball_bot >= p1_top and ball_y <= p1_bot {
      ball_dx = -ball_dx
      ball_x = 10 + @as(i32, @intCast(PADDLE_WIDTH, i32))
    }
  }
  if ball_dx > 0 and ball_x + @as(i32, @intCast(BALL_SIZE, i32)) >= 305 and ball_x <= 305 + @as(i32, @intCast(PADDLE_WIDTH, i32)) {
    if ball_bot >= p2_top and ball_y <= p2_bot {
      ball_dx = -ball_dx
      ball_x = 305 - @as(i32, @intCast(BALL_SIZE, i32))
    }
  }

  // Score points (missed paddle).
  if ball_x <= 0 {
    score2 = score2 + 1
    ball_x = 160
    ball_y = 100
    ball_dx = 2
    ball_dy = 2
  }
  if ball_x >= @as(i32, @intCast(SCREEN_WIDTH, i32)) {
    score1 = score1 + 1
    ball_x = 160
    ball_y = 100
    ball_dx = -2
    ball_dy = 2
  }
}

export fn pong_main() {
  vga.vga_graphics_init()

  var running: u32 = 1
  while running == 1 {
    pong_update()
    pong_draw()

    if keyboard.keyboard_has_char() == 1 {
      var ch: u8 = keyboard.keyboard_getchar()
      if ch == 'q' or ch == 'Q' {
        running = 0
      } else if ch == 'w' or ch == 'W' {
        if paddle1_y > 0 {
          paddle1_y = paddle1_y - 5
        }
      } else if ch == 's' or ch == 'S' {
        if paddle1_y < @as(i32, @intCast(SCREEN_HEIGHT, i32)) - @as(i32, @intCast(PADDLE_HEIGHT, i32)) {
          paddle1_y = paddle1_y + 5
        }
      }
    }
  }
}
