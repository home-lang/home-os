// home-os Tetris Game
// Classic tetris

import "../../kernel/src/core/foundation.home" as foundation
import "../../kernel/src/drivers/keyboard.home" as keyboard
import "../../kernel/src/drivers/timer.home" as timer

const GRID_WIDTH: u32 = 10
const GRID_HEIGHT: u32 = 20

var grid: [[u8; 10]; 20]
var current_piece: [u8; 16]
var piece_x: i32 = 4
var piece_y: i32 = 0
var score: u32 = 0
var game_over: u32 = 0

// Functional Tetris core — spawn, drop with collision
// detection, lock into grid, clear complete lines, spawn again.
// Score is actually rendered.

const PIECE_SIZE: u32 = 4

// Seven standard tetrominoes as 4×4 bitmaps (MSB = top-left).
const TETROMINOES: [u16; 7] = [
  0x0F00,  // I
  0x0660,  // O
  0x0E40,  // T
  0x06C0,  // S
  0x0C60,  // Z
  0x08E0,  // J
  0x02E0   // L
]

var piece_shape: u16 = 0
var next_piece_id: u32 = 0

fn tetris_piece_collides(px: i32, py: i32, shape: u16): u32 {
  var r: u32 = 0
  while r < PIECE_SIZE {
    var c: u32 = 0
    while c < PIECE_SIZE {
      var bit: u16 = @as(u16, 0x8000) >> (r * 4 + c)
      if (shape & bit) != 0 {
        var gx: i32 = px + @as(i32, @intCast(c, i32))
        var gy: i32 = py + @as(i32, @intCast(r, i32))
        if gx < 0 or gx >= @as(i32, @intCast(GRID_WIDTH, i32)) { return 1 }
        if gy >= @as(i32, @intCast(GRID_HEIGHT, i32)) { return 1 }
        if gy >= 0 and grid[@intCast(gy, u32)][@intCast(gx, u32)] != 0 { return 1 }
      }
      c = c + 1
    }
    r = r + 1
  }
  return 0
}

fn tetris_spawn_piece() {
  piece_shape = TETROMINOES[next_piece_id]
  next_piece_id = (next_piece_id + 1) % 7
  piece_x = 3
  piece_y = 0
  if tetris_piece_collides(piece_x, piece_y, piece_shape) == 1 {
    game_over = 1
  }
}

fn tetris_lock_piece() {
  var r: u32 = 0
  while r < PIECE_SIZE {
    var c: u32 = 0
    while c < PIECE_SIZE {
      var bit: u16 = @as(u16, 0x8000) >> (r * 4 + c)
      if (piece_shape & bit) != 0 {
        var gx: i32 = piece_x + @as(i32, @intCast(c, i32))
        var gy: i32 = piece_y + @as(i32, @intCast(r, i32))
        if gx >= 0 and gy >= 0 and
           gx < @as(i32, @intCast(GRID_WIDTH, i32)) and
           gy < @as(i32, @intCast(GRID_HEIGHT, i32)) {
          grid[@intCast(gy, u32)][@intCast(gx, u32)] = 1
        }
      }
      c = c + 1
    }
    r = r + 1
  }
}

fn tetris_clear_lines(): u32 {
  var cleared: u32 = 0
  var y: i32 = @as(i32, @intCast(GRID_HEIGHT, i32)) - 1
  while y >= 0 {
    var yu: u32 = @intCast(y, u32)
    var full: u32 = 1
    var c: u32 = 0
    while c < GRID_WIDTH {
      if grid[yu][c] == 0 { full = 0; break }
      c = c + 1
    }
    if full == 1 {
      cleared = cleared + 1
      var ry: u32 = yu
      while ry > 0 {
        var rc: u32 = 0
        while rc < GRID_WIDTH {
          grid[ry][rc] = grid[ry - 1][rc]
          rc = rc + 1
        }
        ry = ry - 1
      }
      var tc: u32 = 0
      while tc < GRID_WIDTH { grid[0][tc] = 0; tc = tc + 1 }
      // Don't decrement y — the new row at this index needs to be rechecked.
    } else {
      y = y - 1
    }
  }
  return cleared
}

fn tetris_draw() {
  foundation.vga_clear()
  foundation.vga_write_string("=== Tetris ===\n")
  foundation.vga_write_string("Score: ")
  foundation.vga_write_u64(@as(u64, score))  //
  foundation.vga_write_string("\n\n")

  var y: u32 = 0
  while y < GRID_HEIGHT {
    foundation.vga_write_char('|')
    var x: u32 = 0
    while x < GRID_WIDTH {
      var filled: u32 = 0
      if grid[y][x] != 0 { filled = 1 }
      var px_in_piece: i32 = @as(i32, @intCast(x, i32)) - piece_x
      var py_in_piece: i32 = @as(i32, @intCast(y, i32)) - piece_y
      if px_in_piece >= 0 and px_in_piece < 4 and py_in_piece >= 0 and py_in_piece < 4 {
        var bit: u16 = @as(u16, 0x8000) >> (@intCast(py_in_piece, u32) * 4 + @intCast(px_in_piece, u32))
        if (piece_shape & bit) != 0 { filled = 1 }
      }
      if filled == 1 {
        foundation.vga_write_char('#')
      } else {
        foundation.vga_write_char(' ')
      }
      x = x + 1
    }
    foundation.vga_write_string("|\n")
    y = y + 1
  }

  foundation.vga_write_string("+----------+\n")
  foundation.vga_write_string("\nA/D=Move Space=Rotate Q=Quit\n")
}

export fn tetris_main() {
  score = 0
  game_over = 0
  next_piece_id = 0
  var gy: u32 = 0
  while gy < GRID_HEIGHT {
    var gx: u32 = 0
    while gx < GRID_WIDTH { grid[gy][gx] = 0; gx = gx + 1 }
    gy = gy + 1
  }
  tetris_spawn_piece()
  tetris_draw()

  var running: u32 = 1
  while running == 1 and game_over == 0 {
    timer.timer_sleep_ms(500)

    if tetris_piece_collides(piece_x, piece_y + 1, piece_shape) == 1 {
      tetris_lock_piece()
      var lines: u32 = tetris_clear_lines()
      if lines == 1 { score = score + 100 }
      if lines == 2 { score = score + 300 }
      if lines == 3 { score = score + 500 }
      if lines >= 4 { score = score + 800 }
      tetris_spawn_piece()
    } else {
      piece_y = piece_y + 1
    }

    tetris_draw()

    if keyboard.keyboard_has_char() == 1 {
      var ch: u8 = keyboard.keyboard_getchar()
      if ch == 'q' or ch == 'Q' {
        running = 0
      } else if ch == 'a' or ch == 'h' {
        if tetris_piece_collides(piece_x - 1, piece_y, piece_shape) == 0 {
          piece_x = piece_x - 1
        }
      } else if ch == 'd' or ch == 'l' {
        if tetris_piece_collides(piece_x + 1, piece_y, piece_shape) == 0 {
          piece_x = piece_x + 1
        }
      } else if ch == ' ' {
        // Rotate 90° clockwise in-place.
        var rotated: u16 = 0
        var r: u32 = 0
        while r < 4 {
          var c: u32 = 0
          while c < 4 {
            var sbit: u16 = @as(u16, 0x8000) >> (r * 4 + c)
            if (piece_shape & sbit) != 0 {
              var nr: u32 = c
              var nc: u32 = 3 - r
              rotated = rotated | (@as(u16, 0x8000) >> (nr * 4 + nc))
            }
            c = c + 1
          }
          r = r + 1
        }
        if tetris_piece_collides(piece_x, piece_y, rotated) == 0 {
          piece_shape = rotated
        }
      }
    }
  }

  if game_over == 1 {
    foundation.vga_write_string("\nGAME OVER — Final score: ")
    foundation.vga_write_u64(@as(u64, score))
    foundation.vga_write_string("\n")
  }
}
