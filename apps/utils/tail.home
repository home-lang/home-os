// home-os Tail
// Display last lines of file

import "../../kernel/src/core/foundation.home" as foundation
import "../../kernel/src/core/filesystem.home" as filesystem

export fn tail_main(file: u64, lines: u32) {
  if lines == 0 { lines = 10 }
  
  var fd: u32 = filesystem.vfs_open(file, 0)
  if fd == 0xFFFFFFFF {
    foundation.vga_write_string("tail: cannot open file\n")
    return
  }
  
  // Read entire file into memory (up to 64KB) to find last N lines.
  // For larger files, a streaming two-pass approach with seek would be better,
  // but this handles the common case and reports truncation.
  const MAX_FILE_SIZE: u32 = 65536
  var buffer: [u8; 65536]
  var total_bytes: u64 = 0
  var truncated: u32 = 0

  // Read file in chunks
  var chunk_bytes: u64 = 1
  while chunk_bytes > 0 and total_bytes < MAX_FILE_SIZE {
    var remaining: u32 = MAX_FILE_SIZE - @intCast(total_bytes)
    chunk_bytes = filesystem.vfs_read(fd, @ptrFromInt(@intFromPtr(&buffer) + total_bytes), remaining)
    total_bytes = total_bytes + chunk_bytes
  }

  // Check if file was truncated
  if total_bytes >= MAX_FILE_SIZE {
    var extra: [u8; 1]
    if filesystem.vfs_read(fd, @ptrFromInt(@intFromPtr(&extra)), 1) > 0 {
      truncated = 1
      foundation.vga_write_string("tail: warning: file exceeds 64KB, showing last lines of first 64KB\n")
    }
  }

  // Count total lines
  var total_lines: u32 = 0
  var i: u32 = 0
  while i < total_bytes {
    if buffer[i] == '\n' {
      total_lines = total_lines + 1
    }
    i = i + 1
  }

  // Find start position
  var start_line: u32 = 0
  if total_lines > lines {
    start_line = total_lines - lines
  }

  // Display from start_line
  var line_count: u32 = 0
  i = 0
  while i < total_bytes {
    if line_count >= start_line {
      foundation.vga_write_char(buffer[i])
    }
    if buffer[i] == '\n' {
      line_count = line_count + 1
    }
    i = i + 1
  }

  filesystem.vfs_close(fd)
}
