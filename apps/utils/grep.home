// home-os Grep
// Search text patterns

import "../../kernel/src/core/foundation.home" as foundation
import "../../kernel/src/core/filesystem.home" as filesystem

// Substring search: returns 1 if pattern is found within line, 0 otherwise.
// Uses a simple sliding window comparison.
fn grep_search_line(line: u64, line_len: u32, pattern: u64, pattern_len: u32): u32 {
  if pattern_len == 0 { return 1 }  // Empty pattern matches everything
  if line_len < pattern_len { return 0 }

  var i: u32 = 0
  while i <= line_len - pattern_len {
    var match: u32 = 1
    var j: u32 = 0
    while j < pattern_len {
      var line_ch: u8 = @as(*u8, @ptrFromInt(line + i + j)).*
      var pat_ch: u8 = @as(*u8, @ptrFromInt(pattern + j)).*
      if line_ch != pat_ch {
        match = 0
        break
      }
      j = j + 1
    }
    if match == 1 { return 1 }
    i = i + 1
  }
  return 0
}

// Measure null-terminated string length
fn grep_strlen(s: u64): u32 {
  var len: u32 = 0
  while @as(*u8, @ptrFromInt(s + len)).* != 0 {
    len = len + 1
  }
  return len
}

export fn grep_main(pattern: u64, file: u64) {
  foundation.vga_clear()
  foundation.vga_write_string("=== Grep ===\n\n")
  foundation.vga_write_string("Searching for: ")
  foundation.vga_write_string(@as(*u8, @ptrFromInt(pattern)))
  foundation.vga_write_string("\n\n")

  var fd: u32 = filesystem.vfs_open(file, 0)
  if fd == 0xFFFFFFFF {
    foundation.vga_write_string("File not found\n")
    return
  }

  var buffer: [u8; 4096]
  var bytes: u64 = filesystem.vfs_read(fd, @ptrFromInt(@intFromPtr(&buffer)), 4096)

  var pattern_len: u32 = grep_strlen(pattern)
  var line_num: u32 = 1
  var line_start: u32 = 0
  var match_count: u32 = 0
  var i: u32 = 0

  while i < bytes {
    if buffer[i] == '\n' or i == bytes - 1 {
      var line_end: u32 = i
      if buffer[i] == '\n' { line_end = i }
      else { line_end = i + 1 }
      var line_len: u32 = line_end - line_start

      if line_len > 0 {
        if grep_search_line(@intFromPtr(&buffer) + line_start, line_len, pattern, pattern_len) == 1 {
          foundation.vga_write_string("Line ")
          foundation.serial_write_hex(line_num)
          foundation.vga_write_string(": ")
          // Print the matching line
          var k: u32 = line_start
          while k < line_end {
            var ch_buf: [u8; 2]
            ch_buf[0] = buffer[k]
            ch_buf[1] = 0
            foundation.vga_write_string(@as(*u8, @ptrFromInt(@intFromPtr(&ch_buf))))
            k = k + 1
          }
          foundation.vga_write_string("\n")
          match_count = match_count + 1
        }
      }

      line_start = i + 1
      line_num = line_num + 1
    }
    i = i + 1
  }

  if match_count == 0 {
    foundation.vga_write_string("No matches found.\n")
  }

  filesystem.vfs_close(fd)
}
