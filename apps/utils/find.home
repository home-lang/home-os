// home-os Find
// Search for files

import "../../kernel/src/core/foundation.home" as foundation
import "../../kernel/src/core/filesystem.home" as filesystem

// Check if filename contains the search pattern (substring match)
fn find_name_matches(filename: u64, pattern: u64): u32 {
  var flen: u32 = 0
  while @as(*u8, @ptrFromInt(filename + flen)).* != 0 { flen = flen + 1 }
  var plen: u32 = 0
  while @as(*u8, @ptrFromInt(pattern + plen)).* != 0 { plen = plen + 1 }

  if plen == 0 { return 1 }
  if flen < plen { return 0 }

  var i: u32 = 0
  while i <= flen - plen {
    var match: u32 = 1
    var j: u32 = 0
    while j < plen {
      if @as(*u8, @ptrFromInt(filename + i + j)).* != @as(*u8, @ptrFromInt(pattern + j)).* {
        match = 0
        break
      }
      j = j + 1
    }
    if match == 1 { return 1 }
    i = i + 1
  }
  return 0
}

fn find_recursive(path: u64, name: u64, depth: u32) {
  if depth > 10 { return }

  // Open directory for listing
  var dir_fd: u32 = filesystem.vfs_open(path, 0)
  if dir_fd == 0xFFFFFFFF { return }

  var entry_buf: [u8; 256]
  // Read directory entries
  while filesystem.vfs_readdir(dir_fd, @ptrFromInt(@intFromPtr(&entry_buf)), 256) > 0 {
    // Skip . and ..
    if entry_buf[0] == '.' {
      if entry_buf[1] == 0 { continue }
      if entry_buf[1] == '.' and entry_buf[2] == 0 { continue }
    }

    // Build full path: path + "/" + entry
    var full_path: [u8; 4096]
    var pi: u32 = 0
    while @as(*u8, @ptrFromInt(path + pi)).* != 0 and pi < 4090 {
      full_path[pi] = @as(*u8, @ptrFromInt(path + pi)).*
      pi = pi + 1
    }
    full_path[pi] = '/'
    pi = pi + 1
    var ei: u32 = 0
    while entry_buf[ei] != 0 and pi < 4095 {
      full_path[pi] = entry_buf[ei]
      pi = pi + 1
      ei = ei + 1
    }
    full_path[pi] = 0

    // Check if entry name matches pattern
    if find_name_matches(@intFromPtr(&entry_buf), name) == 1 {
      foundation.vga_write_string(@as(*u8, @ptrFromInt(@intFromPtr(&full_path))))
      foundation.vga_write_string("\n")
    }

    // Recurse into subdirectories
    find_recursive(@intFromPtr(&full_path), name, depth + 1)
  }

  filesystem.vfs_close(dir_fd)
}

export fn find_main(path: u64, name: u64) {
  foundation.vga_clear()
  foundation.vga_write_string("=== Find ===\n\n")
  foundation.vga_write_string("Searching for: ")
  foundation.vga_write_string(@as(*u8, @ptrFromInt(name)))
  foundation.vga_write_string("\n")
  foundation.vga_write_string("In: ")
  foundation.vga_write_string(@as(*u8, @ptrFromInt(path)))
  foundation.vga_write_string("\n\n")

  find_recursive(path, name, 0)
}
