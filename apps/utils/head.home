// home-os Head
// Display first lines of file

import "../../kernel/src/core/foundation.home" as foundation
import "../../kernel/src/core/filesystem.home" as filesystem

export fn head_main(file: u64, lines: u32) {
  if lines == 0 { lines = 10 }
  
  var fd: u32 = filesystem.vfs_open(file, 0)
  if fd == 0xFFFFFFFF {
    foundation.vga_write_string("head: cannot open file\n")
    return
  }
  
  // Read file in chunks to handle files larger than buffer size
  const BUF_SIZE: u32 = 4096
  var buffer: [u8; 4096]
  var line_count: u32 = 0
  var total_bytes_read: u64 = 0
  var done: u32 = 0

  while done == 0 {
    var bytes: u64 = filesystem.vfs_read(fd, @ptrFromInt(@intFromPtr(&buffer)), BUF_SIZE)
    if bytes == 0 { break }

    var i: u32 = 0
    while i < bytes and line_count < lines {
      foundation.vga_write_char(buffer[i])
      if buffer[i] == '\n' {
        line_count = line_count + 1
      }
      i = i + 1
    }

    if line_count >= lines { done = 1 }
    total_bytes_read = total_bytes_read + bytes
    if bytes < BUF_SIZE { done = 1 }  // EOF reached
  }

  filesystem.vfs_close(fd)
}
