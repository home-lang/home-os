// home-os Wc
// Word count

import "../../kernel/src/core/foundation.home" as foundation
import "../../kernel/src/core/filesystem.home" as filesystem

export fn wc_main(file: u64) {
  var fd: u32 = filesystem.vfs_open(file, 0)
  if fd == 0xFFFFFFFF {
    foundation.vga_write_string("wc: cannot open file\n")
    foundation.vga_write_string("\n")
    return
  }

  // Counters MUST be u64 so files larger than 4 GiB produce correct
  // counts. The old `var chars: u32 = bytes` silently truncated file
  // sizes ≥ 4 GiB because bytes is a u64.
  var buffer: [u8; 4096]
  var lines: u64 = 0
  var words: u64 = 0
  var chars: u64 = 0
  var in_word: u32 = 0

  // Stream the file in 4 KiB chunks instead of reading a single 4 KiB
  // buffer — that alone ignored everything past the first 4 KiB.
  loop {
    var bytes: u64 = filesystem.vfs_read(fd, @ptrFromInt(buffer), 4096)
    if bytes == 0 { break }
    chars = chars + bytes

    var i: u64 = 0
    while i < bytes {
      var b: u8 = buffer[@intCast(i)]
      if b == '\n' {
        lines = lines + 1
      }
      if b == ' ' or b == '\n' or b == '\t' {
        in_word = 0
      } else {
        if in_word == 0 {
          words = words + 1
          in_word = 1
        }
      }
      i = i + 1
    }
  }

  filesystem.vfs_close(fd)

  foundation.vga_write_u64(lines)
  foundation.vga_write_string(" ")
  foundation.vga_write_u64(words)
  foundation.vga_write_string(" ")
  foundation.vga_write_u64(chars)
  foundation.vga_write_string(" ")

  foundation.vga_write_string("\n")
}
