// home-os Pwd
// Print working directory

import "../../kernel/src/core/foundation.home" as foundation

var current_dir: [u8; 256] = "/home/user"

export fn pwd_main() {
  foundation.vga_write_string(@ptrFromInt(current_dir))
  foundation.vga_write_string("\n")
}

// FIX R3 #34: Guarantee null termination. The previous loop could
// exit with i == 256 (source was exactly 256 bytes without a null),
// leaving `current_dir` unterminated. The next pwd_main() would
// then read past the buffer. We now stop one byte early so we can
// always write the null, and force it on every exit path.
export fn pwd_set(path: u64) {
  var i: u32 = 0
  while i < 255 {
    current_dir[i] = @as(*u8, @ptrFromInt(path + i)).*
    if current_dir[i] == 0 { return }
    i = i + 1
  }
  // Source was 255+ bytes without a null — truncate and terminate.
  current_dir[255] = 0
}
