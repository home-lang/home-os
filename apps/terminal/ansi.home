// home-os ANSI Escape Sequences
// ANSI color and text formatting

import "../../kernel/src/core/foundation.home" as foundation
import "vt100.home" as vt100

const ANSI_ESC: u8 = 0x1B

var current_fg_color: u32 = 0xFFFFFF
var current_bg_color: u32 = 0x000000
var current_bold: u32 = 0
var current_italic: u32 = 0
var current_underline: u32 = 0

var ansi_initialized: u32 = 0

// ANSI color palette
const ANSI_COLORS: [u32; 16] = [
  0x000000,  // Black
  0xAA0000,  // Red
  0x00AA00,  // Green
  0xAAAA00,  // Yellow
  0x0000AA,  // Blue
  0xAA00AA,  // Magenta
  0x00AAAA,  // Cyan
  0xAAAAAA,  // White
  0x555555,  // Bright Black
  0xFF5555,  // Bright Red
  0x55FF55,  // Bright Green
  0xFFFF55,  // Bright Yellow
  0x5555FF,  // Bright Blue
  0xFF55FF,  // Bright Magenta
  0x55FFFF,  // Bright Cyan
  0xFFFFFF   // Bright White
]

export fn ansi_init() {
  if ansi_initialized == 1 { return }
  
  current_fg_color = 0xFFFFFF
  current_bg_color = 0x000000
  current_bold = 0
  current_italic = 0
  current_underline = 0
  
  ansi_initialized = 1
  foundation.serial_write_string("[ANSI] Initialized\n")
}

export fn ansi_parse_sequence(seq: u64): u32 {
  // Parse ANSI escape sequence starting with ESC
  if @as(*u8, @ptrFromInt(seq)).* != ANSI_ESC { return 0 }
  
  var ch: u8 = @as(*u8, @ptrFromInt(seq + 1)).*
  
  // CSI sequences: ESC[
  if ch == '[' {
    return ansi_parse_csi(seq + 2)
  }
  
  // OSC sequences: ESC]
  if ch == ']' {
    return ansi_parse_osc(seq + 2)
  }
  
  return 0
}

// FIX R6 #1, #2, #33: Bound every write to params[] so a 16+ param
// sequence can never overflow, and cap the decimal accumulator so a
// 20-digit parameter can't wrap u32. Final-byte write also needs
// the same cap since it's the most common off-by-one.
const ANSI_MAX_PARAMS: u32 = 16
const ANSI_PARAM_CAP: u32 = 0x0FFFFFFF  // ~268M — any realistic ANSI param

fn ansi_parse_csi(seq: u64): u32 {
  var params: [u32; 16]
  var param_count: u32 = 0
  var i: u32 = 0
  var current_param: u32 = 0

  // Parse parameters
  while i < 64 {
    var ch: u8 = @as(*u8, @ptrFromInt(seq + i)).*

    if ch >= '0' and ch <= '9' {
      // Guard the multiply/add; ignore further digits past the cap.
      if current_param <= ANSI_PARAM_CAP / 10 {
        current_param = current_param * 10 + (ch - '0')
      }
    } else if ch == ';' {
      if param_count < ANSI_MAX_PARAMS {
        params[param_count] = current_param
        param_count = param_count + 1
      }
      current_param = 0
    } else {
      // Final byte — also bounded.
      if param_count < ANSI_MAX_PARAMS {
        params[param_count] = current_param
        param_count = param_count + 1
      }

      ansi_execute_csi(ch, @ptrFromInt(params), param_count)
      return i + 3  // ESC[ + params + final byte
    }

    i = i + 1
  }

  return 0
}

// FIX R6 #3: ECMA-48 says OSC terminates with BEL (0x07) or ST
// (the two-byte sequence ESC-backslash, 0x1B 0x5C). A lone ESC
// is NOT a terminator — it's the start of a new escape sequence,
// and treating it as the end truncated legitimate OSC payloads.
fn ansi_parse_osc(seq: u64): u32 {
  var i: u32 = 0
  while i < 256 {
    var ch: u8 = @as(*u8, @ptrFromInt(seq + i)).*
    if ch == 0x07 { return i + 3 }
    if ch == 0x1B {
      // Check the next byte — proper ST is ESC '\' (0x5C).
      var next: u8 = @as(*u8, @ptrFromInt(seq + i + 1)).*
      if next == 0x5C { return i + 4 }
      // Otherwise the payload is malformed; abort without consuming
      // the next ESC so higher-level parser can recover.
      return 0
    }
    i = i + 1
  }
  return 0
}

// FIX R6 #4: The cursor-movement and erase-display branches were
// empty stubs, so any program relying on ESC[...A/B/C/D/J/K did
// nothing. Now each CSI final byte forwards to the VT100 helper
// module which tracks cursor state and emits the actual serial
// escape sequences.
fn ansi_execute_csi(final_byte: u8, params: u64, param_count: u32) {
  // Extract first parameter (default 1 per ANSI spec, 0 for CUP).
  var p0: u32 = 0
  if param_count > 0 { p0 = @as(*u32, @ptrFromInt(params)).* }
  var p1: u32 = 0
  if param_count > 1 { p1 = @as(*u32, @ptrFromInt(params + 4)).* }

  if final_byte == 'm' {
    // SGR - Select Graphic Rendition
    ansi_sgr(params, param_count)
    return
  }

  if final_byte == 'H' or final_byte == 'f' {
    // CUP - Cursor Position (rows/columns default to 1).
    var row: u32 = if p0 == 0 { 1 } else { p0 }
    var col: u32 = if p1 == 0 { 1 } else { p1 }
    vt100.vt100_move_cursor(col - 1, row - 1)
    return
  }

  // For CUU/CUD/CUF/CUB an argument of 0 means 1 per spec.
  var n: u32 = if p0 == 0 { 1 } else { p0 }

  if final_byte == 'A' {
    vt100.vt100_cursor_up(n)
  } else if final_byte == 'B' {
    vt100.vt100_cursor_down(n)
  } else if final_byte == 'C' {
    vt100.vt100_cursor_forward(n)
  } else if final_byte == 'D' {
    vt100.vt100_cursor_back(n)
  } else if final_byte == 'J' {
    vt100.vt100_erase_display(p0)
  } else if final_byte == 'K' {
    vt100.vt100_erase_line(p0)
  }
}

fn ansi_sgr(params: u64, param_count: u32) {
  if param_count == 0 {
    // Reset
    ansi_reset()
    return
  }
  
  var i: u32 = 0
  while i < param_count {
    var param: u32 = @as(*volatile u32, @ptrFromInt(params + (i * 4))).*
    
    if param == 0 {
      ansi_reset()
    } else if param == 1 {
      current_bold = 1
    } else if param == 3 {
      current_italic = 1
    } else if param == 4 {
      current_underline = 1
    } else if param == 22 {
      current_bold = 0
    } else if param == 23 {
      current_italic = 0
    } else if param == 24 {
      current_underline = 0
    } else if param >= 30 and param <= 37 {
      // Foreground color
      current_fg_color = ANSI_COLORS[param - 30]
    } else if param >= 40 and param <= 47 {
      // Background color
      current_bg_color = ANSI_COLORS[param - 40]
    } else if param >= 90 and param <= 97 {
      // Bright foreground color
      current_fg_color = ANSI_COLORS[param - 90 + 8]
    } else if param >= 100 and param <= 107 {
      // Bright background color
      current_bg_color = ANSI_COLORS[param - 100 + 8]
    }
    
    i = i + 1
  }
}

export fn ansi_reset() {
  current_fg_color = 0xFFFFFF
  current_bg_color = 0x000000
  current_bold = 0
  current_italic = 0
  current_underline = 0
}

export fn ansi_get_fg_color(): u32 {
  return current_fg_color
}

export fn ansi_get_bg_color(): u32 {
  return current_bg_color
}

export fn ansi_is_bold(): u32 {
  return current_bold
}

export fn ansi_is_italic(): u32 {
  return current_italic
}

export fn ansi_is_underline(): u32 {
  return current_underline
}
