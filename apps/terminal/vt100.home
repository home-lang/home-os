// home-os VT100 Emulation
// VT100 terminal control sequences

import "../../kernel/src/core/foundation.home" as foundation

const VT100_ESC: u8 = 0x1B

var vt100_initialized: u32 = 0
var cursor_x: u32 = 0
var cursor_y: u32 = 0
var saved_cursor_x: u32 = 0
var saved_cursor_y: u32 = 0
var scroll_region_top: u32 = 0
var scroll_region_bottom: u32 = 24
var cursor_visible: u32 = 1

const TERM_WIDTH: u32 = 80
const TERM_HEIGHT: u32 = 25

export fn vt100_init() {
  if vt100_initialized == 1 { return }
  
  cursor_x = 0
  cursor_y = 0
  vt100_initialized = 1
  foundation.serial_write_string("[VT100] Initialized\n")
}

export fn vt100_clear_screen() {
  // ESC[2J
  foundation.serial_write_string("\x1B[2J")
}

export fn vt100_clear_line() {
  // ESC[2K
  foundation.serial_write_string("\x1B[2K")
}

// FIX R6 #7, #8: Cursor-motion APIs now emit the actual ANSI escape
// sequence rather than just updating local state, and coordinates
// are clamped so CUD/CUF can't walk past the terminal bounds.
fn vt100_emit_decimal(v: u32) {
  var digits: [u8; 12]
  var n: u32 = v
  var count: u32 = 0
  if n == 0 {
    foundation.serial_write_char('0')
    return
  }
  while n > 0 and count < 12 {
    digits[count] = @intCast((n % 10) + 48, u8)
    n = n / 10
    count = count + 1
  }
  while count > 0 {
    count = count - 1
    foundation.serial_write_char(digits[count])
  }
}

fn vt100_emit_simple(final_byte: u8, n: u32) {
  foundation.serial_write_char(0x1B)
  foundation.serial_write_char('[')
  if n > 1 { vt100_emit_decimal(n) }
  foundation.serial_write_char(final_byte)
}

fn vt100_emit_cup(row: u32, col: u32) {
  foundation.serial_write_char(0x1B)
  foundation.serial_write_char('[')
  vt100_emit_decimal(row)
  foundation.serial_write_char(';')
  vt100_emit_decimal(col)
  foundation.serial_write_char('H')
}

export fn vt100_move_cursor(x: u32, y: u32) {
  var cx: u32 = if x >= TERM_WIDTH { TERM_WIDTH - 1 } else { x }
  var cy: u32 = if y >= TERM_HEIGHT { TERM_HEIGHT - 1 } else { y }
  cursor_x = cx
  cursor_y = cy
  vt100_emit_cup(cy + 1, cx + 1)
}

export fn vt100_cursor_up(n: u32) {
  var step: u32 = if n == 0 { 1 } else { n }
  if cursor_y >= step {
    cursor_y = cursor_y - step
  } else {
    cursor_y = 0
  }
  vt100_emit_simple('A', step)
}

export fn vt100_cursor_down(n: u32) {
  var step: u32 = if n == 0 { 1 } else { n }
  cursor_y = cursor_y + step
  if cursor_y >= TERM_HEIGHT { cursor_y = TERM_HEIGHT - 1 }
  vt100_emit_simple('B', step)
}

export fn vt100_cursor_forward(n: u32) {
  var step: u32 = if n == 0 { 1 } else { n }
  cursor_x = cursor_x + step
  if cursor_x >= TERM_WIDTH { cursor_x = TERM_WIDTH - 1 }
  vt100_emit_simple('C', step)
}

export fn vt100_cursor_back(n: u32) {
  var step: u32 = if n == 0 { 1 } else { n }
  if cursor_x >= step {
    cursor_x = cursor_x - step
  } else {
    cursor_x = 0
  }
  vt100_emit_simple('D', step)
}

export fn vt100_save_cursor() {
  saved_cursor_x = cursor_x
  saved_cursor_y = cursor_y
}

export fn vt100_restore_cursor() {
  cursor_x = saved_cursor_x
  cursor_y = saved_cursor_y
}

export fn vt100_hide_cursor() {
  cursor_visible = 0
  foundation.serial_write_string("\x1B[?25l")
}

export fn vt100_show_cursor() {
  cursor_visible = 1
  foundation.serial_write_string("\x1B[?25h")
}

export fn vt100_set_scroll_region(top: u32, bottom: u32) {
  scroll_region_top = top
  scroll_region_bottom = bottom
}

// FIX R6 #9: Actually emit the IL/DL sequences so the terminal
// performs the insert/delete instead of just resetting cursor_x.
export fn vt100_insert_line(n: u32) {
  var count: u32 = if n == 0 { 1 } else { n }
  cursor_x = 0
  vt100_emit_simple('L', count)
}

export fn vt100_delete_line(n: u32) {
  var count: u32 = if n == 0 { 1 } else { n }
  cursor_x = 0
  vt100_emit_simple('M', count)
}

export fn vt100_erase_display(mode: u32) {
  if mode == 0 {
    foundation.serial_write_string("\x1B[0J")
  } else if mode == 1 {
    foundation.serial_write_string("\x1B[1J")
  } else if mode == 2 {
    foundation.serial_write_string("\x1B[2J")
    cursor_x = 0
    cursor_y = 0
  }
}

export fn vt100_erase_line(mode: u32) {
  if mode == 0 {
    foundation.serial_write_string("\x1B[0K")
  } else if mode == 1 {
    foundation.serial_write_string("\x1B[1K")
  } else if mode == 2 {
    foundation.serial_write_string("\x1B[2K")
  }
}

export fn vt100_get_cursor_x(): u32 {
  return cursor_x
}

export fn vt100_get_cursor_y(): u32 {
  return cursor_y
}
