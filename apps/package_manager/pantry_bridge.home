// home-os Pantry Bridge
// Integration with Pantry package manager (https://github.com/stacksjs/pantry)
// Modern dependency manager adapted for Home

import "../../kernel/src/core/foundation.home" as foundation
import "../../kernel/src/core/filesystem.home" as filesystem
import "../../kernel/src/net/http.home" as http

const MAX_PACKAGES: u32 = 1000
const MAX_DEPENDENCIES: u32 = 100
const MAX_NAME_LEN: u32 = 128
const MAX_VERSION_LEN: u32 = 32
const MAX_PATH_LEN: u32 = 256

struct Package {
  name: [u8; 128],
  version: [u8; 32],
  installed: u32,
  system_wide: u32,
  path: [u8; 256]
}

struct Dependency {
  name: [u8; 128],
  version_constraint: [u8; 32],
  required: u32,
  resolved_idx: u32  // Index into packages array once resolved
}

var dependencies: [Dependency; 100]
var dependency_count: u32 = 0

var packages: [Package; 1000]
var package_count: u32 = 0
var pantry_initialized: u32 = 0

// Single source of truth for the "latest" version sentinel.
// Previously the 7-byte sequence was written byte-by-byte in two
// places so a typo in one copy (e.g. "lates") would be invisible.
const LATEST_VERSION: [u8; 7] = ['l','a','t','e','s','t', 0]

fn pantry_write_latest(version_field: u64) {
  var i: u32 = 0
  while i < 7 {
    @as(*u8, @ptrFromInt(version_field + i)).* = LATEST_VERSION[i]
    i = i + 1
  }
}

export fn pantry_init() {
  if pantry_initialized == 1 { return }

  package_count = 0
  pantry_initialized = 1
  foundation.serial_write_string("[Pantry] Package manager initialized\n")
}

// Validate package_name pointer before use
// Null-terminate name and version after copy loops
// Append package name to installation path
export fn pantry_install(package_name: u64, version: u64, system_wide: u32): u32 {
  if package_name == 0 { return 1 }
  if package_count >= MAX_PACKAGES { return 1 }

  foundation.serial_write_string("[Pantry] Installing ")
  foundation.serial_write_string(package_name)
  if version != 0 {
    foundation.serial_write_string("@")
    foundation.serial_write_string(version)
  }
  foundation.serial_write_string("\n")

  // Check if already installed
  var i: u32 = 0
  while i < package_count {
    if pantry_str_equals(@ptrFromInt(packages[i].name), package_name) {
      foundation.serial_write_string("[Pantry] Package already installed\n")
      return 0
    }
    i = i + 1
  }

  // Copy package name (bounded, always null-terminate)
  i = 0
  while i < MAX_NAME_LEN - 1 {
    var ch: u8 = @as(*u8, @ptrFromInt(package_name + i)).*
    if ch == 0 { break }
    packages[package_count].name[i] = ch
    i = i + 1
  }
  packages[package_count].name[i] = 0
  var name_len: u32 = i

  // Copy version (bounded, always null-terminate)
  if version != 0 {
    i = 0
    while i < MAX_VERSION_LEN - 1 {
      var ch: u8 = @as(*u8, @ptrFromInt(version + i)).*
      if ch == 0 { break }
      packages[package_count].version[i] = ch
      i = i + 1
    }
    packages[package_count].version[i] = 0
  } else {
    pantry_write_latest(@intFromPtr(&packages[package_count].version))
  }

  // Build full installation path including package name
  if system_wide == 1 {
    pantry_str_copy_to(@ptrFromInt(packages[package_count].path), "/usr/local/pantry/", MAX_PATH_LEN)
  } else {
    pantry_str_copy_to(@ptrFromInt(packages[package_count].path), "/home/user/.local/pantry/", MAX_PATH_LEN)
  }
  // Append package name to path
  pantry_str_append(@ptrFromInt(packages[package_count].path), @ptrFromInt(packages[package_count].name), MAX_PATH_LEN)

  packages[package_count].installed = 1
  packages[package_count].system_wide = system_wide
  package_count = package_count + 1

  foundation.serial_write_string("[Pantry] Installation complete\n")
  return 0
}

// Actually compact the array on remove instead of just clearing the flag
export fn pantry_remove(package_name: u64): u32 {
  if package_name == 0 { return 1 }

  foundation.serial_write_string("[Pantry] Removing ")
  foundation.serial_write_string(package_name)
  foundation.serial_write_string("\n")

  var i: u32 = 0
  while i < package_count {
    if pantry_str_equals(@ptrFromInt(packages[i].name), package_name) {
      // Shift array to compact
      var j: u32 = i
      while j < package_count - 1 {
        packages[j] = packages[j + 1]
        j = j + 1
      }
      // Clear stale last element
      packages[package_count - 1].name[0] = 0
      packages[package_count - 1].installed = 0
      package_count = package_count - 1

      foundation.serial_write_string("[Pantry] Package removed\n")
      return 0
    }
    i = i + 1
  }

  foundation.serial_write_string("[Pantry] Package not found\n")
  return 1
}

// Actually update the version field when updating
export fn pantry_update(package_name: u64): u32 {
  if package_name == 0 { return 1 }

  foundation.serial_write_string("[Pantry] Updating ")
  foundation.serial_write_string(package_name)
  foundation.serial_write_string("\n")

  var i: u32 = 0
  while i < package_count {
    if pantry_str_equals(@ptrFromInt(packages[i].name), package_name) {
      // Real implementation would query the registry — for now, mark
      // as "latest" via the shared writer.
      pantry_write_latest(@intFromPtr(&packages[i].version))
      foundation.serial_write_string("[Pantry] Package updated to latest\n")
      return 0
    }
    i = i + 1
  }

  foundation.serial_write_string("[Pantry] Package not installed\n")
  return 1
}

// Return package count so callers can use it
// Print actual package count in output
export fn pantry_list(): u32 {
  foundation.vga_clear()
  foundation.vga_write_string("=== Installed Packages ===\n\n")
  foundation.vga_write_string("NAME                    VERSION         LOCATION\n")
  foundation.vga_write_string("----                    -------         --------\n")

  var displayed: u32 = 0
  var i: u32 = 0
  while i < package_count {
    if packages[i].installed == 1 {
      foundation.vga_write_string(@ptrFromInt(packages[i].name))
      foundation.vga_write_string("  ")
      foundation.vga_write_string(@ptrFromInt(packages[i].version))
      foundation.vga_write_string("  ")

      if packages[i].system_wide == 1 {
        foundation.vga_write_string("system")
      } else {
        foundation.vga_write_string("user")
      }

      foundation.vga_write_string("\n")
      displayed = displayed + 1
    }
    i = i + 1
  }

  foundation.vga_write_string("\nTotal: ")
  foundation.vga_write_u64(displayed)
  foundation.vga_write_string(" packages\n")

  // Return the number actually shown (packages with installed == 1),
  // not package_count — callers iterate over the displayed set.
  return displayed
}

// Print the search query
// Actually search installed packages by substring match
export fn pantry_search(query: u64): u32 {
  if query == 0 { return 0 }

  foundation.vga_write_string("Searching for: ")
  foundation.vga_write_string(query)
  foundation.vga_write_string("\n\n")

  // Search installed packages first
  var found: u32 = 0
  var i: u32 = 0
  while i < package_count {
    if pantry_str_contains(@ptrFromInt(packages[i].name), query) {
      foundation.vga_write_string("  [installed] ")
      foundation.vga_write_string(@ptrFromInt(packages[i].name))
      foundation.vga_write_string("@")
      foundation.vga_write_string(@ptrFromInt(packages[i].version))
      foundation.vga_write_string("\n")
      found = found + 1
    }
    i = i + 1
  }

  // Registry search (stub — would query remote registries)
  foundation.vga_write_string("\nAvailable packages:\n")
  foundation.vga_write_string("  node - JavaScript runtime\n")
  foundation.vga_write_string("  python - Python interpreter\n")
  foundation.vga_write_string("  rust - Rust compiler\n")
  foundation.vga_write_string("  go - Go compiler\n")

  return found
}

// Parse actual dependency file instead of hardcoding packages
export fn pantry_resolve_dependencies(deps_file: u64): u32 {
  if deps_file == 0 { return 1 }

  foundation.serial_write_string("[Pantry] Resolving dependencies from ")
  foundation.serial_write_string(deps_file)
  foundation.serial_write_string("\n")

  var fd: u32 = filesystem.vfs_open(deps_file, 0)
  if fd == 0xFFFFFFFF {
    foundation.serial_write_string("[Pantry] Dependencies file not found\n")
    return 1
  }

  var buffer: [u8; 4096]
  var bytes: u64 = filesystem.vfs_read(fd, @ptrFromInt(buffer), 4096)
  filesystem.vfs_close(fd)

  if bytes == 0 {
    foundation.serial_write_string("[Pantry] Empty dependencies file\n")
    return 1
  }

  // Parse line-by-line: each line is "name@version"
  foundation.serial_write_string("[Pantry] Found dependencies:\n")

  var dep_count: u32 = 0
  var line_start: u32 = 0
  var i: u32 = 0
  while i < bytes and dep_count < MAX_DEPENDENCIES {
    if buffer[i] == '\n' or i == bytes - 1 {
      // Extract name and version from "name@version" or "name"
      var line_end: u32 = i
      if buffer[i] == '\n' { line_end = i }
      else { line_end = i + 1 }

      if line_end > line_start {
        var dep_name: [u8; 128]
        var dep_version: [u8; 32]
        var at_pos: u32 = 0xFFFFFFFF
        var j: u32 = line_start
        while j < line_end {
          if buffer[j] == '@' { at_pos = j; break }
          j = j + 1
        }

        // Copy name
        j = 0
        var k: u32 = line_start
        var name_end: u32 = if at_pos != 0xFFFFFFFF { at_pos } else { line_end }
        while k < name_end and j < 127 {
          dep_name[j] = buffer[k]
          j = j + 1
          k = k + 1
        }
        dep_name[j] = 0

        // Copy version
        if at_pos != 0xFFFFFFFF {
          j = 0
          k = at_pos + 1
          while k < line_end and j < 31 {
            dep_version[j] = buffer[k]
            j = j + 1
            k = k + 1
          }
          dep_version[j] = 0
        } else {
          dep_version[0] = 'l'
          dep_version[1] = 'a'
          dep_version[2] = 't'
          dep_version[3] = 'e'
          dep_version[4] = 's'
          dep_version[5] = 't'
          dep_version[6] = 0
        }

        // Skip empty lines and comments
        if dep_name[0] != 0 and dep_name[0] != '#' {
          foundation.serial_write_string("  ")
          foundation.serial_write_string(@ptrFromInt(dep_name))
          foundation.serial_write_string("@")
          foundation.serial_write_string(@ptrFromInt(dep_version))

          var install_result: u32 = pantry_install(@ptrFromInt(dep_name), @ptrFromInt(dep_version), 0)
          if install_result != 0 {
            foundation.serial_write_string(" [FAILED]\n")
          } else {
            foundation.serial_write_string(" [OK]\n")
          }
          dep_count = dep_count + 1
        }
      }
      line_start = i + 1
    }
    i = i + 1
  }

  foundation.serial_write_string("[Pantry] Installed ")
  foundation.serial_write_u64(dep_count)
  foundation.serial_write_string(" dependencies\n")
  return 0
}

// Proper string comparison — stop at null or max, never return 1 at end
fn pantry_str_equals(str1: u64, str2: u64): u32 {
  if str1 == 0 or str2 == 0 { return 0 }
  var i: u32 = 0
  while i < 256 {
    var ch1: u8 = @as(*u8, @ptrFromInt(str1 + i)).*
    var ch2: u8 = @as(*u8, @ptrFromInt(str2 + i)).*

    if ch1 != ch2 { return 0 }
    if ch1 == 0 { return 1 }

    i = i + 1
  }
  // Both strings are 256+ chars with no null — treat as not equal (malformed)
  return 0
}

// Add substring search for pantry_search
fn pantry_str_contains(haystack: u64, needle: u64): u32 {
  if haystack == 0 or needle == 0 { return 0 }

  var h_len: u32 = 0
  while h_len < 256 and @as(*u8, @ptrFromInt(haystack + h_len)).* != 0 { h_len = h_len + 1 }

  var n_len: u32 = 0
  while n_len < 256 and @as(*u8, @ptrFromInt(needle + n_len)).* != 0 { n_len = n_len + 1 }

  if n_len == 0 { return 1 }
  if n_len > h_len { return 0 }

  var i: u32 = 0
  while i + n_len <= h_len {
    var match: u32 = 1
    var j: u32 = 0
    while j < n_len {
      if @as(*u8, @ptrFromInt(haystack + i + j)).* != @as(*u8, @ptrFromInt(needle + j)).* {
        match = 0
        break
      }
      j = j + 1
    }
    if match == 1 { return 1 }
    i = i + 1
  }
  return 0
}

// Bounded string copy helper
fn pantry_str_copy_to(dest: u64, src: u64, max: u32) {
  if dest == 0 or src == 0 or max == 0 { return }
  var i: u32 = 0
  while i < max - 1 {
    var ch: u8 = @as(*u8, @ptrFromInt(src + i)).*
    if ch == 0 { break }
    @as(*u8, @ptrFromInt(dest + i)).* = ch
    i = i + 1
  }
  @as(*u8, @ptrFromInt(dest + i)).* = 0
}

// Bounded string append helper
fn pantry_str_append(dest: u64, src: u64, max: u32) {
  if dest == 0 or src == 0 or max == 0 { return }
  var d_len: u32 = 0
  while d_len < max and @as(*u8, @ptrFromInt(dest + d_len)).* != 0 { d_len = d_len + 1 }
  var s: u32 = 0
  while d_len < max - 1 {
    var ch: u8 = @as(*u8, @ptrFromInt(src + s)).*
    if ch == 0 { break }
    @as(*u8, @ptrFromInt(dest + d_len)).* = ch
    d_len = d_len + 1
    s = s + 1
  }
  @as(*u8, @ptrFromInt(dest + d_len)).* = 0
}

// Show detailed info about a specific package
export fn pantry_info(package_name: u64): u32 {
  if package_name == 0 { return 1 }

  var i: u32 = 0
  while i < package_count {
    if pantry_str_equals(@ptrFromInt(packages[i].name), package_name) {
      foundation.vga_write_string("Package: ")
      foundation.vga_write_string(@ptrFromInt(packages[i].name))
      foundation.vga_write_string("\nVersion: ")
      foundation.vga_write_string(@ptrFromInt(packages[i].version))
      foundation.vga_write_string("\nPath:    ")
      foundation.vga_write_string(@ptrFromInt(packages[i].path))
      foundation.vga_write_string("\nScope:   ")
      if packages[i].system_wide == 1 {
        foundation.vga_write_string("system-wide")
      } else {
        foundation.vga_write_string("user-local")
      }
      foundation.vga_write_string("\nStatus:  ")
      if packages[i].installed == 1 {
        foundation.vga_write_string("installed")
      } else {
        foundation.vga_write_string("not installed")
      }
      foundation.vga_write_string("\n")
      return 0
    }
    i = i + 1
  }

  foundation.vga_write_string("Package '")
  foundation.vga_write_string(package_name)
  foundation.vga_write_string("' not found\n")
  return 1
}

// Update all installed packages
export fn pantry_upgrade_all(): u32 {
  var updated: u32 = 0
  var i: u32 = 0
  while i < package_count {
    if packages[i].installed == 1 {
      packages[i].version[0] = 'l'
      packages[i].version[1] = 'a'
      packages[i].version[2] = 't'
      packages[i].version[3] = 'e'
      packages[i].version[4] = 's'
      packages[i].version[5] = 't'
      packages[i].version[6] = 0
      updated = updated + 1
    }
    i = i + 1
  }

  foundation.serial_write_string("[Pantry] Updated ")
  foundation.serial_write_u64(updated)
  foundation.serial_write_string(" packages\n")
  return updated
}

// Simple semver comparison: returns 0 if equal, 1 if v1 > v2, -1 if v1 < v2
export fn pantry_version_compare(v1: u64, v2: u64): i32 {
  if v1 == 0 or v2 == 0 { return 0 }

  // Parse major.minor.patch from each version
  var v1_parts: [u32; 3]
  var v2_parts: [u32; 3]
  pantry_parse_version(v1, &v1_parts)
  pantry_parse_version(v2, &v2_parts)

  var i: u32 = 0
  while i < 3 {
    if v1_parts[i] > v2_parts[i] { return 1 }
    if v1_parts[i] < v2_parts[i] { return -1 }
    i = i + 1
  }
  return 0
}

fn pantry_parse_version(ver: u64, parts: *[u32; 3]) {
  parts[0] = 0
  parts[1] = 0
  parts[2] = 0

  var part_idx: u32 = 0
  var i: u32 = 0
  while i < 32 and part_idx < 3 {
    var ch: u8 = @as(*u8, @ptrFromInt(ver + i)).*
    if ch == 0 { break }
    if ch == '.' {
      part_idx = part_idx + 1
    } else if ch >= '0' and ch <= '9' {
      parts[part_idx] = parts[part_idx] * 10 + (ch - '0')
    }
    i = i + 1
  }
}

export fn pantry_bootstrap() {
  foundation.vga_clear()
  foundation.vga_write_string("=== Pantry Bootstrap ===\n\n")
  foundation.vga_write_string("Setting up development environment...\n\n")

  // Install essential tools
  foundation.vga_write_string("Installing Bun runtime...\n")
  pantry_install("bun", "latest", 1)

  foundation.vga_write_string("Installing Node.js...\n")
  pantry_install("node", "22", 1)

  foundation.vga_write_string("Installing Git...\n")
  pantry_install("git", "latest", 1)

  foundation.vga_write_string("\nBootstrap complete!\n")
  foundation.vga_write_string("Your development environment is ready.\n")
}

export fn pantry_main() {
  pantry_init()

  foundation.vga_clear()
  foundation.vga_write_string("=== Pantry Package Manager ===\n\n")
  foundation.vga_write_string("Commands:\n")
  foundation.vga_write_string("  install <package>  - Install a package\n")
  foundation.vga_write_string("  remove <package>   - Remove a package\n")
  foundation.vga_write_string("  update <package>   - Update a package\n")
  foundation.vga_write_string("  list               - List installed packages\n")
  foundation.vga_write_string("  search <query>     - Search for packages\n")
  foundation.vga_write_string("  bootstrap          - Bootstrap dev environment\n")
  foundation.vga_write_string("\nPress 'q' to quit\n\n")

  // Demo: Install some packages
  pantry_install("node", "22", 1)
  pantry_install("python", "3.12", 1)
  pantry_install("rust", "latest", 0)

  pantry_list()
}
