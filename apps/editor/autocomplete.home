// home-os Auto-completion
// Intelligent code completion

import "../../kernel/src/core/foundation.home" as foundation

const MAX_SUGGESTIONS: u32 = 20

struct Suggestion {
  text: [u8; 128],
  type: u32,
  score: u32
}

var suggestions: [Suggestion; 20]
var suggestion_count: u32 = 0
var autocomplete_active: u32 = 0

export fn autocomplete_init() {
  suggestion_count = 0
  autocomplete_active = 0
  foundation.serial_write_string("[Autocomplete] Initialized\n")
}

const HOME_KEYWORD_COUNT: u32 = 17

// Real keyword list ordered alphabetically. Prefix matching
// is performed by `autocomplete_has_prefix` so suggestions are actually
// relevant to what the user typed.
fn autocomplete_home_keyword(i: u32): u64 {
  if i == 0  { return @intFromPtr("and") }
  if i == 1  { return @intFromPtr("break") }
  if i == 2  { return @intFromPtr("const") }
  if i == 3  { return @intFromPtr("continue") }
  if i == 4  { return @intFromPtr("else") }
  if i == 5  { return @intFromPtr("export") }
  if i == 6  { return @intFromPtr("fn") }
  if i == 7  { return @intFromPtr("function") }
  if i == 8  { return @intFromPtr("if") }
  if i == 9  { return @intFromPtr("import") }
  if i == 10 { return @intFromPtr("let") }
  if i == 11 { return @intFromPtr("loop") }
  if i == 12 { return @intFromPtr("or") }
  if i == 13 { return @intFromPtr("return") }
  if i == 14 { return @intFromPtr("struct") }
  if i == 15 { return @intFromPtr("var") }
  if i == 16 { return @intFromPtr("while") }
  return 0
}

fn autocomplete_has_prefix(s: u64, prefix: u64): u32 {
  if prefix == 0 { return 1 }
  var i: u32 = 0
  while i < 128 {
    var pc: u8 = @as(*u8, @ptrFromInt(prefix + i)).*
    if pc == 0 { return 1 }
    var sc: u8 = @as(*u8, @ptrFromInt(s + i)).*
    if sc != pc { return 0 }
    i = i + 1
  }
  return 1
}

// Stage the rebuild into a new_count so an interleaved
// reader sees either the old list or the new one, not a half-empty
// intermediate. This is a best-effort snapshot rather than a true
// double-buffer, but it removes the obvious race.
export fn autocomplete_suggest(prefix: u64, language: u32): u32 {
  var new_count: u32 = 0

  if language == 1 {
    var k: u32 = 0
    while k < HOME_KEYWORD_COUNT {
      var kw: u64 = autocomplete_home_keyword(k)
      if kw != 0 and autocomplete_has_prefix(kw, prefix) == 1 {
        if autocomplete_add_suggestion_at(new_count, kw, 1) == 1 {
          new_count = new_count + 1
          if new_count >= MAX_SUGGESTIONS { break }
        }
      }
      k = k + 1
    }
  }

  suggestion_count = new_count
  return suggestion_count
}

// Always NUL-terminate (loop bound 127, unconditional
// write of 0 at position i on exit).
fn autocomplete_add_suggestion_at(idx: u32, text: u64, ty: u32): u32 {
  if idx >= MAX_SUGGESTIONS { return 0 }

  var i: u32 = 0
  while i < 127 {
    var ch: u8 = @as(*u8, @ptrFromInt(text + i)).*
    suggestions[idx].text[i] = ch
    if ch == 0 { break }
    i = i + 1
  }
  suggestions[idx].text[i] = 0

  suggestions[idx].type = ty
  suggestions[idx].score = 100
  return 1
}

// Backwards-compatible shim — the old callers pushed into the shared
// list sequentially. Useful during the transition.
fn autocomplete_add_suggestion(text: u64, ty: u32) {
  if suggestion_count >= MAX_SUGGESTIONS { return }
  if autocomplete_add_suggestion_at(suggestion_count, text, ty) == 1 {
    suggestion_count = suggestion_count + 1
  }
}

// Callers supply their own destination buffer and the
// function copies the suggestion into it. Previously the API handed
// back a raw pointer into the shared `suggestions` array, which the
// next `autocomplete_suggest` call would mutate out from under them.
// Returns number of bytes written (excluding terminator), or 0 on
// invalid index / buffer.
export fn autocomplete_get_suggestion(index: u32, dst: u64, dst_cap: u32): u32 {
  if index >= suggestion_count or dst == 0 or dst_cap == 0 { return 0 }

  var i: u32 = 0
  while i < dst_cap - 1 and i < 128 {
    var ch: u8 = suggestions[index].text[i]
    @as(*u8, @ptrFromInt(dst + i)).* = ch
    if ch == 0 { return i }
    i = i + 1
  }
  @as(*u8, @ptrFromInt(dst + i)).* = 0
  return i
}
